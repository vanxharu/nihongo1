"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-156","text":"男の人は昨日何をしましたか?","start":949.69,"end":955.199,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"昨日","reading":"きのう","offset":4},{"word":"何","reading":"なに","offset":6}]},{"id":"sentence-157","text":"昨日どこか行ったんでしょううん。","start":976.279,"end":979.586,"readings":[{"word":"昨日","reading":"きのう","offset":0},{"word":"行っ","reading":"おこなっ","offset":5}]},{"id":"sentence-158","text":"海へ行ったんだ。","start":979.586,"end":981.24,"readings":[{"word":"海","reading":"うみ","offset":0},{"word":"行っ","reading":"いっ","offset":2}]},{"id":"sentence-159","text":"泳ぎに。","start":981.24,"end":982.319,"readings":[{"word":"泳ぎ","reading":"およぎ","offset":0}]},{"id":"sentence-160","text":"うん。","start":982.319,"end":983.72,"readings":[]},{"id":"sentence-161","text":"奥さんを連れて散歩でもしたの?","start":983.72,"end":985.595,"readings":[{"word":"奥さん","reading":"おくさん","offset":0},{"word":"連れ","reading":"つれ","offset":4},{"word":"散歩","reading":"さんぽ","offset":7}]},{"id":"sentence-162","text":"そんな時間ないよ。","start":985.595,"end":986.72,"readings":[{"word":"時間","reading":"じかん","offset":3}]},{"id":"sentence-163","text":"じゃあ。","start":988.639,"end":989.658,"readings":[]},{"id":"sentence-164","text":"あ、分かった。","start":989.658,"end":991.44,"readings":[{"word":"分かっ","reading":"わかっ","offset":2}]},{"id":"sentence-165","text":"そう。","start":991.44,"end":992.19,"readings":[]},{"id":"sentence-166","text":"晩御飯のおかずさ。","start":992.19,"end":994.44,"readings":[{"word":"晩","reading":"ばん","offset":0},{"word":"御飯","reading":"ごはん","offset":1}]},{"id":"sentence-167","text":"男の人は昨日何をしましたか?","start":999.959,"end":1006.04,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"昨日","reading":"きのう","offset":4},{"word":"何","reading":"なに","offset":6}]},{"id":"sentence-168","text":"6番女の人と人が話しています。","start":1019.519,"end":1025.959,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"女","reading":"おんな","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"人","reading":"ひと","offset":6},{"word":"話し","reading":"はなし","offset":8}]},{"id":"sentence-169","text":"はいつですか?","start":1025.959,"end":1030.16,"readings":[]},{"id":"sentence-170","text":"あら、紙来たの?","start":1051.24,"end":1054.24,"readings":[{"word":"紙","reading":"かみ","offset":3},{"word":"来","reading":"き","offset":4}]},{"id":"sentence-171","text":"ああ。","start":1054.679,"end":1054.919,"readings":[]},{"id":"sentence-172","text":"2週間ぐらい前かな。","start":1054.919,"end":1055.719,"readings":[{"word":"週間","reading":"しゅうかん","offset":1},{"word":"前","reading":"まえ","offset":6}]},{"id":"sentence-173","text":"本の間に入れて忘れていた。","start":1055.719,"end":1056.76,"readings":[{"word":"本","reading":"ほん","offset":0},{"word":"間","reading":"ま","offset":2},{"word":"入れ","reading":"いれ","offset":4},{"word":"忘れ","reading":"わすれ","offset":7}]},{"id":"sentence-174","text":"ごめん。","start":1056.76,"end":1057.08,"readings":[]},{"id":"sentence-175","text":"大切なものだった。","start":1057.08,"end":1057.8,"readings":[{"word":"大切","reading":"たいせつ","offset":0}]},{"id":"sentence-176","text":"パーティーの案内なのよ。","start":1057.8,"end":1058.76,"readings":[{"word":"案内","reading":"あんない","offset":6}]},{"id":"sentence-177","text":"日前までに答えてくださいって書いてあるわ。","start":1066.16,"end":1070.898,"readings":[{"word":"日前","reading":"ひくま","offset":0},{"word":"答え","reading":"こたえ","offset":5},{"word":"書い","reading":"かい","offset":14}]},{"id":"sentence-178","text":"今日は15日ね。","start":1070.898,"end":1072.704,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"日","reading":"にち","offset":5}]},{"id":"sentence-179","text":"あと5日しかないわ。","start":1072.704,"end":1074.96,"readings":[{"word":"日","reading":"にち","offset":3}]},{"id":"sentence-180","text":"ごめん。","start":1074.96,"end":1077.96,"readings":[]},{"id":"sentence-181","text":"パーティーはいつですか?","start":1081.679,"end":1086.44,"readings":[]},{"id":"sentence-182","text":"7番男の人と女の人が話しています。","start":1099.84,"end":1106.32,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-183","text":"はどれを見ていますか?","start":1106.32,"end":1111.24,"readings":[{"word":"見","reading":"み","offset":4}]},{"id":"sentence-184","text":"あなたちょっと見小鳥の卵がまた2つ増えたみたいよ。","start":1132.44,"end":1139.44,"readings":[{"word":"見","reading":"み","offset":7},{"word":"小鳥","reading":"ことり","offset":8},{"word":"卵","reading":"たまご","offset":11},{"word":"増え","reading":"ふえ","offset":17}]},{"id":"sentence-185","text":"へえ。","start":1139.44,"end":1140.083,"readings":[]},{"id":"sentence-186","text":"昨日はいくつあったの?","start":1140.083,"end":1142.44,"readings":[{"word":"昨日","reading":"きのう","offset":0}]},{"id":"sentence-187","text":"昨日が3つで昨日は5つになっていたの。","start":1143.28,"end":1148.48,"readings":[{"word":"昨日","reading":"きのう","offset":0},{"word":"昨日","reading":"きのう","offset":6}]},{"id":"sentence-188","text":"いくつになるか楽しみだね。","start":1148.48,"end":1151.48,"readings":[{"word":"楽しみ","reading":"たのしみ","offset":7}]},{"id":"sentence-189","text":"2人はどれを見ていますか?","start":1156.84,"end":1162.159,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"見","reading":"み","offset":6}]},{"id":"sentence-190","text":"問題3問題3では絵を見ながら質問を聞いてください。","start":1174.64,"end":1184.88,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"絵","reading":"え","offset":8},{"word":"見","reading":"み","offset":10},{"word":"質問","reading":"しつもん","offset":14},{"word":"聞い","reading":"きい","offset":17}]},{"id":"sentence-191","text":"矢印の人は何と言いますか?","start":1184.88,"end":1189.36,"readings":[{"word":"矢印","reading":"やじるし","offset":0},{"word":"人","reading":"ひと","offset":3},{"word":"何","reading":"なに","offset":5},{"word":"言い","reading":"いい","offset":7}]},{"id":"sentence-192","text":"1から3の中から1番いいものを1つ選んでください。","start":1189.36,"end":1198.52,"readings":[{"word":"中","reading":"なか","offset":5},{"word":"番","reading":"ばん","offset":9},{"word":"選ん","reading":"えらん","offset":17}]},{"id":"sentence-193","text":"1番灰皿が欲しいです。","start":1202.28,"end":1206.309,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"灰皿","reading":"はいざら","offset":2},{"word":"欲しい","reading":"ほしい","offset":5}]},{"id":"sentence-194","text":"何と言いますか?","start":1206.309,"end":1209.24,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-195","text":"1ごめんなさい。","start":1209.24,"end":1212.233,"readings":[]},{"id":"sentence-196","text":"ザラそこにあるよ。","start":1212.233,"end":1215.6,"readings":[]},{"id":"sentence-197","text":"に、あの、それは灰皿と言ってもいい?","start":1215.6,"end":1221.919,"readings":[{"word":"灰皿","reading":"はいざら","offset":8},{"word":"言っ","reading":"いっ","offset":11}]},{"id":"sentence-198","text":"3悪いけどそこの灰皿取ってくれる?","start":1221.919,"end":1228.84,"readings":[{"word":"悪い","reading":"わるい","offset":1},{"word":"灰皿","reading":"はいざら","offset":8},{"word":"取っ","reading":"とっ","offset":10}]},{"id":"sentence-199","text":"2番日遊びをしている子を見つけてやめさせます。","start":1240.12,"end":1246.501,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"日","reading":"び","offset":2},{"word":"遊び","reading":"あそび","offset":3},{"word":"子","reading":"こ","offset":10},{"word":"見つけ","reading":"みつけ","offset":12}]},{"id":"sentence-200","text":"何と言いますか?","start":1246.501,"end":1248.72,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-201","text":"日遊びは子供のすることよ。","start":1250.2,"end":1253.2,"readings":[{"word":"日","reading":"にち","offset":0},{"word":"遊び","reading":"あそび","offset":1},{"word":"子供","reading":"こども","offset":4}]},{"id":"sentence-202","text":"2家事になった場合どうしたらいい?","start":1254.84,"end":1258.72,"readings":[{"word":"家事","reading":"かじ","offset":1},{"word":"場合","reading":"ばあい","offset":7}]},{"id":"sentence-203","text":"3あ、危ない。","start":1260.799,"end":1262.932,"readings":[{"word":"危ない","reading":"あぶない","offset":3}]},{"id":"sentence-204","text":"やめなさい。","start":1262.932,"end":1264.76,"readings":[]},{"id":"sentence-205","text":"3番遅れたわけを聞きます。","start":1278.32,"end":1281.044,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"遅れ","reading":"おくれ","offset":2},{"word":"聞き","reading":"きき","offset":8}]},{"id":"sentence-206","text":"何と言いますか?","start":1281.044,"end":1282.72,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-207","text":"どうだったの?","start":1286.559,"end":1288.174,"readings":[]},{"id":"sentence-208","text":"遅くなるか?","start":1288.174,"end":1289.559,"readings":[{"word":"遅く","reading":"おそく","offset":0}]},{"id":"sentence-209","text":"2どうしたの?","start":1291,"end":1293.175,"readings":[]},{"id":"sentence-210","text":"遅かったね。","start":1293.175,"end":1295.039,"readings":[{"word":"遅かっ","reading":"おそかっ","offset":0}]},{"id":"sentence-211","text":"3どう?","start":1296.44,"end":1298.314,"readings":[]},{"id":"sentence-212","text":"今からでは遅くない?","start":1298.314,"end":1303,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"遅く","reading":"おそく","offset":5}]},{"id":"sentence-213","text":"4番友達にお金を借りたいです。","start":1314.24,"end":1318.72,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"友達","reading":"ともだち","offset":2},{"word":"お金","reading":"おかね","offset":5},{"word":"借り","reading":"かり","offset":8}]},{"id":"sentence-214","text":"と言いますか?","start":1318.72,"end":1322.919,"readings":[{"word":"言い","reading":"いい","offset":1}]},{"id":"sentence-215","text":"悪いけど持ってる?","start":1322.919,"end":1325.919,"readings":[{"word":"悪い","reading":"わるい","offset":0},{"word":"持っ","reading":"もっ","offset":4}]},{"id":"sentence-216","text":"2今日お金を持ってるだろう。","start":1327.36,"end":1331.44,"readings":[{"word":"今日","reading":"きょう","offset":1},{"word":"お金","reading":"おかね","offset":3},{"word":"持っ","reading":"もっ","offset":6}]},{"id":"sentence-217","text":"3君のお金僕が使ってみようか?","start":1332.6,"end":1339.279,"readings":[{"word":"君","reading":"くん","offset":1},{"word":"お金","reading":"おかね","offset":3},{"word":"僕","reading":"ぼく","offset":5},{"word":"使っ","reading":"つかっ","offset":7}]},{"id":"sentence-218","text":"5番初めて会う人挨拶をします。と言いますか?","start":1350.559,"end":1359.799,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"初めて","reading":"はじめて","offset":2},{"word":"会う","reading":"あう","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"挨拶","reading":"あいさつ","offset":8},{"word":"言い","reading":"いい","offset":16}]},{"id":"sentence-219","text":"ここで会えて良かったじゃない?","start":1359.799,"end":1362.799,"readings":[{"word":"会え","reading":"あえ","offset":3},{"word":"良かっ","reading":"よかっ","offset":6}]},{"id":"sentence-220","text":"2お会いできて嬉しいです。","start":1363.96,"end":1367.799,"readings":[{"word":"会い","reading":"あい","offset":2},{"word":"嬉しい","reading":"うれしい","offset":7}]},{"id":"sentence-221","text":"3初めてですけど挨拶をします。","start":1368.76,"end":1372.72,"readings":[{"word":"初めて","reading":"はじめて","offset":1},{"word":"挨拶","reading":"あいさつ","offset":8}]},{"id":"sentence-222","text":"問題4問題4では絵などがありません。","start":1385.52,"end":1388.709,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"絵","reading":"え","offset":8}]},{"id":"sentence-223","text":"まず文を聞いてください。","start":1388.709,"end":1390.834,"readings":[{"word":"文","reading":"ぶん","offset":2},{"word":"聞い","reading":"きい","offset":4}]},{"id":"sentence-224","text":"それからその返事を聞いて","start":1390.834,"end":1392.96,"readings":[{"word":"返事","reading":"へんじ","offset":6},{"word":"聞い","reading":"きい","offset":9}]},{"id":"sentence-225","text":"1から3の中から1番いいものを1つ選んでください。","start":1401.559,"end":1409,"readings":[{"word":"中","reading":"なか","offset":5},{"word":"番","reading":"ばん","offset":9},{"word":"選ん","reading":"えらん","offset":17}]},{"id":"sentence-226","text":"1番。","start":1414.36,"end":1414.878,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-227","text":"今の仕事給料も少ないし疲れるし。","start":1414.878,"end":1417.64,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"仕事","reading":"しごと","offset":2},{"word":"給料","reading":"きゅうりょう","offset":4},{"word":"少ない","reading":"すくない","offset":7},{"word":"疲れる","reading":"つかれる","offset":11}]},{"id":"sentence-228","text":"まあ色々大変でしょうね。","start":1423.48,"end":1426.48,"readings":[{"word":"色々","reading":"いろいろ","offset":2},{"word":"大変","reading":"たいへん","offset":4}]},{"id":"sentence-229","text":"そういえば食べるのは心配ありませんね。","start":1429.52,"end":1432.52,"readings":[{"word":"食べる","reading":"たべる","offset":5},{"word":"心配","reading":"しんぱい","offset":10}]},{"id":"sentence-230","text":"3じゃあちょっと休みにしましょうか。","start":1434.96,"end":1441.76,"readings":[{"word":"休み","reading":"やすみ","offset":8}]},{"id":"sentence-231","text":"2番ねえ、うちの息子とあの女の子合わないと思うわ。","start":1453.159,"end":1462.36,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"息子","reading":"むすこ","offset":8},{"word":"女の子","reading":"おんなのこ","offset":13},{"word":"合わ","reading":"あわ","offset":16},{"word":"思う","reading":"おもう","offset":21}]},{"id":"sentence-232","text":"私反対よ。","start":1462.36,"end":1464.2,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"反対","reading":"はんたい","offset":1}]},{"id":"sentence-233","text":"君のことをいつから好きになったの?","start":1464.6,"end":1469.32,"readings":[{"word":"君","reading":"きみ","offset":0},{"word":"好き","reading":"すき","offset":9}]},{"id":"sentence-234","text":"2嫌われてもいいじゃないか。","start":1469.32,"end":1474.159,"readings":[{"word":"嫌わ","reading":"きらわ","offset":1}]},{"id":"sentence-235","text":"3でも好きならいいじゃない。","start":1474.159,"end":1480.2,"readings":[{"word":"好き","reading":"すき","offset":3}]},{"id":"sentence-236","text":"3番。","start":1491.559,"end":1493.039,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-237","text":"あの、貸してくれた本を汚してしまって。","start":1493.039,"end":1496.039,"readings":[{"word":"貸し","reading":"かし","offset":3},{"word":"本","reading":"ほん","offset":9},{"word":"汚し","reading":"よごし","offset":11}]},{"id":"sentence-238","text":"もう何日心配していたの?","start":1500.08,"end":1503.08,"readings":[{"word":"何","reading":"なん","offset":2},{"word":"日","reading":"にち","offset":3},{"word":"心配","reading":"しんぱい","offset":4}]},{"id":"sentence-239","text":"2。","start":1504.64,"end":1505.115,"readings":[]},{"id":"sentence-240","text":"まあ、これぐらいは大丈夫よ。","start":1505.115,"end":1508.44,"readings":[{"word":"大丈夫","reading":"だいじょうぶ","offset":9}]},{"id":"sentence-241","text":"3読みたいなら貸してあげましょう。","start":1510,"end":1513.88,"readings":[{"word":"読み","reading":"よみ","offset":1},{"word":"貸し","reading":"かし","offset":7}]},{"id":"sentence-242","text":"4番。","start":1527.24,"end":1528.32,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-243","text":"あ、すみません。","start":1528.32,"end":1530.32,"readings":[]},{"id":"sentence-244","text":"どうも。","start":1530.32,"end":1531.32,"readings":[]},{"id":"sentence-245","text":"おかげ様で元気です。","start":1533.679,"end":1536.679,"readings":[{"word":"様","reading":"さま","offset":3},{"word":"元気","reading":"げんき","offset":5}]},{"id":"sentence-246","text":"2こちらよろしくお願いします。","start":1537.559,"end":1541.44,"readings":[{"word":"お願い","reading":"おねがい","offset":8}]},{"id":"sentence-247","text":"3いいえ。","start":1543,"end":1544.414,"readings":[]},{"id":"sentence-248","text":"どういたしまして。","start":1544.414,"end":1546.96,"readings":[]},{"id":"sentence-249","text":"5番空港まで誰がお客さんを迎えに行くの?","start":1560,"end":1564.64,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"空港","reading":"くうこう","offset":2},{"word":"誰","reading":"だれ","offset":6},{"word":"お客","reading":"おきゃく","offset":8},{"word":"迎え","reading":"むかえ","offset":13},{"word":"行く","reading":"いく","offset":16}]},{"id":"sentence-250","text":"はい、もう行きました。","start":1568.32,"end":1571.32,"readings":[{"word":"行き","reading":"いき","offset":5}]},{"id":"sentence-251","text":"2ええ、私が言ってます。","start":1572.08,"end":1576.039,"readings":[{"word":"私","reading":"わたし","offset":4},{"word":"言っ","reading":"いっ","offset":6}]},{"id":"sentence-252","text":"3よければ私が行きましょう。","start":1577.12,"end":1583.279,"readings":[{"word":"私","reading":"わたし","offset":5},{"word":"行き","reading":"いき","offset":7}]},{"id":"sentence-253","text":"6番ああにしていた試合は雨で1本当残念だったね。","start":1594.64,"end":1606.84,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"試合","reading":"しあい","offset":9},{"word":"雨","reading":"あめ","offset":12},{"word":"本当","reading":"ほんとう","offset":15},{"word":"残念","reading":"ざんねん","offset":17}]},{"id":"sentence-254","text":"2うん。","start":1606.84,"end":1608.403,"readings":[]},{"id":"sentence-255","text":"楽しい試合だった。","start":1608.403,"end":1611.919,"readings":[{"word":"楽しい","reading":"たのしい","offset":0},{"word":"試合","reading":"しあい","offset":3}]},{"id":"sentence-256","text":"3、もう少しで振り出すところだったな。","start":1611.919,"end":1618.08,"readings":[{"word":"もう少し","reading":"もうすこし","offset":2},{"word":"振り出す","reading":"ふりだす","offset":7}]},{"id":"sentence-257","text":"7番お体の具合いかがですか?","start":1629.559,"end":1633.96,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"体","reading":"からだ","offset":3},{"word":"具合い","reading":"ぐあい","offset":5}]},{"id":"sentence-258","text":"おかげ様で良くなりました。","start":1636.159,"end":1639.159,"readings":[{"word":"様","reading":"さま","offset":3},{"word":"良く","reading":"よく","offset":5}]},{"id":"sentence-259","text":"2これからお事にしてくださいね。","start":1640.36,"end":1644.32,"readings":[{"word":"事","reading":"こと","offset":6}]},{"id":"sentence-260","text":"3特に綺麗にしてきましたよ。","start":1645.88,"end":1649.88,"readings":[{"word":"特に","reading":"とくに","offset":1},{"word":"綺麗","reading":"きれい","offset":3}]},{"id":"sentence-261","text":"8番。","start":1663.159,"end":1664.399,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-262","text":"今晩のパーティー楽しかったわ。","start":1664.399,"end":1667.399,"readings":[{"word":"今晩","reading":"こんばん","offset":0},{"word":"楽しかっ","reading":"たのしかっ","offset":8}]},{"id":"sentence-263","text":"遠いところから来ていただければ嬉しいと思います。","start":1670.2,"end":1673.2,"readings":[{"word":"遠い","reading":"とおい","offset":0},{"word":"来","reading":"き","offset":7},{"word":"嬉しい","reading":"うれしい","offset":15},{"word":"思い","reading":"おもい","offset":19}]},{"id":"sentence-264","text":"2、いらっしゃっていただいてどうもありがとうございました。","start":1675.84,"end":1678.84,"readings":[]},{"id":"sentence-265","text":"3すっかりお邪魔しまして本当にすみませんでした。","start":1683.399,"end":1691.12,"readings":[{"word":"邪魔","reading":"じゃま","offset":6},{"word":"本当に","reading":"ほんとうに","offset":12}]},{"id":"sentence-266","text":"これで長試験を終わります。","start":1699.559,"end":1706.48,"readings":[{"word":"長","reading":"ちょう","offset":3},{"word":"試験","reading":"しけん","offset":4},{"word":"終わり","reading":"おわり","offset":7}]}]}