{"videoId":"W7OPNaqIFUY","title":"【N5-N4】Ep276 What would you do if AI took your job? / Japanese Podcast for Beginners","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"しと日本語ポッドキャスト276初心者ビズ元気レベルAIに仕事を取られたらどうする?","start":0.719,"end":20.48,"readings":[{"word":"日本語","reading":"にほんご","offset":2},{"word":"初心者","reading":"しょしんしゃ","offset":15},{"word":"元気","reading":"げんき","offset":20},{"word":"仕事","reading":"しごと","offset":28},{"word":"取ら","reading":"とら","offset":31}]},{"id":"sentence-1","text":"皆さん、こんにちは。","start":32.32,"end":34.341,"readings":[{"word":"皆さん","reading":"みなさん","offset":0}]},{"id":"sentence-2","text":"日本語教師のです。","start":34.341,"end":36.16,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"教師","reading":"きょうし","offset":3}]},{"id":"sentence-3","text":"元気ですか?","start":36.16,"end":39.12,"readings":[{"word":"元気","reading":"げんき","offset":0}]},{"id":"sentence-4","text":"はい。","start":39.12,"end":40.07,"readings":[]},{"id":"sentence-5","text":"え、今日のトピックは面白いと思います。","start":40.07,"end":46.089,"readings":[{"word":"今日","reading":"きょう","offset":2},{"word":"面白い","reading":"おもしろい","offset":10},{"word":"思い","reading":"おもい","offset":14}]},{"id":"sentence-6","text":"皆さん今AIがすごいですよね。","start":46.089,"end":50.84,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"今","reading":"こん","offset":3}]},{"id":"sentence-7","text":"どうですか?","start":50.84,"end":52.879,"readings":[]},{"id":"sentence-8","text":"仕事でAIを使っていますか?","start":52.879,"end":58.68,"readings":[{"word":"仕事","reading":"しごと","offset":0},{"word":"使っ","reading":"つかっ","offset":6}]},{"id":"sentence-9","text":"ほとんどの人はAIを使って仕事をしていますよね。","start":58.68,"end":67.119,"readings":[{"word":"人","reading":"ひと","offset":5},{"word":"使っ","reading":"つかっ","offset":10},{"word":"仕事","reading":"しごと","offset":13}]},{"id":"sentence-10","text":"10年前は誰もAIを使っていませんでした。","start":67.36,"end":74.96,"readings":[{"word":"年","reading":"ねん","offset":2},{"word":"前","reading":"まえ","offset":3},{"word":"誰","reading":"だれ","offset":5},{"word":"使っ","reading":"つかっ","offset":10}]},{"id":"sentence-11","text":"AIの成長はすごすぎますよね。","start":74.96,"end":81.24,"readings":[{"word":"成長","reading":"せいちょう","offset":3}]},{"id":"sentence-12","text":"早すぎますよね。","start":81.24,"end":84.44,"readings":[{"word":"早","reading":"はや","offset":0}]},{"id":"sentence-13","text":"うん。","start":84.44,"end":85.64,"readings":[]},{"id":"sentence-14","text":"どう思いますか?","start":85.64,"end":88.04,"readings":[{"word":"思い","reading":"おもい","offset":2}]},{"id":"sentence-15","text":"本当に毎年AIのレベルは本当に上がっています。","start":88.04,"end":97.56,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"毎年","reading":"まいとし","offset":3},{"word":"本当に","reading":"ほんとうに","offset":12},{"word":"上がっ","reading":"あがっ","offset":15}]},{"id":"sentence-16","text":"今では1人でAIを使ってゲームやアプリ、動画を作ることができてしまいます。","start":97.68,"end":112.399,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"人","reading":"にん","offset":4},{"word":"使っ","reading":"つかっ","offset":9},{"word":"動画","reading":"どうが","offset":20},{"word":"作る","reading":"つくる","offset":23}]},{"id":"sentence-17","text":"InstagramやTikTokでもよくAIのコンテンツを見ますね。","start":112.96,"end":121.88,"readings":[{"word":"見","reading":"み","offset":29}]},{"id":"sentence-18","text":"あと最近はAIのクオリティが高すぎてAIかどうかも分からなくなってしまいました。","start":122.32,"end":136.12,"readings":[{"word":"最近","reading":"さいきん","offset":2},{"word":"高","reading":"たか","offset":14},{"word":"分から","reading":"わから","offset":25}]},{"id":"sentence-19","text":"皆さんはAIがもっと成長したらいい将来が待っていると思いますか?","start":136.72,"end":149.12,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"成長","reading":"せいちょう","offset":10},{"word":"将来","reading":"しょうらい","offset":17},{"word":"待っ","reading":"まっ","offset":20},{"word":"思い","reading":"おもい","offset":26}]},{"id":"sentence-20","text":"私は半分楽しみで半分怖いです。","start":150.599,"end":156.84,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"半分","reading":"はんぶん","offset":2},{"word":"楽しみ","reading":"たのしみ","offset":4},{"word":"半分","reading":"はんぶん","offset":8},{"word":"怖い","reading":"こわい","offset":10}]},{"id":"sentence-21","text":"まあ怖いですよね。","start":156.84,"end":161.099,"readings":[{"word":"怖い","reading":"こわい","offset":2}]},{"id":"sentence-22","text":"うん。","start":161.099,"end":162.519,"readings":[]},{"id":"sentence-23","text":"AIのせいで今の仕事はたくさんなくなると思います。","start":162.519,"end":171.08,"readings":[{"word":"今","reading":"いま","offset":6},{"word":"仕事","reading":"しごと","offset":8},{"word":"思い","reading":"おもい","offset":20}]},{"id":"sentence-24","text":"でも生活をするために仕事が必要ですから今の仕事がなくなるかもしれないのは少し不安になりますよね。","start":171.08,"end":187.92,"readings":[{"word":"生活","reading":"せいかつ","offset":2},{"word":"仕事","reading":"しごと","offset":10},{"word":"必要","reading":"ひつよう","offset":13},{"word":"今","reading":"いま","offset":19},{"word":"仕事","reading":"しごと","offset":21},{"word":"少し","reading":"すこし","offset":36},{"word":"不安","reading":"ふあん","offset":38}]},{"id":"sentence-25","text":"プログラマーもAIに取られるかもしれません。","start":189.04,"end":195.12,"readings":[{"word":"取ら","reading":"とら","offset":10}]},{"id":"sentence-26","text":"ま、日本語の先生も同じですよね。","start":195.12,"end":201.84,"readings":[{"word":"日本語","reading":"にほんご","offset":2},{"word":"先生","reading":"せんせい","offset":6},{"word":"同じ","reading":"おなじ","offset":9}]},{"id":"sentence-27","text":"本当にAIがすごくなかったら私の仕事もなくなるかもしれませんよね。","start":202.239,"end":213.2,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"私","reading":"わたし","offset":14},{"word":"仕事","reading":"しごと","offset":16}]},{"id":"sentence-28","text":"本当に分かりません。","start":213.2,"end":218,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"分かり","reading":"わかり","offset":3}]},{"id":"sentence-29","text":"でも皆さんどうですか?","start":218,"end":222.113,"readings":[{"word":"皆さん","reading":"みなさん","offset":2}]},{"id":"sentence-30","text":"少しワクワクしませんか?","start":222.113,"end":226.599,"readings":[{"word":"少し","reading":"すこし","offset":0}]},{"id":"sentence-31","text":"私だけですかね?","start":226.599,"end":229.439,"readings":[{"word":"私","reading":"わたし","offset":0}]},{"id":"sentence-32","text":"うん。","start":229.439,"end":230.486,"readings":[]},{"id":"sentence-33","text":"AIがすごくなかすごくなったらあのしたくない仕事はしなくても良くなりますね。","start":230.486,"end":243.752,"readings":[{"word":"仕事","reading":"しごと","offset":22},{"word":"良く","reading":"よく","offset":30}]},{"id":"sentence-34","text":"うん。","start":243.752,"end":244.799,"readings":[]},{"id":"sentence-35","text":"じゃあAIに仕事を取られたら皆さんは何をしますか?","start":244.799,"end":255.959,"readings":[{"word":"仕事","reading":"しごと","offset":6},{"word":"取ら","reading":"とら","offset":9},{"word":"皆さん","reading":"みなさん","offset":14},{"word":"何","reading":"なに","offset":18}]},{"id":"sentence-36","text":"うん。","start":256.239,"end":257.324,"readings":[]},{"id":"sentence-37","text":"私はAIにできない仕事をしたいですね。","start":257.324,"end":264.199,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"仕事","reading":"しごと","offset":9}]},{"id":"sentence-38","text":"うん。","start":264.199,"end":265.276,"readings":[]},{"id":"sentence-39","text":"多分AIがもっと発展したら人と人との繋がりがもっと必要になると思います。","start":265.276,"end":278.199,"readings":[{"word":"多分","reading":"たぶん","offset":0},{"word":"発展","reading":"はってん","offset":8},{"word":"人","reading":"ひと","offset":13},{"word":"人","reading":"ひと","offset":15},{"word":"繋がり","reading":"つながり","offset":18},{"word":"必要","reading":"ひつよう","offset":25},{"word":"思い","reading":"おもい","offset":31}]},{"id":"sentence-40","text":"だからみんなが繋がれるような仕事ができたらいいなって思います。","start":278.199,"end":290.12,"readings":[{"word":"繋が","reading":"つなが","offset":7},{"word":"仕事","reading":"しごと","offset":14},{"word":"思い","reading":"おもい","offset":26}]},{"id":"sentence-41","text":"あと旅行。","start":290.12,"end":292.203,"readings":[{"word":"旅行","reading":"りょこう","offset":2}]},{"id":"sentence-42","text":"旅行はもっと価値が出てくると思います。","start":292.203,"end":300.12,"readings":[{"word":"旅行","reading":"りょこう","offset":0},{"word":"価値","reading":"かち","offset":6},{"word":"出","reading":"で","offset":9},{"word":"思い","reading":"おもい","offset":14}]},{"id":"sentence-43","text":"色々な国に行ってその国の雰囲気を感じて知らない人と出会う経験はAIではできないと思います。","start":300.12,"end":318.199,"readings":[{"word":"色々","reading":"いろいろ","offset":0},{"word":"国","reading":"くに","offset":3},{"word":"行っ","reading":"いっ","offset":5},{"word":"国","reading":"くに","offset":10},{"word":"雰囲気","reading":"ふんいき","offset":12},{"word":"感じ","reading":"かんじ","offset":16},{"word":"知ら","reading":"しら","offset":19},{"word":"人","reading":"ひと","offset":23},{"word":"出会う","reading":"であう","offset":25},{"word":"経験","reading":"けいけん","offset":28},{"word":"思い","reading":"おもい","offset":40}]},{"id":"sentence-44","text":"だからAIがもっとすごくなったら多分みんな本当に大切なものに気づくことができると思います。","start":318.199,"end":334,"readings":[{"word":"多分","reading":"たぶん","offset":16},{"word":"本当に","reading":"ほんとうに","offset":21},{"word":"大切","reading":"たいせつ","offset":24},{"word":"気づく","reading":"きづく","offset":30},{"word":"思い","reading":"おもい","offset":40}]},{"id":"sentence-45","text":"だから私は半分AIがAIの将来が楽しみです。","start":334.4,"end":342.56,"readings":[{"word":"私","reading":"わたし","offset":3},{"word":"半分","reading":"はんぶん","offset":5},{"word":"将来","reading":"しょうらい","offset":13},{"word":"楽しみ","reading":"たのしみ","offset":16}]},{"id":"sentence-46","text":"Aは本当に人間より100倍、1000倍のスピードで仕事をすることができますよね。","start":343.44,"end":355.759,"readings":[{"word":"本当に","reading":"ほんとうに","offset":2},{"word":"人間","reading":"にんげん","offset":5},{"word":"倍","reading":"ばい","offset":12},{"word":"倍","reading":"ばい","offset":18},{"word":"仕事","reading":"しごと","offset":25}]},{"id":"sentence-47","text":"あと100倍、1000倍のスピードで発展しています。","start":355.759,"end":364.28,"readings":[{"word":"倍","reading":"ばい","offset":5},{"word":"倍","reading":"ばい","offset":11},{"word":"発展","reading":"はってん","offset":18}]},{"id":"sentence-48","text":"だから本当に今を生きなければいけないと思いました。","start":364.28,"end":373.479,"readings":[{"word":"本当に","reading":"ほんとうに","offset":3},{"word":"今","reading":"いま","offset":6},{"word":"生き","reading":"いき","offset":8},{"word":"思い","reading":"おもい","offset":19}]},{"id":"sentence-49","text":"本当にやりたいことをやっていたらAIに仕事を取られてもみんな大丈夫だと思いますよ。","start":373.8,"end":387.28,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"仕事","reading":"しごと","offset":19},{"word":"取ら","reading":"とら","offset":22},{"word":"大丈夫","reading":"だいじょうぶ","offset":30},{"word":"思い","reading":"おもい","offset":35}]},{"id":"sentence-50","text":"まあうん。","start":387.52,"end":389.117,"readings":[]},{"id":"sentence-51","text":"今の仕事に生きがいを感じている人もたくさんいますからね。","start":389.117,"end":398.06,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"仕事","reading":"しごと","offset":2},{"word":"生きがい","reading":"いきがい","offset":5},{"word":"感じ","reading":"かんじ","offset":10},{"word":"人","reading":"ひと","offset":15}]},{"id":"sentence-52","text":"うん。","start":398.06,"end":399.018,"readings":[]},{"id":"sentence-53","text":"ま、だから色々な生きがいを見つけるのは大切だと思いました。","start":399.018,"end":408.28,"readings":[{"word":"色々","reading":"いろいろ","offset":5},{"word":"生きがい","reading":"いきがい","offset":8},{"word":"見つける","reading":"みつける","offset":13},{"word":"大切","reading":"たいせつ","offset":19},{"word":"思い","reading":"おもい","offset":23}]},{"id":"sentence-54","text":"分かりませんよ。","start":408.4,"end":410.573,"readings":[{"word":"分かり","reading":"わかり","offset":0}]},{"id":"sentence-55","text":"うん。","start":410.573,"end":411.387,"readings":[]},{"id":"sentence-56","text":"将来は本当にバカなことが生きがいになるかもしれません。","start":411.387,"end":418.72,"readings":[{"word":"将来","reading":"しょうらい","offset":0},{"word":"本当に","reading":"ほんとうに","offset":3},{"word":"生きがい","reading":"いきがい","offset":12}]},{"id":"sentence-57","text":"うん。","start":418.72,"end":419.858,"readings":[]},{"id":"sentence-58","text":"今は全然大切じゃないことが大切になるかもしれません。","start":419.858,"end":429.72,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"全然","reading":"ぜんぜん","offset":2},{"word":"大切","reading":"たいせつ","offset":4},{"word":"大切","reading":"たいせつ","offset":13}]},{"id":"sentence-59","text":"将来は誰にも分かりません。","start":429.72,"end":435.56,"readings":[{"word":"将来","reading":"しょうらい","offset":0},{"word":"誰","reading":"だれ","offset":3},{"word":"分かり","reading":"わかり","offset":6}]},{"id":"sentence-60","text":"だから皆さん今を行きましょう。","start":435.56,"end":443.599,"readings":[{"word":"皆さん","reading":"みなさん","offset":3},{"word":"今","reading":"いま","offset":6},{"word":"行き","reading":"いき","offset":8}]},{"id":"sentence-61","text":"成長するtogrow上がるtogoup動画videos不安発展するto繋がりコネクction価値valu雰囲気出会うtomeetforthe人間","start":448.96,"end":501.72,"readings":[{"word":"成長","reading":"せいちょう","offset":0},{"word":"上がる","reading":"あがる","offset":10},{"word":"動画","reading":"どうが","offset":19},{"word":"不安","reading":"ふあん","offset":27},{"word":"発展","reading":"はってん","offset":29},{"word":"繋がり","reading":"つながり","offset":35},{"word":"価値","reading":"かち","offset":46},{"word":"雰囲気","reading":"ふんいき","offset":52},{"word":"出会う","reading":"であう","offset":55},{"word":"人間","reading":"にんげん","offset":70}]},{"id":"sentence-62","text":"今を生きる生きがいpurposeoflifeバカstupidorデッはいえ今今日はAIについて少し話してみました。","start":509.28,"end":535.72,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"生きる","reading":"いきる","offset":2},{"word":"生きがい","reading":"いきがい","offset":5},{"word":"今","reading":"こん","offset":37},{"word":"今日","reading":"きょう","offset":38},{"word":"少し","reading":"すこし","offset":47},{"word":"話し","reading":"はなし","offset":49}]},{"id":"sentence-63","text":"どうでしたか?","start":535.72,"end":539.32,"readings":[]},{"id":"sentence-64","text":"AIの発展について考えると少し怖くなりますよね。","start":539.44,"end":548.36,"readings":[{"word":"発展","reading":"はってん","offset":3},{"word":"考える","reading":"かんがえる","offset":9},{"word":"少し","reading":"すこし","offset":13},{"word":"怖く","reading":"こわく","offset":15}]},{"id":"sentence-65","text":"うん。","start":548.36,"end":550.36,"readings":[]},{"id":"sentence-66","text":"でもポジティブに考えることもできると思います。","start":550.36,"end":557.68,"readings":[{"word":"考える","reading":"かんがえる","offset":8},{"word":"思い","reading":"おもい","offset":18}]},{"id":"sentence-67","text":"どうですか?","start":557.68,"end":560.519,"readings":[]},{"id":"sentence-68","text":"皆さんは将来AIはどうなると思いますかAIで私たちの生活はどう変わると思いますか?","start":5