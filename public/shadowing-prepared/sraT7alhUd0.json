72,"end":1293.853,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"絵","reading":"え","offset":5}]},{"id":"sentence-214","text":"まず文を聞いてください。","start":1293.853,"end":1297.159,"readings":[{"word":"文","reading":"ぶん","offset":2},{"word":"聞い","reading":"きい","offset":4}]},{"id":"sentence-215","text":"それからその返事を聞いて1から3の中から1番いいものを1つ選んでください。","start":1297.159,"end":1307,"readings":[{"word":"返事","reading":"へんじ","offset":6},{"word":"聞い","reading":"きい","offset":9},{"word":"中","reading":"なか","offset":17},{"word":"番","reading":"ばん","offset":21},{"word":"選ん","reading":"えらん","offset":29}]},{"id":"sentence-216","text":"1番今窓を開けてもいいですか?","start":1310.6,"end":1313.88,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"今","reading":"いま","offset":2},{"word":"窓","reading":"まど","offset":3},{"word":"開け","reading":"あけ","offset":5}]},{"id":"sentence-217","text":"はい、大丈夫ですよ。","start":1318.039,"end":1321,"readings":[{"word":"大丈夫","reading":"だいじょうぶ","offset":3}]},{"id":"sentence-218","text":"2はい、まだ早いですよ。","start":1321,"end":1325.08,"readings":[{"word":"早い","reading":"はやい","offset":6}]},{"id":"sentence-219","text":"3はい。","start":1325.32,"end":1327.146,"readings":[]},{"id":"sentence-220","text":"閉めましょうか?","start":1327.146,"end":1330.799,"readings":[{"word":"閉め","reading":"しめ","offset":0}]},{"id":"sentence-221","text":"2番会議はいつ始まりますか?","start":1349.76,"end":1355.96,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"会議","reading":"かいぎ","offset":2},{"word":"始まり","reading":"はじまり","offset":7}]},{"id":"sentence-222","text":"13時までです。","start":1355.96,"end":1359.559,"readings":[{"word":"時","reading":"じ","offset":2}]},{"id":"sentence-223","text":"23時からです。","start":1359.559,"end":1365,"readings":[{"word":"時","reading":"じ","offset":2}]},{"id":"sentence-224","text":"階の会議室です。","start":1365,"end":1369.159,"readings":[{"word":"階","reading":"かい","offset":0},{"word":"会議","reading":"かいぎ","offset":2},{"word":"室","reading":"しつ","offset":4}]},{"id":"sentence-225","text":"番。","start":1388.64,"end":1388.901,"readings":[{"word":"番","reading":"ばん","offset":0}]},{"id":"sentence-226","text":"ここは図書館ですから静かにしてくださいね。","start":1388.901,"end":1391.64,"readings":[{"word":"図書館","reading":"としょかん","offset":3},{"word":"静か","reading":"しずか","offset":10}]},{"id":"sentence-227","text":"1はい、静かですか?","start":1396.039,"end":1400.279,"readings":[{"word":"静か","reading":"しずか","offset":4}]},{"id":"sentence-228","text":"2すみません。","start":1400.32,"end":1402.582,"readings":[]},{"id":"sentence-229","text":"忘れました。","start":1402.582,"end":1404.52,"readings":[{"word":"忘れ","reading":"わすれ","offset":0}]},{"id":"sentence-230","text":"3すみません。","start":1405.2,"end":1407.32,"readings":[]},{"id":"sentence-231","text":"わかりました。","start":1407.32,"end":1409.44,"readings":[]},{"id":"sentence-232","text":"番田中さん、今晩映画を見に行きませんか?","start":1430.559,"end":1433.559,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"田中","reading":"たなか","offset":1},{"word":"今晩","reading":"こんばん","offset":6},{"word":"映画","reading":"えいが","offset":8},{"word":"見","reading":"み","offset":11},{"word":"行き","reading":"いき","offset":13}]},{"id":"sentence-233","text":"はい。","start":1439.08,"end":1439.83,"readings":[]},{"id":"sentence-234","text":"つも映画を見ます。","start":1439.83,"end":1442.08,"readings":[{"word":"映画","reading":"えいが","offset":2},{"word":"見","reading":"み","offset":5}]},{"id":"sentence-235","text":"2はい。","start":1443.159,"end":1444.564,"readings":[]},{"id":"sentence-236","text":"映画はいつも1人で見ますよ。","start":1444.564,"end":1449.48,"readings":[{"word":"映画","reading":"えいが","offset":0},{"word":"人","reading":"にん","offset":7},{"word":"見","reading":"み","offset":9}]},{"id":"sentence-237","text":"3すみません。","start":1449.48,"end":1452.5,"readings":[]},{"id":"sentence-238","text":"今日はちょっと","start":1452.5,"end":1455.52,"readings":[{"word":"今日","reading":"きょう","offset":0}]},{"id":"sentence-239","text":"5番コーヒーと紅茶どちらがいいですか1紅茶はいいです。","start":1474.919,"end":1486,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"紅茶","reading":"こうちゃ","offset":7},{"word":"紅茶","reading":"こうちゃ","offset":19}]},{"id":"sentence-240","text":"2紅茶よりいいです。","start":1486,"end":1492.159,"readings":[{"word":"紅茶","reading":"こうちゃ","offset":1}]},{"id":"sentence-241","text":"紅茶お願いします。","start":1492.159,"end":1496.52,"readings":[{"word":"紅茶","reading":"こうちゃ","offset":0},{"word":"お願い","reading":"おねがい","offset":2}]},{"id":"sentence-242","text":"6番。","start":1515.64,"end":1516.343,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-243","text":"この映画見たことある?","start":1516.343,"end":1518.919,"readings":[{"word":"映画","reading":"えいが","offset":2},{"word":"見","reading":"み","offset":4}]},{"id":"sentence-244","text":"うん。","start":1522.96,"end":1523.933,"readings":[]},{"id":"sentence-245","text":"今度見るよ。","start":1523.933,"end":1525.88,"readings":[{"word":"今度","reading":"こんど","offset":0},{"word":"見る","reading":"みる","offset":2}]},{"id":"sentence-246","text":"2うん。","start":1525.88,"end":1527.451,"readings":[]},{"id":"sentence-247","text":"友達と見たよ。","start":1527.451,"end":1530.2,"readings":[{"word":"友達","reading":"ともだち","offset":0},{"word":"見","reading":"み","offset":3}]},{"id":"sentence-248","text":"3うん。","start":1530.44,"end":1531.651,"readings":[]},{"id":"sentence-249","text":"あまり好きじゃない。","start":1531.651,"end":1534.679,"readings":[{"word":"好き","reading":"すき","offset":3}]},{"id":"sentence-250","text":"7番すみません。","start":1555.64,"end":1558.6,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-251","text":"この本はいつまでに返せばいいですか?","start":1558.6,"end":1561.6,"readings":[{"word":"本","reading":"ほん","offset":2},{"word":"返せ","reading":"かえせ","offset":9}]},{"id":"sentence-252","text":"来週の金曜日かもしれない。","start":1565.399,"end":1568.399,"readings":[{"word":"来週","reading":"らいしゅう","offset":0},{"word":"金曜日","reading":"きんようび","offset":3}]},{"id":"sentence-253","text":"2来週の金曜日までに返してください。","start":1569.32,"end":1573.679,"readings":[{"word":"来週","reading":"らいしゅう","offset":1},{"word":"金曜日","reading":"きんようび","offset":4},{"word":"返し","reading":"かえし","offset":10}]},{"id":"sentence-254","text":"3来週の金曜日からです。","start":1575.48,"end":1579.84,"readings":[{"word":"来週","reading":"らいしゅう","offset":1},{"word":"金曜日","reading":"きんようび","offset":4}]},{"id":"sentence-255","text":"8番。","start":1600.559,"end":1601.262,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-256","text":"あ、傘忘れていますよ。","start":1601.262,"end":1603.84,"readings":[{"word":"傘","reading":"かさ","offset":2},{"word":"忘れ","reading":"わすれ","offset":3}]},{"id":"sentence-257","text":"あ、そうですか。","start":1607.32,"end":1610.08,"readings":[]},{"id":"sentence-258","text":"2あ、助かります。","start":1610.08,"end":1613.039,"readings":[{"word":"助かり","reading":"たすかり","offset":3}]},{"id":"sentence-259","text":"どうも。","start":1613.039,"end":1615.653,"readings":[]},{"id":"sentence-260","text":"あ、大丈夫です。","start":1615.653,"end":1620.88,"readings":[{"word":"大丈夫","reading":"だいじょうぶ","offset":2}]}]}