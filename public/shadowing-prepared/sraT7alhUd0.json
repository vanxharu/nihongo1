{"videoId":"sraT7alhUd0","title":"Đề luyện nghe N4 · Bài 05","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"日本語能力試験長これからN4の会試験を始めます。","start":4.52,"end":13.893,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"能力","reading":"のうりょく","offset":3},{"word":"試験","reading":"しけん","offset":5},{"word":"長","reading":"ちょう","offset":7},{"word":"会","reading":"かい","offset":15},{"word":"試験","reading":"しけん","offset":16},{"word":"始め","reading":"はじめ","offset":19}]},{"id":"sentence-1","text":"問題用紙にメモを取っても構いません。","start":13.893,"end":20.923,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"用紙","reading":"ようし","offset":2},{"word":"取っ","reading":"とっ","offset":8},{"word":"構い","reading":"かまい","offset":12}]},{"id":"sentence-2","text":"問題用紙を開けてください。","start":20.923,"end":26,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"用紙","reading":"ようし","offset":2},{"word":"開け","reading":"あけ","offset":5}]},{"id":"sentence-3","text":"問題1。","start":28.84,"end":29.989,"readings":[{"word":"問題","reading":"もんだい","offset":0}]},{"id":"sentence-4","text":"問題1ではまず質問を聞いてください。","start":29.989,"end":35.159,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"質問","reading":"しつもん","offset":7},{"word":"聞い","reading":"きい","offset":10}]},{"id":"sentence-5","text":"それから話を聞いて問題用紙の1から4の中から1番いいものを1つ選んでください。","start":35.159,"end":46.36,"readings":[{"word":"話","reading":"はなし","offset":4},{"word":"聞い","reading":"きい","offset":6},{"word":"問題","reading":"もんだい","offset":9},{"word":"用紙","reading":"ようし","offset":11},{"word":"中","reading":"なか","offset":19},{"word":"番","reading":"ばん","offset":23},{"word":"選ん","reading":"えらん","offset":31}]},{"id":"sentence-6","text":"1番学校で女の学生と男の学生が話しています。","start":48.719,"end":55.038,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"学校","reading":"がっこう","offset":2},{"word":"女","reading":"おんな","offset":5},{"word":"学生","reading":"がくせい","offset":7},{"word":"男","reading":"おとこ","offset":10},{"word":"学生","reading":"がくせい","offset":12},{"word":"話し","reading":"はなし","offset":15}]},{"id":"sentence-7","text":"男の学生はこの後すぐ何をしますか?","start":55.038,"end":59.92,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"学生","reading":"がくせい","offset":2},{"word":"後","reading":"のち","offset":7},{"word":"何","reading":"なに","offset":10}]},{"id":"sentence-8","text":"島村さん、パーティーは6時からだけど、まだ教室にいるの?","start":63.84,"end":69.28,"readings":[{"word":"島村","reading":"しまむら","offset":0},{"word":"時","reading":"じ","offset":12},{"word":"教室","reading":"きょうしつ","offset":21}]},{"id":"sentence-9","text":"うん。","start":69.759,"end":69.95,"readings":[]},{"id":"sentence-10","text":"レポートがまだ少し終わってないんだ。","start":69.95,"end":71.099,"readings":[{"word":"少し","reading":"すこし","offset":7},{"word":"終わっ","reading":"おわっ","offset":9}]},{"id":"sentence-11","text":"悪いけど僕は後で行くってみんなに伝えておいてくれる?","start":71.099,"end":72.759,"readings":[{"word":"悪い","reading":"わるい","offset":0},{"word":"僕","reading":"ぼく","offset":4},{"word":"後で","reading":"あとで","offset":6},{"word":"行く","reading":"いく","offset":8},{"word":"伝え","reading":"つたえ","offset":16}]},{"id":"sentence-12","text":"分かった。","start":78.479,"end":79.494,"readings":[{"word":"分かっ","reading":"わかっ","offset":0}]},{"id":"sentence-13","text":"場所を覚えてる?","start":79.494,"end":81.119,"readings":[{"word":"場所","reading":"ばしょ","offset":0},{"word":"覚え","reading":"おぼえ","offset":3}]},{"id":"sentence-14","text":"うん。","start":81.119,"end":81.376,"readings":[]},{"id":"sentence-15","text":"前にみんなで行ったレストランだよね。","start":81.376,"end":82.919,"readings":[{"word":"前","reading":"まえ","offset":0},{"word":"行っ","reading":"おこなっ","offset":6}]},{"id":"sentence-16","text":"これが終わったらすぐ行くよ。","start":82.919,"end":84.119,"readings":[{"word":"終わっ","reading":"おわっ","offset":3},{"word":"行く","reading":"いく","offset":10}]},{"id":"sentence-17","text":"じゃあ飲み物を先に頼んでおくね。","start":86.439,"end":89.4,"readings":[{"word":"飲み物","reading":"のみもの","offset":3},{"word":"先","reading":"さき","offset":7},{"word":"頼ん","reading":"たのん","offset":9}]},{"id":"sentence-18","text":"ありがとう。","start":89.4,"end":91.036,"readings":[]},{"id":"sentence-19","text":"助かるよ。","start":91.036,"end":92.4,"readings":[{"word":"助かる","reading":"たすかる","offset":0}]},{"id":"sentence-20","text":"男の学生はこの後すぐ何をしますか?","start":96.799,"end":103.72,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"学生","reading":"がくせい","offset":2},{"word":"後","reading":"のち","offset":7},{"word":"何","reading":"なに","offset":10}]},{"id":"sentence-21","text":"2番女の人と男の人が話しています。","start":123.799,"end":127.039,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"女","reading":"おんな","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"男","reading":"おとこ","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-22","text":"2人はお父さんの誕生日に何をしますか?","start":129.64,"end":132.8,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"お父さん","reading":"おとうさん","offset":3},{"word":"誕生","reading":"たんじょう","offset":8},{"word":"日","reading":"び","offset":10},{"word":"何","reading":"なに","offset":12}]},{"id":"sentence-23","text":"お父さんの誕生日来週だけどどうしようか。","start":137.16,"end":140.16,"readings":[{"word":"お父さん","reading":"おとうさん","offset":0},{"word":"誕生","reading":"たんじょう","offset":5},{"word":"日","reading":"び","offset":7},{"word":"来週","reading":"らいしゅう","offset":8}]},{"id":"sentence-24","text":"去年みたいに家でケーキを食べるだけでいいんじゃない?","start":142.12,"end":145.12,"readings":[{"word":"去年","reading":"きょねん","offset":0},{"word":"家","reading":"いえ","offset":6},{"word":"食べる","reading":"たべる","offset":12}]},{"id":"sentence-25","text":"え、今年は歳の誕生日だからもっと特別にしたいな。","start":146.56,"end":151.959,"readings":[{"word":"今年","reading":"ことし","offset":2},{"word":"歳","reading":"とし","offset":5},{"word":"誕生","reading":"たんじょう","offset":7},{"word":"日","reading":"び","offset":9},{"word":"特別","reading":"とくべつ","offset":16}]},{"id":"sentence-26","text":"じゃあ旅行にでも行く?","start":153.28,"end":156.2,"readings":[{"word":"旅行","reading":"りょこう","offset":3},{"word":"行く","reading":"いく","offset":8}]},{"id":"sentence-27","text":"旅行は時間がかかりすぎるよ。","start":156.2,"end":157.435,"readings":[{"word":"旅行","reading":"りょこう","offset":0},{"word":"時間","reading":"じかん","offset":3}]},{"id":"sentence-28","text":"近くの温泉旅館で食事会っていうのはどう?","start":157.435,"end":159.2,"readings":[{"word":"近く","reading":"ちかく","offset":0},{"word":"温泉","reading":"おんせん","offset":3},{"word":"旅館","reading":"りょかん","offset":5},{"word":"食事","reading":"しょくじ","offset":8},{"word":"会","reading":"かい","offset":10}]},{"id":"sentence-29","text":"いいね。","start":163.2,"end":164,"readings":[]},{"id":"sentence-30","text":"お父さん温泉好きだし。","start":164,"end":166.2,"readings":[{"word":"お父さん","reading":"おとうさん","offset":0},{"word":"温泉","reading":"おんせん","offset":4},{"word":"好き","reading":"すき","offset":6}]},{"id":"sentence-31","text":"あ、でも駅前の新しいレストラン人気みたいだよ。","start":166.599,"end":169.599,"readings":[{"word":"駅前","reading":"えきまえ","offset":4},{"word":"新しい","reading":"あたらしい","offset":7},{"word":"人気","reading":"にんき","offset":15}]},{"id":"sentence-32","text":"うーん。","start":172.04,"end":172.373,"readings":[]},{"id":"sentence-33","text":"でもお父さんはゆっくりしたいだろうから温泉旅館の方がいいと思う。","start":172.373,"end":175.04,"readings":[{"word":"お父さん","reading":"おとうさん","offset":2},{"word":"温泉","reading":"おんせん","offset":19},{"word":"旅館","reading":"りょかん","offset":21},{"word":"方","reading":"ほう","offset":24},{"word":"思う","reading":"おもう","offset":29}]},{"id":"sentence-34","text":"そうだね。","start":179.4,"end":180.282,"readings":[]},{"id":"sentence-35","text":"じゃあそこに予約しよう。","start":180.282,"end":182.4,"readings":[{"word":"予約","reading":"よやく","offset":6}]},{"id":"sentence-36","text":"うん。","start":182.64,"end":183.458,"readings":[]},{"id":"sentence-37","text":"僕が電話するよ。","start":183.458,"end":185.64,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"電話","reading":"でんわ","offset":2}]},{"id":"sentence-38","text":"2人はお父さんの誕生日に何をしますか?","start":190.44,"end":197.64,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"お父さん","reading":"おとうさん","offset":3},{"word":"誕生","reading":"たんじょう","offset":8},{"word":"日","reading":"び","offset":10},{"word":"何","reading":"なに","offset":12}]},{"id":"sentence-39","text":"番女の人と男の人が話しています。","start":218.04,"end":218.814,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"女","reading":"おんな","offset":1},{"word":"人","reading":"ひと","offset":3},{"word":"男","reading":"おとこ","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"話し","reading":"はなし","offset":9}]},{"id":"sentence-40","text":"女の人は面接にどんな格好で行きますか?","start":218.814,"end":219.734,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"面接","reading":"めんせつ","offset":4},{"word":"格好","reading":"かっこう","offset":10},{"word":"行き","reading":"いき","offset":13}]},{"id":"sentence-41","text":"明日の面接のスーツとこのワンピースどっちがいいと思う?","start":219.734,"end":221.04,"readings":[{"word":"明日","reading":"あした","offset":0},{"word":"面接","reading":"めんせつ","offset":3},{"word":"思う","reading":"おもう","offset":24}]},{"id":"sentence-42","text":"うーん。","start":238.159,"end":238.659,"readings":[]},{"id":"sentence-43","text":"スーツの方がきちんとして見えると思うよ。","start":238.659,"end":241.159,"readings":[{"word":"方","reading":"ほう","offset":4},{"word":"見える","reading":"みえる","offset":12},{"word":"思う","reading":"おもう","offset":16}]},{"id":"sentence-44","text":"そうかな。","start":242.879,"end":244.12,"readings":[]},{"id":"sentence-45","text":"でも面接だから少し柔らかい印象の方がいいんじゃない?","start":244.12,"end":247.12,"readings":[{"word":"面接","reading":"めんせつ","offset":2},{"word":"少し","reading":"すこし","offset":7},{"word":"柔らかい","reading":"やわらかい","offset":9},{"word":"印象","reading":"いんしょう","offset":13},{"word":"方","reading":"ほう","offset":16}]},{"id":"sentence-46","text":"そんなことないと思うけど。","start":250.319,"end":252.36,"readings":[{"word":"思う","reading":"おもう","offset":8}]},{"id":"sentence-47","text":"あ、そう分かった。","start":252.36,"end":253.398,"readings":[{"word":"分かっ","reading":"わかっ","offset":4}]},{"id":"sentence-48","text":"それからこのカを持っていこうかな。","start":253.398,"end":255.36,"readings":[{"word":"持っ","reading":"もっ","offset":8}]},{"id":"sentence-49","text":"ああ、いいんじゃない?","start":257.919,"end":260.27,"readings":[]},{"id":"sentence-50","text":"そのカについている花綺麗だね、これ。","start":260.27,"end":264.117,"readings":[{"word":"花","reading":"はな","offset":9},{"word":"綺麗","reading":"きれい","offset":10}]},{"id":"sentence-51","text":"うん。","start":264.117,"end":264.758,"readings":[]},{"id":"sentence-52","text":"ありがとう。","start":264.758,"end":266.04,"readings":[]},{"id":"sentence-53","text":"女の人は面接にどんな格好で行きますか?","start":271.28,"end":278.479,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"面接","reading":"めんせつ","offset":4},{"word":"格好","reading":"かっこう","offset":10},{"word":"行き","reading":"いき","offset":13}]},{"id":"sentence-54","text":"番家で女の人と男の人が話しています。","start":298.639,"end":299.379,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"家","reading":"か","offset":1},{"word":"女","reading":"おんな","offset":3},{"word":"人","reading":"ひと","offset":5},{"word":"男","reading":"おとこ","offset":7},{"word":"人","reading":"ひと","offset":9},{"word":"話し","reading":"はなし","offset":11}]},{"id":"sentence-55","text":"男の人はこの後すぐ何をしますか?","start":299.379,"end":300.036,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"後","reading":"のち","offset":6},{"word":"何","reading":"なに","offset":9}]},{"id":"sentence-56","text":"大変。","start":300.036,"end":300.16,"readings":[{"word":"大変","reading":"たいへん","offset":0}]},{"id":"sentence-57","text":"もうこんな時間。","start":300.16,"end":300.488,"readings":[{"word":"時間","reading":"じかん","offset":5}]},{"id":"sentence-58","text":"もうすぐみんなが来るのにテーブルの準備がまだできてない。","start":300.488,"end":301.639,"readings":[{"word":"来る","reading":"くる","offset":8},{"word":"準備","reading":"じゅんび","offset":17}]},{"id":"sentence-59","text":"それは僕がするよ。","start":319,"end":320.88,"readings":[{"word":"僕","reading":"ぼく","offset":3}]},{"id":"sentence-60","text":"助かる。","start":320.88,"end":321.737,"readings":[{"word":"助かる","reading":"たすかる","offset":0}]},{"id":"sentence-61","text":"私は料理を続けるね。","start":321.737,"end":323.88,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"料理","reading":"りょうり","offset":2},{"word":"続ける","reading":"つづける","offset":5}]},{"id":"sentence-62","text":"あ、お砂糖がもう少しかない。","start":324.199,"end":327.16,"readings":[{"word":"砂糖","reading":"さとう","offset":3},{"word":"もう少し","reading":"もうすこし","offset":6}]},{"id":"sentence-63","text":"じゃあ先にスーパーに行って買ってくるよ。","start":327.16,"end":328.782,"readings":[{"word":"先","reading":"さき","offset":3},{"word":"行っ","reading":"いっ","offset":10},{"word":"買っ","reading":"かっ","offset":13}]},{"id":"sentence-64","text":"テーブルの準備は戻ってからするね。","start":328.782,"end":330.16,"readings":[{"word":"準備","reading":"じゅんび","offset":5},{"word":"戻っ","reading":"もどっ","offset":8}]},{"id":"sentence-65","text":"分かった。","start":332.6,"end":333.282,"readings":[{"word":"分かっ","reading":"わかっ","offset":0}]},{"id":"sentence-66","text":"じゃあテーブルは私がやっておくよ。","start":333.282,"end":335.6,"readings":[{"word":"私","reading":"わたし","offset":8}]},{"id":"sentence-67","text":"ありがとう。","start":336.039,"end":336.553,"readings":[]},{"id":"sentence-68","text":"ああ、そうだ。","start":336.553,"end":337.153,"readings":[]},{"id":"sentence-69","text":"玄関の掃除もまだだからそれは戻ったらやるよ。","start":337.153,"end":339.039,"readings":[{"word":"玄関","reading":"げんかん","offset":0},{"word":"掃除","reading":"そうじ","offset":3},{"word":"戻っ","reading":"もどっ","offset":14}]},{"id":"sentence-70","text":"うん。","start":341.84,"end":342.13,"readings":[]},{"id":"sentence-71","text":"お願いね。","start":342.13,"end":342.614,"readings":[{"word":"お願い","reading":"おねがい","offset":0}]},{"id":"sentence-72","text":"あ、飲み物も買ってきて冷蔵庫に入れておいてね。","start":342.614,"end":344.84,"readings":[{"word":"飲み物","reading":"のみもの","offset":2},{"word":"買っ","reading":"かっ","offset":6},{"word":"冷蔵庫","reading":"れいぞうこ","offset":11},{"word":"入れ","reading":"いれ","offset":15}]},{"id":"sentence-73","text":"男の人はこの後すぐ何をしますか?","start":352.639,"end":359.24,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"後","reading":"のち","offset":6},{"word":"何","reading":"なに","offset":9}]},{"id":"sentence-74","text":"番会社で男の人と女の人が話しています。","start":379.24,"end":381.021,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"会社","reading":"かいしゃ","offset":1},{"word":"男","reading":"おとこ","offset":4},{"word":"人","reading":"ひと","offset":6},{"word":"女","reading":"おんな","offset":8},{"word":"人","reading":"ひと","offset":10},{"word":"話し","reading":"はなし","offset":12}]},{"id":"sentence-75","text":"女の人は午後何をしますか?","start":381.021,"end":382.24,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"午後","reading":"ごご","offset":4},{"word":"何","reading":"なに","offset":6}]},{"id":"sentence-76","text":"佐藤さん、なんだか元気なさそうですね。","start":391.72,"end":393.912,"readings":[{"word":"佐藤","reading":"さとう","offset":0},{"word":"元気","reading":"げんき","offset":9}]},{"id":"sentence-77","text":"大丈夫ですか?","start":393.912,"end":394.72,"readings":[{"word":"大丈夫","reading":"だいじょうぶ","offset":0}]},{"id":"sentence-78","text":"昨日子供が熱を出して病院に連れて行ったのであまり眠れなかったんです。","start":397,"end":400,"readings":[{"word":"昨日","reading":"きのう","offset":0},{"word":"子供","reading":"こども","offset":2},{"word":"熱","reading":"ねつ","offset":5},{"word":"出し","reading":"だし","offset":7},{"word":"病院","reading":"びょういん","offset":10},{"word":"連れ","reading":"つれ","offset":13},{"word":"行っ","reading":"いっ","offset":16},{"word":"眠れ","reading":"ねむれ","offset":24}]},{"id":"sentence-79","text":"それは心配でしたね。","start":404.12,"end":406.24,"readings":[{"word":"心配","reading":"しんぱい","offset":3}]},{"id":"sentence-80","text":"午後は早く帰って家で休みますか?","start":406.24,"end":409.24,"readings":[{"word":"午後","reading":"ごご","offset":0},{"word":"早く","reading":"はやく","offset":3},{"word":"帰っ","reading":"かえっ","offset":5},{"word":"家","reading":"いえ","offset":8},{"word":"休み","reading":"やすみ","offset":10}]},{"id":"sentence-81","text":"いえ、大丈夫です。","start":409.84,"end":410.499,"readings":[{"word":"大丈夫","reading":"だいじょうぶ","offset":3}]},{"id":"sentence-82","text":"午後の会議に参加します。","start":410.499,"end":411.377,"readings":[{"word":"午後","reading":"ごご","offset":0},{"word":"会議","reading":"かいぎ","offset":3},{"word":"参加","reading":"さんか","offset":6}]},{"id":"sentence-83","text":"今中に決めないといけないことがあるので。","start":411.377,"end":412.84,"readings":[{"word":"今中","reading":"いまなか","offset":0},{"word":"決め","reading":"きめ","offset":3}]},{"id":"sentence-84","text":"そうですか。","start":417.28,"end":418.137,"readings":[]},{"id":"sentence-85","text":"でも無理はしないでくださいね。","start":418.137,"end":420.28,"readings":[{"word":"無理","reading":"むり","offset":2}]},{"id":"sentence-86","text":"ありがとうございます。","start":420.879,"end":423.879,"readings":[]},{"id":"sentence-87","text":"女の人は午後何をしますかH","start":426.84,"end":432.96,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"午後","reading":"ごご","offset":4},{"word":"何","reading":"なに","offset":6}]},{"id":"sentence-88","text":"会社で男の人と女の人が話しています。","start":454.919,"end":459.879,"readings":[{"word":"会社","reading":"かいしゃ","offset":0},{"word":"男","reading":"おとこ","offset":3},{"word":"人","reading":"ひと","offset":5},{"word":"女","reading":"おんな","offset":7},{"word":"人","reading":"ひと","offset":9},{"word":"話し","reading":"はなし","offset":11}]},{"id":"sentence-89","text":"女の人はこれから何をしますか?","start":459.879,"end":462.879,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"何","reading":"なに","offset":8}]},{"id":"sentence-90","text":"田中さん、今少し時間ある?","start":464.96,"end":466.142,"readings":[{"word":"田中","reading":"たなか","offset":0},{"word":"今","reading":"いま","offset":5},{"word":"少し","reading":"すこし","offset":6},{"word":"時間","reading":"じかん","offset":8}]},{"id":"sentence-91","text":"イベントの準備を手伝って欲しいんだけど。","start":466.142,"end":467.96,"readings":[{"word":"準備","reading":"じゅんび","offset":5},{"word":"手伝っ","reading":"てつだっ","offset":8},{"word":"欲しい","reading":"ほしい","offset":12}]},{"id":"sentence-92","text":"はい、大丈夫です。","start":471.599,"end":472.949,"readings":[{"word":"大丈夫","reading":"だいじょうぶ","offset":3}]},{"id":"sentence-93","text":"何をしたらいいですか?","start":472.949,"end":474.599,"readings":[{"word":"何","reading":"なに","offset":0}]},{"id":"sentence-94","text":"この名札を20枚作ってもらえる?","start":475.52,"end":478.8,"readings":[{"word":"名札","reading":"なふだ","offset":2},{"word":"枚","reading":"まい","offset":7},{"word":"作っ","reading":"つくっ","offset":8}]},{"id":"sentence-95","text":"わかりました。","start":478.8,"end":479.96,"readings":[]},{"id":"sentence-96","text":"あ、ちょっと待って。","start":479.96,"end":481.324,"readings":[{"word":"待っ","reading":"まっ","offset":6}]},{"id":"sentence-97","text":"先に椅子を並べましょう。","start":481.324,"end":482.96,"readings":[{"word":"先","reading":"さき","offset":0},{"word":"椅子","reading":"いす","offset":2},{"word":"並べ","reading":"ならべ","offset":5}]},{"id":"sentence-98","text":"今その部屋掃除中のようですが。","start":484.039,"end":487.039,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"部屋","reading":"へや","offset":3},{"word":"掃除","reading":"そうじ","offset":5},{"word":"中","reading":"ちゅう","offset":7}]},{"id":"sentence-99","text":"そうか。","start":487.319,"end":488.199,"readings":[]},{"id":"sentence-100","text":"じゃあ掃除が終わったら急いでやりましょう。","start":488.199,"end":491.199,"readings":[{"word":"掃除","reading":"そうじ","offset":3},{"word":"終わっ","reading":"おわっ","offset":6},{"word":"急い","reading":"いそい","offset":11}]},{"id":"sentence-101","text":"はい。","start":491.8,"end":492.384,"readings":[]},{"id":"sentence-102","text":"お菓子の準備もしますか?","start":492.384,"end":494.72,"readings":[{"word":"お菓子","reading":"おかし","offset":0},{"word":"準備","reading":"じゅんび","offset":4}]},{"id":"sentence-103","text":"お菓子は田中さんが準備するから大丈夫だよ。","start":494.72,"end":497.72,"readings":[{"word":"お菓子","reading":"おかし","offset":0},{"word":"田中","reading":"たなか","offset":4},{"word":"準備","reading":"じゅんび","offset":9},{"word":"大丈夫","reading":"だいじょうぶ","offset":15}]},{"id":"sentence-104","text":"はい、わかりました。","start":498.599,"end":501.599,"readings":[]},{"id":"sentence-105","text":"女の人はこれから何をしますか?","start":