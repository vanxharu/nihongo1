":857.04,"readings":[]},{"id":"sentence-150","text":"急だね。","start":857.04,"end":859.12,"readings":[{"word":"急","reading":"きゅう","offset":0}]},{"id":"sentence-151","text":"多いのかな?","start":859.12,"end":860.639,"readings":[{"word":"多い","reading":"おおい","offset":0}]},{"id":"sentence-152","text":"そんなに多くないらしいけど、人だと大変だから荷物の片付けは木曜日までかかりそうらしいよ。","start":860.639,"end":865.88,"readings":[{"word":"多く","reading":"おおく","offset":4},{"word":"人","reading":"ひと","offset":14},{"word":"大変","reading":"たいへん","offset":17},{"word":"荷物","reading":"にもつ","offset":22},{"word":"片付け","reading":"かたづけ","offset":25},{"word":"木曜日","reading":"もくようび","offset":29}]},{"id":"sentence-153","text":"じゃあ手伝いに行こうよ。","start":868.639,"end":870.079,"readings":[{"word":"手伝い","reading":"てつだい","offset":3},{"word":"行こ","reading":"いこ","offset":7}]},{"id":"sentence-154","text":"月曜日の午後は時間がある?","start":870.079,"end":871.639,"readings":[{"word":"月曜日","reading":"げつようび","offset":0},{"word":"午後","reading":"ごご","offset":4},{"word":"時間","reading":"じかん","offset":7}]},{"id":"sentence-155","text":"ごめん。","start":873.56,"end":873.935,"readings":[]},{"id":"sentence-156","text":"月曜は会議があるんだ。","start":873.935,"end":874.966,"readings":[{"word":"月曜","reading":"げつよう","offset":0},{"word":"会議","reading":"かいぎ","offset":3}]},{"id":"sentence-157","text":"火曜と水曜の午後なら大丈夫だけど。","start":874.966,"end":876.56,"readings":[{"word":"火曜","reading":"かよう","offset":0},{"word":"水曜","reading":"すいよう","offset":3},{"word":"午後","reading":"ごご","offset":6},{"word":"大丈夫","reading":"だいじょうぶ","offset":10}]},{"id":"sentence-158","text":"火曜日は3日か。","start":879.72,"end":880.989,"readings":[{"word":"火曜日","reading":"かようび","offset":0},{"word":"日","reading":"にち","offset":5}]},{"id":"sentence-159","text":"その日は歯医者の予約があるから無理だな。","start":880.989,"end":884.16,"readings":[{"word":"日","reading":"ひ","offset":2},{"word":"歯医者","reading":"はいしゃ","offset":4},{"word":"予約","reading":"よやく","offset":8},{"word":"無理","reading":"むり","offset":15}]},{"id":"sentence-160","text":"じゃあ4日だったらいい。","start":885.88,"end":887.92,"readings":[{"word":"日","reading":"にち","offset":4}]},{"id":"sentence-161","text":"うん。","start":887.92,"end":888.893,"readings":[]},{"id":"sentence-162","text":"早い方が田中さんも助かるよね。","start":888.893,"end":893.759,"readings":[{"word":"早い","reading":"はやい","offset":0},{"word":"方","reading":"ほう","offset":2},{"word":"田中","reading":"たなか","offset":4},{"word":"助かる","reading":"たすかる","offset":9}]},{"id":"sentence-163","text":"2人はいつ田中さんの引っ越しを手伝いに行きますか?","start":896.36,"end":904.88,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"田中","reading":"たなか","offset":5},{"word":"引っ越し","reading":"ひっこし","offset":10},{"word":"手伝い","reading":"てつだい","offset":15},{"word":"行き","reading":"いき","offset":19}]},{"id":"sentence-164","text":"男のトレーナーと女の人が話しています。","start":926.24,"end":931.88,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"女","reading":"おんな","offset":8},{"word":"人","reading":"ひと","offset":10},{"word":"話し","reading":"はなし","offset":12}]},{"id":"sentence-165","text":"トレーナーはどうして痩せないと言っていますか?","start":931.88,"end":939.24,"readings":[{"word":"痩せ","reading":"やせ","offset":10},{"word":"言っ","reading":"いっ","offset":15}]},{"id":"sentence-166","text":"すみません。","start":950.88,"end":952.399,"readings":[]},{"id":"sentence-167","text":"先月から運動しているのに全然痩せないんです。","start":952.399,"end":955.399,"readings":[{"word":"先月","reading":"せんげつ","offset":0},{"word":"運動","reading":"うんどう","offset":4},{"word":"全然","reading":"ぜんぜん","offset":12},{"word":"痩せ","reading":"やせ","offset":14}]},{"id":"sentence-168","text":"先月教えたトレーニングはやっていますか?","start":956.8,"end":959.8,"readings":[{"word":"先月","reading":"せんげつ","offset":0},{"word":"教え","reading":"おしえ","offset":2}]},{"id":"sentence-169","text":"はい。","start":960.199,"end":960.413,"readings":[]},{"id":"sentence-170","text":"やると少し体が軽くなるんですが、すぐにまた疲れて甘いものが食べたくなるんです。","start":960.413,"end":963.199,"readings":[{"word":"少し","reading":"すこし","offset":3},{"word":"体","reading":"からだ","offset":5},{"word":"軽く","reading":"かるく","offset":7},{"word":"疲れ","reading":"つかれ","offset":21},{"word":"甘い","reading":"あまい","offset":24},{"word":"食べ","reading":"たべ","offset":29}]},{"id":"sentence-171","text":"お仕事は忙しいですか?","start":968.079,"end":970.519,"readings":[{"word":"仕事","reading":"しごと","offset":1},{"word":"忙しい","reading":"いそがしい","offset":4}]},{"id":"sentence-172","text":"そうですね。","start":970.519,"end":971.795,"readings":[]},{"id":"sentence-173","text":"毎晩帰るのは9時過ぎです。","start":971.795,"end":974.56,"readings":[{"word":"毎晩","reading":"まいばん","offset":0},{"word":"帰る","reading":"かえる","offset":2},{"word":"時","reading":"じ","offset":7},{"word":"過ぎ","reading":"すぎ","offset":8}]},{"id":"sentence-174","text":"休みの日はどうですか?","start":974.56,"end":975.935,"readings":[{"word":"休み","reading":"やすみ","offset":0},{"word":"日","reading":"ひ","offset":3}]},{"id":"sentence-175","text":"食事に気をつけていますか?","start":975.935,"end":977.56,"readings":[{"word":"食事","reading":"しょくじ","offset":0},{"word":"気","reading":"き","offset":3}]},{"id":"sentence-176","text":"それがよく友達とお菓子やケーキを食べに行っています。","start":978.88,"end":981.88,"readings":[{"word":"友達","reading":"ともだち","offset":5},{"word":"お菓子","reading":"おかし","offset":8},{"word":"食べ","reading":"たべ","offset":16},{"word":"行っ","reading":"いっ","offset":19}]},{"id":"sentence-177","text":"なるほど。","start":983.839,"end":984.102,"readings":[]},{"id":"sentence-178","text":"甘いものを食べすぎているんですね。","start":984.102,"end":984.997,"readings":[{"word":"甘い","reading":"あまい","offset":0},{"word":"食べ","reading":"たべ","offset":5}]},{"id":"sentence-179","text":"運動は続けてください。","start":984.997,"end":985.576,"readings":[{"word":"運動","reading":"うんどう","offset":0},{"word":"続け","reading":"つづけ","offset":3}]},{"id":"sentence-180","text":"でも休みの日の食べ方も少し気をつけてくださいね。","start":985.576,"end":986.839,"readings":[{"word":"休み","reading":"やすみ","offset":2},{"word":"日","reading":"ひ","offset":5},{"word":"食べ","reading":"たべ","offset":7},{"word":"方","reading":"かた","offset":9},{"word":"少し","reading":"すこし","offset":11},{"word":"気","reading":"き","offset":13}]},{"id":"sentence-181","text":"トレーナーはどうして痩せないと言っていますかは","start":999.24,"end":1006.72,"readings":[{"word":"痩せ","reading":"やせ","offset":10},{"word":"言っ","reading":"いっ","offset":15}]},{"id":"sentence-182","text":"3では絵を見ながら質問を聞いてください。","start":1027.839,"end":1034.069,"readings":[{"word":"絵","reading":"え","offset":3},{"word":"見","reading":"み","offset":5},{"word":"質問","reading":"しつもん","offset":9},{"word":"聞い","reading":"きい","offset":12}]},{"id":"sentence-183","text":"矢印の人は何と言いますか?","start":1034.069,"end":1038.119,"readings":[{"word":"矢印","reading":"やじるし","offset":0},{"word":"人","reading":"ひと","offset":3},{"word":"何","reading":"なに","offset":5},{"word":"言い","reading":"いい","offset":7}]},{"id":"sentence-184","text":"1から3の中から1番いいものを1つ選んでください1番入院しているお母さんのお見舞いに来ました。","start":1038.119,"end":1052.76,"readings":[{"word":"中","reading":"なか","offset":5},{"word":"番","reading":"ばん","offset":9},{"word":"選ん","reading":"えらん","offset":17},{"word":"番","reading":"ばん","offset":25},{"word":"入院","reading":"にゅういん","offset":26},{"word":"お母さん","reading":"おかあさん","offset":32},{"word":"見舞い","reading":"みまい","offset":38},{"word":"来","reading":"き","offset":42}]},{"id":"sentence-185","text":"何と言いますか?","start":1052.76,"end":1056.52,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-186","text":"1失礼します。","start":1056.52,"end":1060.88,"readings":[{"word":"失礼","reading":"しつれい","offset":1}]},{"id":"sentence-187","text":"2体調はどうですか?","start":1060.88,"end":1065.72,"readings":[{"word":"体調","reading":"たいちょう","offset":1}]},{"id":"sentence-188","text":"3最近忙しいですか?","start":1065.72,"end":1072.16,"readings":[{"word":"最近","reading":"さいきん","offset":1},{"word":"忙しい","reading":"いそがしい","offset":3}]},{"id":"sentence-189","text":"2番友達の近くに蛇が向かってきました。","start":1091.159,"end":1098.08,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"友達","reading":"ともだち","offset":2},{"word":"近く","reading":"ちかく","offset":5},{"word":"蛇","reading":"へび","offset":8},{"word":"向かっ","reading":"むかっ","offset":10}]},{"id":"sentence-190","text":"何と言いますか?","start":1098.08,"end":1103.4,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-191","text":"蛇怖いよ。","start":1103.4,"end":1106.64,"readings":[{"word":"蛇","reading":"へび","offset":0},{"word":"怖い","reading":"こわい","offset":1}]},{"id":"sentence-192","text":"2蛇来ないで。","start":1106.64,"end":1111.48,"readings":[{"word":"蛇","reading":"へび","offset":1},{"word":"来","reading":"こ","offset":2}]},{"id":"sentence-193","text":"3蛇来たよ。","start":1111.48,"end":1114.72,"readings":[{"word":"蛇","reading":"へび","offset":1},{"word":"来","reading":"き","offset":2}]},{"id":"sentence-194","text":"気をつけて。","start":1114.72,"end":1117.96,"readings":[{"word":"気","reading":"き","offset":0}]},{"id":"sentence-195","text":"3番バスを折ります。","start":1137,"end":1141.64,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"折り","reading":"おり","offset":5}]},{"id":"sentence-196","text":"前の人が邪魔なので何と言いますか?","start":1141.64,"end":1144.64,"readings":[{"word":"前","reading":"まえ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"邪魔","reading":"じゃま","offset":4},{"word":"何","reading":"なに","offset":9},{"word":"言い","reading":"いい","offset":11}]},{"id":"sentence-197","text":"すみません。","start":1149.36,"end":1150.646,"readings":[]},{"id":"sentence-198","text":"後ろを通ります。","start":1150.646,"end":1152.36,"readings":[{"word":"後ろ","reading":"うしろ","offset":0},{"word":"通り","reading":"とおり","offset":3}]},{"id":"sentence-199","text":"2すみません。","start":1155.24,"end":1157.2,"readings":[]},{"id":"sentence-200","text":"後ろに乗ります。","start":1157.2,"end":1159.44,"readings":[{"word":"後ろ","reading":"うしろ","offset":0},{"word":"乗り","reading":"のり","offset":3}]},{"id":"sentence-201","text":"3すみません。","start":1162.28,"end":1164.259,"readings":[]},{"id":"sentence-202","text":"後ろで座ります。","start":1164.259,"end":1166.52,"readings":[{"word":"後ろ","reading":"うしろ","offset":0},{"word":"座り","reading":"すわり","offset":3}]},{"id":"sentence-203","text":"4番仕事中に困っている後輩を見ました。","start":1189.