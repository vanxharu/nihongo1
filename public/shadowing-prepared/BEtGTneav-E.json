ffset":9}]},{"id":"sentence-132","text":"あの、いつでも、あの、おむ子さん、お嫁さんお待ちしてます。","start":712.571,"end":717.458,"readings":[{"word":"子","reading":"こ","offset":13},{"word":"嫁さん","reading":"よめさん","offset":18},{"word":"お待ち","reading":"おまち","offset":21}]},{"id":"sentence-133","text":"何人でもできますからね。","start":717.458,"end":719.48,"readings":[{"word":"何","reading":"なん","offset":0},{"word":"人","reading":"にん","offset":1}]},{"id":"sentence-134","text":"日本語の結婚であれば、まあ、20人ぐらいかな。","start":719.48,"end":723.134,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"結婚","reading":"けっこん","offset":4},{"word":"人","reading":"にん","offset":16}]},{"id":"sentence-135","text":"20人、20人ぐらい結婚できます。","start":723.134,"end":725.836,"readings":[{"word":"人","reading":"にん","offset":2},{"word":"人","reading":"にん","offset":6},{"word":"結婚","reading":"けっこん","offset":10}]},{"id":"sentence-136","text":"え、ちなみに、まあ、10人以上は結婚してますけどね、もうすでに。","start":725.836,"end":730.92,"readings":[{"word":"人","reading":"にん","offset":12},{"word":"以上","reading":"いじょう","offset":13},{"word":"結婚","reading":"けっこん","offset":16}]},{"id":"sentence-137","text":"はい。というわけでまたね。","start":730.92,"end":735.399,"readings":[]}]}