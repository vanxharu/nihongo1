{"videoId":"o98AN6fmnug","title":"Japanese podcast for beginners (Nihongo con Teppei)#1604「勉強時間を作ることについて！」","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"し金え、今日は勉強時間を作ることについてはい、皆さん元気ですか?","start":1.64,"end":10.879,"readings":[{"word":"金","reading":"きん","offset":1},{"word":"今日","reading":"きょう","offset":4},{"word":"勉強","reading":"べんきょう","offset":7},{"word":"時間","reading":"じかん","offset":9},{"word":"作る","reading":"つくる","offset":12},{"word":"皆さん","reading":"みなさん","offset":23},{"word":"元気","reading":"げんき","offset":26}]},{"id":"sentence-1","text":"日本語コンて平の時間ですね。","start":10.879,"end":14.922,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"平","reading":"たいら","offset":6},{"word":"時間","reading":"じかん","offset":8}]},{"id":"sentence-2","text":"あの勉強時間ありますか?","start":14.922,"end":18.386,"readings":[{"word":"勉強","reading":"べんきょう","offset":2},{"word":"時間","reading":"じかん","offset":4}]},{"id":"sentence-3","text":"あの毎日毎日忙しいですよね。","start":18.386,"end":22.429,"readings":[{"word":"毎日","reading":"まいにち","offset":2},{"word":"毎日","reading":"まいにち","offset":4},{"word":"忙しい","reading":"いそがしい","offset":6}]},{"id":"sentence-4","text":"多分これを聞いているほとんどの人は仕事をしてますね。","start":22.429,"end":29.936,"readings":[{"word":"多分","reading":"たぶん","offset":0},{"word":"聞い","reading":"きい","offset":5},{"word":"人","reading":"ひと","offset":15},{"word":"仕事","reading":"しごと","offset":17}]},{"id":"sentence-5","text":"もしくは学校に行ってますね。","start":29.936,"end":33.978,"readings":[{"word":"学校","reading":"がっこう","offset":4},{"word":"行っ","reading":"いっ","offset":7}]},{"id":"sentence-6","text":"大学とか毎日毎日勉強とかまの勉強とか仕事とかま子供がいる人もいるかもしれない。","start":33.978,"end":45.238,"readings":[{"word":"大学","reading":"だいがく","offset":0},{"word":"毎日","reading":"まいにち","offset":4},{"word":"毎日","reading":"まいにち","offset":6},{"word":"勉強","reading":"べんきょう","offset":8},{"word":"勉強","reading":"べんきょう","offset":14},{"word":"仕事","reading":"しごと","offset":18},{"word":"子供","reading":"こども","offset":23},{"word":"人","reading":"ひと","offset":28}]},{"id":"sentence-7","text":"えー、両親の世話をしてる人もいるかもしれない。","start":45.238,"end":51.879,"readings":[{"word":"両親","reading":"りょうしん","offset":3},{"word":"世話","reading":"せわ","offset":6},{"word":"人","reading":"ひと","offset":12}]},{"id":"sentence-8","text":"とにかく忙しいですよね。","start":51.879,"end":55.959,"readings":[{"word":"忙しい","reading":"いそがしい","offset":4}]},{"id":"sentence-9","text":"毎日毎日時間がない。","start":55.959,"end":59.359,"readings":[{"word":"毎日","reading":"まいにち","offset":0},{"word":"毎日","reading":"まいにち","offset":2},{"word":"時間","reading":"じかん","offset":4}]},{"id":"sentence-10","text":"で、そういう時に日本語の勉強の時間、日本語のための勉強時間を作るのは結構難しいですよね。","start":59.359,"end":73.159,"readings":[{"word":"時","reading":"とき","offset":6},{"word":"日本語","reading":"にほんご","offset":8},{"word":"勉強","reading":"べんきょう","offset":12},{"word":"時間","reading":"じかん","offset":15},{"word":"日本語","reading":"にほんご","offset":18},{"word":"勉強","reading":"べんきょう","offset":25},{"word":"時間","reading":"じかん","offset":27},{"word":"作る","reading":"つくる","offset":30},{"word":"結構","reading":"けっこう","offset":34},{"word":"難しい","reading":"むずかしい","offset":36}]},{"id":"sentence-11","text":"うん。","start":73.159,"end":74,"readings":[]},{"id":"sentence-12","text":"1時間、1時間、1時間あるかなね。","start":74,"end":78.766,"readings":[{"word":"時間","reading":"じかん","offset":1},{"word":"時間","reading":"じかん","offset":5},{"word":"時間","reading":"じかん","offset":9}]},{"id":"sentence-13","text":"1時間、1時間。","start":78.766,"end":81.009,"readings":[{"word":"時間","reading":"じかん","offset":1},{"word":"時間","reading":"じかん","offset":5}]},{"id":"sentence-14","text":"まあ、例えば僕は、え、子供がいます。","start":81.009,"end":86.056,"readings":[{"word":"例えば","reading":"たとえば","offset":3},{"word":"僕","reading":"ぼく","offset":6},{"word":"子供","reading":"こども","offset":11}]},{"id":"sentence-15","text":"で、ま、僕はちょっとラッキーで家でね、家で仕事をしてるからまあまあ時間はあります。","start":86.056,"end":97.551,"readings":[{"word":"僕","reading":"ぼく","offset":4},{"word":"家","reading":"いえ","offset":15},{"word":"家","reading":"いえ","offset":19},{"word":"仕事","reading":"しごと","offset":21},{"word":"時間","reading":"じかん","offset":33}]},{"id":"sentence-16","text":"でも例えば週末ですよね。","start":97.551,"end":100.915,"readings":[{"word":"例えば","reading":"たとえば","offset":2},{"word":"週末","reading":"しゅうまつ","offset":5}]},{"id":"sentence-17","text":"週末。","start":100.915,"end":101.756,"readings":[{"word":"週末","reading":"しゅうまつ","offset":0}]},{"id":"sentence-18","text":"週末は家に子供がいる。","start":101.756,"end":104.84,"readings":[{"word":"週末","reading":"しゅうまつ","offset":0},{"word":"家","reading":"いえ","offset":3},{"word":"子供","reading":"こども","offset":5}]},{"id":"sentence-19","text":"奥さんもいるで色々やることがあるんですね。","start":104.84,"end":110.404,"readings":[{"word":"奥さん","reading":"おくさん","offset":0},{"word":"色々","reading":"いろいろ","offset":7}]},{"id":"sentence-20","text":"え、子供の将棋のクラスとか、えー、ま、学校の宿題とか、あとは、まあ、3人で遊んだり、ま、映画を見たり散歩したり、えー、ま、色々ですよね。","start":110.404,"end":128.422,"readings":[{"word":"子供","reading":"こども","offset":2},{"word":"将棋","reading":"しょうぎ","offset":5},{"word":"学校","reading":"がっこう","offset":19},{"word":"宿題","reading":"しゅくだい","offset":22},{"word":"人","reading":"にん","offset":35},{"word":"遊ん","reading":"あそん","offset":37},{"word":"映画","reading":"えいが","offset":44},{"word":"見","reading":"み","offset":47},{"word":"散歩","reading":"さんぽ","offset":50},{"word":"色々","reading":"いろいろ","offset":61}]},{"id":"sentence-21","text":"そうすると1時間勉強する時間はないです。","start":128.422,"end":133.721,"readings":[{"word":"時間","reading":"じかん","offset":6},{"word":"勉強","reading":"べんきょう","offset":8},{"word":"時間","reading":"じかん","offset":12}]},{"id":"sentence-22","text":"1時間ないと思う。","start":133.721,"end":136.106,"readings":[{"word":"時間","reading":"じかん","offset":1},{"word":"思う","reading":"おもう","offset":6}]},{"id":"sentence-23","text":"普通の人は週末1時間難しいな。","start":136.106,"end":140.08,"readings":[{"word":"普通","reading":"ふつう","offset":0},{"word":"人","reading":"ひと","offset":3},{"word":"週末","reading":"しゅうまつ","offset":5},{"word":"時間","reading":"じかん","offset":8},{"word":"難しい","reading":"むずかしい","offset":10}]},{"id":"sentence-24","text":"普通の日ももっと難しいですよね。","start":140.08,"end":143.359,"readings":[{"word":"普通","reading":"ふつう","offset":0},{"word":"日","reading":"ひ","offset":3},{"word":"難しい","reading":"むずかしい","offset":8}]},{"id":"sentence-25","text":"ま、僕はラッキーだけど、例えば僕の奥さん。","start":143.359,"end":147.663,"readings":[{"word":"僕","reading":"ぼく","offset":2},{"word":"例えば","reading":"たとえば","offset":12},{"word":"僕","reading":"ぼく","offset":15},{"word":"奥さん","reading":"おくさん","offset":17}]},{"id":"sentence-26","text":"僕の奥さんはあの日本語の勉強が必要ですよね。","start":147.663,"end":152.172,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"奥さん","reading":"おくさん","offset":2},{"word":"日本語","reading":"にほんご","offset":8},{"word":"勉強","reading":"べんきょう","offset":12},{"word":"必要","reading":"ひつよう","offset":15}]},{"id":"sentence-27","text":"奥さんはスペイン人です。","start":152.172,"end":154.632,"readings":[{"word":"奥さん","reading":"おくさん","offset":0},{"word":"人","reading":"じん","offset":8}]},{"id":"sentence-28","text":"奥さんは朝起きて、ま、朝ご飯食べて会社に行きます。","start":154.632,"end":159.756,"readings":[{"word":"奥さん","reading":"おくさん","offset":0},{"word":"朝","reading":"あさ","offset":4},{"word":"起き","reading":"おき","offset":5},{"word":"朝","reading":"あさ","offset":11},{"word":"ご飯","reading":"ごはん","offset":12},{"word":"食べ","reading":"たべ","offset":14},{"word":"会社","reading":"かいしゃ","offset":17},{"word":"行き","reading":"いき","offset":20}]},{"id":"sentence-29","text":"え、仕事が終わって家に帰るのは夜の7時ぐらいですね。","start":159.756,"end":165.085,"readings":[{"word":"仕事","reading":"しごと","offset":2},{"word":"終わっ","reading":"おわっ","offset":5},{"word":"家","reading":"いえ","offset":9},{"word":"帰る","reading":"かえる","offset":11},{"word":"夜","reading":"よる","offset":15},{"word":"時","reading":"じ","offset":18}]},{"id":"sentence-30","text":"家に帰ってきて、ま、晩御飯食べてお風呂に入って、え、なんか子供と色々話したり、子供のために、え、スペイン語で本を読んだり、ま、色々したら、まあ大体9時半ぐらいかな。","start":165.085,"end":181.891,"readings":[{"word":"家","reading":"いえ","offset":0},{"word":"帰っ","reading":"かえっ","offset":2},{"word":"晩","reading":"ばん","offset":10},{"word":"御飯","reading":"ごはん","offset":11},{"word":"食べ","reading":"たべ","offset":13},{"word":"風呂","reading":"ふろ","offset":17},{"word":"入っ","reading":"はいっ","offset":20},{"word":"子供","reading":"こども","offset":29},{"word":"色々","reading":"いろいろ","offset":32},{"word":"話し","reading":"はなし","offset":34},{"word":"子供","reading":"こども","offset":39},{"word":"語","reading":"ご","offset":52},{"word":"本","reading":"ほん","offset":54},{"word":"読ん","reading":"よん","offset":56},{"word":"色々","reading":"いろいろ","offset":63},{"word":"大体","reading":"だいたい","offset":71},{"word":"時半","reading":"じはん","offset":74}]},{"id":"sentence-31","text":"9時半、10時ぐらいになってしまいますね。","start":181.891,"end":186.195,"readings":[{"word":"時半","reading":"じはん","offset":1},{"word":"時","reading":"じ","offset":6}]},{"id":"sentence-32","text":"で","start":186.195,"end":186.4,"readings":[]},{"id":"sentence-33","text":"、それからまあ1時間勉強したくないでしょう。","start":186.4,"end":192.64,"readings":[{"word":"時間","reading":"じかん","offset":8},{"word":"勉強","reading":"べんきょう","offset":10}]},{"id":"sentence-34","text":"結構大変ですよね。","start":192.64,"end":194.605,"readings":[{"word":"結構","reading":"けっこう","offset":0},{"word":"大変","reading":"たいへん","offset":2}]},{"id":"sentence-35","text":"普通の人は時間がないと思う。","start":194.605,"end":197.662,"readings":[{"word":"普通","reading":"ふつう","offset":0},{"word":"人","reading":"ひと","offset":3},{"word":"時間","reading":"じかん","offset":5},{"word":"思う","reading":"おもう","offset":11}]},{"id":"sentence-36","text":"じゃあどうやって勉強時間を作ればいいかと言うと、やっぱり電車に乗ってる時間とか車を運転してる時間とかそういう、ま、あのポッドキャストですよね。","start":197.662,"end":213.163,"readings":[{"word":"勉強","reading":"べんきょう","offset":8},{"word":"時間","reading":"じかん","offset":10},{"word":"作れ","reading":"つくれ","offset":13},{"word":"言う","reading":"いう","offset":20},{"word":"電車","reading":"でんしゃ","offset":28},{"word":"乗っ","reading":"のっ","offset":31},{"word":"時間","reading":"じかん","offset":35},{"word":"車","reading":"くるま","offset":39},{"word":"運転","reading":"うんてん","offset":41},{"word":"時間","reading":"じかん","offset":46}]},{"id":"sentence-37","text":"やっぱりポッドキャストを聞きながら会社に行くとか、ポッドキャストを聞きながら帰るとか、やっぱりそれが1番だと思います。","start":213.163,"end":226.045,"readings":[{"word":"聞き","reading":"きき","offset":12},{"word":"会社","reading":"かいしゃ","offset":17},{"word":"行く","reading":"いく","offset":20},{"word":"聞き","reading":"きき","offset":33},{"word":"帰る","reading":"かえる","offset":38},{"word":"番","reading":"ばん","offset":51},{"word":"思い","reading":"おもい","offset":54}]},{"id":"sentence-38","text":"あとはちょっとトイレの中でまあまあまあトイレの中で少し単語をチェックしたりとかね、そういう隙間時間ですよね。","start":226.045,"end":237.835,"readings":[{"word":"中","reading":"なか","offset":11},{"word":"中","reading":"なか","offset":23},{"word":"少し","reading":"すこし","offset":25},{"word":"単語","reading":"たんご","offset":27},{"word":"隙間","reading":"すきま","offset":45},{"word":"時間","reading":"じかん","offset":47}]},{"id":"sentence-39","text":"ちょっと時間がある。","start":237.835,"end":240.018,"readings":[{"word":"時間","reading":"じかん","offset":4}]},{"id":"sentence-40","text":"ちょっとだけね、1分とか2分とか3分とか、え、","start":240.018,"end":245.04,"readings":[{"word":"分","reading":"ふん","offset":9},{"word":"分","reading":"ふん","offset":13},{"word":"分","reading":"ふん","offset":17}]},{"id":"sentence-41","text":"昼ご飯を食べた後5分とかそういう少しの時間を使って勉強する。","start":245.04,"end":252.58,"readings":[{"word":"昼","reading":"ひる","offset":0},{"word":"ご飯","reading":"ごはん","offset":1},{"word":"食べ","reading":"たべ","offset":4},{"word":"後","reading":"のち","offset":7},{"word":"分","reading":"ふん","offset":9},{"word":"少し","reading":"すこし","offset":16},{"word":"時間","reading":"じかん","offset":19},{"word":"使っ","reading":"つかっ","offset":22},{"word":"勉強","reading":"べんきょう","offset":25}]},{"id":"sentence-42","text":"そうすれば1日の中で1時間ぐらい勉強時間を作れると思います。","start":252.58,"end":260.12,"readings":[{"word":"日","reading":"にち","offset":6},{"word":"中","reading":"なか","offset":8},{"word":"時間","reading":"じかん","offset":11},{"word":"勉強","reading":"べんきょう","offset":16},{"word":"時間","reading":"じかん","offset":18},{"word":"作れる","reading":"つくれる","offset":21},{"word":"思い","reading":"おもい","offset":25}]},{"id":"sentence-43","text":"はい。というわけで勉強時間を作ることは結構難しい。","start":260.12,"end":265.704,"readings":[{"word":"勉強","reading":"べんきょう","offset":9},{"word":"時間","reading":"じかん","offset":11},{"word":"作る","reading":"つくる","offset":14},{"word":"結構","reading":"けっこう","offset":19},{"word":"難しい","reading":"むずかしい","offset":21}]},{"id":"sentence-44","text":"1時間ストレートでね、1時間まとめて勉強するのは難しい。","start":265.704,"end":271.958,"readings":[{"word":"時間","reading":"じかん","offset":1},{"word":"時間","reading":"じかん","offset":12},{"word":"勉強","reading":"べんきょう","offset":18},{"word":"難しい","reading":"むずかしい","offset":24}]},{"id":"sentence-45","text":"だけど会社に行く時、会社から帰る時ね、そして5分とかの小さい隙間時間を使って勉強すれば毎日1時間ぐらいかな、1時間ぐらい日本語の勉強ができると思いますね。","start":271.958,"end":289.157,"readings":[{"word":"会社","reading":"かいしゃ","offset":3},{"word":"行く","reading":"いく","offset":6},{"word":"時","reading":"とき","offset":8},{"word":"会社","reading":"かいしゃ","offset":10},{"word":"帰る","reading":"かえる","offset":14},{"word":"時","reading":"とき","offset":16},{"word":"分","reading":"ふん","offset":23},{"word":"小さい","reading":"ちいさい","offset":27},{"word":"隙間","reading":"すきま","offset":30},{"word":"時間","reading":"じかん","offset":32},{"word":"使っ","reading":"つかっ","offset":35},{"word":"勉強","reading":"べんきょう","offset":38},{"word":"毎日","reading":"まいにち","offset":43},{"word":"時間","reading":"じかん","offset":46},{"word":"時間","reading":"じかん","offset":55},{"word":"日本語","reading":"にほんご","offset":60},{"word":"勉強","reading":"べんきょう","offset":64},{"word":"思い","reading":"おもい","offset":71}]},{"id":"sentence-46","text":"頑張ってください。","start":289.157,"end":291.167,"readings":[{"word":"頑張っ","reading":"がんばっ","offset":0}]},{"id":"sentence-47","text":"まあ、ルーティンですね。","start":291.167,"end":293.848,"readings":[]},{"id":"sentence-48","text":"大事なのは週慣です。","start":293.848,"end":296.081,"readings":[{"word":"大事","reading":"だいじ","offset":0},{"word":"週","reading":"しゅう","offset":5}]},{"id":"sentence-49","text":"毎日家を出たらね、家を出る時にポッドキャストを聞くね。","start":296.081,"end":302.112,"readings":[{"word":"毎日","reading":"まいにち","offset":0},{"word":"家","reading":"か","offset":2},{"word":"出","reading":"で","offset":4},{"word":"家","reading":"いえ","offset":9},{"word":"出る","reading":"でる","offset":11},{"word":"時","reading":"とき","offset":13},{"word":"聞く","reading":"きく","offset":23}]},{"id":"sentence-50","text":"えー、犬の散歩をする時にポッドキャストを聞く。","start":302.112,"end":307.249,"readings":[{"word":"犬","reading":"いぬ","offset":3},{"word":"散歩","reading":"さんぽ","offset":5},{"word":"時","reading":"とき","offset":10},{"word":"聞く","reading":"きく","offset":20}]},{"id":"sentence-51","text":"そういう習慣ですよね。","start":307.249,"end":309.706,"readings":[{"word":"習慣","reading":"しゅうかん","offset":4}]},{"id":"sentence-52","text":"習慣を作ればそんなに難しくないと","start":309.706,"end":313.28,"readings":[{"word":"習慣","reading":"しゅうかん","offset":0},{"word":"作れ","reading":"つくれ","offset":3},{"word":"難しく","reading":"むずかしく","offset":10}]},{"id":"sentence-53","text":"思いますね。","start":313.28,"end":314.72,"readings":[{"word":"思い","reading":"おもい","offset":0}]},{"id":"sentence-54","text":"応援してます。","start":314.72,"end":316.4,"readings":[{"word":"応援","reading":"おうえん","offset":0}]},{"id":"sentence-55","text":"頑張ってください。","start":316.4,"end":318.559,"readings":[{"word":"頑張っ","reading":"がんばっ","offset":0}]},{"id":"sentence-56","text":"それではまたね。","start":318.559,"end":320.479,"readings":[]}]}