{"videoId":"ZCai4_tyshE","title":"【N5-N4】Ep277 New Friends, Old Friends / Japanese Podcast for Beginners","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"しと日本語ポッドキャスト277初心者ビギナーズ元気レベル新しい友達昔の友達","start":0.68,"end":22.84,"readings":[{"word":"日本語","reading":"にほんご","offset":2},{"word":"初心者","reading":"しょしんしゃ","offset":15},{"word":"元気","reading":"げんき","offset":23},{"word":"新しい","reading":"あたらしい","offset":28},{"word":"友達","reading":"ともだち","offset":31},{"word":"昔","reading":"むかし","offset":33},{"word":"友達","reading":"ともだち","offset":35}]},{"id":"sentence-1","text":"皆さん、こんにちは。","start":30.84,"end":33.502,"readings":[{"word":"皆さん","reading":"みなさん","offset":0}]},{"id":"sentence-2","text":"日本語教師の春です。","start":33.502,"end":36.163,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"教師","reading":"きょうし","offset":3},{"word":"春","reading":"はる","offset":6}]},{"id":"sentence-3","text":"元気ですか?","start":36.163,"end":37.76,"readings":[{"word":"元気","reading":"げんき","offset":0}]},{"id":"sentence-4","text":"いやあ、今日は本当にいい天気ですよ。","start":37.76,"end":42.399,"readings":[{"word":"今日","reading":"きょう","offset":4},{"word":"本当に","reading":"ほんとうに","offset":7},{"word":"天気","reading":"てんき","offset":12}]},{"id":"sentence-5","text":"さあ、え、今日は友達について話したいと思います。","start":42.399,"end":50.16,"readings":[{"word":"今日","reading":"きょう","offset":5},{"word":"友達","reading":"ともだち","offset":8},{"word":"話し","reading":"はなし","offset":14},{"word":"思い","reading":"おもい","offset":19}]},{"id":"sentence-6","text":"皆さんはどんな友達がいますか?","start":50.16,"end":55.12,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"友達","reading":"ともだち","offset":7}]},{"id":"sentence-7","text":"色々な友達がいますよね。","start":55.12,"end":59.96,"readings":[{"word":"色々","reading":"いろいろ","offset":0},{"word":"友達","reading":"ともだち","offset":3}]},{"id":"sentence-8","text":"まずは昔の友達です。","start":59.96,"end":64.72,"readings":[{"word":"昔","reading":"むかし","offset":3},{"word":"友達","reading":"ともだち","offset":5}]},{"id":"sentence-9","text":"幼馴染みですね。","start":64.72,"end":69,"readings":[{"word":"幼馴染み","reading":"おさななじみ","offset":0}]},{"id":"sentence-10","text":"幼馴染みは、ま、本当に地元の友達で子供の時から仲がいい友達ですね。","start":69,"end":80.439,"readings":[{"word":"幼馴染み","reading":"おさななじみ","offset":0},{"word":"本当に","reading":"ほんとうに","offset":8},{"word":"地元","reading":"じもと","offset":11},{"word":"友達","reading":"ともだち","offset":14},{"word":"子供","reading":"こども","offset":17},{"word":"時","reading":"とき","offset":20},{"word":"仲","reading":"なか","offset":23},{"word":"友達","reading":"ともだち","offset":27}]},{"id":"sentence-11","text":"どうやって友達になったか覚えていません。","start":80.439,"end":87.2,"readings":[{"word":"友達","reading":"ともだち","offset":5},{"word":"覚え","reading":"おぼえ","offset":12}]},{"id":"sentence-12","text":"気づいたら友達になっていますよね。","start":87.2,"end":92.119,"readings":[{"word":"気づい","reading":"きづい","offset":0},{"word":"友達","reading":"ともだち","offset":5}]},{"id":"sentence-13","text":"はい。","start":92.119,"end":93.225,"readings":[]},{"id":"sentence-14","text":"幼馴染みはすごく大切な友達だと思います。","start":93.225,"end":100.6,"readings":[{"word":"幼馴染み","reading":"おさななじみ","offset":0},{"word":"大切","reading":"たいせつ","offset":8},{"word":"友達","reading":"ともだち","offset":11},{"word":"思い","reading":"おもい","offset":15}]},{"id":"sentence-15","text":"本当に色々な性格の友達がいます。","start":100.6,"end":108.079,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"色々","reading":"いろいろ","offset":3},{"word":"性格","reading":"せいかく","offset":6},{"word":"友達","reading":"ともだち","offset":9}]},{"id":"sentence-16","text":"静かな人やうるさい人、バカな人、色々な友達がいます。","start":108.079,"end":119.159,"readings":[{"word":"静か","reading":"しずか","offset":0},{"word":"人","reading":"ひと","offset":3},{"word":"人","reading":"ひと","offset":9},{"word":"人","reading":"ひと","offset":14},{"word":"色々","reading":"いろいろ","offset":16},{"word":"友達","reading":"ともだち","offset":19}]},{"id":"sentence-17","text":"幼馴染みと一緒にいるとリラックスできますよね。","start":119.56,"end":127.039,"readings":[{"word":"幼馴染み","reading":"おさななじみ","offset":0},{"word":"一緒","reading":"いっしょ","offset":5}]},{"id":"sentence-18","text":"うん。","start":127.039,"end":128.138,"readings":[]},{"id":"sentence-19","text":"私はいつも仕事を忘れて楽しむことができます。","start":128.138,"end":136.2,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"仕事","reading":"しごと","offset":5},{"word":"忘れ","reading":"わすれ","offset":8},{"word":"楽しむ","reading":"たのしむ","offset":11}]},{"id":"sentence-20","text":"今幼馴染みと遊ぶ時はあの友達友達はよく仕事の話をします。","start":136.8,"end":148.025,"readings":[{"word":"今","reading":"こん","offset":0},{"word":"幼馴染み","reading":"おさななじみ","offset":1},{"word":"遊ぶ","reading":"あそぶ","offset":6},{"word":"時","reading":"とき","offset":8},{"word":"友達","reading":"ともだち","offset":12},{"word":"友達","reading":"ともだち","offset":14},{"word":"仕事","reading":"しごと","offset":19},{"word":"話","reading":"はなし","offset":22}]},{"id":"sentence-21","text":"でも私は全然仕事の話をしません。","start":148.025,"end":154.44,"readings":[{"word":"私","reading":"わたし","offset":2},{"word":"全然","reading":"ぜんぜん","offset":4},{"word":"仕事","reading":"しごと","offset":6},{"word":"話","reading":"はなし","offset":9}]},{"id":"sentence-22","text":"ま、でも面白いですよ。","start":154.44,"end":157.756,"readings":[{"word":"面白い","reading":"おもしろい","offset":4}]},{"id":"sentence-23","text":"うん。","start":157.756,"end":158.661,"readings":[]},{"id":"sentence-24","text":"私は会社員じゃないから幼馴染みといる時にいつも会社員の生活を知ることができます。","start":158.661,"end":170.72,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"会社","reading":"かいしゃ","offset":2},{"word":"員","reading":"いん","offset":4},{"word":"幼馴染み","reading":"おさななじみ","offset":11},{"word":"時","reading":"とき","offset":18},{"word":"会社","reading":"かいしゃ","offset":23},{"word":"員","reading":"いん","offset":25},{"word":"生活","reading":"せいかつ","offset":27},{"word":"知る","reading":"しる","offset":30}]},{"id":"sentence-25","text":"あと今は私は35歳なので友達は1番仕事を頑張っている時期ですね。","start":170.72,"end":182.2,"readings":[{"word":"今","reading":"いま","offset":2},{"word":"私","reading":"わたし","offset":4},{"word":"歳","reading":"さい","offset":8},{"word":"友達","reading":"ともだち","offset":12},{"word":"番","reading":"ばん","offset":16},{"word":"仕事","reading":"しごと","offset":17},{"word":"頑張っ","reading":"がんばっ","offset":20},{"word":"時期","reading":"じき","offset":26}]},{"id":"sentence-26","text":"うん。","start":182.2,"end":183.175,"readings":[]},{"id":"sentence-27","text":"ま、でも私にとって幼馴染みと過ごす時間は本当に大切です。","start":183.175,"end":192.28,"readings":[{"word":"私","reading":"わたし","offset":4},{"word":"幼馴染み","reading":"おさななじみ","offset":9},{"word":"過ごす","reading":"すごす","offset":14},{"word":"時間","reading":"じかん","offset":17},{"word":"本当に","reading":"ほんとうに","offset":20},{"word":"大切","reading":"たいせつ","offset":23}]},{"id":"sentence-28","text":"だから最低1ヶ月に1回は幼馴染みと会います。","start":192.28,"end":202.159,"readings":[{"word":"最低","reading":"さいてい","offset":3},{"word":"ヶ月","reading":"かげつ","offset":6},{"word":"回","reading":"かい","offset":10},{"word":"幼馴染み","reading":"おさななじみ","offset":12},{"word":"会い","reading":"あい","offset":17}]},{"id":"sentence-29","text":"あと新しい友達ですね。","start":202.159,"end":208.08,"readings":[{"word":"新しい","reading":"あたらしい","offset":2},{"word":"友達","reading":"ともだち","offset":5}]},{"id":"sentence-30","text":"はい。","start":208.08,"end":210.319,"readings":[]},{"id":"sentence-31","text":"皆さんは大学を卒業してから友達を作っていますか?","start":210.319,"end":219.68,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"大学","reading":"だいがく","offset":4},{"word":"卒業","reading":"そつぎょう","offset":7},{"word":"友達","reading":"ともだち","offset":13},{"word":"作っ","reading":"つくっ","offset":16}]},{"id":"sentence-32","text":"学生の時に友達を作るのは簡単ですよね。","start":219.84,"end":227.28,"readings":[{"word":"学生","reading":"がくせい","offset":0},{"word":"時","reading":"とき","offset":3},{"word":"友達","reading":"ともだち","offset":5},{"word":"作る","reading":"つくる","offset":8},{"word":"簡単","reading":"かんたん","offset":12}]},{"id":"sentence-33","text":"でも卒業してからはどうですか?","start":227.28,"end":233.28,"readings":[{"word":"卒業","reading":"そつぎょう","offset":2}]},{"id":"sentence-34","text":"日本で私の友達は会社で友達を見つけます日本では大学を卒業した後のコミュニティは大抵会社しかありません。","start":233.28,"end":253.079,"readings":[{"word":"日本","reading":"にっぽん","offset":0},{"word":"私","reading":"わたし","offset":3},{"word":"友達","reading":"ともだち","offset":5},{"word":"会社","reading":"かいしゃ","offset":8},{"word":"友達","reading":"ともだち","offset":11},{"word":"見つけ","reading":"みつけ","offset":14},{"word":"日本","reading":"にっぽん","offset":19},{"word":"大学","reading":"だいがく","offset":23},{"word":"卒業","reading":"そつぎょう","offset":26},{"word":"後","reading":"のち","offset":30},{"word":"大抵","reading":"たいてい","offset":39},{"word":"会社","reading":"かいしゃ","offset":41}]},{"id":"sentence-35","text":"うん。","start":253.079,"end":253.927,"readings":[]},{"id":"sentence-36","text":"ちょっと悲しいですよね。","start":253.927,"end":257.32,"readings":[{"word":"悲しい","reading":"かなしい","offset":4}]},{"id":"sentence-37","text":"はい。","start":257.32,"end":258.926,"readings":[]},{"id":"sentence-38","text":"でもこれが現実です。","start":258.926,"end":264.28,"readings":[{"word":"現実","reading":"げんじつ","offset":5}]},{"id":"sentence-39","text":"会社の同僚や後輩が友達になります。","start":264.36,"end":274.32,"readings":[{"word":"会社","reading":"かいしゃ","offset":0},{"word":"同僚","reading":"どうりょう","offset":3},{"word":"後輩","reading":"こうはい","offset":6},{"word":"友達","reading":"ともだち","offset":9}]},{"id":"sentence-40","text":"私の友達は休みの日も同僚や後輩とお酒を飲みに行ったり旅行に行ったりしていますよ。","start":275.199,"end":289.16,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"友達","reading":"ともだち","offset":2},{"word":"休み","reading":"やすみ","offset":5},{"word":"日","reading":"ひ","offset":8},{"word":"同僚","reading":"どうりょう","offset":10},{"word":"後輩","reading":"こうはい","offset":13},{"word":"酒","reading":"さけ","offset":17},{"word":"飲み","reading":"のみ","offset":19},{"word":"行っ","reading":"いっ","offset":22},{"word":"旅行","reading":"りょこう","offset":26},{"word":"行っ","reading":"いっ","offset":29}]},{"id":"sentence-41","text":"うん。","start":289.16,"end":290.313,"readings":[]},{"id":"sentence-42","text":"私は会社員じゃないので色々なところで新しい友達を作りました。","start":290.313,"end":301.84,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"会社","reading":"かいしゃ","offset":2},{"word":"員","reading":"いん","offset":4},{"word":"色々","reading":"いろいろ","offset":11},{"word":"新しい","reading":"あたらしい","offset":18},{"word":"友達","reading":"ともだち","offset":21},{"word":"作り","reading":"つくり","offset":24}]},{"id":"sentence-43","text":"私は色々な国に住んでいました。","start":301.84,"end":307.28,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"色々","reading":"いろいろ","offset":2},{"word":"国","reading":"くに","offset":5},{"word":"住ん","reading":"すん","offset":7}]},{"id":"sentence-44","text":"その国で新しい友達を作りました。","start":307.28,"end":314.12,"readings":[{"word":"国","reading":"くに","offset":2},{"word":"新しい","reading":"あたらしい","offset":4},{"word":"友達","reading":"ともだち","offset":7},{"word":"作り","reading":"つくり","offset":10}]},{"id":"sentence-45","text":"例えば住んでいる家の近所の人ですね。","start":314.12,"end":321.88,"readings":[{"word":"例えば","reading":"たとえば","offset":0},{"word":"住ん","reading":"すん","offset":3},{"word":"家","reading":"いえ","offset":8},{"word":"近所","reading":"きんじょ","offset":10},{"word":"人","reading":"ひと","offset":13}]},{"id":"sentence-46","text":"毎日会うから少しずつ仲が良くなって一緒に晩御飯を食べたりパーティーに行ったりしました。","start":322.16,"end":336,"readings":[{"word":"毎日","reading":"まいにち","offset":0},{"word":"会う","reading":"あう","offset":2},{"word":"少し","reading":"すこし","offset":6},{"word":"仲","reading":"なか","offset":10},{"word":"良く","reading":"よく","offset":12},{"word":"一緒","reading":"いっしょ","offset":17},{"word":"晩","reading":"ばん","offset":20},{"word":"御飯","reading":"ごはん","offset":21},{"word":"食べ","reading":"たべ","offset":24},{"word":"行っ","reading":"いっ","offset":34}]},{"id":"sentence-47","text":"あとはあの旅行に行った時のホステルでたくさん友達を作りました。","start":336.16,"end":349.36,"readings":[{"word":"旅行","reading":"りょこう","offset":5},{"word":"行っ","reading":"いっ","offset":8},{"word":"時","reading":"とき","offset":11},{"word":"友達","reading":"ともだち","offset":22},{"word":"作り","reading":"つくり","offset":25}]},{"id":"sentence-48","text":"テルでほとんど友達を作りましたね。","start":349.8,"end":354.56,"readings":[{"word":"友達","reading":"ともだち","offset":7},{"word":"作り","reading":"つくり","offset":10}]},{"id":"sentence-49","text":"うん。","start":354.56,"end":355.65,"readings":[]},{"id":"sentence-50","text":"時々ホステルで会った人と一緒に旅行に行って今でも連絡を取ってます。","start":355.65,"end":367.639,"readings":[{"word":"時々","reading":"ときどき","offset":0},{"word":"会っ","reading":"あっ","offset":7},{"word":"人","reading":"ひと","offset":10},{"word":"一緒","reading":"いっしょ","offset":12},{"word":"旅行","reading":"りょこう","offset":15},{"word":"行っ","reading":"いっ","offset":18},{"word":"今","reading":"いま","offset":21},{"word":"連絡","reading":"れんらく","offset":24},{"word":"取っ","reading":"とっ","offset":27}]},{"id":"sentence-51","text":"時々彼らに会いに行きましたよ。","start":367.68,"end":373.199,"readings":[{"word":"時々","reading":"ときどき","offset":0},{"word":"彼ら","reading":"かれら","offset":2},{"word":"会い","reading":"あい","offset":5},{"word":"行き","reading":"いき","offset":8}]},{"id":"sentence-52","text":"はい。","start":373.199,"end":374.208,"readings":[]},{"id":"sentence-53","text":"ま、本当に楽しい時間でした。","start":374.208,"end":378.919,"readings":[{"word":"本当に","reading":"ほんとうに","offset":2},{"word":"楽しい","reading":"たのしい","offset":5},{"word":"時間","reading":"じかん","offset":8}]},{"id":"sentence-54","text":"ポステルは本当にたくさん新しい友達を作ることができるいい場所だと思いますね本当に仲がいい最高の友達を見つけることができて嬉しいです。","start":379.039,"end":401.52,"readings":[{"word":"本当に","reading":"ほんとうに","offset":5},{"word":"新しい","reading":"あたらしい","offset":12},{"word":"友達","reading":"ともだち","offset":15},{"word":"作る","reading":"つくる","offset":18},{"word":"場所","reading":"ばしょ","offset":28},{"word":"思い","reading":"おもい","offset":32},{"word":"本当に","reading":"ほんとうに","offset":37},{"word":"仲","reading":"なか","offset":40},{"word":"最高","reading":"さいこう","offset":44},{"word":"友達","reading":"ともだち","offset":47},{"word":"見つける","reading":"みつける","offset":50},{"word":"嬉しい","reading":"うれしい","offset":60}]},{"id":"sentence-55","text":"新しい友達は自分と価値観が同じ人が多いと思います。","start":402.16,"end":412.36,"readings":[{"word":"新しい","reading":"あたらしい","offset":0},{"word":"友達","reading":"ともだち","offset":3},{"word":"自分","reading":"じぶん","offset":6},{"word":"価値","reading":"かち","offset":9},{"word":"観","reading":"かん","offset":11},{"word":"同じ","reading":"おなじ","offset":13},{"word":"人","reading":"ひと","offset":15},{"word":"多い","reading":"おおい","offset":17},{"word":"思い","reading":"おもい","offset":20}]},{"id":"sentence-56","text":"幼馴染みは色々な価値観の人がいます。","start":412.56,"end":420.08,"readings":[{"word":"幼馴染み","reading":"おさななじみ","offset":0},{"word":"色々","reading":"いろいろ","offset":5},{"word":"価値","reading":"かち","offset":8},{"word":"観","reading":"かん","offset":10},{"word":"人","reading":"ひと","offset":12}]},{"id":"sentence-57","text":"ま、ほとんど私と違う価値観を持っていますね。","start":420.08,"end":425.56,"readings":[{"word":"私","reading":"わたし","offset":6},{"word":"違う","reading":"ちがう","offset":8},{"word":"価値","reading":"かち","offset":10},{"word":"観","reading":"かん","offset":12},{"word":"持っ","reading":"もっ","offset":14}]},{"id":"sentence-58","text":"でも大好きな友達です。","start":425.56,"end":431.68,"readings":[{"word":"大好き","reading":"だいすき","offset":2},{"word":"友達","reading":"ともだち","offset":6}]},{"id":"sentence-59","text":"新しく作った友達は私と同じような価値観の人が多いから一緒にいると本当に楽しいです。","start":432.36,"end":446.44,"readings":[{"word":"新しく","reading":"あたらしく","offset":0},{"word":"作っ","reading":"つくっ","offset":3},{"word":"友達","reading":"ともだち","offset":6},{"word":"私","reading":"わたし","offset":9},{"word":"同じ","reading":"おなじ","offset":11},{"word":"価値","reading":"かち","offset":16},{"word":"観","reading":"かん","offset":18},{"word":"人","reading":"ひと","offset":20},{"word":"多い","reading":"おおい","offset":22},{"word":"一緒","reading":"いっしょ","offset":26},{"word":"本当に","reading":"ほんとうに","offset":32},{"word":"楽しい","reading":"たのしい","offset":35}]},{"id":"sentence-60","text":"ま、特に私は日本では少し変なタイプの人だと思います。","start":446.44,"end":454.24,"readings":[{"word":"特に","reading":"とくに","offset":2},{"word":"私","reading":"わたし","offset":4},{"word":"日本","reading":"にっぽん","offset":6},{"word":"少し","reading":"すこし","offset":10},{"word":"変","reading":"へん","offset":12},{"word":"人","reading":"ひと","offset":18},{"word":"思い","reading":"おもい","offset":21}]},{"id":"sentence-61","text":"うん。","start":454.24,"end":455.384,"readings":[]},{"id":"sentence-62","text":"他の日本人と違うと思います。","start":455.384,"end":460.72,"readings":[{"word":"他","reading":"た","offset":0},{"word":"日本人","reading":"にっぽんじん","offset":2},{"word":"違う","reading":"ちがう","offset":6},{"word":"思い","reading":"おもい","offset":9}]},{"id":"sentence-63","text":"だから価値観が似ている友達と過ごすと本当に気持ちが楽になりますね。","start":460.72,"end":473.627,"readings":[{"word":"価値","reading":"かち","offset":3},{"word":"観","reading":"かん","offset":5},{"word":"似","reading":"に","offset":7},{"word":"友達","reading":"ともだち","offset":11},{"word":"過ごす","reading":"すごす","offset":14},{"word":"本当に","reading":"ほんとうに","offset":18},{"word":"気持ち","reading":"きもち","offset":21},{"word":"楽","reading":"らく","offset":25}]},{"id":"sentence-64","text":"はい。","start":473.627,"end":474.8,"readings":[]},{"id":"sentence-65","text":"あと私の場合新しい友達の80%は外国人です。","start":474.84,"end":485.879,"readings":[{"word":"私","reading":"わたし","offset":2},{"word":"場合","reading":"ばあい","offset":4},{"word":"新しい","reading":"あたらしい","offset":6},{"word":"友達","reading":"ともだち","offset":9},{"word":"外国","reading":"がいこく","offset":16},{"word":"人","reading":"じん","offset":18}]},{"id":"sentence-66","text":"うん。","start":485.879,"end":486.379,"readings":[]},{"id":"sentence-67","text":"ほとんど外国にいましたからね。","start":486.379,"end":488.879,"readings":[{"word":"外国","reading":"がいこく","offset":4}]},{"id":"sentence-68","text":"はい。","start":488.879,"end":491.44,"readings":[]},{"id":"sentence-69","text":"え、仲がいい友達を作るのは難しいと思います。","start":491.44,"end":499.199,"readings":[{"word":"仲","reading":"なか","offset":2},{"word":"友達","reading":"ともだち","offset":6},{"word":"作る","reading":"つくる","offset":9},{"word":"難しい","reading":"むずかしい","offset":13},{"word":"思い","reading":"おもい","offset":17}]},{"id":"sentence-70","text":"その時だけの友達は簡単に作ることができます。","start":499.199,"end":507.406,"readings":[{"word":"時","reading":"とき","offset":2},{"word":"友達","reading":"ともだち","offset":6},{"word":"簡単","reading":"かんたん","of