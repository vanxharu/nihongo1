{"videoId":"5nDjpkkc48I","title":"Nihongo con Teppei 波! #292「浅い奴について！」","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"カツカーツは朝についてはい、皆さんこんにちは。","start":0.919,"end":9.639,"readings":[{"word":"朝","reading":"あさ","offset":6},{"word":"皆さん","reading":"みなさん","offset":14}]},{"id":"sentence-1","text":"日本語てのですね。","start":9.639,"end":11.367,"readings":[{"word":"日本語","reading":"にほんご","offset":0}]},{"id":"sentence-2","text":"えー、今日も頑張って文句を行ってみましょう。","start":11.367,"end":15.592,"readings":[{"word":"今日","reading":"きょう","offset":3},{"word":"頑張っ","reading":"がんばっ","offset":6},{"word":"文句","reading":"もんく","offset":10},{"word":"行っ","reading":"おこなっ","offset":13}]},{"id":"sentence-3","text":"ま、文句と言うと悪いイメージがあると思いますが、ま、ここはあのちょっと、ま、日本語の勉強のためにあの聞いていただきたい。","start":15.592,"end":27.114,"readings":[{"word":"文句","reading":"もんく","offset":2},{"word":"言う","reading":"いう","offset":5},{"word":"悪い","reading":"わるい","offset":8},{"word":"思い","reading":"おもい","offset":18},{"word":"日本語","reading":"にほんご","offset":38},{"word":"勉強","reading":"べんきょう","offset":42},{"word":"聞い","reading":"きい","offset":50}]},{"id":"sentence-4","text":"僕もあの言いたくて言ってるわけではない。","start":27.114,"end":30.955,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"言い","reading":"いい","offset":4},{"word":"言っ","reading":"いっ","offset":9}]},{"id":"sentence-5","text":"まあ、なんで文句って言うかと言うと、一般的に人々は、ま、文句は聞きたくないですよね。","start":30.955,"end":39.02,"readings":[{"word":"文句","reading":"もんく","offset":6},{"word":"言う","reading":"いう","offset":10},{"word":"言う","reading":"いう","offset":14},{"word":"一般","reading":"いっぱん","offset":18},{"word":"的","reading":"てき","offset":20},{"word":"人々","reading":"ひとびと","offset":22},{"word":"文句","reading":"もんく","offset":28},{"word":"聞き","reading":"きき","offset":31}]},{"id":"sentence-6","text":"なぜかと言うと、感情的に文句言ってるから。","start":39.02,"end":43.053,"readings":[{"word":"言う","reading":"いう","offset":4},{"word":"感情","reading":"かんじょう","offset":8},{"word":"的","reading":"てき","offset":10},{"word":"文句","reading":"もんく","offset":12},{"word":"言っ","reading":"いっ","offset":14}]},{"id":"sentence-7","text":"僕は感情的に文句言ってないですからね。","start":43.053,"end":46.702,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"感情","reading":"かんじょう","offset":2},{"word":"的","reading":"てき","offset":4},{"word":"文句","reading":"もんく","offset":6},{"word":"言っ","reading":"いっ","offset":8}]},{"id":"sentence-8","text":"僕はあくまで冷静に、そして一般論として、一般論ね、僕の個人的な経験","start":46.702,"end":53.039,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"冷静","reading":"れいせい","offset":6},{"word":"一般","reading":"いっぱん","offset":13},{"word":"論","reading":"ろん","offset":15},{"word":"一般","reading":"いっぱん","offset":20},{"word":"論","reading":"ろん","offset":22},{"word":"僕","reading":"ぼく","offset":25},{"word":"個人","reading":"こじん","offset":27},{"word":"的","reading":"てき","offset":29},{"word":"経験","reading":"けいけん","offset":31}]},{"id":"sentence-9","text":"じゃなくて一般論を話しているわけで、これは勉強のためになります。","start":53.039,"end":58.851,"readings":[{"word":"一般","reading":"いっぱん","offset":5},{"word":"論","reading":"ろん","offset":7},{"word":"話し","reading":"はなし","offset":9},{"word":"勉強","reading":"べんきょう","offset":21}]},{"id":"sentence-10","text":"はい。","start":58.851,"end":59.395,"readings":[]},{"id":"sentence-11","text":"あの、文句っていうのはね、やっぱり良くない。","start":59.395,"end":63.391,"readings":[{"word":"文句","reading":"もんく","offset":3},{"word":"良く","reading":"よく","offset":17}]},{"id":"sentence-12","text":"だから文句ではないな。","start":63.391,"end":65.389,"readings":[{"word":"文句","reading":"もんく","offset":3}]},{"id":"sentence-13","text":"これは文句ではありません。","start":65.389,"end":67.75,"readings":[{"word":"文句","reading":"もんく","offset":3}]},{"id":"sentence-14","text":"これは一般論です。","start":67.75,"end":69.384,"readings":[{"word":"一般","reading":"いっぱん","offset":3},{"word":"論","reading":"ろん","offset":5}]},{"id":"sentence-15","text":"一般的にこういうやつってこうだよねという、ま、いわゆる社会学のようなものですから。","start":69.384,"end":76.83,"readings":[{"word":"一般","reading":"いっぱん","offset":0},{"word":"的","reading":"てき","offset":2},{"word":"社会","reading":"しゃかい","offset":27},{"word":"学","reading":"がく","offset":29}]},{"id":"sentence-16","text":"だ、ただ社会学でもない。","start":76.83,"end":79.009,"readings":[{"word":"社会","reading":"しゃかい","offset":4},{"word":"学","reading":"がく","offset":6}]},{"id":"sentence-17","text":"ま、その理由は僕が全く社会学的なアプローチが分からないし、えー、ボキャブラリーも足りないし、知識も足りない。","start":79.009,"end":88.816,"readings":[{"word":"理由","reading":"りゆう","offset":4},{"word":"僕","reading":"ぼく","offset":7},{"word":"全く","reading":"まったく","offset":9},{"word":"社会","reading":"しゃかい","offset":11},{"word":"学","reading":"がく","offset":13},{"word":"的","reading":"てき","offset":14},{"word":"分から","reading":"わから","offset":22},{"word":"足り","reading":"たり","offset":40},{"word":"知識","reading":"ちしき","offset":46},{"word":"足り","reading":"たり","offset":49}]},{"id":"sentence-18","text":"いわゆるバカが、バカな日本語の先生が話すただの日本語の","start":88.816,"end":93.72,"readings":[{"word":"日本語","reading":"にほんご","offset":11},{"word":"先生","reading":"せんせい","offset":15},{"word":"話す","reading":"はなす","offset":18},{"word":"日本語","reading":"にほんご","offset":23}]},{"id":"sentence-19","text":"リソースということで、ま、あの知識はね、いや、バカな日本語の先生じゃない。","start":93.72,"end":99.159,"readings":[{"word":"知識","reading":"ちしき","offset":15},{"word":"日本語","reading":"にほんご","offset":26},{"word":"先生","reading":"せんせい","offset":30}]},{"id":"sentence-20","text":"ちょっと待てよ。","start":99.159,"end":100.439,"readings":[{"word":"待て","reading":"まて","offset":4}]},{"id":"sentence-21","text":"ちょっと待てよ。","start":100.439,"end":101.719,"readings":[{"word":"待て","reading":"まて","offset":4}]},{"id":"sentence-22","text":"バカな日本語の先生とは何事だ。","start":101.719,"end":104.119,"readings":[{"word":"日本語","reading":"にほんご","offset":3},{"word":"先生","reading":"せんせい","offset":7},{"word":"何事","reading":"なにごと","offset":11}]},{"id":"sentence-23","text":"そんなことを言うんじゃないですよ、僕に。","start":104.119,"end":107.319,"readings":[{"word":"言う","reading":"いう","offset":6},{"word":"僕","reading":"ぼく","offset":17}]},{"id":"sentence-24","text":"失礼だな。","start":107.319,"end":108.119,"readings":[{"word":"失礼","reading":"しつれい","offset":0}]},{"id":"sentence-25","text":"というわけで、ま、普通に話したいと思います。","start":108.119,"end":111.796,"readings":[{"word":"普通","reading":"ふつう","offset":9},{"word":"話し","reading":"はなし","offset":12},{"word":"思い","reading":"おもい","offset":17}]},{"id":"sentence-26","text":"あのね、えっと、コーヒーを今日は2杯飲んで、ま、元気なんですが、ちょっとうん、ちょっとイライラする気持ちがありますね。","start":111.796,"end":121.656,"readings":[{"word":"今日","reading":"きょう","offset":13},{"word":"杯","reading":"はい","offset":17},{"word":"飲ん","reading":"のん","offset":18},{"word":"元気","reading":"げんき","offset":24},{"word":"気持ち","reading":"きもち","offset":49}]},{"id":"sentence-27","text":"分からない理由は分かりません。","start":121.656,"end":124.163,"readings":[{"word":"分から","reading":"わから","offset":0},{"word":"理由","reading":"りゆう","offset":5},{"word":"分かり","reading":"わかり","offset":8}]},{"id":"sentence-28","text":"だから文句っぽい言い方で話したいと思います。","start":124.163,"end":127.84,"readings":[{"word":"文句","reading":"もんく","offset":3},{"word":"言い方","reading":"いいかた","offset":8},{"word":"話し","reading":"はなし","offset":12},{"word":"思い","reading":"おもい","offset":17}]},{"id":"sentence-29","text":"ちょっとイライラしてる。","start":127.84,"end":129.846,"readings":[]},{"id":"sentence-30","text":"なんでわからない。","start":129.846,"end":131.35,"readings":[]},{"id":"sentence-31","text":"天気が悪いから。","start":131.35,"end":132.687,"readings":[{"word":"天気","reading":"てんき","offset":0},{"word":"悪い","reading":"わるい","offset":3}]},{"id":"sentence-32","text":"それとも疲れてるから。","start":132.687,"end":134.525,"readings":[{"word":"疲れ","reading":"つかれ","offset":4}]},{"id":"sentence-33","text":"疲れてないんですよね。","start":134.525,"end":136.364,"readings":[{"word":"疲れ","reading":"つかれ","offset":0}]},{"id":"sentence-34","text":"疲れてないんですよ。","start":136.364,"end":138.035,"readings":[{"word":"疲れ","reading":"つかれ","offset":0}]},{"id":"sentence-35","text":"元気なんですよ。","start":138.035,"end":139.372,"readings":[{"word":"元気","reading":"げんき","offset":0}]},{"id":"sentence-36","text":"元気すぎるんですよ。","start":139.372,"end":141.043,"readings":[{"word":"元気","reading":"げんき","offset":0}]},{"id":"sentence-37","text":"天気すぎるけど天気が悪いから散歩に行けない。","start":141.043,"end":144.72,"readings":[{"word":"天気","reading":"てんき","offset":0},{"word":"天気","reading":"てんき","offset":7},{"word":"悪い","reading":"わるい","offset":10},{"word":"散歩","reading":"さんぽ","offset":14},{"word":"行け","reading":"いけ","offset":17}]},{"id":"sentence-38","text":"まるで23日ずっと家の中にいるボーダーコリーンみたいな状態になってるわけですよね。","start":144.72,"end":151.822,"readings":[{"word":"日","reading":"にち","offset":5},{"word":"家","reading":"いえ","offset":9},{"word":"中","reading":"なか","offset":11},{"word":"状態","reading":"じょうたい","offset":27}]},{"id":"sentence-39","text":"このエネルギーをどうすればいいんだというね、もう家の中でぐるぐるぐるぐる自分の尻尾を追いかけて回ってるようなボーダーコリーそんな感じです。","start":151.822,"end":163.775,"readings":[{"word":"家","reading":"いえ","offset":24},{"word":"中","reading":"なか","offset":26},{"word":"自分","reading":"じぶん","offset":36},{"word":"尻尾","reading":"しっぽ","offset":39},{"word":"追いかけ","reading":"おいかけ","offset":42},{"word":"回っ","reading":"まわっ","offset":47},{"word":"感じ","reading":"かんじ","offset":64}]},{"id":"sentence-40","text":"ま、あれは結構精神精神的な問題ですよね。","start":163.775,"end":167.239,"readings":[{"word":"結構","reading":"けっこう","offset":5},{"word":"精神","reading":"せいしん","offset":7},{"word":"精神","reading":"せいしん","offset":9},{"word":"的","reading":"てき","offset":11},{"word":"問題","reading":"もんだい","offset":13}]},{"id":"sentence-41","text":"あの、犬が尻尾を追いかけるっていうね。","start":167.239,"end":170.36,"readings":[{"word":"犬","reading":"いぬ","offset":3},{"word":"尻尾","reading":"しっぽ","offset":5},{"word":"追いかける","reading":"おいかける","offset":8}]},{"id":"sentence-42","text":"あれ結構やばいらしいですね。","start":170.36,"end":172.655,"readings":[{"word":"結構","reading":"けっこう","offset":2}]},{"id":"sentence-43","text":"ストレスが大きすぎると。","start":172.655,"end":174.622,"readings":[{"word":"大き","reading":"おおき","offset":5}]},{"id":"sentence-44","text":"で、僕も今そういう状態で、ま、文句言うわけですけど、これはあくまで自分のお尻を追いかけてぐるぐる回ってる俺というわけで、ま、あの、誰に対して怒ってるわけでもありませんね。","start":174.622,"end":188.554,"readings":[{"word":"僕","reading":"ぼく","offset":2},{"word":"今","reading":"いま","offset":4},{"word":"状態","reading":"じょうたい","offset":9},{"word":"文句","reading":"もんく","offset":15},{"word":"言う","reading":"いう","offset":17},{"word":"自分","reading":"じぶん","offset":33},{"word":"尻","reading":"しり","offset":37},{"word":"追いかけ","reading":"おいかけ","offset":39},{"word":"回っ","reading":"まわっ","offset":48},{"word":"俺","reading":"おれ","offset":52},{"word":"誰","reading":"だれ","offset":65},{"word":"に対して","reading":"にたいして","offset":66},{"word":"怒っ","reading":"おこっ","offset":70}]},{"id":"sentence-45","text":"ま、今日はちょっと浅いやつについて話そうと思います。","start":188.554,"end":192.815,"readings":[{"word":"今日","reading":"きょう","offset":2},{"word":"浅い","reading":"あさい","offset":9},{"word":"話そ","reading":"はなそ","offset":17},{"word":"思い","reading":"おもい","offset":21}]},{"id":"sentence-46","text":"ま、皆さんが誰かと会ってとか、ま、話してる時、ま、友達の場合は別に浅くてもいいんですけど、僕の友達のとやとかも結構浅いし、ただ愛すべき浅さがあるんで、もしくはあの意図的な浅さが","start":192.815,"end":207.239,"readings":[{"word":"皆さん","reading":"みなさん","offset":2},{"word":"誰","reading":"だれ","offset":6},{"word":"会っ","reading":"あっ","offset":9},{"word":"話し","reading":"はなし","offset":17},{"word":"時","reading":"とき","offset":21},{"word":"友達","reading":"ともだち","offset":25},{"word":"場合","reading":"ばあい","offset":28},{"word":"別に","reading":"べつに","offset":31},{"word":"浅く","reading":"あさく","offset":33},{"word":"僕","reading":"ぼく","offset":45},{"word":"友達","reading":"ともだち","offset":47},{"word":"結構","reading":"けっこう","offset":55},{"word":"浅い","reading":"あさい","offset":57},{"word":"愛す","reading":"あいす","offset":63},{"word":"浅","reading":"あさ","offset":67},{"word":"意図","reading":"いと","offset":81},{"word":"的","reading":"てき","offset":83},{"word":"浅","reading":"あさ","offset":85}]},{"id":"sentence-47","text":"あるんで、あのあいつはこうものすごくできるやつかもしれない。","start":207.239,"end":212.859,"readings":[]},{"id":"sentence-48","text":"でも、あの、ま、知らない人とか、ま、初めて話す人とか、ま、あってなんか汗せえなこいつと思う。","start":212.859,"end":221.477,"readings":[{"word":"知ら","reading":"しら","offset":8},{"word":"人","reading":"ひと","offset":12},{"word":"初めて","reading":"はじめて","offset":18},{"word":"話す","reading":"はなす","offset":21},{"word":"人","reading":"ひと","offset":23},{"word":"汗せ","reading":"あせせ","offset":35},{"word":"思う","reading":"おもう","offset":43}]},{"id":"sentence-49","text":"ま、その人に実際あった時はあんまり思わないかもしれないけど、ま、例えばYouTubeとかで話を聞いて浅いな、この人って思うことってないですか?","start":221.477,"end":234.777,"readings":[{"word":"人","reading":"ひと","offset":4},{"word":"実際","reading":"じっさい","offset":6},{"word":"時","reading":"とき","offset":11},{"word":"思わ","reading":"おもわ","offset":17},{"word":"例えば","reading":"たとえば","offset":32},{"word":"話","reading":"はなし","offset":45},{"word":"聞い","reading":"きい","offset":47},{"word":"浅い","reading":"あさい","offset":50},{"word":"人","reading":"ひと","offset":56},{"word":"思う","reading":"おもう","offset":59}]},{"id":"sentence-50","text":"ありますよね、もちろん。","start":234.777,"end":237.026,"readings":[]},{"id":"sentence-51","text":"で、どういう時にそういう風に感じてしまうのだろうかと僕はちょっと考えてみました。","start":237.026,"end":244.519,"readings":[{"word":"時","reading":"とき","offset":6},{"word":"風","reading":"かぜ","offset":12},{"word":"感じ","reading":"かんじ","offset":14},{"word":"僕","reading":"ぼく","offset":26},{"word":"考え","reading":"かんがえ","offset":32}]},{"id":"sentence-52","text":"え、それについて今日話したいと思います。","start":244.519,"end":247.959,"readings":[{"word":"今日","reading":"きょう","offset":8},{"word":"話し","reading":"はなし","offset":10},{"word":"思い","reading":"おもい","offset":15}]},{"id":"sentence-53","text":"浅い、何が浅いんだと。","start":247.959,"end":249.852,"readings":[{"word":"浅い","reading":"あさい","offset":0},{"word":"何","reading":"なに","offset":3},{"word":"浅い","reading":"あさい","offset":5}]},{"id":"sentence-54","text":"なんでこの人の考えが浅いのかとな、どう、どういうところで僕たちはそれを意識するんだろうかと。","start":249.852,"end":257.765,"readings":[{"word":"人","reading":"ひと","offset":5},{"word":"考え","reading":"かんがえ","offset":7},{"word":"浅い","reading":"あさい","offset":10},{"word":"僕","reading":"ぼく","offset":28},{"word":"意識","reading":"いしき","offset":35}]},{"id":"sentence-55","text":"あの、おそらくそれはまず大事なことが視野が狭い。","start":257.765,"end":261.893,"readings":[{"word":"大事","reading":"だいじ","offset":12},{"word":"視野","reading":"しや","offset":18},{"word":"狭い","reading":"せまい","offset":21}]},{"id":"sentence-56","text":"で、視野が狭いというのはどういうことかと言うと、ま、基本的に全ての人は、ま、自分の視野があるじゃないですか。","start":261.893,"end":271.182,"readings":[{"word":"視野","reading":"しや","offset":2},{"word":"狭い","reading":"せまい","offset":5},{"word":"言う","reading":"いう","offset":20},{"word":"基本","reading":"きほん","offset":26},{"word":"的","reading":"てき","offset":28},{"word":"全て","reading":"すべて","offset":30},{"word":"人","reading":"ひと","offset":33},{"word":"自分","reading":"じぶん","offset":38},{"word":"視野","reading":"しや","offset":41}]},{"id":"sentence-57","text":"自分というね。","start":271.182,"end":272.387,"readings":[{"word":"自分","reading":"じぶん","offset":0}]},{"id":"sentence-58","text":"で、自分の視野でしか話していないという。","start":272.387,"end":275.827,"readings":[{"word":"自分","reading":"じぶん","offset":2},{"word":"視野","reading":"しや","offset":5},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-59","text":"ここにまず浅さが当てます。","start":275.827,"end":278.063,"readings":[{"word":"浅","reading":"あさ","offset":5},{"word":"当て","reading":"あて","offset":8}]},{"id":"sentence-60","text":"自分の話。","start":278.063,"end":278.923,"readings":[{"word":"自分","reading":"じぶん","offset":0},{"word":"話","reading":"はなし","offset":3}]},{"id":"sentence-61","text":"ま、自分の話でもいいんですよ。","start":278.923,"end":281.504,"readings":[{"word":"自分","reading":"じぶん","offset":2},{"word":"話","reading":"はなし","offset":5}]},{"id":"sentence-62","text":"自分の話でもいい","start":281.504,"end":282.88,"readings":[{"word":"自分","reading":"じぶん","offset":0},{"word":"話","reading":"はなし","offset":3}]},{"id":"sentence-63","text":"けど、自分の目から見える感じ。","start":282.88,"end":285.722,"readings":[{"word":"自分","reading":"じぶん","offset":3},{"word":"目","reading":"め","offset":6},{"word":"見える","reading":"みえる","offset":9},{"word":"感じ","reading":"かんじ","offset":12}]},{"id":"sentence-64","text":"自分のあの視点ですよね。","start":285.722,"end":287.995,"readings":[{"word":"自分","reading":"じぶん","offset":0},{"word":"視点","reading":"してん","offset":5}]},{"id":"sentence-65","text":"いわゆる自分の、ま、そういうのはよく半径1m、半径2mとか言いますよね。","start":287.995,"end":294.816,"readings":[{"word":"自分","reading":"じぶん","offset":4},{"word":"半径","reading":"はんけい","offset":18},{"word":"半径","reading":"はんけい","offset":23},{"word":"言い","reading":"いい","offset":29}]},{"id":"sentence-66","text":"その自分の周りの円ですね。","start":294.816,"end":297.278,"readings":[{"word":"自分","reading":"じぶん","offset":2},{"word":"周り","reading":"まわり","offset":5},{"word":"円","reading":"えん","offset":8}]},{"id":"sentence-67","text":"自分の周りの円しか見えてない。","start":297.278,"end":300.12,"readings":[{"word":"自分","reading":"じぶん","offset":0},{"word":"周り","reading":"まわり","offset":3},{"word":"円","reading":"えん","offset":6},{"word":"見え","reading":"みえ","offset":9}]},{"id":"sentence-68","text":"そして自分からの自分の目で見える角度からしか見えてないということ。","start":300.12,"end":306.372,"readings":[{"word":"自分","reading":"じぶん","offset":3},{"word":"自分","reading":"じぶん","offset":8},{"word":"目","reading":"め","offset":11},{"word":"見える","reading":"みえる","offset":13},{"word":"角度","reading":"かくど","offset":16},{"word":"見え","reading":"みえ","offset":22}]},{"id":"sentence-69","text":"ま、いわゆる自分の話しかしてないということです。","start":306.372,"end":310.919,"readings":[{"word":"自分","reading":"じぶん","offset":6},{"word":"話","reading":"はなし","offset":9}]},{"id":"sentence-70","text":"で、さらに言えば非常に現実的な話しかしてない。","start":310.919,"end":314.649,"readings":[{"word":"言え","reading":"いえ","offset":5},{"word":"非常","reading":"ひじょう","offset":8},{"word":"現実","reading":"げんじつ","offset":11},{"word":"的","reading":"てき","offset":13},{"word":"話","reading":"はなし","offset":15}]},{"id":"sentence-71","text":"え、今日朝起きて、え、トイレに行ってコーヒー飲んで、それは俺、俺の話し方だと思いますよね。","start":314.649,"end":321.947,"readings":[{"word":"今日","reading":"きょう","offset":2},{"word":"朝","reading":"あさ","offset":4},{"word":"起き","reading":"おき","offset":5},{"word":"行っ","reading":"いっ","offset":15},{"word":"飲ん","reading":"のん","offset":22},{"word":"俺","reading":"おれ","offset":29},{"word":"俺","reading":"おれ","offset":31},{"word":"話し方","reading":"はなしかた","offset":33},{"word":"思い","reading":"おもい","offset":38}]},{"id":"sentence-72","text":"ま、でもこれは、ま、日本語学習のためにね、何回も何回も言ってるけど基本的にそんなやついないでしょ。","start":321.947,"end":329.894,"readings":[{"word":"日本語","reading":"にほんご","offset":10},{"word":"学習","reading":"がくしゅう","offset":13},{"word":"何","reading":"なん","offset":21},{"word":"回","reading":"かい","offset":22},{"word":"何","reading":"なん","offset":24},{"word":"回","reading":"かい","offset":25},{"word":"言っ","reading":"いっ","offset":27},{"word":"基本","reading":"きほん","offset":33},{"word":"的","reading":"てき","offset":35}]},{"id":"sentence-73","text":"あの、ま、友達とか、ま、知り合いとかとあって、ま、あとはコンテンツとしてね、日本語学習コンテンツってかなりあの意図的に簡単に作られてることが多いので、ま、そういう話し方をする人も多いですけどね。","start":329.894,"end":345.626,"readings":[{"word":"友達","reading":"ともだち","offset":5},{"word":"知り合い","reading":"しりあい","offset":12},{"word":"日本語","reading":"にほんご","offset":38},{"word":"学習","reading":"がくしゅう","offset":41},{"word":"意図","reading":"いと","offset":55},{"word":"的","reading":"てき","offset":57},{"word":"簡単","reading":"かんたん","offset":59},{"word":"作ら","reading":"つくら","offset":62},{"word":"多い","reading":"おおい","offset":70},{"word":"話し方","reading":"はなしかた","offset":81},{"word":"人","reading":"ひと","offset":87},{"word":"多い","reading":"おおい","offset":89}]},{"id":"sentence-74","text":"はい。","start":345.626,"end":346.112,"readings":[]},{"id":"sentence-75","text":"今日は、あ、皆さんこんにちは。","start":346.112,"end":348.545,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"皆さん","reading":"みなさん","offset":6}]},{"id":"sentence-76","text":"今日私は朝起き","start":348.545,"end":349.68,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"私","reading":"わたし","offset":2},{"word":"朝起き","reading":"あさおき","offset":4}]},{"id":"sentence-77","text":"て、えー、まずあのトイレに行ってうんこしましたみたいなことをわざわざ言わなきゃいけないの僕たちは。","start":349.68,"end":358.132,"readings":[{"word":"行っ","reading":"いっ","offset":13},{"word":"言わ","reading":"いわ","offset":34},{"word":"僕","reading":"ぼく","offset":44}]},{"id":"sentence-78","text":"なぜかと言うと、全ては学習者のためだからね。","start":358.132,"end":361.927,"readings":[{"word":"言う","reading":"いう","offset":4},{"word":"全て","reading":"すべて","offset":8},{"word":"学習","reading":"がくしゅう","offset":11},{"word":"者","reading":"しゃ","offset":13}]},{"id":"sentence-79","text":"全ては学習者のためなんで、あえてあの子供っぽい話し方をしたりするわけですよ、人々は。","start":361.927,"end":369.171,"readings":[{"word":"全て","reading":"すべて","offset":0},{"word":"学習","reading":"がくしゅう","offset":3},{"word":"者","reading":"しゃ","offset":5},{"word":"子供","reading":"こども","offset":18},{"word":"話し方","reading":"はなしかた","offset":23},{"word":"人々","reading":"ひとびと","offset":38}]},{"id":"sentence-80","text":"僕はしないね。","start":369.171,"end":370.379,"readings":[{"word":"僕","reading":"ぼく","offset":0}]},{"id":"sentence-81","text":"僕はしないね。","start":370.379,"end":371.586,"readings":[{"word":"僕","reading":"ぼく","offset":0}]},{"id":"sentence-82","text":"僕はもっとかっこよく言うからね。","start":371.586,"end":374.346,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"言う","reading":"いう","offset":10}]},{"id":"sentence-83","text":"俺朝起きてトイレってあの大きい方ね、結構大きかったから、ま、2回に分けてやったんだけどみたいにちょっとちょっとなんて言うの?","start":374.346,"end":385.04,"readings":[{"word":"俺","reading":"おれ","offset":0},{"word":"朝","reading":"あさ","offset":1},{"word":"起き","reading":"おき","offset":2},{"word":"大きい","reading":"おおきい","offset":12},{"word":"方","reading":"ほう","offset":15},{"word":"結構","reading":"けっこう","offset":18},{"word":"大きかっ","reading":"おおきかっ","offset":20},{"word":"回","reading":"かい","offset":31},{"word":"分け","reading":"わけ","offset":33},{"word":"言う","reading":"いう","offset":58}]},{"id":"sentence-84","text":"少し想像力が必要な話し方をするんですけど、ま、普通の人はね、私は","start":385.04,"end":390.56,"readings":[{"word":"少し","reading":"すこし","offset":0},{"word":"想像","reading":"そうぞう","offset":2},{"word":"力","reading":"りょく","offset":4},{"word":"必要","reading":"ひつよう","offset":6},{"word":"話し方","reading":"はなしかた","offset":9},{"word":"普通","reading":"ふつう","offset":23},{"word":"人","reading":"ひと","offset":26},{"word":"私","reading":"わたし","offset":30}]},{"id":"sentence-85","text":"うんこしましたみたいに言っちゃうわけですよ。","start":390.56,"end":395.015,"readings":[{"word":"言っ","reading":"いっ","offset":11}]},{"id":"sentence-86","text":"はい。","start":395.015,"end":395.622,"readings":[]},{"id":"sentence-87","text":"まあまあまあまあとにかくで、あの、半径1m以内にうんこして、で、まあ、トイレから出て、で、ま、あの、ま、実はこういうことが今日起こりましたみたいな話をする時にやっぱり自分の自分からの視点しかないわけ。","start":395.622,"end":415.871,"readings":[{"word":"半径","reading":"はんけい","offset":17},{"word":"以内","reading":"いない","offset":21},{"word":"出","reading":"で","offset":40},{"word":"実は","reading":"じつは","offset":52},{"word":"今日","reading":"きょう","offset":61},{"word":"起こり","reading":"おこり","offset":63},{"word":"話","reading":"はなし","offset":73},{"word":"時","reading":"とき","offset":77},{"word":"自分","reading":"じぶん","offset":83},{"word":"自分","reading":"じぶん","offset":86},{"word":"視点","reading":"してん","offset":91}]},{"id":"sentence-88","text":"そして現実的な話だけね、現実的な話だけをすると浅いですよ。","start":415.871,"end":421.743,"readings":[{"word":"現実","reading":"げんじつ","offset":3},{"word":"的","reading":"てき","offset":5},{"word":"話","reading":"はなし","offset":7},{"word":"現実","reading":"げんじつ","offset":12},{"word":"的","reading":"てき","offset":14},{"word":"話","reading":"はなし","offset":16},{"word":"浅い","reading":"あさい","offset":23}]},{"id":"sentence-89","text":"はい。","start":421.743,"end":422.351,"readings":[]},{"id":"sentence-90","text":"やっぱり深くなるためにはもう少し想像力を使ってそして自分だけじゃなくていわゆる人類とは私たち人間とは我々はみたいな話になるともうちょっと","start":422.351,"end":436.12,"readings":[{"word":"深く","reading":"ふかく","offset":4},{"word":"もう少し","reading":"もうすこし","offset":12},{"word":"想像","reading":"そうぞう","offset":16},{"word":"力","reading":"りょく","offset":18},{"word":"使っ","reading":"つかっ","offset":20},{"word":"自分","reading":"じぶん","offset":26},{"word":"人類","reading":"じんるい","offset":39},{"word":"私","reading":"わたし","offset":43},{"word":"人間","reading":"にんげん","offset":46},{"word":"我々","reading":"われわれ","offset":50},{"word":"話","reading":"はなし","offset":57}]},{"id":"sentence-91","text":"深みが出ると。","start":436.12,"end":437.349,"readings":[{"word":"深み","reading":"ふかみ","offset":0},{"word":"出る","reading":"でる","offset":3}]},{"id":"sentence-92","text":"そして、え、今だけではなくやっぱり過去そして未来も同時に考えなければいけない。","start":437.349,"end":444.193,"readings":[{"word":"今","reading":"いま","offset":6},{"word":"過去","reading":"かこ","offset":17},{"word":"未来","reading":"みらい","offset":22},{"word":"同時に","reading":"どうじに","offset":25},{"word":"考え","reading":"かんがえ","offset":28}]},{"id":"sentence-93","text":"過去というのは、ま、少なくとも50万年前ぐらいまで。","start":444.193,"end":448.756,"readings":[{"word":"過去","reading":"かこ","offset":0},{"word":"少なくとも","reading":"すくなくとも","offset":10},{"word":"万","reading":"まん","offset":17},{"word":"年","reading":"ねん","offset":18},{"word":"前","reading":"まえ","offset":19}]},{"id":"sentence-94","text":"未来というのも、ま、少なくとも2000年後ぐらいは考えるべきですね。","start":448.756,"end":454.723,"readings":[{"word":"未来","reading":"みらい","offset":0},{"word":"少なくとも","reading":"すくなくとも","offset":10},{"word":"年","reading":"ねん","offset":19},{"word":"後","reading":"ご","offset":20},{"word":"考える","reading":"かんがえる","offset":25}]},{"id":"sentence-95","text":"2000年だからね。","start":454.723,"end":456.478,"readings":[{"word":"年","reading":"ねん","offset":4}]},{"id":"sentence-96","text":"高々2000年だからそんなに難しくはありません。","start":456.478,"end":460.69,"readings":[{"word":"高々","reading":"たかだか","offset":0},{"word":"年","reading":"ねん","offset":6},{"word":"難しく","reading":"むずかしく","offset":14}]},{"id":"sentence-97","text":"なぜ50万年後を考えないかというと50万年後人間が生きてるちょっとそを想像するのはかなり難しいな。","start":460.69,"end":469.29,"readings":[{"word":"万","reading":"まん","offset":4},{"word":"年","reading":"ねん","offset":5},{"word":"後","reading":"ご","offset":6},{"word":"考え","reading":"かんがえ","offset":8},{"word":"万","reading":"まん","offset":19},{"word":"年","reading":"ねん","offset":20},{"word":"後","reading":"ご","offset":21},{"word":"人間","reading":"にんげん","offset":22},{"word":"生き","reading":"いき","offset":25},{"word":"想像","reading":"そうぞう","offset":35},{"word":"難しい","reading":"むずかしい","offset":44}]},{"id":"sentence-98","text":"それは結構怖いことを言ってますね、僕は。","start":469.29,"end":472.8,"readings":[{"word":"結構","reading":"けっこう","offset":3},{"word":"怖い","reading":"こわい","offset":5},{"word":"言っ","reading":"いっ","offset":10},{"word":"僕","reading":"ぼく","offset":17}]},{"id":"sentence-99","text":"え、数万年前の人間の話はできたとしても数万年後の人間の話ができ","start":472.8,"end":478.24,"readings":[{"word":"数","reading":"すう","offset":2},{"word":"万","reading":"まん","offset":3},{"word":"年","reading":"ねん","offset":4},{"word":"前","reading":"まえ","offset":5},{"word":"人間","reading":"にんげん","offset":7},{"word":"話","reading":"はなし","offset":10},{"word":"数","reading":"すう","offset":19},{"word":"万","reading":"まん","offset":20},{"word":"年","reading":"ねん","offset":21},{"word":"後","reading":"ご","offset":22},{"word":"人間","reading":"にんげん","offset":24},{"word":"話","reading":"はなし","offset":27}]},{"id":"sentence-100","text":"ない可能性があると恐ろしいことです。","start":478.24,"end":482.72,"readings":[{"word":"可能","reading":"かのう","offset":2},{"word":"性","reading":"せい","offset":4},{"word":"恐ろしい","reading":"おそろしい","offset":9}]},{"id":"sentence-101","text":"人間は生きられるのでしょうかね。","start":482.72,"end":486,"readings":[{"word":"人間","reading":"にんげん","offset":0},{"word":"生き","reading":"いき","offset":3}]},{"id":"sentence-102","text":"これからずっと、ま、それはずっとは無理かもしれないけどね。","start":486,"end":491.945,"readings":[{"word":"無理","reading":"むり","offset":17}]},{"id":"sentence-103","text":"うん。","start":491.945,"end":492.56,"readings":[]},{"id":"sentence-104","text":"今の、今の感じじゃ無理ですよね。","start":492.56,"end":495.84,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"今","reading":"いま","offset":3},{"word":"感じ","reading":"かんじ","offset":5},{"word":"無理","reading":"むり","offset":9}]},{"id":"sentence-105","text":"で、えー、他にどういうことか、ど、どういうのが浅いかというと、いわゆる冗談が、冗談を言わないやは浅いですよね。","start":495.84,"end":505.451,"readings":[{"word":"他","reading":"た","offset":5},{"word":"浅い","reading":"あさい","offset":23},{"word":"冗談","reading":"じょうだん","offset":35},{"word":"冗談","reading":"じょうだん","offset":39},{"word":"言わ","reading":"いわ","offset":42},{"word":"浅い","reading":"あさい","offset":48}]},{"id":"sentence-106","text":"どう考えても冗談を言わないやは浅いでしょ。","start":505.451,"end":509.12,"readings":[{"word":"考え","reading":"かんがえ","offset":2},{"word":"冗談","reading":"じょうだん","offset":6},{"word":"言わ","reading":"いわ","offset":9},{"word":"浅い","reading":"あさい","offset":15}]},{"id":"sentence-107","text":"冗談が言えないとダメですよね。","start":509.12,"end":511.579,"readings":[{"word":"冗談","reading":"じょうだん","offset":0},{"word":"言え","reading":"いえ","offset":3}]},{"id":"sentence-108","text":"僕の子供だって言いますよ、よく。","start":511.579,"end":514.202,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"子供","reading":"こども","offset":2},{"word":"言い","reading":"いい","offset":7}]},{"id":"sentence-109","text":"冗談、冗談、マイケル冗談とかね、ちゃんとそうやって冗談言えるんですよ。","start":514.202,"end":519.939,"readings":[{"word":"冗談","reading":"じょうだん","offset":0},{"word":"冗談","reading":"じょうだん","offset":3},{"word":"冗談","reading":"じょうだん","offset":10},{"word":"冗談","reading":"じょうだん","offset":25},{"word":"言える","reading":"いえる","offset":27}]},{"id":"sentence-110","text":"で、ちゃんとそうやって冗談言えないとダめですよ。","start":519.939,"end":523.873,"readings":[{"word":"冗談","reading":"じょうだん","offset":11},{"word":"言え","reading":"いえ","offset":13}]},{"id":"sentence-111","text":"で、ま、冗談冗談マイケルジーダンで僕、僕の子供が言うから、ま、それはお前な浅いぞと。","start":523.873,"end":530.758,"readings":[{"word":"冗談","reading":"じょうだん","offset":4},{"word":"冗談","reading":"じょうだん","offset":6},{"word":"僕","reading":"ぼく","offset":17},{"word":"僕","reading":"ぼく","offset":19},{"word":"子供","reading":"こども","offset":21},{"word":"言う","reading":"いう","offset":24},{"word":"お前","reading":"おまえ","offset":34},{"word":"浅い","reading":"あさい","offset":37}]},{"id":"sentence-112","text":"まだまだ。","start":530.758,"end":531.577,"readings":[]},{"id":"sentence-113","text":"え、じゃあパピなんて言うの?","start":531.577,"end":533.872,"readings":[{"word":"言う","reading":"いう","offset":10}]},{"id":"sentence-114","text":"冗談冗談マイケルジャクソン。","start":533.872,"end":536.167,"readings":[{"word":"冗談","reading":"じょうだん","offset":0},{"word":"冗談","reading":"じょうだん","offset":2}]},{"id":"sentence-115","text":"ま、これぐらいになるとね、もうあのシールレアリズムの世界になってきます。","start":536.167,"end":542.068,"readings":[{"word":"世界","reading":"せかい","offset":26}]},{"id":"sentence-116","text":"はい。","start":542.068,"end":542.56,"readings":[]},{"id":"sentence-117","text":"冗談、冗談をそのまま言うわけではない。","start":542.56,"end":547.12,"readings":[{"word":"冗談","reading":"じょうだん","offset":0},{"word":"冗談","reading":"じょうだん","offset":3},{"word":"言う","reading":"いう","offset":10}]},{"id":"sentence-118","text":"冗談。","start":547.12,"end":547.795,"readings":[{"word":"冗談","reading":"じょうだん","offset":0}]},{"id":"sentence-119","text":"冗談。","start":547.795,"end":548.47,"readings":[{"word":"冗談","reading":"じょうだん","offset":0}]},{"id":"sentence-120","text":"マイケルジャクソン。","start":548.47,"end":550.72,"readings":[]},{"id":"sentence-121","text":"かなりこう不思議な世界に入ってくる感じがしますよね。","start":550.72,"end":556.186,"readings":[{"word":"不思議","reading":"ふしぎ","offset":5},{"word":"世界","reading":"せかい","offset":9},{"word":"入っ","reading":"はいっ","offset":12},{"word":"感じ","reading":"かんじ","offset":17}]},{"id":"sentence-122","text":"こういうのを聞くと、ま、て先生はやっぱり天才だ。","start":556.186,"end":561.231,"readings":[{"word":"聞く","reading":"きく","offset":6},{"word":"先生","reading":"せんせい","offset":13},{"word":"天才","reading":"てんさい","offset":20}]},{"id":"sentence-123","text":"もしくはて先生は本物のバカだと。","start":561.231,"end":564.595,"readings":[{"word":"先生","reading":"せんせい","offset":5},{"word":"本物","reading":"ほんもの","offset":8}]},{"id":"sentence-124","text":"どちらかしかどちらがどちらかが答えです。","start":564.595,"end":568.799,"readings":[{"word":"答え","reading":"こたえ","offset":15}]},{"id":"sentence-125","text":"せ、先生は本物の天才か本物のバカだと。","start":568.799,"end":572.793,"readings":[{"word":"先生","reading":"せんせい","offset":2},{"word":"本物","reading":"ほんもの","offset":5},{"word":"天才","reading":"てんさい","offset":8},{"word":"本物","reading":"ほんもの","offset":11}]},{"id":"sentence-126","text":"ただ本物の天才は本物のバカとほぼ同じ。","start":572.793,"end":576.787,"readings":[{"word":"本物","reading":"ほんもの","offset":2},{"word":"天才","reading":"てんさい","offset":5},{"word":"本物","reading":"ほんもの","offset":8},{"word":"同じ","reading":"おなじ","offset":16}]},{"id":"sentence-127","text":"ほぼ同じですからね。","start":576.787,"end":578.89,"readings":[{"word":"同じ","reading":"おなじ","offset":2}]},{"id":"sentence-128","text":"そのほぼがどれぐらいなのか。","start":578.89,"end":581.833,"readings":[]},{"id":"sentence-129","text":"そして僕がそのほぼに入るのか入らないのか、ま、それは皆さんが分かると思います。","start":581.833,"end":590.031,"readings":[{"word":"僕","reading":"ぼく","offset":3},{"word":"入る","reading":"はいる","offset":10},{"word":"入ら","reading":"はいら","offset":14},{"word":"皆さん","reading":"みなさん","offset":26},{"word":"分かる","reading":"わかる","offset":30},{"word":"思い","reading":"おもい","offset":34}]},{"id":"sentence-130","text":"はい。","start":590.031,"end":590.662,"readings":[]},{"id":"sentence-131","text":"おそらくほぼほぼのほぼが99%例えば99%の天才と99%のバカは同じという","start":590.662,"end":598.44,"readings":[{"word":"例えば","reading":"たとえば","offset":15},{"word":"天才","reading":"てんさい","offset":22},{"word":"同じ","reading":"おなじ","offset":32}]},{"id":"sentence-132","text":"場合僕は残りの1%でしょうね。","start":598.44,"end":600.985,"readings":[{"word":"場合","reading":"ばあい","offset":0},{"word":"僕","reading":"ぼく","offset":2},{"word":"残り","reading":"のこり","offset":4}]},{"id":"sentence-133","text":"いわゆるただのバカだと。","start":600.985,"end":603.021,"readings":[]},{"id":"sentence-134","text":"ま、自分でそういうのが謙虚、謙虚さというものです。","start":603.021,"end":607.263,"readings":[{"word":"自分","reading":"じぶん","offset":2},{"word":"謙虚","reading":"けんきょ","offset":11},{"word":"謙虚","reading":"けんきょ","offset":14}]},{"id":"sentence-135","text":"はい。","start":607.263,"end":607.772,"readings":[]},{"id":"sentence-136","text":"で、ま、浅い、とにかく浅いやつと話すとイライラしますよね。","start":607.772,"end":612.692,"readings":[{"word":"浅い","reading":"あさい","offset":4},{"word":"浅い","reading":"あさい","offset":11},{"word":"話す","reading":"はなす","offset":16}]},{"id":"sentence-137","text":"浅いやつの話を聞くとイライラするでしょ。","start":612.692,"end":616.085,"readings":[{"word":"浅い","reading":"あさい","offset":0},{"word":"話","reading":"はなし","offset":5},{"word":"聞く","reading":"きく","offset":7}]},{"id":"sentence-138","text":"僕は皆さんが今イライラしてないことを願ってますね。","start":616.085,"end":620.327,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"皆さん","reading":"みなさん","offset":2},{"word":"今","reading":"いま","offset":6},{"word":"願っ","reading":"ねがっ","offset":18}]},{"id":"sentence-139","text":"だけど朝の話を聞くとやっぱイライラする。","start":620.327,"end":623.72,"readings":[{"word":"朝","reading":"あさ","offset":3},{"word":"話","reading":"はなし","offset":5},{"word":"聞く","reading":"きく","offset":7}]},{"id":"sentence-140","text":"本当になんでこんなにイライラするんだろうかと。","start":623.72,"end":626.853,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0}]},{"id":"sentence-141","text":"なんでこんなにつまんねえんだろうかと。","start":626.853,"end":629.441,"readings":[]},{"id":"sentence-142","text":"なんでそんなつまんねえことをその自分で気づいてねえんだろうかと。","start":629.441,"end":633.8,"readings":[{"word":"自分","reading":"じぶん","offset":16},{"word":"気づい","reading":"きづい","offset":19}]},{"id":"sentence-143","text":"ま、そう思うでしょ。","start":633.8,"end":635.276,"readings":[{"word":"思う","reading":"おもう","offset":4}]},{"id":"sentence-144","text":"そう思われたくないですよね。","start":635.276,"end":637.342,"readings":[{"word":"思わ","reading":"おもわ","offset":2}]},{"id":"sentence-145","text":"だからやっぱり不思議なこととか言った方がいいですよね。","start":637.342,"end":641.326,"readings":[{"word":"不思議","reading":"ふしぎ","offset":7},{"word":"言っ","reading":"いっ","offset":15},{"word":"方","reading":"ほう","offset":18}]},{"id":"sentence-146","text":"不思議なこと。","start":641.326,"end":642.359,"readings":[{"word":"不思議","reading":"ふしぎ","offset":0}]},{"id":"sentence-147","text":"ただ不思議すとバカなんですよね。","start":642.359,"end":644.72,"readings":[{"word":"不思議","reading":"ふしぎ","offset":2}]},{"id":"sentence-148","text":"不思議するとなんかなんだこのサイキック野郎はとなっちゃうんで、その辺がやっぱりいわゆる常人普通の人をちゃんと予想得ないといけないわけです。","start":644.72,"end":657.786,"readings":[{"word":"不思議","reading":"ふしぎ","offset":0},{"word":"野郎","reading":"やろう","offset":19},{"word":"辺","reading":"あたり","offset":33},{"word":"常人","reading":"じょうじん","offset":43},{"word":"普通","reading":"ふつう","offset":45},{"word":"人","reading":"ひと","offset":48},{"word":"予想","reading":"よそう","offset":54},{"word":"得","reading":"え","offset":56}]},{"id":"sentence-149","text":"で、話を戻すと1番最初に言ったいわゆるとみたいなやつはいわゆるあいつはね、常人をこう振る舞っている変人なわけですよね。","start":657.786,"end":668.959,"readings":[{"word":"話","reading":"はなし","offset":2},{"word":"戻す","reading":"もどす","offset":4},{"word":"番","reading":"ばん","offset":8},{"word":"最初","reading":"さいしょ","offset":9},{"word":"言っ","reading":"いっ","offset":12},{"word":"常人","reading":"じょうじん","offset":37},{"word":"振る舞っ","reading":"ふるまっ","offset":42},{"word":"変人","reading":"へんじん","offset":49}]},{"id":"sentence-150","text":"一見普通のやつ、一見普通の浅いやつに見える。","start":668.959,"end":672.884,"readings":[{"word":"一見","reading":"いっけん","offset":0},{"word":"普通","reading":"ふつう","offset":2},{"word":"一見","reading":"いっけん","offset":8},{"word":"普通","reading":"ふつう","offset":10},{"word":"浅い","reading":"あさい","offset":13},{"word":"見える","reading":"みえる","offset":18}]},{"id":"sentence-151","text":"ただそれはわざとやってるわけ。","start":672.884,"end":675.56,"readings":[]},{"id":"sentence-152","text":"じゃああいつがいつ深さを見せるのかね。","start":675.56,"end":679.24,"readings":[{"word":"深","reading":"ふか","offset":9},{"word":"見せる","reading":"みせる","offset":12}]},{"id":"sentence-153","text":"僕はそのそれを見たことがありますよ。","start":679.24,"end":682.235,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"見","reading":"み","offset":7}]},{"id":"sentence-154","text":"何度かあいつが黙った時ですね。","start":682.235,"end":684.73,"readings":[{"word":"何","reading":"なん","offset":0},{"word":"度","reading":"ど","offset":1},{"word":"黙っ","reading":"だまっ","offset":7},{"word":"時","reading":"とき","offset":10}]},{"id":"sentence-155","text":"あのなんかベンチとか公園のベンチとかに座ってるじゃないですか。","start":684.73,"end":689.888,"readings":[{"word":"公園","reading":"こうえん","offset":10},{"word":"座っ","reading":"すわっ","offset":19}]},{"id":"sentence-156","text":"一緒にであいつが黙るんですよ。","start":689.888,"end":692.383,"readings":[{"word":"一緒","reading":"いっしょ","offset":0},{"word":"黙る","reading":"だまる","offset":8}]},{"id":"sentence-157","text":"なんか何も言わずになんかこう池とかをこう見つめ始めるわけです。","start":692.383,"end":697.54,"readings":[{"word":"何","reading":"なに","offset":3},{"word":"言わ","reading":"いわ","offset":5},{"word":"池","reading":"いけ","offset":14},{"word":"見つめ","reading":"みつめ","offset":20},{"word":"始める","reading":"はじめる","offset":23}]},{"id":"sentence-158","text":"そん時にあの目の中にこう深さを感じる。","start":697.54,"end":700.701,"readings":[{"word":"時","reading":"じ","offset":2},{"word":"目","reading":"め","offset":6},{"word":"中","reading":"なか","offset":8},{"word":"深","reading":"ふか","offset":12},{"word":"感じる","reading":"かんじる","offset":15}]},{"id":"sentence-159","text":"闇、闇みたいなものをね。","start":700.701,"end":702.698,"readings":[{"word":"闇","reading":"やみ","offset":0},{"word":"闇","reading":"やみ","offset":2}]},{"id":"sentence-160","text":"で、僕はちょっと怖くなる。","start":702.698,"end":704.861,"readings":[{"word":"僕","reading":"ぼく","offset":2},{"word":"怖く","reading":"こわく","offset":8}]},{"id":"sentence-161","text":"なんてやつだこいつはね、ハンターハンターのキルアみキルアでしたっけ?","start":704.861,"end":710.517,"readings":[]},{"id":"sentence-162","text":"キリアですか?","start":710.517,"end":711.682,"readings":[]},{"id":"sentence-163","text":"キリアかな?","start":711.682,"end":712.68,"readings":[]},{"id":"sentence-164","text":"ハンターハンターのキリアみたいななんかこう目がまゴンかゴンの方ですかね?","start":712.68,"end":717.76,"readings":[{"word":"目","reading":"め","offset":21},{"word":"方","reading":"ほう","offset":30}]},{"id":"sentence-165","text":"ハンターハンターのゴンかな?","start":717.76,"end":720.245,"readings":[]},{"id":"sentence-166","text":"なんか闇闇を感じる目みたいなね。","start":720.245,"end":723.085,"readings":[{"word":"闇","reading":"やみ","offset":3},{"word":"闇","reading":"やみ","offset":4},{"word":"感じる","reading":"かんじる","offset":6},{"word":"目","reading":"め","offset":9}]},{"id":"sentence-167","text":"そんな感じがするんです。","start":723.085,"end":725.215,"readings":[{"word":"感じ","reading":"かんじ","offset":3}]},{"id":"sentence-168","text":"一見なんかゴンだってそうですよね。","start":725.215,"end":728.232,"readings":[{"word":"一見","reading":"いっけん","offset":0}]},{"id":"sentence-169","text":"なんか普通の子供みたいに振る舞ってるけど、どう考えてもおかしいですよね。","start":728.232,"end":734.622,"readings":[{"word":"普通","reading":"ふつう","offset":3},{"word":"子供","reading":"こども","offset":6},{"word":"振る舞っ","reading":"ふるまっ","offset":12},{"word":"考え","reading":"かんがえ","offset":23}]},{"id":"sentence-170","text":"めえめめえめ。というわけで、今日も何言ったかよくわかんなくてぐるぐるぐるぐるぐるぐる話を回しただけで、でも皆さんにとってはいいあの常人とかね、変人とかね、新しい言葉を学ぶこともできた。というわけでとても良かったと思います。","start":734.622,"end":754.324,"readings":[{"word":"今日","reading":"きょう","offset":14},{"word":"何","reading":"なに","offset":17},{"word":"言っ","reading":"いっ","offset":18},{"word":"話","reading":"はなし","offset":42},{"word":"回し","reading":"まわし","offset":44},{"word":"皆さん","reading":"みなさん","offset":53},{"word":"常人","reading":"じょうじん","offset":65},{"word":"変人","reading":"へんじん","offset":71},{"word":"新しい","reading":"あたらしい","offset":77},{"word":"言葉","reading":"ことば","offset":80},{"word":"学ぶ","reading":"まなぶ","offset":83},{"word":"良かっ","reading":"よかっ","offset":101},{"word":"思い","reading":"おもい","offset":106}]},{"id":"sentence-171","text":"それではイライラしないでね。","start":754.324,"end":756.809,"readings":[]},{"id":"sentence-172","text":"またね。","start":756.809,"end":757.519,"readings":[]}]}