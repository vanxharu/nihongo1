{"videoId":"_Oi-9tGMxyM","title":"【N5-N4】Ep278 How to make a good relationship with people / Japanese Podcast for Beginners","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"しと日本語ポッドキャスト278初心者ビナーズ元気レベルいい人間関係の作り方","start":0.84,"end":19.32,"readings":[{"word":"日本語","reading":"にほんご","offset":2},{"word":"初心者","reading":"しょしんしゃ","offset":15},{"word":"元気","reading":"げんき","offset":22},{"word":"人間","reading":"にんげん","offset":29},{"word":"関係","reading":"かんけい","offset":31},{"word":"作り方","reading":"つくりかた","offset":34}]},{"id":"sentence-1","text":"皆さん、こんにちは。","start":29.439,"end":31.993,"readings":[{"word":"皆さん","reading":"みなさん","offset":0}]},{"id":"sentence-2","text":"日本語教師のしです。","start":31.993,"end":34.547,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"教師","reading":"きょうし","offset":3}]},{"id":"sentence-3","text":"元気ですか?","start":34.547,"end":36.079,"readings":[{"word":"元気","reading":"げんき","offset":0}]},{"id":"sentence-4","text":"え、今日はいい人間関係の作り方について話したいと思います。","start":36.079,"end":44.44,"readings":[{"word":"今日","reading":"きょう","offset":2},{"word":"人間","reading":"にんげん","offset":7},{"word":"関係","reading":"かんけい","offset":9},{"word":"作り方","reading":"つくりかた","offset":12},{"word":"話し","reading":"はなし","offset":19},{"word":"思い","reading":"おもい","offset":24}]},{"id":"sentence-5","text":"いや、面白いトピックですよね。","start":44.44,"end":48.8,"readings":[{"word":"面白い","reading":"おもしろい","offset":3}]},{"id":"sentence-6","text":"皆さん知っていますか?","start":48.8,"end":51.96,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"知っ","reading":"しっ","offset":3}]},{"id":"sentence-7","text":"あの800人ぐらいの人に80年ぐらいした研究があります。","start":51.96,"end":61.92,"readings":[{"word":"人","reading":"にん","offset":5},{"word":"人","reading":"ひと","offset":10},{"word":"年","reading":"ねん","offset":14},{"word":"研究","reading":"けんきゅう","offset":20}]},{"id":"sentence-8","text":"みんな色々な人生があります。","start":61.92,"end":68.159,"readings":[{"word":"色々","reading":"いろいろ","offset":3},{"word":"人生","reading":"じんせい","offset":6}]},{"id":"sentence-9","text":"色々な仕事、色々な友達、家族があります。","start":68.159,"end":77.24,"readings":[{"word":"色々","reading":"いろいろ","offset":0},{"word":"仕事","reading":"しごと","offset":3},{"word":"色々","reading":"いろいろ","offset":6},{"word":"友達","reading":"ともだち","offset":9},{"word":"家族","reading":"かぞく","offset":12}]},{"id":"sentence-10","text":"この研究で幸せになるために1番必要なことが分かったんですよ。","start":77.24,"end":91.36,"readings":[{"word":"研究","reading":"けんきゅう","offset":2},{"word":"幸せ","reading":"しあわせ","offset":5},{"word":"番","reading":"ばん","offset":14},{"word":"必要","reading":"ひつよう","offset":15},{"word":"分かっ","reading":"わかっ","offset":21}]},{"id":"sentence-11","text":"皆さんは何だと思いますか?","start":91.36,"end":96.799,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"何","reading":"なに","offset":4},{"word":"思い","reading":"おもい","offset":7}]},{"id":"sentence-12","text":"そうなんですよ。","start":97.079,"end":99.6,"readings":[]},{"id":"sentence-13","text":"いい人間関係は幸せに1番大切なことだと分かったんですだからお金があまりなくてもいい人間関係があったら幸せを感じることができるんです。","start":99.6,"end":127.92,"readings":[{"word":"人間","reading":"にんげん","offset":2},{"word":"関係","reading":"かんけい","offset":4},{"word":"幸せ","reading":"しあわせ","offset":7},{"word":"番","reading":"ばん","offset":11},{"word":"大切","reading":"たいせつ","offset":12},{"word":"分かっ","reading":"わかっ","offset":19},{"word":"お金","reading":"おかね","offset":29},{"word":"人間","reading":"にんげん","offset":41},{"word":"関係","reading":"かんけい","offset":43},{"word":"幸せ","reading":"しあわせ","offset":50},{"word":"感じる","reading":"かんじる","offset":53}]},{"id":"sentence-14","text":"団体にお金がたくさんあってもいい人間関係がなかったら幸せを感じることができません。","start":128.119,"end":144.84,"readings":[{"word":"団体","reading":"だんたい","offset":0},{"word":"お金","reading":"おかね","offset":3},{"word":"人間","reading":"にんげん","offset":16},{"word":"関係","reading":"かんけい","offset":18},{"word":"幸せ","reading":"しあわせ","offset":26},{"word":"感じる","reading":"かんじる","offset":29}]},{"id":"sentence-15","text":"皆さんはこの研究についてどう思いますか私は本当にこの研究を見つけた時にあ、本当にそうだなと思いました。","start":145.319,"end":163.959,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"研究","reading":"けんきゅう","offset":6},{"word":"思い","reading":"おもい","offset":14},{"word":"私","reading":"わたし","offset":19},{"word":"本当に","reading":"ほんとうに","offset":21},{"word":"研究","reading":"けんきゅう","offset":26},{"word":"見つけ","reading":"みつけ","offset":29},{"word":"時","reading":"とき","offset":33},{"word":"本当に","reading":"ほんとうに","offset":37},{"word":"思い","reading":"おもい","offset":45}]},{"id":"sentence-16","text":"私たちの悩み、私たちの悩みのほとんどは人間関係ですよね。","start":164.68,"end":176.159,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"悩み","reading":"なやみ","offset":4},{"word":"私","reading":"わたし","offset":7},{"word":"悩み","reading":"なやみ","offset":11},{"word":"人間","reading":"にんげん","offset":19},{"word":"関係","reading":"かんけい","offset":21}]},{"id":"sentence-17","text":"ま、色々な人間関係があります。","start":176.159,"end":181.908,"readings":[{"word":"色々","reading":"いろいろ","offset":2},{"word":"人間","reading":"にんげん","offset":5},{"word":"関係","reading":"かんけい","offset":7}]},{"id":"sentence-18","text":"家族との関係、妻や夫との関係、友達との関係、恋人との関係、会社の同僚との関係。","start":181.908,"end":196.857,"readings":[{"word":"家族","reading":"かぞく","offset":0},{"word":"関係","reading":"かんけい","offset":4},{"word":"妻","reading":"つま","offset":7},{"word":"夫","reading":"おっと","offset":9},{"word":"関係","reading":"かんけい","offset":12},{"word":"友達","reading":"ともだち","offset":15},{"word":"関係","reading":"かんけい","offset":19},{"word":"恋人","reading":"こいびと","offset":22},{"word":"関係","reading":"かんけい","offset":26},{"word":"会社","reading":"かいしゃ","offset":29},{"word":"同僚","reading":"どうりょう","offset":32},{"word":"関係","reading":"かんけい","offset":36}]},{"id":"sentence-19","text":"うん。","start":196.857,"end":198.007,"readings":[]},{"id":"sentence-20","text":"ま、色々ありますね。","start":198.007,"end":201.84,"readings":[{"word":"色々","reading":"いろいろ","offset":2}]},{"id":"sentence-21","text":"どうですか?","start":201.84,"end":204.48,"readings":[]},{"id":"sentence-22","text":"皆さんはみんなといい関係がありますか?","start":204.48,"end":211.239,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"関係","reading":"かんけい","offset":10}]},{"id":"sentence-23","text":"ま、全部完璧な関係は難しいかもしれません。","start":211.239,"end":219.319,"readings":[{"word":"全部","reading":"ぜんぶ","offset":2},{"word":"完璧","reading":"かんぺき","offset":4},{"word":"関係","reading":"かんけい","offset":7},{"word":"難しい","reading":"むずかしい","offset":10}]},{"id":"sentence-24","text":"でもお金をもっと稼ぐよりいい人間関係を作った、たくさん作った方が幸せになれると思います。","start":219.319,"end":235.72,"readings":[{"word":"お金","reading":"おかね","offset":2},{"word":"稼ぐ","reading":"かせぐ","offset":8},{"word":"人間","reading":"にんげん","offset":14},{"word":"関係","reading":"かんけい","offset":16},{"word":"作っ","reading":"つくっ","offset":19},{"word":"作っ","reading":"つくっ","offset":27},{"word":"方","reading":"ほう","offset":30},{"word":"幸せ","reading":"しあわせ","offset":32},{"word":"思い","reading":"おもい","offset":39}]},{"id":"sentence-25","text":"だから私も最近は友達や家族や妻との関係をもっと良くするようにしています。","start":236,"end":251.079,"readings":[{"word":"私","reading":"わたし","offset":3},{"word":"最近","reading":"さいきん","offset":5},{"word":"友達","reading":"ともだち","offset":8},{"word":"家族","reading":"かぞく","offset":11},{"word":"妻","reading":"つま","offset":14},{"word":"関係","reading":"かんけい","offset":17},{"word":"良く","reading":"よく","offset":23}]},{"id":"sentence-26","text":"まず家族との関係ですね。","start":251.519,"end":257.639,"readings":[{"word":"家族","reading":"かぞく","offset":2},{"word":"関係","reading":"かんけい","offset":6}]},{"id":"sentence-27","text":"時々いい家族との関係を気づくのは難しいですよね。","start":257.639,"end":266.24,"readings":[{"word":"時々","reading":"ときどき","offset":0},{"word":"家族","reading":"かぞく","offset":4},{"word":"関係","reading":"かんけい","offset":8},{"word":"気づく","reading":"きづく","offset":11},{"word":"難しい","reading":"むずかしい","offset":16}]},{"id":"sentence-28","text":"でもそうですよ。","start":266.24,"end":269.721,"readings":[]},{"id":"sentence-29","text":"まずあの両親と私の考え方や価値観は本当に違います。","start":269.721,"end":280.6,"readings":[{"word":"両親","reading":"りょうしん","offset":4},{"word":"私","reading":"わたし","offset":7},{"word":"考え方","reading":"かんがえかた","offset":9},{"word":"価値","reading":"かち","offset":13},{"word":"観","reading":"かん","offset":15},{"word":"本当に","reading":"ほんとうに","offset":17},{"word":"違い","reading":"ちがい","offset":20}]},{"id":"sentence-30","text":"前は両親が私の価値観を分かってくれない時に喧嘩をしていました。","start":280.6,"end":291.919,"readings":[{"word":"前","reading":"まえ","offset":0},{"word":"両親","reading":"りょうしん","offset":2},{"word":"私","reading":"わたし","offset":5},{"word":"価値","reading":"かち","offset":7},{"word":"観","reading":"かん","offset":9},{"word":"分かっ","reading":"わかっ","offset":11},{"word":"時","reading":"とき","offset":19},{"word":"喧嘩","reading":"けんか","offset":21}]},{"id":"sentence-31","text":"でも気づきました。","start":291.919,"end":296.16,"readings":[{"word":"気づき","reading":"きづき","offset":2}]},{"id":"sentence-32","text":"いい人間関係を気づきたかったら自分が変わらなければいけないと思います前はいつか私の両親が私と同じ価値観を持ってくれると思っていました。","start":296.16,"end":322.84,"readings":[{"word":"人間","reading":"にんげん","offset":2},{"word":"関係","reading":"かんけい","offset":4},{"word":"気づき","reading":"きづき","offset":7},{"word":"自分","reading":"じぶん","offset":15},{"word":"変わら","reading":"かわら","offset":18},{"word":"思い","reading":"おもい","offset":30},{"word":"前","reading":"まえ","offset":34},{"word":"私","reading":"わたし","offset":39},{"word":"両親","reading":"りょうしん","offset":41},{"word":"私","reading":"わたし","offset":44},{"word":"同じ","reading":"おなじ","offset":46},{"word":"価値","reading":"かち","offset":48},{"word":"観","reading":"かん","offset":50},{"word":"持っ","reading":"もっ","offset":52},{"word":"思っ","reading":"おもっ","offset":59}]},{"id":"sentence-33","text":"でも私はそれを諦めました。","start":323.28,"end":330.039,"readings":[{"word":"私","reading":"わたし","offset":2},{"word":"諦め","reading":"あきらめ","offset":7}]},{"id":"sentence-34","text":"両親は両親の価値観があって、私は私の価値観があります。","start":330.199,"end":340.479,"readings":[{"word":"両親","reading":"りょうしん","offset":0},{"word":"両親","reading":"りょうしん","offset":3},{"word":"価値","reading":"かち","offset":6},{"word":"観","reading":"かん","offset":8},{"word":"私","reading":"わたし","offset":14},{"word":"私","reading":"わたし","offset":16},{"word":"価値","reading":"かち","offset":18},{"word":"観","reading":"かん","offset":20}]},{"id":"sentence-35","text":"だから両親と意見が違ってもいいです。","start":341.12,"end":349.4,"readings":[{"word":"両親","reading":"りょうしん","offset":3},{"word":"意見","reading":"いけん","offset":6},{"word":"違っ","reading":"ちがっ","offset":9}]},{"id":"sentence-36","text":"それから両親と会話をする時はできるだけ喧嘩にならないように両親の話をもっと聞いてあげるようにしました。","start":350.12,"end":368.16,"readings":[{"word":"両親","reading":"りょうしん","offset":4},{"word":"会話","reading":"かいわ","offset":7},{"word":"時","reading":"とき","offset":12},{"word":"喧嘩","reading":"けんか","offset":19},{"word":"両親","reading":"りょうしん","offset":29},{"word":"話","reading":"はなし","offset":32},{"word":"聞い","reading":"きい","offset":37}]},{"id":"sentence-37","text":"もちろん両親の意見と同じじゃない時もあります。","start":368.8,"end":376.96,"readings":[{"word":"両親","reading":"りょうしん","offset":4},{"word":"意見","reading":"いけん","offset":7},{"word":"同じ","reading":"おなじ","offset":10},{"word":"時","reading":"とき","offset":16}]},{"id":"sentence-38","text":"でも反対して喧嘩するより両親の意見を聞いてあげて楽しい時間を増やした方がいいと思いました。","start":377.039,"end":393.36,"readings":[{"word":"反対","reading":"はんたい","offset":2},{"word":"喧嘩","reading":"けんか","offset":6},{"word":"両親","reading":"りょうしん","offset":12},{"word":"意見","reading":"いけん","offset":15},{"word":"聞い","reading":"きい","offset":18},{"word":"楽しい","reading":"たのしい","offset":24},{"word":"時間","reading":"じかん","offset":27},{"word":"増やし","reading":"ふやし","offset":30},{"word":"方","reading":"ほう","offset":34},{"word":"思い","reading":"おもい","offset":39}]},{"id":"sentence-39","text":"これから本当に私の両親との関係が良くなりましたね。","start":393.8,"end":402.599,"readings":[{"word":"本当に","reading":"ほんとうに","offset":4},{"word":"私","reading":"わたし","offset":7},{"word":"両親","reading":"りょうしん","offset":9},{"word":"関係","reading":"かんけい","offset":13},{"word":"良く","reading":"よく","offset":16}]},{"id":"sentence-40","text":"うん。","start":402.599,"end":403.545,"readings":[]},{"id":"sentence-41","text":"両親との時間をもっと楽しめるようになりました。","start":403.545,"end":410.8,"readings":[{"word":"両親","reading":"りょうしん","offset":0},{"word":"時間","reading":"じかん","offset":4},{"word":"楽しめる","reading":"たのしめる","offset":10}]},{"id":"sentence-42","text":"私は今妻と一緒に住んでいますが、妻といい関係を気づくのも1番大切にしています。","start":412,"end":427.8,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"今","reading":"こん","offset":2},{"word":"妻","reading":"つま","offset":3},{"word":"一緒","reading":"いっしょ","offset":5},{"word":"住ん","reading":"すん","offset":8},{"word":"妻","reading":"つま","offset":16},{"word":"関係","reading":"かんけい","offset":20},{"word":"気づく","reading":"きづく","offset":23},{"word":"番","reading":"ばん","offset":29},{"word":"大切","reading":"たいせつ","offset":30}]},{"id":"sentence-43","text":"もちろん仕事が忙しい時もあります。","start":428.599,"end":433.84,"readings":[{"word":"仕事","reading":"しごと","offset":4},{"word":"忙しい","reading":"いそがしい","offset":7},{"word":"時","reading":"とき","offset":10}]},{"id":"sentence-44","text":"でも1番は妻が幸せを感じてくれることが大切なのでできるだけ妻といい時間を作るようにしていますね。","start":433.84,"end":451.479,"readings":[{"word":"番","reading":"ばん","offset":3},{"word":"妻","reading":"つま","offset":5},{"word":"幸せ","reading":"しあわせ","offset":7},{"word":"感じ","reading":"かんじ","offset":10},{"word":"大切","reading":"たいせつ","offset":19},{"word":"妻","reading":"つま","offset":29},{"word":"時間","reading":"じかん","offset":33},{"word":"作る","reading":"つくる","offset":36}]},{"id":"sentence-45","text":"うん。","start":451.479,"end":452.363,"readings":[]},{"id":"sentence-46","text":"特に毎日妻と一緒にいますからね。","start":452.363,"end":457.08,"readings":[{"word":"特に","reading":"とくに","offset":0},{"word":"毎日","reading":"まいにち","offset":2},{"word":"妻","reading":"つま","offset":4},{"word":"一緒","reading":"いっしょ","offset":6}]},{"id":"sentence-47","text":"本当に大切です。","start":457.08,"end":461.12,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"大切","reading":"たいせつ","offset":3}]},{"id":"sentence-48","text":"あと友達も同じです。","start":461.12,"end":466.159,"readings":[{"word":"友達","reading":"ともだち","offset":2},{"word":"同じ","reading":"おなじ","offset":5}]},{"id":"sentence-49","text":"友達とは毎日一緒にいませんが、友達といる時はもっとバカなことができます。","start":466.159,"end":479.319,"readings":[{"word":"友達","reading":"ともだち","offset":0},{"word":"毎日","reading":"まいにち","offset":4},{"word":"一緒","reading":"いっしょ","offset":6},{"word":"友達","reading":"ともだち","offset":15},{"word":"時","reading":"とき","offset":20}]},{"id":"sentence-50","text":"本当に仲がいい気を使わなくてもいい友達は本当に大切だと思いますね。","start":479.44,"end":491.36,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"仲","reading":"なか","offset":3},{"word":"気","reading":"き","offset":7},{"word":"使わ","reading":"つかわ","offset":9},{"word":"友達","reading":"ともだち","offset":17},{"word":"本当に","reading":"ほんとうに","offset":20},{"word":"大切","reading":"たいせつ","offset":23},{"word":"思い","reading":"おもい","offset":27}]},{"id":"sentence-51","text":"週末は大抵妻と過ごしますが、最低1ヶ月に1回か2回は友達に会うようにしています。","start":492.12,"end":507.599,"readings":[{"word":"週末","reading":"しゅうまつ","offset":0},{"word":"大抵","reading":"たいてい","offset":3},{"word":"妻","reading":"つま","offset":5},{"word":"過ごし","reading":"すごし","offset":7},{"word":"最低","reading":"さいてい","offset":14},{"word":"ヶ月","reading":"かげつ","offset":17},{"word":"回","reading":"かい","offset":21},{"word":"回","reading":"かい","offset":24},{"word":"友達","reading":"ともだち","offset":26},{"word":"会う","reading":"あう","offset":29}]},{"id":"sentence-52","text":"あと前は本当に仲が良かった友達だけど、最近全然会っていない友達も大切です。","start":508.8,"end":525.24,"readings":[{"word":"前","reading":"まえ","offset":2},{"word":"本当に","reading":"ほんとうに","offset":4},{"word":"仲","reading":"なか","offset":7},{"word":"良かっ","reading":"よかっ","offset":9},{"word":"友達","reading":"ともだち","offset":13},{"word":"最近","reading":"さいきん","offset":19},{"word":"全然","reading":"ぜんぜん","offset":21},{"word":"会っ","reading":"あっ","offset":23},{"word":"友達","reading":"ともだち","offset":29},{"word":"大切","reading":"たいせつ","offset":32}]},{"id":"sentence-53","text":"私は時々そんな友達に連絡をして一緒に居酒屋に行きます。","start":525.519,"end":535.279,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"時々","reading":"ときどき","offset":2},{"word":"友達","reading":"ともだち","offset":7},{"word":"連絡","reading":"れんらく","offset":10},{"word":"一緒","reading":"いっしょ","offset":15},{"word":"居酒屋","reading":"いざかや","offset":18},{"word":"行き","reading":"いき","offset":22}]},{"id":"sentence-54","text":"前にとても仲が良かった友達なので、すぐに昔みたいになりますね。","start":535.72,"end":546.588,"readings":[{"word":"前","reading":"まえ","offset":0},{"word":"仲","reading":"なか","offset":5},{"word":"良かっ","reading":"よかっ","offset":7},{"word":"友達","reading":"ともだち","offset":11},{"word":"昔","reading":"むかし","offset":20}]},{"id":"sentence-55","text":"はい。","start":546.588,"end":547.64,"readings":[]},{"id":"sentence-56","text":"まあ、大人になって結婚して子供ができるとライフスタイルが変わって昔の友達と全然遊ばなくなりますよね。","start":547.64,"end":563.92,"readings":[{"word":"大人","reading":"おとな","offset":3},{"word":"結婚","reading":"けっこん","offset":9},{"word":"子供","reading":"こども","offset":13},{"word":"変わっ","reading":"かわっ","offset":28},{"word":"昔","reading":"むかし","offset":32},{"word":"友達","reading":"ともだち","offset":34},{"word":"全然","reading":"ぜんぜん","offset":37},{"word":"遊ば","reading":"あそば","offset":39}]},{"id":"sentence-57","text":"それは本当に悲しいことだと思います。","start":563.92,"end":569.56,"readings":[{"word":"本当に","reading":"ほんとうに","offset":3},{"word":"悲しい","reading":"かなしい","offset":6},{"word":"思い","reading":"おもい","offset":13}]},{"id":"sentence-58","text":"だから私は家族がいる友達にも連絡をしてたくさんじゃないけど時々時間を作って居酒屋に行ったり昼ご飯を食べに行ったりします。","start":569.68,"end":589.72,"readings":[{"word":"私","reading":"わたし","offset":3},{"word":"家族","reading":"かぞく","offset":5},{"word":"友達","reading":"ともだち","offset":10},{"word":"連絡","reading":"れんらく","offset":14},{"word":"時々","reading":"ときどき","offset":29},{"word":"時間","reading":"じかん","offset":31},{"word":"作っ","reading":"つくっ","offset":34},{"word":"居酒屋","reading":"いざかや","offset":37},{"word":"行っ","reading":"いっ","offset":41},{"word":"昼","reading":"ひる","offset":45},{"word":"ご飯","reading":"ごはん","offset":46},{"word":"食べ","reading":"たべ","offset":49},{"word":"行っ","reading":"いっ","offset":52}]},{"id":"sentence-59","text":"皆さん、同僚との関係はどうですかね?","start":590.24,"end":599.04,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"同僚","reading":"どうりょう","offset":4},{"word":"関係","reading":"かんけい","offset":8}]},{"id":"sentence-60","text":"私は同僚がいないので実はあまり分かりません。","start":599.64,"end":607.24,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"同僚","reading":"どうりょう","offset":2},{"word":"実は","reading":"じつは","offset":10},{"word":"分かり","reading":"わかり","offset":15}]},{"id":"sentence-61","text":"でも本当に好きじゃない上司がいたらどうしますか?","start":607.24,"end":614.959,"readings":[{"word":"本当に","reading":"ほんとうに","offset":2},{"word":"好き","reading":"すき","offset":5},{"word":"上司","reading":"じょうし","offset":11}]},{"id":"sentence-62","text":"ま、私だったら多分その仕事をやめているかもしれません。","start":616.32,"end":622.599,"readings":[{"word":"私","reading":"わたし","offset":2},{"word":"多分","reading":"たぶん","offset":7},{"word":"仕事","reading":"しごと","offset":11}]},{"id":"sentence-63","text":"いや、でもそれは難しいですよね。","start":622.599,"end":626.32,"readings":[{"word":"難しい","reading":"むずかしい","offset":8}]},{"id":"sentence-64","text":"うん。","start":626.32,"end":628.24,"readings":[]},{"id":"sentence-65","text":"はい。","start":628.24,"end":629.218,"readings":[]},{"id":"sentence-66","text":"仕事も毎日するから同僚との人間関係も本当に大切ですね。","start":629.218,"end":638.022,"readings":[{"word":"仕事","reading":"しごと","offset":0},{"word":"毎日","reading":"まいにち","offset":3},{"word":"同僚","reading":"どうりょう","offset":9},{"word":"人間","reading":"にんげん","offset":13},{"word":"関係","reading":"かんけい","offset":15},{"word":"本当に","reading":"ほんとうに","offset":18},{"word":"大切","reading":"たいせつ","offset":21}]},{"id":"sentence-67","text":"うん。","start":638.022,"end":639,"readings":[]},{"id":"sentence-68","text":"ま、多分これも自分が変わらなければいけませんよね。","start":639.16,"end":646.399,"readings":[{"word":"多分","reading":"たぶん","offset":2},{"word":"自分","reading":"じぶん","offset":7},{"word":"変わら","reading":"かわら","offset":10}]},{"id":"sentence-69","text":"まずはあまりその人にエネルギーを使わないようにマインドセットを変えると思います。","start":646.399,"end":658.56,"readings":[{"word":"人","reading":"ひと","offset":8},{"word":"使わ","reading":"つかわ","offset":16},{"word":"変える","reading":"かえる","offset":31},{"word":"思い","reading":"おもい","offset":35}]},{"id":"sentence-70","text":"瞑想みたいですよ。","start":658.88,"end":662.72,"readings":[{"word":"瞑想","reading":"めいそう","offset":0}]},{"id":"sentence-71","text":"その上司と話している時は本当にその好きじゃない上司のエネルギーをもらわないようにします。","start":662.72,"end":676.92,"readings":[{"word":"上司","reading":"じょうし","offset":2},{"word":"話し","reading":"はなし","offset":5},{"word":"時","reading":"とき","offset":10},{"word":"本当に","reading":"ほんとうに","offset":12},{"word":"好き","reading":"すき","offset":17},{"word":"上司","reading":"じょうし","offset":23}]},{"id":"sentence-72","text":"あとはうん、他の同僚に相談してその上司と働かないようにしてもらうのもいいかもしれませんね。","start":677.279,"end":690.892,"readings":[{"word":"他","reading":"た","offset":6},{"word":"同僚","reading":"どうりょう","offset":8},{"word":"相談","reading":"そうだん","offset":11},{"word":"上司","reading":"じょうし","offset":17},{"word":"働か","reading":"はたらか","offset":20}]},{"id":"sentence-73","text":"はい。","start":690.892,"end":691.8,"readings":[]},{"id":"sentence-74","text":"いや、仕事の人間関係は本当に難しいと思います。","start":691.8,"end":698.48,"readings":[{"word":"仕事","reading":"しごと","offset":3},{"word":"人間","reading":"にんげん","offset":6},{"word":"関係","reading":"かんけい","offset":8},{"word":"本当に","reading":"ほんとうに","offset":11},{"word":"難しい","reading":"むずかしい","offset":14},{"word":"思い","reading":"おもい","offset":18}]},{"id":"sentence-75","text":"でも皆さん仕事はやめてもいいですからね本当に仕事の人間関係で困っている人がいたらいつもやめる選択もありますよ。","start":698.48,"end":718.12,"readings":[{"word":"皆さん","reading":"みなさん","offset":2},{"word":"仕事","reading":"しごと","offset":5},{"word":"本当に","reading":"ほんとうに","offset":19},{"word":"仕事","reading":"しごと","offset":22},{"word":"人間","reading":"にんげん","offset":25},{"word":"関係","reading":"かんけい","offset":27},{"word":"困っ","reading":"こまっ","offset":30},{"word":"人","reading":"ひと","offset":35},{"word":"選択","reading":"せんたく","offset":46}]},{"id":"sentence-76","text":"うん。","start":718.12,"end":721.24,"readings":[]},{"id":"sentence-77","text":"私が習ったのは他の人を変えることはできないけど自分が変わることはできるです。","start":721.24,"end":737.04,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"習っ","reading":"ならっ","offset":2},{"word":"他","reading":"た","offset":7},{"word":"人","reading":"ひと","offset":9},{"word":"変える","reading":"かえる","offset":11},{"word":"自分","reading":"じぶん","offset":23},{"word":"変わる","reading":"かわる","offset":26}]},{"id":"sentence-78","text":"自分の考え方を少し変えたらもっと人間関係が良くなると思います。","start":737.079,"end":748.519,"readings":[{"word":"自分","reading":"じぶん","offset":0},{"word":"考え方","reading":"かんがえかた","offset":3},{"word":"少し","reading":"すこし","offset":7},{"word":"変え","reading":"かえ","offset":9},{"word":"人間","reading":"にんげん","offset":16},{"word":"関係","reading":"かんけい","offset":18},{"word":"良く","reading":"よく","offset":21},{"word":"思い","reading":"おもい","offset":26}]},{"id":"sentence-79","text":"あと多分たくさんの人はあまり人間関係を良くする努力をしていないと思います。","start":748.88,"end":762.48,"readings":[{"word":"多分","reading":"たぶん","offset":2},{"word":"人","reading":"ひと","offset":9},{"word":"人間","reading":"にんげん","offset":14},{"word":"関係","reading":"かんけい","offset":16},{"word":"良く","reading":"よく","offset":19},{"word":"努力","reading":"どりょく","offset":23},{"word":"思い","reading":"おもい","offset":32}]},{"id":"sentence-80","text":"仕事や趣味はすごく頑張っているのに人間関係を良くするのを忘れている人もたくさんいると思います。","start":763.12,"end":779.12,"readings":[{"word":"仕事","reading":"しごと","offset":0},{"word":"趣味","reading":"しゅみ","offset":3},{"word":"頑張っ","reading":"がんばっ","offset":9},{"word":"人間","reading":"にんげん","offset":17},{"word":"関係","reading":"かんけい","offset":19},{"word":"良く","reading":"よく","offset":22},{"word":"忘れ","reading":"わすれ","offset":28},{"word":"人","reading":"ひと","offset":33},{"word":"思い","reading":"おもい","offset":42}]},{"id":"sentence-81","text":"まずは人間関係がもっと大切だと気づくことが1番大切かもしれませんね。","start":779.72,"end":794.56,"readings":[{"word":"人間","reading":"にんげん","offset":3},{"word":"関係","reading":"かんけい","offset":5},{"word":"大切","reading":"たいせつ","offset":11},{"word":"気づく","reading":"きづく","offset":15},{"word":"番","reading":"ばん","offset":2