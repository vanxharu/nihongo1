{"videoId":"HgatfkTSbjc","title":"【N5-N4】#155 Border / Oyasumi Japanese Podcast for Beginners","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"おやすみ。","start":0.84,"end":3.222,"readings":[]},{"id":"sentence-1","text":"しと日本語。","start":3.222,"end":6.08,"readings":[{"word":"日本語","reading":"にほんご","offset":2}]},{"id":"sentence-2","text":"皆さんこんばんは。","start":12.12,"end":14.375,"readings":[{"word":"皆さん","reading":"みなさん","offset":0}]},{"id":"sentence-3","text":"日本語教師のしです。","start":14.375,"end":16.88,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"教師","reading":"きょうし","offset":3}]},{"id":"sentence-4","text":"皆さん、今日はどんな1日でしたか?","start":16.88,"end":22.24,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"今日","reading":"きょう","offset":4},{"word":"日","reading":"にち","offset":11}]},{"id":"sentence-5","text":"皆さんの週末はどうでしたか?","start":22.24,"end":27.359,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"週末","reading":"しゅうまつ","offset":4}]},{"id":"sentence-6","text":"皆さん国境を超えたことがありますか?","start":28.199,"end":35.239,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"国境","reading":"こっきょう","offset":3},{"word":"超え","reading":"こえ","offset":6}]},{"id":"sentence-7","text":"ま、飛行機じゃなくて陸クロで国境を超えたことがありますか?","start":35.239,"end":45.6,"readings":[{"word":"飛行機","reading":"ひこうき","offset":2},{"word":"陸","reading":"りく","offset":10},{"word":"国境","reading":"こっきょう","offset":14},{"word":"超え","reading":"こえ","offset":17}]},{"id":"sentence-8","text":"最からラオスにバスで行きました。","start":45.96,"end":53.239,"readings":[{"word":"最","reading":"さい","offset":0},{"word":"行き","reading":"いき","offset":10}]},{"id":"sentence-9","text":"リクロで国境を超えるのは本当にワクワクしますよね。","start":53.28,"end":62.039,"readings":[{"word":"国境","reading":"こっきょう","offset":4},{"word":"超える","reading":"こえる","offset":7},{"word":"本当に","reading":"ほんとうに","offset":12}]},{"id":"sentence-10","text":"日本は島国です。","start":62.32,"end":66.24,"readings":[{"word":"日本","reading":"にっぽん","offset":0},{"word":"島国","reading":"しまぐに","offset":3}]},{"id":"sentence-11","text":"だから日本から外国に行く時は飛行機で行かなければいけませんね。","start":66.24,"end":77.52,"readings":[{"word":"日本","reading":"にっぽん","offset":3},{"word":"外国","reading":"がいこく","offset":7},{"word":"行く","reading":"いく","offset":10},{"word":"時","reading":"とき","offset":12},{"word":"飛行機","reading":"ひこうき","offset":14},{"word":"行か","reading":"いか","offset":18}]},{"id":"sentence-12","text":"どうですか?","start":77.52,"end":79.762,"readings":[]},{"id":"sentence-13","text":"飛行機で国境を超える時とリクロで国境を超える時と本当に違うと思います。","start":79.762,"end":92.84,"readings":[{"word":"飛行機","reading":"ひこうき","offset":0},{"word":"国境","reading":"こっきょう","offset":4},{"word":"超える","reading":"こえる","offset":7},{"word":"時","reading":"とき","offset":10},{"word":"国境","reading":"こっきょう","offset":16},{"word":"超える","reading":"こえる","offset":19},{"word":"時","reading":"とき","offset":22},{"word":"本当に","reading":"ほんとうに","offset":24},{"word":"違う","reading":"ちがう","offset":27},{"word":"思い","reading":"おもい","offset":30}]},{"id":"sentence-14","text":"私は人生で初めてリクロで国境を超えたのは19歳の時でした。","start":93.52,"end":106.2,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"人生","reading":"じんせい","offset":2},{"word":"初めて","reading":"はじめて","offset":5},{"word":"国境","reading":"こっきょう","offset":12},{"word":"超え","reading":"こえ","offset":15},{"word":"歳","reading":"さい","offset":22},{"word":"時","reading":"とき","offset":24}]},{"id":"sentence-15","text":"1人でタに飛行機で行って、タからカンボジアに陸で国境を超えました本当に緊張していたけどワクワクしていました。","start":107.04,"end":128.119,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"飛行機","reading":"ひこうき","offset":5},{"word":"行っ","reading":"おこなっ","offset":9},{"word":"陸","reading":"りく","offset":22},{"word":"国境","reading":"こっきょう","offset":24},{"word":"超え","reading":"こえ","offset":27},{"word":"本当に","reading":"ほんとうに","offset":32},{"word":"緊張","reading":"きんちょう","offset":35}]},{"id":"sentence-16","text":"映画の中にいるみたいでしたね。","start":128.119,"end":133.84,"readings":[{"word":"映画","reading":"えいが","offset":0},{"word":"中","reading":"なか","offset":3}]},{"id":"sentence-17","text":"特でビザのために30ドル払わなければいけませんでした。","start":134.319,"end":143.519,"readings":[{"word":"特","reading":"とく","offset":0},{"word":"払わ","reading":"はらわ","offset":12}]},{"id":"sentence-18","text":"国境を超えるとタと全然違う雰囲気でびっくりしました。","start":143.92,"end":153.92,"readings":[{"word":"国境","reading":"こっきょう","offset":0},{"word":"超える","reading":"こえる","offset":3},{"word":"全然","reading":"ぜんぜん","offset":9},{"word":"違う","reading":"ちがう","offset":11},{"word":"雰囲気","reading":"ふんいき","offset":13}]},{"id":"sentence-19","text":"今回も同じです。","start":154.44,"end":158.519,"readings":[{"word":"今回","reading":"こんかい","offset":0},{"word":"同じ","reading":"おなじ","offset":3}]},{"id":"sentence-20","text":"今回はビザが必要ありませんでしたが、国境を超えてすぐに雰囲気の違いを感じました。","start":158.519,"end":173.12,"readings":[{"word":"今回","reading":"こんかい","offset":0},{"word":"必要","reading":"ひつよう","offset":6},{"word":"国境","reading":"こっきょう","offset":18},{"word":"超え","reading":"こえ","offset":21},{"word":"雰囲気","reading":"ふんいき","offset":27},{"word":"違い","reading":"ちがい","offset":31},{"word":"感じ","reading":"かんじ","offset":34}]},{"id":"sentence-21","text":"タはここ10年で本当に発展したと思います。","start":173.519,"end":182,"readings":[{"word":"年","reading":"ねん","offset":6},{"word":"本当に","reading":"ほんとうに","offset":8},{"word":"発展","reading":"はってん","offset":11},{"word":"思い","reading":"おもい","offset":16}]},{"id":"sentence-22","text":"建物や街のインフラはすごく良かったですラオスに入ってすぐに国境の町に行きました。","start":182.76,"end":200,"readings":[{"word":"建物","reading":"たてもの","offset":0},{"word":"街","reading":"まち","offset":3},{"word":"良かっ","reading":"よかっ","offset":13},{"word":"入っ","reading":"はいっ","offset":23},{"word":"国境","reading":"こっきょう","offset":29},{"word":"町","reading":"まち","offset":32},{"word":"行き","reading":"いき","offset":34}]},{"id":"sentence-23","text":"道路はあまり良くなくて家も本当に古かったです。","start":200.2,"end":209,"readings":[{"word":"道路","reading":"どうろ","offset":0},{"word":"良く","reading":"よく","offset":6},{"word":"家","reading":"いえ","offset":11},{"word":"本当に","reading":"ほんとうに","offset":13},{"word":"古かっ","reading":"ふるかっ","offset":16}]},{"id":"sentence-24","text":"目標を少し超えただけでもう本当に街は違ってびっくりしました。","start":209.519,"end":222.08,"readings":[{"word":"目標","reading":"もくひょう","offset":0},{"word":"少し","reading":"すこし","offset":3},{"word":"超え","reading":"こえ","offset":5},{"word":"本当に","reading":"ほんとうに","offset":13},{"word":"街","reading":"まち","offset":16},{"word":"違っ","reading":"ちがっ","offset":18}]},{"id":"sentence-25","text":"でもこれがリクロで国境を超える楽しいことだと思います。","start":222.08,"end":233.799,"readings":[{"word":"国境","reading":"こっきょう","offset":9},{"word":"超える","reading":"こえる","offset":12},{"word":"楽しい","reading":"たのしい","offset":15},{"word":"思い","reading":"おもい","offset":22}]},{"id":"sentence-26","text":"2つの国の違いを1日で感じることができます。","start":234.36,"end":243.239,"readings":[{"word":"国","reading":"くに","offset":3},{"word":"違い","reading":"ちがい","offset":5},{"word":"日","reading":"にち","offset":9},{"word":"感じる","reading":"かんじる","offset":11}]},{"id":"sentence-27","text":"本当に面白いですね。","start":243.28,"end":246.18,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"面白い","reading":"おもしろい","offset":3}]},{"id":"sentence-28","text":"うん。","start":246.18,"end":247.05,"readings":[]},{"id":"sentence-29","text":"なんかラオスはなんか15年前のタみたいでした。","start":247.05,"end":253.72,"readings":[{"word":"年","reading":"ねん","offset":12},{"word":"前","reading":"まえ","offset":13}]},{"id":"sentence-30","text":"バックパッカーはたくさんここにいます。","start":253.72,"end":259.88,"readings":[]},{"id":"sentence-31","text":"でもまだ街のインフラはあまり良くないです。","start":259.88,"end":266.12,"readings":[{"word":"街","reading":"まち","offset":4},{"word":"良く","reading":"よく","offset":14}]},{"id":"sentence-32","text":"多分タみたいに観光でもっとお金を稼いでインフラが良くなるといいですね。","start":266.36,"end":277.56,"readings":[{"word":"多分","reading":"たぶん","offset":0},{"word":"観光","reading":"かんこう","offset":7},{"word":"お金","reading":"おかね","offset":13},{"word":"稼い","reading":"かせい","offset":16},{"word":"良く","reading":"よく","offset":24}]},{"id":"sentence-33","text":"でもそれと同時にまだ発展していないラオスを感じたいと思いました。","start":277.56,"end":290.44,"readings":[{"word":"同時に","reading":"どうじに","offset":5},{"word":"発展","reading":"はってん","offset":10},{"word":"感じ","reading":"かんじ","offset":21},{"word":"思い","reading":"おもい","offset":26}]},{"id":"sentence-34","text":"私は昔のタと今の体を両方経験しました。","start":290.96,"end":299.039,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"昔","reading":"むかし","offset":2},{"word":"今","reading":"いま","offset":6},{"word":"体","reading":"からだ","offset":8},{"word":"両方","reading":"りょうほう","offset":10},{"word":"経験","reading":"けいけん","offset":12}]},{"id":"sentence-35","text":"もちろん今の方が綺麗で便利です。","start":299.039,"end":304.759,"readings":[{"word":"今","reading":"いま","offset":4},{"word":"方","reading":"ほう","offset":6},{"word":"綺麗","reading":"きれい","offset":8},{"word":"便利","reading":"べんり","offset":11}]},{"id":"sentence-36","text":"でもなんか少し昔の体をもう経験できないと思うと少し寂しい気持ちになりますね。","start":304.759,"end":319.36,"readings":[{"word":"少し","reading":"すこし","offset":5},{"word":"昔","reading":"むかし","offset":7},{"word":"体","reading":"からだ","offset":9},{"word":"経験","reading":"けいけん","offset":13},{"word":"思う","reading":"おもう","offset":20},{"word":"少し","reading":"すこし","offset":23},{"word":"寂しい","reading":"さびしい","offset":25},{"word":"気持ち","reading":"きもち","offset":28}]},{"id":"sentence-37","text":"目標を超える時には色々な気持ちになります。","start":320.24,"end":327.639,"readings":[{"word":"目標","reading":"もくひょう","offset":0},{"word":"超える","reading":"こえる","offset":3},{"word":"時","reading":"とき","offset":6},{"word":"色々","reading":"いろいろ","offset":9},{"word":"気持ち","reading":"きもち","offset":12}]},{"id":"sentence-38","text":"まずは本当に自由を感じます。","start":327.639,"end":334.36,"readings":[{"word":"本当に","reading":"ほんとうに","offset":3},{"word":"自由","reading":"じゆう","offset":6},{"word":"感じ","reading":"かんじ","offset":9}]},{"id":"sentence-39","text":"特に国境を超えた瞬間と国境にある町に着いた時に自由を感じますと国境を超えるといつも新しいことを学ぶことができます。","start":334.4,"end":358.28,"readings":[{"word":"特に","reading":"とくに","offset":0},{"word":"国境","reading":"こっきょう","offset":2},{"word":"超え","reading":"こえ","offset":5},{"word":"瞬間","reading":"しゅんかん","offset":8},{"word":"国境","reading":"こっきょう","offset":11},{"word":"町","reading":"まち","offset":16},{"word":"着い","reading":"つい","offset":18},{"word":"時","reading":"とき","offset":21},{"word":"自由","reading":"じゆう","offset":23},{"word":"感じ","reading":"かんじ","offset":26},{"word":"国境","reading":"こっきょう","offset":31},{"word":"超える","reading":"こえる","offset":34},{"word":"新しい","reading":"あたらしい","offset":41},{"word":"学ぶ","reading":"まなぶ","offset":47}]},{"id":"sentence-40","text":"前の国では普通のことが普通じゃなくなります。","start":358.84,"end":367.68,"readings":[{"word":"前","reading":"まえ","offset":0},{"word":"国","reading":"くに","offset":2},{"word":"普通","reading":"ふつう","offset":5},{"word":"普通","reading":"ふつう","offset":11}]},{"id":"sentence-41","text":"人も違います。","start":367.68,"end":370.88,"readings":[{"word":"人","reading":"ひと","offset":0},{"word":"違い","reading":"ちがい","offset":2}]},{"id":"sentence-42","text":"雰囲気も景色も違います。","start":370.88,"end":376.36,"readings":[{"word":"雰囲気","reading":"ふんいき","offset":0},{"word":"景色","reading":"けしき","offset":4},{"word":"違い","reading":"ちがい","offset":7}]},{"id":"sentence-43","text":"それを実際に経験すると本当に世界は色々な人が住んでいてみんな幸せに生きようとその国で頑張っているんだなと思いました。","start":376.36,"end":398.68,"readings":[{"word":"実際","reading":"じっさい","offset":3},{"word":"経験","reading":"けいけん","offset":6},{"word":"本当に","reading":"ほんとうに","offset":11},{"word":"世界","reading":"せかい","offset":14},{"word":"色々","reading":"いろいろ","offset":17},{"word":"人","reading":"ひと","offset":20},{"word":"住ん","reading":"すん","offset":22},{"word":"幸せ","reading":"しあわせ","offset":30},{"word":"生きよ","reading":"いきよ","offset":33},{"word":"国","reading":"くに","offset":40},{"word":"頑張っ","reading":"がんばっ","offset":42},{"word":"思い","reading":"おもい","offset":52}]},{"id":"sentence-44","text":"ずっと同じ国にいると本当にこのことを忘れてしまいますね。","start":399.24,"end":408.12,"readings":[{"word":"同じ","reading":"おなじ","offset":3},{"word":"国","reading":"くに","offset":5},{"word":"本当に","reading":"ほんとうに","offset":10},{"word":"忘れ","reading":"わすれ","offset":18}]},{"id":"sentence-45","text":"うん。","start":408.88,"end":409.931,"readings":[]},{"id":"sentence-46","text":"もちろん日本には日本の文化や習慣、価値観があります。","start":409.931,"end":419.039,"readings":[{"word":"日本","reading":"にっぽん","offset":4},{"word":"日本","reading":"にっぽん","offset":8},{"word":"文化","reading":"ぶんか","offset":11},{"word":"習慣","reading":"しゅうかん","offset":14},{"word":"価値","reading":"かち","offset":17},{"word":"観","reading":"かん","offset":19}]},{"id":"sentence-47","text":"でも他の国に行くとそれは全部変わりますその国にはその国の文化や習慣、価値観があります。","start":419.039,"end":437,"readings":[{"word":"他","reading":"た","offset":2},{"word":"国","reading":"くに","offset":4},{"word":"行く","reading":"いく","offset":6},{"word":"全部","reading":"ぜんぶ","offset":12},{"word":"変わり","reading":"かわり","offset":14},{"word":"国","reading":"くに","offset":21},{"word":"国","reading":"くに","offset":26},{"word":"文化","reading":"ぶんか","offset":28},{"word":"習慣","reading":"しゅうかん","offset":31},{"word":"価値","reading":"かち","offset":34},{"word":"観","reading":"かん","offset":36}]},{"id":"sentence-48","text":"その国で失礼なことをしないようにその国の文化や習慣を私たちが学ばなければいけません。","start":437.44,"end":452.08,"readings":[{"word":"国","reading":"くに","offset":2},{"word":"失礼","reading":"しつれい","offset":4},{"word":"国","reading":"くに","offset":18},{"word":"文化","reading":"ぶんか","offset":20},{"word":"習慣","reading":"しゅうかん","offset":23},{"word":"私","reading":"わたし","offset":26},{"word":"学ば","reading":"まなば","offset":30}]},{"id":"sentence-49","text":"リクロで国境を超えるとうん。","start":452.639,"end":457,"readings":[{"word":"国境","reading":"こっきょう","offset":4},{"word":"超える","reading":"こえる","offset":7}]},{"id":"sentence-50","text":"それをもっと感じられますね。","start":457,"end":461.36,"readings":[{"word":"感じ","reading":"かんじ","offset":6}]},{"id":"sentence-51","text":"色々な場所に住むと色々な価値観や習慣の中で生きなければいけません。","start":461.879,"end":472.4,"readings":[{"word":"色々","reading":"いろいろ","offset":0},{"word":"場所","reading":"ばしょ","offset":3},{"word":"住む","reading":"すむ","offset":6},{"word":"色々","reading":"いろいろ","offset":9},{"word":"価値","reading":"かち","offset":12},{"word":"観","reading":"かん","offset":14},{"word":"習慣","reading":"しゅうかん","offset":16},{"word":"中","reading":"なか","offset":19},{"word":"生き","reading":"いき","offset":21}]},{"id":"sentence-52","text":"でもそれを経験すると自分の国の習慣や文化ももっと大切にできると思います。","start":472.4,"end":487.12,"readings":[{"word":"経験","reading":"けいけん","offset":5},{"word":"自分","reading":"じぶん","offset":10},{"word":"国","reading":"くに","offset":13},{"word":"習慣","reading":"しゅうかん","offset":15},{"word":"文化","reading":"ぶんか","offset":18},{"word":"大切","reading":"たいせつ","offset":24},{"word":"思い","reading":"おもい","offset":31}]},{"id":"sentence-53","text":"はい。","start":487.52,"end":488.424,"readings":[]},{"id":"sentence-54","text":"え、ま、最近リクロで国境を超えたので、今日は国境について話してみましたどうでしたか?","start":488.424,"end":501.08,"readings":[{"word":"最近","reading":"さいきん","offset":4},{"word":"国境","reading":"こっきょう","offset":10},{"word":"超え","reading":"こえ","offset":13},{"word":"今日","reading":"きょう","offset":19},{"word":"国境","reading":"こっきょう","offset":22},{"word":"話し","reading":"はなし","offset":28}]},{"id":"sentence-55","text":"国境を超えるのは特別な経験ですよね。","start":501.08,"end":507.96,"readings":[{"word":"国境","reading":"こっきょう","offset":0},{"word":"超える","reading":"こえる","offset":3},{"word":"特別","reading":"とくべつ","offset":8},{"word":"経験","reading":"けいけん","offset":11}]},{"id":"sentence-56","text":"皆さんはリクロで国境を超えたことがありますか?","start":507.96,"end":514.839,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"国境","reading":"こっきょう","offset":8},{"word":"超え","reading":"こえ","offset":11}]},{"id":"sentence-57","text":"国境を超えた時どんな気分になりますか?","start":514.839,"end":522.32,"readings":[{"word":"国境","reading":"こっきょう","offset":0},{"word":"超え","reading":"こえ","offset":3},{"word":"時","reading":"とき","offset":6},{"word":"気分","reading":"きぶん","offset":10}]},{"id":"sentence-58","text":"よかったら寝る前にYouTubeのコメントで教えてください。","start":522.32,"end":529.76,"readings":[{"word":"寝る","reading":"ねる","offset":5},{"word":"前","reading":"まえ","offset":7},{"word":"教え","reading":"おしえ","offset":22}]},{"id":"sentence-59","text":"このトランス