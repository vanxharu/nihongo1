{"videoId":"XR0GkscTM90","title":"Đề luyện nghe N4 · Bài 05","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"教会スクリプト第1回問題1問題1ではまず質問を聞いてください。","start":1.24,"end":11.931,"readings":[{"word":"教会","reading":"きょうかい","offset":0},{"word":"第","reading":"だい","offset":7},{"word":"回","reading":"かい","offset":9},{"word":"問題","reading":"もんだい","offset":10},{"word":"問題","reading":"もんだい","offset":13},{"word":"質問","reading":"しつもん","offset":20},{"word":"聞い","reading":"きい","offset":23}]},{"id":"sentence-1","text":"それから話を聞いて問題用紙の","start":11.931,"end":16.759,"readings":[{"word":"話","reading":"はなし","offset":4},{"word":"聞い","reading":"きい","offset":6},{"word":"問題","reading":"もんだい","offset":9},{"word":"用紙","reading":"ようし","offset":11}]},{"id":"sentence-2","text":"1から4の中から1番いいものを1つ選んでください。","start":23.199,"end":30.439,"readings":[{"word":"中","reading":"なか","offset":5},{"word":"番","reading":"ばん","offset":9},{"word":"選ん","reading":"えらん","offset":17}]},{"id":"sentence-3","text":"番男の人と女の人が話しています。","start":36.559,"end":38.214,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"男","reading":"おとこ","offset":1},{"word":"人","reading":"ひと","offset":3},{"word":"女","reading":"おんな","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"話し","reading":"はなし","offset":9}]},{"id":"sentence-4","text":"女の人は将来何をしますか?","start":38.214,"end":39.559,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"将来","reading":"しょうらい","offset":4},{"word":"何","reading":"なに","offset":6}]},{"id":"sentence-5","text":"将来何をするつもり?","start":46.8,"end":49.32,"readings":[{"word":"将来","reading":"しょうらい","offset":0},{"word":"何","reading":"なに","offset":2}]},{"id":"sentence-6","text":"そうね、小さい頃は警察官や看護師になりたかったのよ。","start":49.32,"end":52.32,"readings":[{"word":"小さい","reading":"ちいさい","offset":4},{"word":"頃","reading":"ころ","offset":7},{"word":"警察官","reading":"けいさつかん","offset":9},{"word":"看護","reading":"かんご","offset":13},{"word":"師","reading":"し","offset":15}]},{"id":"sentence-7","text":"いいじゃないか。","start":55.359,"end":56.719,"readings":[]},{"id":"sentence-8","text":"でも体が小さいし丈夫でもないから。","start":56.719,"end":59.719,"readings":[{"word":"体","reading":"からだ","offset":2},{"word":"小さい","reading":"ちいさい","offset":4},{"word":"丈夫","reading":"じょうぶ","offset":8}]},{"id":"sentence-9","text":"会社で働くのはどうなの?","start":61.84,"end":62.677,"readings":[{"word":"会社","reading":"かいしゃ","offset":0},{"word":"働く","reading":"はたらく","offset":3}]},{"id":"sentence-10","text":"会社ってあまり好きじゃないし、スーパーのレジもつまらないしね。","start":62.677,"end":64.84,"readings":[{"word":"会社","reading":"かいしゃ","offset":0},{"word":"好き","reading":"すき","offset":7}]},{"id":"sentence-11","text":"人と一緒にいるのがいいみたいだから先生なんかどう?","start":71.159,"end":74.159,"readings":[{"word":"人","reading":"ひと","offset":0},{"word":"一緒","reading":"いっしょ","offset":2},{"word":"先生","reading":"せんせい","offset":17}]},{"id":"sentence-12","text":"そうね。","start":76.56,"end":77.36,"readings":[]},{"id":"sentence-13","text":"小学生は可愛いからね。","start":77.36,"end":79.56,"readings":[{"word":"小学生","reading":"しょうがくせい","offset":0},{"word":"可愛い","reading":"かわいい","offset":4}]},{"id":"sentence-14","text":"女の人は将来何をしますか?","start":86.24,"end":92.159,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"将来","reading":"しょうらい","offset":4},{"word":"何","reading":"なに","offset":6}]},{"id":"sentence-15","text":"2番男の人と女の人が話しています。","start":105.64,"end":112.88,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-16","text":"この人は漢字を書く前にどうしますか?","start":112.88,"end":115.88,"readings":[{"word":"人","reading":"ひと","offset":2},{"word":"漢字","reading":"かんじ","offset":4},{"word":"書く","reading":"かく","offset":7},{"word":"前","reading":"まえ","offset":9}]},{"id":"sentence-17","text":"漢字は難しいですね。","start":118.159,"end":120.926,"readings":[{"word":"漢字","reading":"かんじ","offset":0},{"word":"難しい","reading":"むずかしい","offset":3}]},{"id":"sentence-18","text":"私は読むのが1番難しいです。","start":120.926,"end":124.799,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"読む","reading":"よむ","offset":2},{"word":"番","reading":"ばん","offset":7},{"word":"難しい","reading":"むずかしい","offset":8}]},{"id":"sentence-19","text":"読むのも難しいですが、書くのはもっと難しいですよ。","start":124.799,"end":127.799,"readings":[{"word":"読む","reading":"よむ","offset":0},{"word":"難しい","reading":"むずかしい","offset":4},{"word":"書く","reading":"かく","offset":11},{"word":"難しい","reading":"むずかしい","offset":18}]},{"id":"sentence-20","text":"本を読んだりテープを聞いたりしますが、うまく読めないのです。","start":130.36,"end":133.36,"readings":[{"word":"本","reading":"ほん","offset":0},{"word":"読ん","reading":"よん","offset":2},{"word":"聞い","reading":"きい","offset":10},{"word":"読め","reading":"よめ","offset":22}]},{"id":"sentence-21","text":"私は書く前に辞書をよく見ます。","start":136.68,"end":139.68,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"書く","reading":"かく","offset":2},{"word":"前","reading":"まえ","offset":4},{"word":"辞書","reading":"じしょ","offset":6},{"word":"見","reading":"み","offset":11}]},{"id":"sentence-22","text":"男の人は漢字を書く前にどうしますか?","start":146.2,"end":153.599,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"漢字","reading":"かんじ","offset":4},{"word":"書く","reading":"かく","offset":7},{"word":"前","reading":"まえ","offset":9}]},{"id":"sentence-23","text":"3番女の人が話しています。","start":167.159,"end":167.928,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"女","reading":"おんな","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"話し","reading":"はなし","offset":6}]},{"id":"sentence-24","text":"まだやっていないことは何ですか?","start":167.928,"end":168.874,"readings":[{"word":"何","reading":"なに","offset":11}]},{"id":"sentence-25","text":"やっていないことです。","start":168.874,"end":169.524,"readings":[]},{"id":"sentence-26","text":"今朝も早くから起きて掃除したり選択したりして忙しかったです。","start":169.524,"end":171.298,"readings":[{"word":"今朝","reading":"けさ","offset":0},{"word":"早くから","reading":"はやくから","offset":3},{"word":"起き","reading":"おき","offset":7},{"word":"掃除","reading":"そうじ","offset":10},{"word":"選択","reading":"せんたく","offset":15},{"word":"忙しかっ","reading":"いそがしかっ","offset":22}]},{"id":"sentence-27","text":"毎日の仕事ですから仕方がありません。","start":171.298,"end":172.362,"readings":[{"word":"毎日","reading":"まいにち","offset":0},{"word":"仕事","reading":"しごと","offset":3},{"word":"仕方","reading":"しかた","offset":9}]},{"id":"sentence-28","text":"食事はもうできていますが、主人と子供たちは寝ています。","start":172.362,"end":173.959,"readings":[{"word":"食事","reading":"しょくじ","offset":0},{"word":"主人","reading":"しゅじん","offset":13},{"word":"子供","reading":"こども","offset":16},{"word":"寝","reading":"ね","offset":21}]},{"id":"sentence-29","text":"食事が終わってから友達とスーパーへ行きます。","start":199.799,"end":205.72,"readings":[{"word":"食事","reading":"しょくじ","offset":0},{"word":"終わっ","reading":"おわっ","offset":3},{"word":"友達","reading":"ともだち","offset":9},{"word":"行き","reading":"いき","offset":17}]},{"id":"sentence-30","text":"休める時間はありますが、夜11時の後ですよ。","start":205.72,"end":215.552,"readings":[{"word":"休める","reading":"やすめる","offset":0},{"word":"時間","reading":"じかん","offset":3},{"word":"夜","reading":"よる","offset":12},{"word":"時","reading":"じ","offset":15},{"word":"後","reading":"のち","offset":17}]},{"id":"sentence-31","text":"まだやっていないことは何ですか?","start":217.159,"end":222.137,"readings":[{"word":"何","reading":"なに","offset":11}]},{"id":"sentence-32","text":"やっていないことです。","start":222.137,"end":225.56,"readings":[]},{"id":"sentence-33","text":"4番女の人が話しています。","start":238.76,"end":240.714,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"女","reading":"おんな","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"話し","reading":"はなし","offset":6}]},{"id":"sentence-34","text":"娘さんはいつもどんな順番で服を着ますか?","start":240.714,"end":243.72,"readings":[{"word":"娘","reading":"むすめ","offset":0},{"word":"順番","reading":"じゅんばん","offset":10},{"word":"服","reading":"ふく","offset":13},{"word":"着","reading":"き","offset":15}]},{"id":"sentence-35","text":"服を着る時上から下でしょう。","start":250.68,"end":253.68,"readings":[{"word":"服","reading":"ふく","offset":0},{"word":"着る","reading":"きる","offset":2},{"word":"時","reading":"とき","offset":4},{"word":"上","reading":"うえ","offset":5},{"word":"下","reading":"した","offset":8}]},{"id":"sentence-36","text":"しかしうちの娘は反対ですよ。","start":255.92,"end":261.65,"readings":[{"word":"娘","reading":"むすめ","offset":6},{"word":"反対","reading":"はんたい","offset":8}]},{"id":"sentence-37","text":"そう、下から上という順序。","start":261.65,"end":266.971,"readings":[{"word":"下","reading":"した","offset":3},{"word":"上","reading":"うえ","offset":6},{"word":"順序","reading":"じゅんじょ","offset":10}]},{"id":"sentence-38","text":"まあ、靴は最後ですけど。","start":266.971,"end":271.883,"readings":[{"word":"靴","reading":"くつ","offset":3},{"word":"最後","reading":"さいご","offset":5}]},{"id":"sentence-39","text":"娘さんはいつもどんな順番で服を着ますか","start":273.72,"end":281.24,"readings":[{"word":"娘","reading":"むすめ","offset":0},{"word":"順番","reading":"じゅんばん","offset":10},{"word":"服","reading":"ふく","offset":13},{"word":"着","reading":"き","offset":15}]},{"id":"sentence-40","text":"5番男の人と女の人が話しています。","start":294.6,"end":300.68,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-41","text":"今日男の人は何を忘れましたか?","start":300.68,"end":303.68,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"何","reading":"なに","offset":6},{"word":"忘れ","reading":"わすれ","offset":8}]},{"id":"sentence-42","text":"あれ?","start":305.6,"end":306.05,"readings":[]},{"id":"sentence-43","text":"ない。","start":306.05,"end":306.5,"readings":[]},{"id":"sentence-44","text":"あれがないと車が動かないよ。","start":306.5,"end":308.6,"readings":[{"word":"車","reading":"くるま","offset":6},{"word":"動か","reading":"うごか","offset":8}]},{"id":"sentence-45","text":"カの中にはないよ。","start":311.16,"end":314.56,"readings":[{"word":"中","reading":"なか","offset":2}]},{"id":"sentence-46","text":"この間は時計を忘れて、今朝もう少しで財布を忘れるところだったわね。","start":314.56,"end":316.76,"readings":[{"word":"この間","reading":"このかん","offset":0},{"word":"時計","reading":"とけい","offset":4},{"word":"忘れ","reading":"わすれ","offset":7},{"word":"今朝","reading":"けさ","offset":11},{"word":"もう少し","reading":"もうすこし","offset":13},{"word":"財布","reading":"さいふ","offset":18},{"word":"忘れる","reading":"わすれる","offset":21}]},{"id":"sentence-47","text":"最近どうしたの?","start":316.76,"end":317.293,"readings":[{"word":"最近","reading":"さいきん","offset":0}]},{"id":"sentence-48","text":"あなた。","start":317.293,"end":317.56,"readings":[]},{"id":"sentence-49","text":"もう年かな?","start":325.88,"end":326.908,"readings":[{"word":"年","reading":"とし","offset":2}]},{"id":"sentence-50","text":"今日男の人は何を忘れましたか?","start":326.908,"end":329.479,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"何","reading":"なに","offset":6},{"word":"忘れ","reading":"わすれ","offset":8}]},{"id":"sentence-51","text":"6さん、女の人と男の人が話しています。","start":353.479,"end":358.52,"readings":[{"word":"女","reading":"おんな","offset":4},{"word":"人","reading":"ひと","offset":6},{"word":"男","reading":"おとこ","offset":8},{"word":"人","reading":"ひと","offset":10},{"word":"話し","reading":"はなし","offset":12}]},{"id":"sentence-52","text":"2人は何をプレゼントしますか?","start":360.28,"end":363.479,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"何","reading":"なに","offset":3}]},{"id":"sentence-53","text":"おじいちゃん今年でしょ?","start":364.8,"end":367.111,"readings":[{"word":"今年","reading":"ことし","offset":6}]},{"id":"sentence-54","text":"何かプレゼント考えなくちゃね。","start":367.111,"end":370,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"考え","reading":"かんがえ","offset":7}]},{"id":"sentence-55","text":"そうだなあ。","start":371.8,"end":372.747,"readings":[]},{"id":"sentence-56","text":"ネクタイなんかどうだろう?","start":372.747,"end":374.8,"readings":[]},{"id":"sentence-57","text":"おじいちゃん、もうスーツなんか着ないわよ。","start":375.919,"end":378.919,"readings":[{"word":"着","reading":"き","offset":15}]},{"id":"sentence-58","text":"そうか。","start":379.8,"end":380.675,"readings":[]},{"id":"sentence-59","text":"じゃあセーターにしようか。","start":380.675,"end":383.52,"readings":[]},{"id":"sentence-60","text":"セーターは去年したでしょ?","start":383.52,"end":386.039,"readings":[{"word":"去年","reading":"きょねん","offset":5}]},{"id":"sentence-61","text":"あ、そうだったね。","start":386.039,"end":386.833,"readings":[]},{"id":"sentence-62","text":"髪の毛が少なくて寒そうだから帽子なんかどうだろう。","start":386.833,"end":389.039,"readings":[{"word":"髪の毛","reading":"かみのけ","offset":0},{"word":"少なく","reading":"すくなく","offset":4},{"word":"寒","reading":"さむ","offset":8},{"word":"帽子","reading":"ぼうし","offset":14}]},{"id":"sentence-63","text":"系糸の温かいのがいいわね。","start":393.919,"end":395.312,"readings":[{"word":"系","reading":"けい","offset":0},{"word":"糸","reading":"いと","offset":1},{"word":"温かい","reading":"あたたかい","offset":3}]},{"id":"sentence-64","text":"散歩用に手袋もつけてあげよう。","start":395.312,"end":396.919,"readings":[{"word":"散歩","reading":"さんぽ","offset":0},{"word":"用","reading":"よう","offset":2},{"word":"手袋","reading":"てぶくろ","offset":4}]},{"id":"sentence-65","text":"いいね。","start":400.52,"end":403.199,"readings":[]},{"id":"sentence-66","text":"2人は何をプレゼントしますか?","start":407.4,"end":413.199,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"何","reading":"なに","offset":3}]},{"id":"sentence-67","text":"7番男の人がしています。","start":426.599,"end":428.951,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4}]},{"id":"sentence-68","text":"誰からボールペンをもらったのですか?","start":428.951,"end":432.479,"readings":[{"word":"誰","reading":"だれ","offset":0}]},{"id":"sentence-69","text":"うちは5人家族でとても仲がいいです。","start":435.16,"end":435.963,"readings":[{"word":"人","reading":"にん","offset":4},{"word":"家族","reading":"かぞく","offset":5},{"word":"仲","reading":"なか","offset":11}]},{"id":"sentence-70","text":"誕生日にはプレゼントをあげたりもらったりします。","start":435.963,"end":437.033,"readings":[{"word":"誕生","reading":"たんじょう","offset":0},{"word":"日","reading":"び","offset":2}]},{"id":"sentence-71","text":"今年は妹に花をあげたらボールペンをくれました。","start":437.033,"end":438.058,"readings":[{"word":"今年","reading":"ことし","offset":0},{"word":"妹","reading":"いもうと","offset":3},{"word":"花","reading":"はな","offset":5}]},{"id":"sentence-72","text":"父と母にはセーターと靴を買ってもらいました。","start":438.058,"end":439.039,"readings":[{"word":"父","reading":"ちち","offset":0},{"word":"母","reading":"はは","offset":2},{"word":"靴","reading":"くつ","offset":10},{"word":"買っ","reading":"かっ","offset":12}]},{"id":"sentence-73","text":"兄は外国で勉強していますが、何か送ってくれるでしょう?","start":456.319,"end":464.319,"readings":[{"word":"兄","reading":"あに","offset":0},{"word":"外国","reading":"がいこく","offset":2},{"word":"勉強","reading":"べんきょう","offset":5},{"word":"何","reading":"なに","offset":14},{"word":"送っ","reading":"おくっ","offset":16}]},{"id":"sentence-74","text":"誰からボールペンをもらったのですかます","start":467.759,"end":473.599,"readings":[{"word":"誰","reading":"だれ","offset":0}]},{"id":"sentence-75","text":"8番男の人と女の人が話しています。","start":486.879,"end":489.187,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-76","text":"女の人は初めにくいらしましたか?","start":489.187,"end":491.36,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"初め","reading":"はじめ","offset":4}]},{"id":"sentence-77","text":"はい。","start":497.52,"end":498.133,"readings":[]},{"id":"sentence-78","text":"お客さん、全部で4000円です。","start":498.133,"end":501.4,"readings":[{"word":"お客","reading":"おきゃく","offset":0},{"word":"全部","reading":"ぜんぶ","offset":5},{"word":"円","reading":"えん","offset":12}]},{"id":"sentence-79","text":"はい。","start":501.4,"end":502.599,"readings":[]},{"id":"sentence-80","text":"すみません。","start":502.599,"end":504.153,"readings":[]},{"id":"sentence-81","text":"こ、これ3000円ですが。","start":504.153,"end":507.52,"readings":[{"word":"円","reading":"えん","offset":8}]},{"id":"sentence-82","text":"ごめんなさい。","start":507.52,"end":509.08,"readings":[]},{"id":"sentence-83","text":"1枚足りなかったわね。","start":509.08,"end":511.743,"readings":[{"word":"枚","reading":"まい","offset":1},{"word":"足り","reading":"たり","offset":2}]},{"id":"sentence-84","text":"えっと、500円が1枚、100円が4枚。","start":511.743,"end":516.585,"readings":[{"word":"円","reading":"えん","offset":7},{"word":"枚","reading":"まい","offset":10},{"word":"円","reading":"えん","offset":15},{"word":"枚","reading":"まい","offset":18}]},{"id":"sentence-85","text":"まだ100円足りないわ。","start":516.585,"end":519.491,"readings":[{"word":"円","reading":"えん","offset":5},{"word":"足り","reading":"たり","offset":6}]},{"id":"sentence-86","text":"えっと、100円。","start":519.491,"end":521.669,"readings":[{"word":"円","reading":"えん","offset":7}]},{"id":"sentence-87","text":"100円。","start":521.669,"end":522.88,"readings":[{"word":"円","reading":"えん","offset":3}]},{"id":"sentence-88","text":"まあまあ、お客さん、後の100円はいいですよ。","start":522.88,"end":529.938,"readings":[{"word":"お客","reading":"おきゃく","offset":5},{"word":"後","reading":"ご","offset":10},{"word":"円","reading":"えん","offset":15}]},{"id":"sentence-89","text":"ああ。","start":529.938,"end":530.859,"readings":[]},{"id":"sentence-90","text":"そうですか。","start":530.859,"end":532.7,"readings":[]},{"id":"sentence-91","text":"すみません。","start":532.7,"end":534.541,"readings":[]},{"id":"sentence-92","text":"女の人は初めにいくら出しましたか?","start":536.48,"end":542.72,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"初め","reading":"はじめ","offset":4},{"word":"出し","reading":"だし","offset":10}]},{"id":"sentence-93","text":"問題2問題2ではま聞いてください。","start":555.32,"end":563.88,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"聞い","reading":"きい","offset":9}]},{"id":"sentence-94","text":"その後問題用紙を見てください。","start":563.88,"end":569.079,"readings":[{"word":"その後","reading":"そのご","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"用紙","reading":"ようし","offset":5},{"word":"見","reading":"み","offset":8}]},{"id":"sentence-95","text":"読む時間があります。","start":569.079,"end":572.8,"readings":[{"word":"読む","reading":"よむ","offset":0},{"word":"時間","reading":"じかん","offset":2}]},{"id":"sentence-96","text":"それから話を聞いて問題用紙の1から4の中から1番いいものを1つ選んでください","start":572.8,"end":586.399,"readings":[{"word":"話","reading":"はなし","offset":4},{"word":"聞い","reading":"きい","offset":6},{"word":"問題","reading":"もんだい","offset":9},{"word":"用紙","reading":"ようし","offset":11},{"word":"中","reading":"なか","offset":19},{"word":"番","reading":"ばん","offset":23},{"word":"選ん","reading":"えらん","offset":31}]},{"id":"sentence-97","text":"1番女の人が話しています。","start":590.48,"end":595.079,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"女","reading":"おんな","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"話し","reading":"はなし","offset":6}]},{"id":"sentence-98","text":"どんな人が何のために小さい服を買いますか?","start":595.2,"end":602.32,"readings":[{"word":"人","reading":"ひと","offset":3},{"word":"何","reading":"なに","offset":5},{"word":"小さい","reading":"ちいさい","offset":10},{"word":"服","reading":"ふく","offset":13},{"word":"買い","reading":"かい","offset":15}]},{"id":"sentence-99","text":"この小さい服がよく売れています。","start":623.48,"end":627.793,"readings":[{"word":"小さい","reading":"ちいさい","offset":2},{"word":"服","reading":"ふく","offset":5},{"word":"売れ","reading":"うれ","offset":9}]},{"id":"sentence-100","text":"昔は女の子が人形に着せるのに買っていたのですが、大人の人が買っていきます。","start":627.793,"end":637.766,"readings":[{"word":"昔","reading":"むかし","offset":0},{"word":"女の子","reading":"おんなのこ","offset":2},{"word":"人形","reading":"にんぎょう","offset":6},{"word":"着せる","reading":"きせる","offset":9},{"word":"買っ","reading":"かっ","offset":14},{"word":"大人","reading":"おとな","offset":24},{"word":"人","reading":"ひと","offset":27},{"word":"買っ","reading":"かっ","offset":29}]},{"id":"sentence-101","text":"いえ、お人形じゃなく着せるんですよ。","start":637.766,"end":642.618,"readings":[{"word":"人形","reading":"にんぎょう","offset":4},{"word":"着せる","reading":"きせる","offset":10}]},{"id":"sentence-102","text":"ペットが喜ぶのかしらって思ってしまいます。","start":642.618,"end":648.279,"readings":[{"word":"喜ぶ","reading":"よろこぶ","offset":4},{"word":"思っ","reading":"おもっ","offset":12}]},{"id":"sentence-103","text":"どんな人が何のために小さい服を買いますか?","start":651.92,"end":659.04,"readings":[{"word":"人","reading":"ひと","offset":3},{"word":"何","reading":"なに","offset":5},{"word":"小さい","reading":"ちいさい","offset":10},{"word":"服","reading":"ふく","offset":13},{"word":"買い","reading":"かい","offset":15}]},{"id":"sentence-104","text":"2番男の人と女の人が話しています。","start":672.48,"end":679.046,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-105","text":"男の人はどうして眠いのですか?","start":679.046,"end":684.839,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"眠い","reading":"ねむい","offset":8}]},{"id":"sentence-106","text":"眠そうね。","start":706.079,"end":707.959,"readings":[{"word":"眠","reading":"ねむ","offset":0}]},{"id":"sentence-107","text":"夕べ遅くまでテレビ見てたんじゃないの?","start":707.959,"end":710.959,"readings":[{"word":"夕べ","reading":"ゆうべ","offset":0},{"word":"遅く","reading":"おそく","offset":2},{"word":"見","reading":"み","offset":9}]},{"id":"sentence-108","text":"見てたけど10時には寝たんだよ。","start":711.56,"end":715.079,"readings":[{"word":"見","reading":"み","offset":0},{"word":"時","reading":"じ","offset":7},{"word":"寝","reading":"ね","offset":10}]},{"id":"sentence-109","text":"じゃあそれから本でも読んでたの?","start":715.079,"end":716.925,"readings":[{"word":"本","reading":"ほん","offset":7},{"word":"読ん","reading":"よん","offset":10}]},{"i