ce-120","text":"でもちょっと辛いですね。","start":800.839,"end":802,"readings":[{"word":"辛い","reading":"つらい","offset":6}]},{"id":"sentence-121","text":"そうですか。","start":806.24,"end":806.55,"readings":[]},{"id":"sentence-122","text":"高いとは思いませんが、少し辛すぎますね、私には。","start":806.55,"end":807.792,"readings":[{"word":"高い","reading":"たかい","offset":0},{"word":"思い","reading":"おもい","offset":4},{"word":"少し","reading":"すこし","offset":11},{"word":"辛","reading":"つら","offset":13},{"word":"私","reading":"わたし","offset":20}]},{"id":"sentence-123","text":"女の人はここの料理はどうだと言っていますか?","start":807.792,"end":808.93,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"料理","reading":"りょうり","offset":7},{"word":"言っ","reading":"いっ","offset":14}]},{"id":"sentence-124","text":"女の人です。","start":808.93,"end":809.24,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2}]},{"id":"sentence-125","text":"4番男の人と女の人が話しています。","start":841.759,"end":846.48,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-126","text":"吉田さんはどの人ですか?","start":848.199,"end":853.32,"readings":[{"word":"吉田","reading":"よしだ","offset":0},{"word":"どの人","reading":"どのひと","offset":5}]},{"id":"sentence-127","text":"これ吉田さん、随分痩せたのね。","start":874.44,"end":876.729,"readings":[{"word":"吉田","reading":"よしだ","offset":2},{"word":"随分","reading":"ずいぶん","offset":7},{"word":"痩せ","reading":"やせ","offset":9}]},{"id":"sentence-128","text":"昔は丸い顔だったのにね。","start":876.729,"end":878.56,"readings":[{"word":"昔","reading":"むかし","offset":0},{"word":"丸い","reading":"まるい","offset":2},{"word":"顔","reading":"かお","offset":4}]},{"id":"sentence-129","text":"サッカーを始めてから痩せたんだよ。","start":882,"end":885,"readings":[{"word":"始め","reading":"はじめ","offset":5},{"word":"痩せ","reading":"やせ","offset":10}]},{"id":