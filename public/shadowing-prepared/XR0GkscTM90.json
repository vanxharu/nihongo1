fset":4},{"word":"皆さん","reading":"みなさん","offset":7},{"word":"困っ","reading":"こまっ","offset":10}]},{"id":"sentence-142","text":"それが主人は料理をしてくれたし、娘は選濯をよくやってくれました。","start":968.399,"end":970.144,"readings":[{"word":"主人","reading":"しゅじん","offset":3},{"word":"料理","reading":"りょうり","offset":6},{"word":"娘","reading":"むすめ","offset":16},{"word":"選","reading":"せん","offset":18}]},{"id":"sentence-143","text":"息子の方は掃除でもしてくれれば良かったのにね。","start":970.144,"end":971.399,"readings":[{"word":"息子","reading":"むすこ","offset":0},{"word":"方","reading":"ほう","offset":3},{"word":"掃除","reading":"そうじ","offset":5},{"word":"良かっ","reading":"よかっ","offset":15}]},{"id":"sentence-144","text":"勉強もしないで遊んでばかりたらしいんですよ。","start":981.12,"end":984.12,"readings":[{"word":"勉強","reading":"べんきょう","offset":0},{"word":"遊ん","reading":"あそん","offset":7}]},{"id":"sentence-145","text":"そうですか。","start":985.92,"end":986.82,"readings":[]},{"id":"sentence-146","text":"まあ、男の子ですからね。","start":986.82,"end":988.62,"readings":[{"word":"男の子","reading":"おとこのこ","offset":3}]},{"id":"sentence-147","text":"この","start":988.62,"end":988.92,"readings":[]},{"id":"sentence-148","text":"週間、女の人の息子さんは何をしましたか?","start":996.279,"end":998.501,"readings":[{"word":"週間","reading":"しゅうかん","offset":0},{"word":"女","reading":"おんな","offset":3},{"word":"人","reading":"ひと","offset":5},{"word":"息子","reading":"むすこ","offset":7},{"word":"何","reading":"なに","offset":12}]},{"id":"sentence-149","text":"息子さんです。","start":998.501,"end":999.279,"readings":[{"word":"息子","reading":"むすこ","offset":0}]},{"id":"sentence-150","text":"6番男の人と女の人が話しています。","start":1018.839,"end":1023.36,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-151","text":"2人は何時のどの乗り物で行きますか?","start":1024.28,"end":1030.72,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"何時","reading":"いつ","offset":3},{"word":"乗り物","reading":"のりもの","offset":8},{"word":"行き","reading":"いき","offset":12}]},{"id":"sentence-152","text":"今何時えっと、今1時10分で次の電車は、あ、2時30分だ。","start":1051.84,"end":1062.24,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"何","reading":"なん","offset":1},{"word":"時","reading":"じ","offset":2},{"word":"今","reading":"いま","offset":7},{"word":"時","reading":"じ","offset":9},{"word":"分","reading":"ふん","offset":12},{"word":"次","reading":"つぎ","offset":14},{"word":"電車","reading":"でんしゃ","offset":16},{"word":"時","reading":"じ","offset":23},{"word":"分","reading":"ふん","offset":26}]},{"id":"sentence-153","text":"え、1時間以上も待つのか。","start":1062.24,"end":1065.52,"readings":[{"word":"時間","reading":"じかん","offset":3},{"word":"以上","reading":"いじょう","offset":5},{"word":"待つ","reading":"まつ","offset":8}]},{"id":"sentence-154","text":"うーん、どうしようか。","start":1065.52,"end":1067.732,"readings":[]},{"id":"sentence-155","text":"バスなら1時30分のがあるけど、バスは道も混んでるし。","start":1067.732,"end":1073.16,"readings":[{"word":"時","reading":"じ","offset":5},{"word":"分の","reading":"ぶんの","offset":8},{"word":"道","reading":"みち","offset":19},{"word":"混ん","reading":"こん","offset":21}]},{"id":"sentence-156","text":"でもここから3つ目だからなんでも1時間もかからないだろう。","start":1074.76,"end":1080.919,"readings":[{"word":"目","reading":"め","offset":8},{"word":"時間","reading":"じかん","offset":17}]},{"id":"sentence-157","text":"そうね。","start":1080.919,"end":1083.919,"readings":[]},{"id":"sentence-158","text":"2人は何時のどの乗り物で行きますか?","start":1087.96,"end":1094.28,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"何時","reading":"いつ","offset":3},{"word":"乗り物","reading":"のりもの","offset":8},{"word":"行き","reading":"いき","offset":12}]},{"id":"sentence-159","text":"7番男の人と女の人が話しています。","start":1107.679,"end":1114.479,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-160","text":"生徒は全部で何人来ますか?","start":1114.479,"end":1119.679,"readings":[{"word":"生徒","reading":"せいと","offset":0},{"word":"全部","reading":"ぜんぶ","offset":3},{"word":"何","reading":"なん","offset":6},{"word":"人","reading":"にん","offset":7},{"word":"来","reading":"き","offset":8}]},{"id":"sentence-161","text":"それで5つの机は全持ってきたのね。","start":1140.84,"end":1145,"readings":[{"word":"机","reading":"つくえ","offset":6},{"word":"全","reading":"ぜん","offset":8},{"word":"持っ","reading":"もっ","offset":9}]},{"id":"sentence-162","text":"はい。","start":1145,"end":1145.808,"readings":[]},{"id":"sentence-163","text":"1つの机には2人ずつ座るのよね。","start":1145.808,"end":1150.12,"readings":[{"word":"机","reading":"つくえ","offset":3},{"word":"人","reading":"にん","offset":7},{"word":"座る","reading":"すわる","offset":10}]},{"id":"sentence-164","text":"はい。","start":1150.12,"end":1151.679,"readings":[]},{"id":"sentence-165","text":"えっと、後でもう1つ持ってきてください。","start":1151.679,"end":1155.559,"readings":[{"word":"後で","reading":"あとで","offset":4},{"word":"持っ","reading":"もっ","offset":10}]},{"id":"sentence-166","text":"1人用の机ね。","start":1155.559,"end":1157.124,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"用","reading":"よう","offset":2},{"word":"机","reading":"つくえ","offset":4}]},{"id":"sentence-167","text":"もう1人増えたから。","start":1157.124,"end":1159.36,"readings":[{"word":"人","reading":"にん","offset":3},{"word":"増え","reading":"ふえ","offset":4}]},{"id":"sentence-168","text":"あの生徒の中の1人が急にやめてしまったので。","start":1159.36,"end":1164.4,"readings":[{"word":"生徒","reading":"せいと","offset":2},{"word":"中","reading":"なか","offset":5},{"word":"人","reading":"にん","offset":8},{"word":"急","reading":"きゅう","offset":10}]},{"id":"sentence-169","text":"あ、そうですか。","start":1164.44,"end":1165.583,"readings":[]},{"id":"sentence-170","text":"それならそのままでいいわ。","start":1165.583,"end":1167.44,"readings":[]},{"id":"sentence-171","text":"生徒は全部で何人来ますか?","start":1174.32,"end":1180.12,"readings":[{"word":"生徒","reading":"せいと","offset":0},{"word":"全部","reading":"ぜんぶ","offset":3},{"word":"何","reading":"なん","offset":6},{"word":"人","reading":"にん","offset":7},{"word":"来","reading":"き","offset":8}]},{"id":"sentence-172","text":"問題3問題3では絵を見ながら質問を聞いください。","start":1192.52,"end":1202.72,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"絵","reading":"え","offset":8},{"word":"見","reading":"み","offset":10},{"word":"質問","reading":"しつもん","offset":14},{"word":"聞い","reading":"きい","offset":17}]},{"id":"sentence-173","text":"矢印の人は何と言いますか?","start":1202.72,"end":1207.24,"readings":[{"word":"矢印","reading":"やじるし","offset":0},{"word":"人","reading":"ひと","offset":3},{"word":"何","reading":"なに","offset":5},{"word":"言い","reading":"いい","offset":7}]},{"id":"sentence-174","text":"1から3の中から1番いいものを1つ選んでください。","start":1207.24,"end":1216.4,"readings":[{"word":"中","reading":"なか","offset":5},{"word":"番","reading":"ばん","offset":9},{"word":"選ん","reading":"えらん","offset":17}]},{"id":"sentence-175","text":"1番うちを出て会社へ行きます。","start":1220.36,"end":1225.133,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"出","reading":"で","offset":5},{"word":"会社","reading":"かいしゃ","offset":7},{"word":"行き","reading":"いき","offset":10}]},{"id":"sentence-176","text":"何と言いますか?","start":1225.133,"end":1227.679,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-177","text":"1行きます。","start":1227.679,"end":1231.799,"readings":[{"word":"行き","reading":"いき","offset":1}]},{"id":"sentence-178","text":"2行ってらっしゃい。","start":1231.799,"end":1235.76,"readings":[{"word":"行っ","reading":"おこなっ","offset":1}]},{"id":"sentence-179","text":"3ちょっとそこまで","start":1235.76,"end":1240.32,"readings":[]},{"id":"sentence-180","text":"2番客をソファーに座らせます。","start":1251.84,"end":1256.72,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"客","reading":"きゃく","offset":2},{"word":"座ら","reading":"すわら","offset":9}]},{"id":"sentence-181","text":"と言いますか?","start":1256.72,"end":1260.6,"readings":[{"word":"言い","reading":"いい","offset":1}]},{"id":"sentence-182","text":"どうぞお入りください。","start":1260.6,"end":1263.6,"readings":[{"word":"入り","reading":"はいり","offset":4}]},{"id":"sentence-183","text":"2どうぞおかけください。","start":1264.12,"end":1267.96,"readings":[]},{"id":"sentence-184","text":"3どうぞお上がりください。","start":1268.64,"end":1272.64,"readings":[{"word":"上がり","reading":"あがり","offset":5}]},{"id":"sentence-185","text":"番友達と空港で分別れます。","start":1285.76,"end":1287.617,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"友達","reading":"ともだち","offset":1},{"word":"空港","reading":"くうこう","offset":4},{"word":"分別","reading":"ふんべつ","offset":7}]},{"id":"sentence-186","text":"何と言いますか?","start":1287.617,"end":1288.76,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-187","text":"これから別れますね。","start":1294.64,"end":1297.64,"readings":[{"word":"別れ","reading":"わかれ","offset":4}]},{"id":"sentence-188","text":"2お大事に。","start":1298.32,"end":1302.08,"readings":[{"word":"大事","reading":"だいじ","offset":2}]},{"id":"sentence-189","text":"3じゃあお元気で。","start":1302.08,"end":1306.039,"readings":[{"word":"元気","reading":"げんき","offset":5}]},{"id":"sentence-190","text":"4番1年後また友達と会いました。","start":1318.52,"end":1321.72,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"年","reading":"ねん","offset":3},{"word":"後","reading":"ご","offset":4},{"word":"友達","reading":"ともだち","offset":7},{"word":"会い","reading":"あい","offset":10}]},{"id":"sentence-191","text":"何と言いますか?","start":1321.72,"end":1323.32,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-192","text":"同じところで同じ人ですね。","start":1328.88,"end":1331.88,"readings":[{"word":"同じ","reading":"おなじ","offset":0},{"word":"同じ","reading":"おなじ","offset":6},{"word":"人","reading":"ひと","offset":8}]},{"id":"sentence-193","text":"2、また会いましたか?","start":1333.44,"end":1338.12,"readings":[{"word":"会い","reading":"あい","offset":4}]},{"id":"sentence-194","text":"3、お久しぶりですね。","start":1338.12,"end":1343.2,"readings":[{"word":"久しぶり","reading":"ひさしぶり","offset":3}]},{"id":"sentence-195","text":"5番友達にプレゼントをもらいます。","start":1354.48,"end":1359.44,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"友達","reading":"ともだち","offset":2}]},{"id":"sentence-196","text":"と言いますか?","start":1359.44,"end":1363.679,"readings":[{"word":"言い","reading":"いい","offset":1}]},{"id":"sentence-197","text":"それはいいプレゼントでしょうね。","start":1363.679,"end":1366.679,"readings":[]},{"id":"sentence-198","text":"2じゃあ遠慮なくただきます。","start":1367.96,"end":1371.919,"readings":[{"word":"遠慮なく","reading":"えんりょなく","offset":4}]},{"id":"sentence-199","text":"3どうぞ大事にしてください。","start":1373.4,"end":1377.48,"readings":[{"word":"大事","reading":"だいじ","offset":4}]},{"id":"sentence-200","text":"問題4問題4では絵などがありません。","start":1389.799,"end":1392.988,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"絵","reading":"え","offset":8}]},{"id":"sentence-201","text":"まず文を聞いてください。","start":1392.988,"end":1395.114,"readings":[{"word":"文","reading":"ぶん","offset":2},{"word":"聞い","reading":"きい","offset":4}]},{"id":"sentence-202","text":"それからその返事を聞いて","start":1395.114,"end":1397.24,"readings":[{"word":"返事","reading":"へんじ","offset":6},{"word":"聞い","reading":"きい","offset":9}]},{"id":"sentence-203","text":"1から3の中から1番いいものを1つ選んでください。","start":1405.84,"end":1413.279,"readings":[{"word":"中","reading":"なか","offset":5},{"word":"番","reading":"ばん","offset":9},{"word":"選ん","reading":"えらん","offset":17}]},{"id":"sentence-204","text":"1番例のことを田中さんに連絡してくれない?","start":1418.76,"end":1423.6,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"例","reading":"れい","offset":2},{"word":"田中","reading":"たなか","offset":7},{"word":"連絡","reading":"れんらく","offset":12}]},{"id":"sentence-205","text":"はい、連絡してください。","start":1427.08,"end":1430.08,"readings":[{"word":"連絡","reading":"れんらく","offset":3}]},{"id":"sentence-206","text":"2はい、例を上げてみましょう。","start":1431.12,"end":1435.12,"readings":[{"word":"例","reading":"れい","offset":4},{"word":"上げ","reading":"あげ","offset":6}]},{"id":"sentence-207","text":"3はい、承知しました。","start":1436.52,"end":1442.039,"readings":[{"word":"承知","reading":"しょうち","offset":4}]},{"id":"sentence-208","text":"2番この仕事誰かに頼もうか。","start":1453.279,"end":1458.08,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"仕事","reading":"しごと","offset":4},{"word":"誰","reading":"だれ","offset":6},{"word":"頼も","reading":"たのも","offset":9}]},{"id":"sentence-209","text":"井上さんだったらどう?","start":1458.08,"end":1461.08,"readings":[{"word":"井上","reading":"いのうえ","offset":0}]},{"id":"sentence-210","text":"あの人はちょっと2誰に頼んだら3人だけじゃあ","start":1463.08,"end":1476.279,"readings":[{"word":"人","reading":"ひと","offset":2},{"word":"誰","reading":"だれ","offset":9},{"word":"頼ん","reading":"たのん","offset":11},{"word":"人","reading":"にん","offset":16}]},{"id":"sentence-211","text":"番。","start":1488.279,"end":1489.32,"readings":[{"word":"番","reading":"ばん","offset":0}]},{"id":"sentence-212","text":"この誰に頼んだらいいでしょう?","start":1489.32,"end":1492.32,"readings":[{"word":"誰","reading":"だれ","offset":2},{"word":"頼ん","reading":"たのん","offset":4}]},{"id":"sentence-213","text":"そうですか。","start":1495.52,"end":1496.467,"readings":[]},{"id":"sentence-214","text":"中村さんってどんな人なの?","start":1496.467,"end":1498.52,"readings":[{"word":"中村","reading":"なかむら","offset":0},{"word":"人","reading":"ひと","offset":9}]},{"id":"sentence-215","text":"2。","start":1501.24,"end":1501.859,"readings":[]},{"id":"sentence-216","text":"そうですね。","start":1501.859,"end":1503.717,"readings":[]},{"id":"sentence-217","text":"中村さんに頼めばいいと思うよ。","start":1503.717,"end":1508.36,"readings":[{"word":"中村","reading":"なかむら","offset":0},{"word":"頼め","reading":"たのめ","offset":5},{"word":"思う","reading":"おもう","offset":11}]},{"id":"sentence-218","text":"3中村さんが見えたらよろしくと伝えて。","start":1508.36,"end":1515.48,"readings":[{"word":"中村","reading":"なかむら","offset":1},{"word":"見え","reading":"みえ","offset":6},{"word":"伝え","reading":"つたえ","offset":15}]},{"id":"sentence-219","text":"4番。","start":1526.76,"end":1528.44,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-220","text":"お土産はどんなものがいいでしょう?","start":1528.44,"end":1531.44,"readings":[{"word":"土産","reading":"みやげ","offset":1}]},{"id":"sentence-221","text":"23000円ぐらいもらいたいんだけど2000円ぐらいのものでいいだろう。","start":1534.159,"end":1543.12,"readings":[{"word":"円","reading":"えん","offset":5},{"word":"円","reading":"えん","offset":22}]},{"id":"sentence-222","text":"円ぐらいしか欲しくないのか?","start":1545.64,"end":1550.52,"readings":[{"word":"円","reading":"えん","offset":0},{"word":"欲しく","reading":"ほしく","offset":6}]},{"id":"sentence-223","text":"5番これは面白い本是非読んでください。","start":1561.679,"end":1568.799,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"面白い","reading":"おもしろい","offset":5},{"word":"本","reading":"ほん","offset":8},{"word":"是非","reading":"ぜひ","offset":9},{"word":"読ん","reading":"よん","offset":11}]},{"id":"sentence-224","text":"1読んでから色々聞かせてください。","start":1568.799,"end":1574.52,"readings":[{"word":"読ん","reading":"よん","offset":1},{"word":"色々","reading":"いろいろ","offset":6},{"word":"聞か","reading":"きか","offset":8}]},{"id":"sentence-225","text":"2そうですか?","start":1574.52,"end":1576.835,"readings":[]},{"id":"sentence-226","text":"それほど面白くないですか3できたら1週間ばかり貸していただけますか?","start":1576.835,"end":1588.08,"readings":[{"word":"面白く","reading":"おもしろく","offset":4},{"word":"週間","reading":"しゅうかん","offset":18},{"word":"貸し","reading":"かし","offset":23}]},{"id":"sentence-227","text":"6番こんにちは。","start":1599.32,"end":1601.616,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-228","text":"今日は暑いですね。","start":1601.616,"end":1604.2,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"暑い","reading":"あつい","offset":3}]},{"id":"sentence-229","text":"本当に。ところでお出かけですか?","start":1604.2,"end":1607.2,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"お出かけ","reading":"おでかけ","offset":8}]},{"id":"sentence-230","text":"ええ、ちょっとそこまで2。","start":1610.52,"end":1614.534,"readings":[]},{"id":"sentence-231","text":"暑いですけど我慢します。","start":1614.534,"end":1618.24,"readings":[{"word":"暑い","reading":"あつい","offset":0},{"word":"我慢","reading":"がまん","offset":6}]},{"id":"sentence-232","text":"3はい、ここで失礼します。","start":1619.52,"end":1623.44,"readings":[{"word":"失礼","reading":"しつれい","offset":7}]},{"id":"sentence-233","text":"7番。","start":1636.679,"end":1638.279,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-234","text":"今度会社の前に新しくできた店。","start":1638.279,"end":1640.779,"readings":[{"word":"今度","reading":"こんど","offset":0},{"word":"会社","reading":"かいしゃ","offset":2},{"word":"前","reading":"まえ","offset":5},{"word":"新しく","reading":"あたらしく","offset":7},{"word":"店","reading":"みせ","offset":13}]},{"id":"sentence-235","text":"どう?","start":1640.779,"end":1641.279,"readings":[]},{"id":"sentence-236","text":"じゃあ今度またお願いね。","start":1645.679,"end":1648.679,"readings":[{"word":"今度","reading":"こんど","offset":3},{"word":"お願い","reading":"おねがい","offset":7}]},{"id":"sentence-237","text":"2ああ、遠くて古い店だな。","start":1650.32,"end":1654.159,"readings":[{"word":"遠く","reading":"とおく","offset":4},{"word":"古い","reading":"ふるい","offset":7},{"word":"店","reading":"みせ","offset":9}]},{"id":"sentence-238","text":"3うん。","start":1655.799,"end":1657.389,"readings":[]},{"id":"sentence-239","text":"結構流行ってるようだ。","start":1657.389,"end":1661.76,"readings":[{"word":"結構","reading":"けっこう","offset":0},{"word":"流行っ","reading":"はやっ","offset":2}]},{"id":"sentence-240","text":"8番全部食べなければならないの。","start":1673.08,"end":1679.84,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"全部","reading":"ぜんぶ","offset":2},{"word":"食べ","reading":"たべ","offset":4}]},{"id":"sentence-241","text":"一部と全部とどちらのものを食べるか言ってください。","start":1680.399,"end":1686.64,"readings":[{"word":"一部","reading":"いちぶ","offset":0},{"word":"全部","reading":"ぜんぶ","offset":3},{"word":"食べる","reading":"たべる","offset":13},{"word":"言っ","reading":"いっ","offset":17}]},{"id":"sentence-242","text":"2美味しいから食べたければたくさん食べても構わないよ。","start":1686.64,"end":1693.64,"readings":[{"word":"美味しい","reading":"おいしい","offset":1},{"word":"食べ","reading":"たべ","offset":7},{"word":"食べ","reading":"たべ","offset":17},{"word":"構わ","reading":"かまわ","offset":21}]},{"id":"sentence-243","text":"3いや、食べられなければ全部食べなくても構わないよ。","start":1693.64,"end":1701.679,"readings":[{"word":"食べ","reading":"たべ","offset":4},{"word":"全部","reading":"ぜんぶ","offset":12},{"word":"食べ","reading":"たべ","offset":14},{"word":"構わ","reading":"かまわ","offset":20}]},{"id":"sentence-244","text":"これで長試験を終わります。","start":1711.88,"end":1718.799,"readings":[{"word":"長","reading":"ちょう","offset":3},{"word":"試験","reading":"しけん","offset":4},{"word":"終わり","reading":"おわり","offset":7}]}]}