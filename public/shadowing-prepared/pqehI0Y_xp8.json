{"videoId":"pqehI0Y_xp8","title":"Đề luyện nghe N4 · Bài 06","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"日本語能力試験聴会N5これからN5の会試験を始めます。","start":4.319,"end":19.76,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"能力","reading":"のうりょく","offset":3},{"word":"試験","reading":"しけん","offset":5},{"word":"会","reading":"かい","offset":8},{"word":"会","reading":"かい","offset":18},{"word":"試験","reading":"しけん","offset":19},{"word":"始め","reading":"はじめ","offset":22}]},{"id":"sentence-1","text":"メモを取ってもいいです。","start":19.76,"end":23.16,"readings":[{"word":"取っ","reading":"とっ","offset":3}]},{"id":"sentence-2","text":"問題用紙を開けてください。","start":23.16,"end":29.199,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"用紙","reading":"ようし","offset":2},{"word":"開け","reading":"あけ","offset":5}]},{"id":"sentence-3","text":"問題1問題1ではまず問を聞いてください。","start":32.32,"end":36.249,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"問","reading":"とい","offset":10},{"word":"聞い","reading":"きい","offset":12}]},{"id":"sentence-4","text":"それから話を聞いて問題用紙の","start":36.249,"end":39,"readings":[{"word":"話","reading":"はなし","offset":4},{"word":"聞い","reading":"きい","offset":6},{"word":"問題","reading":"もんだい","offset":9},{"word":"用紙","reading":"ようし","offset":11}]},{"id":"sentence-5","text":"1から4の中から1番いいものを1つ選んでください。","start":45.48,"end":52.719,"readings":[{"word":"中","reading":"なか","offset":5},{"word":"番","reading":"ばん","offset":9},{"word":"選ん","reading":"えらん","offset":17}]},{"id":"sentence-6","text":"1番先生が生徒に話しています。","start":58.68,"end":60.583,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"先生","reading":"せんせい","offset":2},{"word":"生徒","reading":"せいと","offset":5},{"word":"話し","reading":"はなし","offset":8}]},{"id":"sentence-7","text":"生徒は休み中に何をしますか?","start":60.583,"end":62.359,"readings":[{"word":"生徒","reading":"せいと","offset":0},{"word":"休み","reading":"やすみ","offset":3},{"word":"中","reading":"ちゅう","offset":5},{"word":"何","reading":"なに","offset":7}]},{"id":"sentence-8","text":"休み中です。","start":62.359,"end":63.12,"readings":[{"word":"休み","reading":"やすみ","offset":0},{"word":"中","reading":"ちゅう","offset":2}]},{"id":"sentence-9","text":"休みが終わるとすぐテストがありますからその前に勉強しましょう。","start":70.4,"end":72.032,"readings":[{"word":"休み","reading":"やすみ","offset":0},{"word":"終わる","reading":"おわる","offset":3},{"word":"前","reading":"まえ","offset":21},{"word":"勉強","reading":"べんきょう","offset":23}]},{"id":"sentence-10","text":"テストが終わったらスポーツや旅行で楽しんでください。","start":72.032,"end":73.4,"readings":[{"word":"終わっ","reading":"おわっ","offset":4},{"word":"旅行","reading":"りょこう","offset":14},{"word":"楽しん","reading":"たのしん","offset":17}]},{"id":"sentence-11","text":"家の仕事をするのもいいことですよ。","start":82.799,"end":85.799,"readings":[{"word":"家","reading":"いえ","offset":0},{"word":"仕事","reading":"しごと","offset":2}]},{"id":"sentence-12","text":"はい、頑張ります。","start":86.6,"end":87.531,"readings":[{"word":"頑張り","reading":"がんばり","offset":3}]},{"id":"sentence-13","text":"生徒は休み中に何をしますか?","start":87.531,"end":88.979,"readings":[{"word":"生徒","reading":"せいと","offset":0},{"word":"休み","reading":"やすみ","offset":3},{"word":"中","reading":"ちゅう","offset":5},{"word":"何","reading":"なに","offset":7}]},{"id":"sentence-14","text":"休み中です。","start":88.979,"end":89.6,"readings":[{"word":"休み","reading":"やすみ","offset":0},{"word":"中","reading":"ちゅう","offset":2}]},{"id":"sentence-15","text":"2番。","start":116.399,"end":117.64,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-16","text":"お母さんと男の子が話しています。","start":117.64,"end":119.052,"readings":[{"word":"お母さん","reading":"おかあさん","offset":0},{"word":"男の子","reading":"おとこのこ","offset":5},{"word":"話し","reading":"はなし","offset":9}]},{"id":"sentence-17","text":"男の子はこれから初めに何をしますか?","start":119.052,"end":120.64,"readings":[{"word":"男の子","reading":"おとこのこ","offset":0},{"word":"初め","reading":"はじめ","offset":8},{"word":"何","reading":"なに","offset":11}]},{"id":"sentence-18","text":"ただいま。","start":125.799,"end":127.119,"readings":[]},{"id":"sentence-19","text":"お帰り。","start":127.119,"end":128.16,"readings":[{"word":"帰り","reading":"かえり","offset":1}]},{"id":"sentence-20","text":"お母さん、お腹空いたよ。","start":128.16,"end":130.278,"readings":[{"word":"お母さん","reading":"おかあさん","offset":0},{"word":"お腹","reading":"おなか","offset":5},{"word":"空い","reading":"あい","offset":7}]},{"id":"sentence-21","text":"何かない?","start":130.278,"end":131.16,"readings":[{"word":"何","reading":"なに","offset":0}]},{"id":"sentence-22","text":"冷蔵庫にケーキが入ってるわよ。","start":132.52,"end":135.52,"readings":[{"word":"冷蔵庫","reading":"れいぞうこ","offset":0},{"word":"入っ","reading":"はいっ","offset":8}]},{"id":"sentence-23","text":"うわあ、3つもあるね。","start":136.08,"end":138.968,"readings":[]},{"id":"sentence-24","text":"買ったの?","start":138.968,"end":140.28,"readings":[{"word":"買っ","reading":"かっ","offset":0}]},{"id":"sentence-25","text":"お隣から頂いたのよ。","start":140.28,"end":141.218,"readings":[{"word":"お隣","reading":"おとなり","offset":0},{"word":"頂い","reading":"いただい","offset":4}]},{"id":"sentence-26","text":"それより手洗ったの?","start":141.218,"end":142.155,"readings":[{"word":"手","reading":"て","offset":4},{"word":"洗っ","reading":"あらっ","offset":5}]},{"id":"sentence-27","text":"早く洗っていらっしゃい。","start":142.155,"end":143.28,"readings":[{"word":"早く","reading":"はやく","offset":0},{"word":"洗っ","reading":"あらっ","offset":2}]},{"id":"sentence-28","text":"はーい。","start":147.4,"end":150.4,"readings":[]},{"id":"sentence-29","text":"男の子はこれから初めに何をしますか?","start":154.239,"end":157.239,"readings":[{"word":"男の子","reading":"おとこのこ","offset":0},{"word":"初め","reading":"はじめ","offset":8},{"word":"何","reading":"なに","offset":11}]},{"id":"sentence-30","text":"番。","start":174,"end":174.92,"readings":[{"word":"番","reading":"ばん","offset":0}]},{"id":"sentence-31","text":"男の人と女の人が話しています。","start":174.92,"end":177.92,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"女","reading":"おんな","offset":4},{"word":"人","reading":"ひと","offset":6},{"word":"話し","reading":"はなし","offset":8}]},{"id":"sentence-32","text":"女の人はどのスポーツをしますか?","start":178.68,"end":181.68,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2}]},{"id":"sentence-33","text":"来週会社のスポーツ週間だけど何に出る?","start":183.12,"end":185.156,"readings":[{"word":"来週","reading":"らいしゅう","offset":0},{"word":"会社","reading":"かいしゃ","offset":2},{"word":"週間","reading":"しゅうかん","offset":9},{"word":"何","reading":"なに","offset":14},{"word":"出る","reading":"でる","offset":16}]},{"id":"sentence-34","text":"走るとか飛ぶとか?","start":185.156,"end":186.12,"readings":[{"word":"走る","reading":"はしる","offset":0},{"word":"飛ぶ","reading":"とぶ","offset":4}]},{"id":"sentence-35","text":"走るのはダめ。","start":189.84,"end":191.34,"readings":[{"word":"走る","reading":"はしる","offset":0}]},{"id":"sentence-36","text":"飛ぶって上に?","start":191.34,"end":192.84,"readings":[{"word":"飛ぶ","reading":"とぶ","offset":0},{"word":"上","reading":"うえ","offset":4}]},{"id":"sentence-37","text":"上じゃなくて前に飛ぶんだ。","start":194.04,"end":196.959,"readings":[{"word":"上","reading":"うえ","offset":0},{"word":"前","reading":"まえ","offset":6},{"word":"飛ぶ","reading":"とぶ","offset":8}]},{"id":"sentence-38","text":"上ならいいけど前はね。","start":196.959,"end":198.394,"readings":[{"word":"上","reading":"うえ","offset":0},{"word":"前","reading":"まえ","offset":7}]},{"id":"sentence-39","text":"私泳ぐのは結構早いのよ。","start":198.394,"end":199.959,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"泳ぐ","reading":"およぐ","offset":1},{"word":"結構","reading":"けっこう","offset":5},{"word":"早い","reading":"はやい","offset":7}]},{"id":"sentence-40","text":"プールはないよ。","start":203.4,"end":205.36,"readings":[]},{"id":"sentence-41","text":"投げるのは結構遠くまで投げるわよ。","start":205.36,"end":209.76,"readings":[{"word":"投げる","reading":"なげる","offset":0},{"word":"結構","reading":"けっこう","offset":5},{"word":"遠く","reading":"とおく","offset":7},{"word":"投げる","reading":"なげる","offset":11}]},{"id":"sentence-42","text":"じゃあそれで行こう。","start":209.76,"end":212.76,"readings":[{"word":"行こ","reading":"いこ","offset":6}]},{"id":"sentence-43","text":"女の人はどのスポーツをしますか?","start":217.319,"end":223.2,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2}]},{"id":"sentence-44","text":"4番お母さんと女の子が話しています。","start":236.64,"end":242.879,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"お母さん","reading":"おかあさん","offset":2},{"word":"女の子","reading":"おんなのこ","offset":7},{"word":"話し","reading":"はなし","offset":11}]},{"id":"sentence-45","text":"女の子はどんなものがいりませんか?","start":242.879,"end":244.841,"readings":[{"word":"女の子","reading":"おんなのこ","offset":0}]},{"id":"sentence-46","text":"いらないものです。","start":244.841,"end":245.879,"readings":[]},{"id":"sentence-47","text":"あきこちゃん、今日は寒いから長いコート着ていきなさいよ。","start":249.2,"end":251.411,"readings":[{"word":"今日","reading":"きょう","offset":7},{"word":"寒い","reading":"さむい","offset":10},{"word":"長い","reading":"ながい","offset":14},{"word":"着","reading":"き","offset":19}]},{"id":"sentence-48","text":"これなら寒くないね。","start":251.411,"end":252.2,"readings":[{"word":"寒く","reading":"さむく","offset":4}]},{"id":"sentence-49","text":"それに首と手にも今日は本当に寒いから。","start":258.199,"end":261.199,"readings":[{"word":"首","reading":"くび","offset":3},{"word":"手","reading":"て","offset":5},{"word":"今日","reading":"きょう","offset":8},{"word":"本当に","reading":"ほんとうに","offset":11},{"word":"寒い","reading":"さむい","offset":14}]},{"id":"sentence-50","text":"首のところはいいけど手は邪魔なの。","start":263.479,"end":266.479,"readings":[{"word":"首","reading":"くび","offset":0},{"word":"手","reading":"て","offset":10},{"word":"邪魔","reading":"じゃま","offset":12}]},{"id":"sentence-51","text":"じゃあカに入れていけばいいでしょ。","start":267.919,"end":270.919,"readings":[{"word":"入れ","reading":"いれ","offset":5}]},{"id":"sentence-52","text":"寒くなったらはめるように。","start":271.039,"end":274.039,"readings":[{"word":"寒く","reading":"さむく","offset":0}]},{"id":"sentence-53","text":"カもいっぱいで入らないのよ。","start":274.039,"end":277.039,"readings":[{"word":"入ら","reading":"はいら","offset":7}]},{"id":"sentence-54","text":"そう。","start":277.72,"end":277.951,"readings":[]},{"id":"sentence-55","text":"まあ、じゃあいいよ。","start":277.951,"end":278.72,"readings":[]},{"id":"sentence-56","text":"女の子はどんなものがいりませんか?","start":278.72,"end":280.028,"readings":[{"word":"女の子","reading":"おんなのこ","offset":0}]},{"id":"sentence-57","text":"いらないものです。","start":280.028,"end":280.72,"readings":[]},{"id":"sentence-58","text":"5番男の人と女の人が話しています。","start":308.44,"end":313.12,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-59","text":"2人は何について話していますか?","start":314.44,"end":317.6,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"何","reading":"なに","offset":3},{"word":"話し","reading":"はなし","offset":8}]},{"id":"sentence-60","text":"え、これ大きすぎるわよ。","start":318.84,"end":320.554,"readings":[{"word":"大き","reading":"おおき","offset":4}]},{"id":"sentence-61","text":"それに重そうだし。","start":320.554,"end":321.84,"readings":[{"word":"重","reading":"おも","offset":3}]},{"id":"sentence-62","text":"でもさ、外国旅行だからいっぱい入らないと。","start":324.36,"end":327.36,"readings":[{"word":"外国","reading":"がいこく","offset":4},{"word":"旅行","reading":"りょこう","offset":6},{"word":"入ら","reading":"はいら","offset":15}]},{"id":"sentence-63","text":"それにしても大きすぎるわよ。","start":329.199,"end":332.199,"readings":[{"word":"大き","reading":"おおき","offset":6}]},{"id":"sentence-64","text":"まあ、あなたが持つんだから構わないけど。","start":332.28,"end":335.28,"readings":[{"word":"持つ","reading":"もつ","offset":7},{"word":"構わ","reading":"かまわ","offset":13}]},{"id":"sentence-65","text":"2人は何について話していますか?","start":341.039,"end":347.12,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"何","reading":"なに","offset":3},{"word":"話し","reading":"はなし","offset":8}]},{"id":"sentence-66","text":"6番男の人と女の人が話しています。","start":360.44,"end":366.88,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-67","text":"夏のコンサートには何人ぐらい集まりますか?","start":366.88,"end":369.88,"readings":[{"word":"夏","reading":"なつ","offset":0},{"word":"何","reading":"なん","offset":9},{"word":"人","reading":"にん","offset":10},{"word":"集まり","reading":"あつまり","offset":14}]},{"id":"sentence-68","text":"いよいよ夏のコンサートが近づきましたね。","start":371.88,"end":373.502,"readings":[{"word":"夏","reading":"なつ","offset":4},{"word":"近づき","reading":"ちかづき","offset":12}]},{"id":"sentence-69","text":"今年は何人ぐらい集まりそうですか?","start":373.502,"end":374.88,"readings":[{"word":"今年","reading":"ことし","offset":0},{"word":"何","reading":"なん","offset":3},{"word":"人","reading":"にん","offset":4},{"word":"集まり","reading":"あつまり","offset":8}]},{"id":"sentence-70","text":"今日までで席予定は150人です。","start":379.88,"end":384.24,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"席","reading":"せき","offset":5},{"word":"予定","reading":"よてい","offset":6},{"word":"人","reading":"にん","offset":12}]},{"id":"sentence-71","text":"去年の今日は何人ぐらいだったんですか?","start":384.24,"end":387.24,"readings":[{"word":"去年","reading":"きょねん","offset":0},{"word":"今日","reading":"きょう","offset":3},{"word":"何","reading":"なん","offset":6},{"word":"人","reading":"にん","offset":7}]},{"id":"sentence-72","text":"えっと200人でした。","start":387.88,"end":390.52,"readings":[{"word":"人","reading":"にん","offset":6}]},{"id":"sentence-73","text":"今1日に20人ぐらいずつ増えています。","start":390.52,"end":395.08,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"日","reading":"にち","offset":2},{"word":"人","reading":"にん","offset":6},{"word":"増え","reading":"ふえ","offset":12}]},{"id":"sentence-74","text":"あと10日ありますね。","start":395.08,"end":396.415,"readings":[{"word":"日","reading":"にち","offset":4}]},{"id":"sentence-75","text":"このまま行くと去年より多くなりますね。","start":396.415,"end":398.72,"readings":[{"word":"行く","reading":"いく","offset":4},{"word":"去年","reading":"きょねん","offset":7},{"word":"多く","reading":"おおく","offset":11}]},{"id":"sentence-76","text":"そうなると思います。","start":401.36,"end":402.724,"readings":[{"word":"思い","reading":"おもい","offset":5}]},{"id":"sentence-77","text":"今年は涼しいですからね。","start":402.724,"end":404.36,"readings":[{"word":"今年","reading":"ことし","offset":0},{"word":"涼しい","reading":"すずしい","offset":3}]},{"id":"sentence-78","text":"夏のコンサートには何人ぐらい集まりますか?","start":411.56,"end":418.44,"readings":[{"word":"夏","reading":"なつ","offset":0},{"word":"何","reading":"なん","offset":9},{"word":"人","reading":"にん","offset":10},{"word":"集まり","reading":"あつまり","offset":14}]},{"id":"sentence-79","text":"7番男の人と女の人が話しています。","start":431.84,"end":438.599,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-80","text":"女の人の娘さんは昼間何をしていますか?","start":438.599,"end":440.974,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"娘","reading":"むすめ","offset":4},{"word":"昼間","reading":"ひるま","offset":8},{"word":"何","reading":"なに","offset":10}]},{"id":"sentence-81","text":"昼間です。","start":440.974,"end":441.599,"readings":[{"word":"昼間","reading":"ひるま","offset":0}]},{"id":"sentence-82","text":"お嬢さんテレビ放送局でアナウンサーしているんでしたよね。","start":445.879,"end":448.033,"readings":[{"word":"お嬢さん","reading":"おじょうさん","offset":0},{"word":"放送","reading":"ほうそう","offset":7},{"word":"局","reading":"きょく","offset":9}]},{"id":"sentence-83","text":"夜遅くて大変でしょう。","start":448.033,"end":448.879,"readings":[{"word":"夜","reading":"よる","offset":0},{"word":"遅く","reading":"おそく","offset":1},{"word":"大変","reading":"たいへん","offset":4}]},{"id":"sentence-84","text":"先月でやめたんですよ。","start":453.879,"end":454.665,"readings":[{"word":"先月","reading":"せんげつ","offset":0}]},{"id":"sentence-85","text":"喉が痛くなったんだって。","start":454.665,"end":455.522,"readings":[{"word":"喉","reading":"のど","offset":0},{"word":"痛く","reading":"いたく","offset":2}]},{"id":"sentence-86","text":"今はアクセサリーの店で働いていますよ。","start":455.522,"end":456.879,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"店","reading":"みせ","offset":9},{"word":"働い","reading":"はたらい","offset":11}]},{"id":"sentence-87","text":"そうだったんですか。","start":462.919,"end":463.99,"readings":[]},{"id":"sentence-88","text":"でも綺麗な仕事でいいじゃないですか。","start":463.99,"end":465.919,"readings":[{"word":"綺麗","reading":"きれい","offset":2},{"word":"仕事","reading":"しごと","offset":5}]},{"id":"sentence-89","text":"でもとても安いらしくて夜はスーパーでレジをやっていますよ。","start":468.08,"end":471.08,"readings":[{"word":"安い","reading":"やすい","offset":5},{"word":"夜","reading":"よる","offset":11}]},{"id":"sentence-90","text":"若いですからね。","start":474.8,"end":477.199,"readings":[{"word":"若い","reading":"わかい","offset":0}]},{"id":"sentence-91","text":"土曜日曜はコンピューターの学校へ行くんだって頑張っていますよ。","start":477.199,"end":478.89,"readings":[{"word":"土曜","reading":"どよう","offset":0},{"word":"日曜","reading":"にちよう","offset":2},{"word":"学校","reading":"がっこう","offset":13},{"word":"行く","reading":"いく","offset":16},{"word":"頑張っ","reading":"がんばっ","offset":22}]},{"id":"sentence-92","text":"女の人の娘さんは昼間何をしていますか?","start":478.89,"end":479.926,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"娘","reading":"むすめ","offset":4},{"word":"昼間","reading":"ひるま","offset":8},{"word":"何","reading":"なに","offset":10}]},{"id":"sentence-93","text":"昼間です。","start":479.926,"end":480.199,"readings":[{"word":"昼間","reading":"ひるま","offset":0}]},{"id":"sentence-94","text":"番男の子と女の子が話しています。","start":511.12,"end":515.24,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"男の子","reading":"おとこのこ","offset":1},{"word":"女の子","reading":"おんなのこ","offset":5},{"word":"話し","reading":"はなし","offset":9}]},{"id":"sentence-95","text":"女の子は今月お小遣いをいくら使っていますか?","start":515.719,"end":518.719,"readings":[{"word":"女の子","reading":"おんなのこ","offset":0},{"word":"今月","reading":"こんげつ","offset":4},{"word":"小遣い","reading":"こづかい","offset":7},{"word":"使っ","reading":"つかっ","offset":14}]},{"id":"sentence-96","text":"毎月親からくらお金もらうの?","start":521,"end":524.107,"readings":[{"word":"毎月","reading":"まいつき","offset":0},{"word":"親","reading":"おや","offset":2},{"word":"お金","reading":"おかね","offset":7}]},{"id":"sentence-97","text":"僕は4000円しかもらえないんだ。","start":524.107,"end":527.88,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"円","reading":"えん","offset":6}]},{"id":"sentence-98","text":"私はお母さんから5000円、お父さんから2000円よ。","start":527.88,"end":533.279,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"お母さん","reading":"おかあさん","offset":2},{"word":"円","reading":"えん","offset":12},{"word":"お父さん","reading":"おとうさん","offset":14},{"word":"円","reading":"えん","offset":24}]},{"id":"sentence-99","text":"7000円か。","start":533.279,"end":535.24,"readings":[{"word":"円","reading":"えん","offset":4}]},{"id":"sentence-100","text":"すごいな。","start":535.24,"end":536.64,"readings":[]},{"id":"sentence-101","text":"でも今月はお父さんがくれないの。","start":536.64,"end":540.17,"readings":[{"word":"今月","reading":"こんげつ","offset":2},{"word":"お父さん","reading":"おとうさん","offset":5}]},{"id":"sentence-102","text":"それに妹に1000円貸したし。","start":540.17,"end":543.48,"readings":[{"word":"妹","reading":"いもうと","offset":3},{"word":"円","reading":"えん","offset":9},{"word":"貸し","reading":"かし","offset":10}]},{"id":"sentence-103","text":"じゃあ僕と一緒だね。","start":543.48,"end":545.72,"readings":[{"word":"僕","reading":"ぼく","offset":3},{"word":"一緒","reading":"いっしょ","offset":5}]},{"id":"sentence-104","text":"でも足りないからお姉さんから2000円借りたの。","start":545.72,"end":551.8,"readings":[{"word":"足り","reading":"たり","offset":2},{"word":"姉さん","reading":"ねえさん","offset":9},{"word":"円","reading":"えん","offset":18},{"word":"借り","reading":"かり","offset":19}]},{"id":"sentence-105","text":"女の子は今月お小遣いをいくら使っていますか?","start":555.959,"end":563.48,"readings":[{"word":"女の子","reading":"おんなのこ","offset":0},{"word":"今月","reading":"こんげつ","offset":4},{"word":"小遣い","reading":"こづかい","offset":7},{"word":"使っ","reading":"つかっ","offset":14}]},{"id":"sentence-106","text":"問題2問題2ではまず質問を聞いてください。","start":575.839,"end":584.32,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"質問","reading":"しつもん","offset":10},{"word":"聞い","reading":"きい","offset":13}]},{"id":"sentence-107","text":"その後問題用紙を見てください。","start":584.32,"end":589.64,"readings":[{"word":"その後","reading":"そのご","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"用紙","reading":"ようし","offset":5},{"word":"見","reading":"み","offset":8}]},{"id":"sentence-108","text":"読む時間があります。","start":589.64,"end":593.32,"readings":[{"word":"読む","reading":"よむ","offset":0},{"word":"時間","reading":"じかん","offset":2}]},{"id":"sentence-109","text":"それから話を聞いて問題用紙の1から4の中から1番いいものを1つ選んでください","start":593.32,"end":606.959,"readings":[{"word":"話","reading":"はなし","offset":4},{"word":"聞い","reading":"きい","offset":6},{"word":"問題","reading":"もんだい","offset":9},{"word":"用紙","reading":"ようし","offset":11},{"word":"中","reading":"なか","offset":19},{"word":"番","reading":"ばん","offset":23},{"word":"選ん","reading":"えらん","offset":31}]},{"id":"sentence-110","text":"番男の人と女の人が話しています。","start":611.839,"end":616.2,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"男","reading":"おとこ","offset":1},{"word":"人","reading":"ひと","offset":3},{"word":"女","reading":"おんな","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"話し","reading":"はなし","offset":9}]},{"id":"sentence-111","text":"伊藤さんが遅いのはどうしてですか?","start":617.76,"end":623.72,"readings":[{"word":"伊藤","reading":"いとう","offset":0},{"word":"遅い","reading":"おそい","offset":5}]},{"id":"sentence-112","text":"伊藤さん遅いわね。","start":644.8,"end":647.399,"readings":[{"word":"伊藤","reading":"いとう","offset":0},{"word":"遅い","reading":"おそい","offset":4}]},{"id":"sentence-113","text":"道が混んでいるのかしら?","start":647.399,"end":649.839,"readings":[{"word":"道","reading":"みち","offset":0},{"word":"混ん","reading":"こん","offset":2}]},{"id":"sentence-114","text":"今日は日曜日だからそんなはずないよ。","start":649.839,"end":652.839,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"日曜日","reading":"にちようび","offset":3}]},{"id":"sentence-115","text":"もう30分過ぎているわよ。","start":653.8,"end":656.537,"readings":[{"word":"分","reading":"ふん","offset":4},{"word":"過ぎ","reading":"すぎ","offset":5}]},{"id":"sentence-116","text":"故障かしら。","start":656.537,"end":657.8,"readings":[{"word":"故障","reading":"こしょう","offset":0}]},{"id":"sentence-117","text":"彼の車は新しいから大丈夫だよ。","start":658.8,"end":661.8,"readings":[{"word":"彼","reading":"かれ","offset":0},{"word":"車","reading":"くるま","offset":2},{"word":"新しい","reading":"あたらしい","offset":4},{"word":"大丈夫","reading":"だいじょうぶ","offset":9}]},{"id":"sentence-118","text":"じゃあもしかしてちょっと電話してみるわ。","start":662.92,"end":665.92,"readings":[{"word":"電話","reading":"でんわ","offset":12}]},{"id":"sentence-119","text":"どうだった?","start":670.68,"end":672.2,"readings":[]},{"id":"sentence-120","text":"まだ家にいたわよ。","start":672.2,"end":674.519,"readings":[{"word":"家","reading":"いえ","offset":2}]},{"id":"sentence-121","text":"1時間間違えたんだと言ってたの。","start":674.519,"end":680.2,"readings":[{"word":"時間","reading":"じかん","offset":1},{"word":"間違え","reading":"まちがえ","offset":3},{"word":"言っ","reading":"いっ","offset":10}]},{"id":"sentence-122","text":"伊藤さんが遅いのはどうしてですか?","start":683.56,"end":689.44,"readings":[{"word":"伊藤","reading":"いとう","offset":0},{"word":"遅い","reading":"おそい","offset":5}]},{"id":"sentence-123","text":"2番男の人と女の人が話しています。","start":702.88,"end":709,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-124","text":"男の人はどうして引っ越しますか?","start":709,"end":714.76,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"引っ越し","reading":"ひっこし","offset":8}]},{"id":"sentence-125","text":"今度引っ越す。","start":735.88,"end":737.407,"readings":[{"word":"今度","reading":"こんど","offset":0},{"word":"引っ越す","reading":"ひっこす","offset":2}]},{"id":"sentence-126","text":"そうね。","start":737.407,"end":738.279,"readings":[]},{"id":"sentence-127","text":"駅から遠いけど静かでいいって言ってたわよね。","start":738.279,"end":741.279,"readings":[{"word":"駅","reading":"えき","offset":0},{"word":"遠い","reading":"とおい","offset":3},{"word":"静か","reading":"しずか","offset":7},{"word":"言っ","reading":"いっ","offset":14}]},{"id":"sentence-128","text":"そうなんだけど今度は駅に近くて広いんだ。","start":742.6,"end":744.669,"readings":[{"word":"今度","reading":"こんど","offset":7},{"word":"駅","reading":"えき","offset":10},{"word":"近く","reading":"ちかく","offset":12},{"word":"広い","reading":"ひろい","offset":15}]},{"id":"sentence-129","text":"少しうるさいけど。","start":744.669,"end":745.6,"readings":[{"word":"少し","reading":"すこし","offset":0}]},{"id":"sentence-130","text":"うるさくてもいいの?","start":749.519,"end":751.6,"readings":[]},{"id":"sentence-131","text":"実は来月結婚するんだ。","start":751.6,"end":752.35,"readings":[{"word":"実は","reading":"じつは","offset":0},{"word":"来月","reading":"らいげつ","offset":2},{"word":"結婚","reading":"けっこん","offset":4}]},{"id":"sentence-132","text":"彼女仕事を続けたいと言ってるし。","start":752.35,"end":753.441,"readings":[{"word":"彼女","reading":"かのじょ","offset":0},{"word":"仕事","reading":"しごと","offset":2},{"word":"続け","reading":"つづけ","offset":5},{"word":"言っ","reading":"いっ","offset":10}]},{"id":"sentence-133","text":"それなら駅に近い方がいいと思って。","start":753.441,"end":754.6,"readings":[{"word":"駅","reading":"えき","offset":4},{"word":"近い","reading":"ちかい","offset":6},{"word":"方","reading":"ほう","offset":8},{"word":"思っ","reading":"おもっ","offset":13}]},{"id":"sentence-134","text":"そうなの?","start":761.48,"end":762.844,"readings":[]},{"id":"sentence-135","text":"おめでとう。","start":762.844,"end":764.48,"readings":[]},{"id":"sentence-136","text":"男の人はどうして引っ越しますか?","start":769.399,"end":775.48,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"引っ越し","reading":"ひっこし","offset":8}]},{"id":"sentence-137","text":