{"videoId":"t2bAaub_G6o","title":"Japanese podcast for beginners (Nihongo con Teppei)#1606「Nihongo con Teppeiからのお願いがあります！」","sentenceVersion":"2026-11-02-v2","cues":[{"id":"sentence-0","text":"シャキン。","start":1.68,"end":3.126,"readings":[]},{"id":"sentence-1","text":"え、今日は日本語con Teppeiからのお願いがあります。","start":3.126,"end":11.799,"readings":[{"word":"今日","reading":"きょう","offset":2},{"word":"日本語","reading":"にほんご","offset":5},{"word":"お願い","reading":"おねがい","offset":21}]},{"id":"sentence-2","text":"はい、皆さんこんにちは。","start":11.799,"end":14.496,"readings":[{"word":"皆さん","reading":"みなさん","offset":3}]},{"id":"sentence-3","text":"日本語con Teppeiの時間です。","start":14.496,"end":18.765,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"時間","reading":"じかん","offset":14}]},{"id":"sentence-4","text":"今日はちょっと特別なんですが皆さんに日本語con Teppeiからまあまあ僕から僕からお願いがあります。","start":18.765,"end":30.45,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"特別","reading":"とくべつ","offset":7},{"word":"皆さん","reading":"みなさん","offset":14},{"word":"日本語","reading":"にほんご","offset":18},{"word":"僕","reading":"ぼく","offset":37},{"word":"僕","reading":"ぼく","offset":40},{"word":"お願い","reading":"おねがい","offset":43}]},{"id":"sentence-5","text":"それはですね、まあ日本語con Teppeiはあの、ま、長く続いていて、長く続けてます。","start":30.45,"end":40.337,"readings":[{"word":"日本語","reading":"にほんご","offset":9},{"word":"長く","reading":"ながく","offset":28},{"word":"続い","reading":"つづい","offset":30},{"word":"長く","reading":"ながく","offset":36},{"word":"続け","reading":"つづけ","offset":38}]},{"id":"sentence-6","text":"で、僕も本当に大好きな、え、プロジェクト。","start":40.337,"end":45.056,"readings":[{"word":"僕","reading":"ぼく","offset":2},{"word":"本当に","reading":"ほんとうに","offset":4},{"word":"大好き","reading":"だいすき","offset":7}]},{"id":"sentence-7","text":"そして皆さんも多分大好きなこのプロジェクト。","start":45.056,"end":50,"readings":[{"word":"皆さん","reading":"みなさん","offset":3},{"word":"多分","reading":"たぶん","offset":7},{"word":"大好き","reading":"だいすき","offset":9}]},{"id":"sentence-8","text":"えー、素晴らしいですよね。","start":50,"end":53.207,"readings":[{"word":"素晴らしい","reading":"すばらしい","offset":3}]},{"id":"sentence-9","text":"だけどちょっと思っていることがありまして、えー、ま、正直に話すと、まあもっともっとたくさんの人に聞いて欲しいなと思うんですね。","start":53.207,"end":68.751,"readings":[{"word":"思っ","reading":"おもっ","offset":7},{"word":"正直","reading":"しょうじき","offset":26},{"word":"話す","reading":"はなす","offset":29},{"word":"人","reading":"ひと","offset":46},{"word":"聞い","reading":"きい","offset":48},{"word":"欲しい","reading":"ほしい","offset":51},{"word":"思う","reading":"おもう","offset":56}]},{"id":"sentence-10","text":"日本語con Teppeiは本当に役に立つ、そして無料のね、無料ですね。","start":68.751,"end":77.633,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"本当に","reading":"ほんとうに","offset":14},{"word":"役に立つ","reading":"やくにたつ","offset":17},{"word":"無料","reading":"むりょう","offset":25},{"word":"無料","reading":"むりょう","offset":30}]},{"id":"sentence-11","text":"そして役に立つ。","start":77.633,"end":79.607,"readings":[{"word":"役に立つ","reading":"やくにたつ","offset":3}]},{"id":"sentence-12","text":"無料で役に立つ。","start":79.607,"end":81.58,"readings":[{"word":"無料","reading":"むりょう","offset":0},{"word":"役に立つ","reading":"やくにたつ","offset":3}]},{"id":"sentence-13","text":"素晴らしいじゃないですか。","start":81.58,"end":84.788,"readings":[{"word":"素晴らしい","reading":"すばらしい","offset":0}]},{"id":"sentence-14","text":"無料ですよ。","start":84.788,"end":86.268,"readings":[{"word":"無料","reading":"むりょう","offset":0}]},{"id":"sentence-15","text":"そして役に立つんですよ。","start":86.268,"end":89.229,"readings":[{"word":"役に立つ","reading":"やくにたつ","offset":3}]},{"id":"sentence-16","text":"無料のゴミじゃないしね。","start":89.229,"end":92.189,"readings":[{"word":"無料","reading":"むりょう","offset":0}]},{"id":"sentence-17","text":"役に立つけどめちゃめちゃ高いものでもない。","start":92.189,"end":97.37,"readings":[{"word":"役に立つ","reading":"やくにたつ","offset":0},{"word":"高い","reading":"たかい","offset":12}]},{"id":"sentence-18","text":"無料で役に立つ。","start":97.37,"end":99.344,"readings":[{"word":"無料","reading":"むりょう","offset":0},{"word":"役に立つ","reading":"やくにたつ","offset":3}]},{"id":"sentence-19","text":"これはもう完璧じゃないですか?","start":99.344,"end":103.045,"readings":[{"word":"完璧","reading":"かんぺき","offset":5}]},{"id":"sentence-20","text":"僕は日本語con Teppeiは日本語学習者のために完璧な","start":103.045,"end":110.2,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"日本語","reading":"にほんご","offset":2},{"word":"日本語","reading":"にほんご","offset":16},{"word":"学習","reading":"がくしゅう","offset":19},{"word":"者","reading":"しゃ","offset":21},{"word":"完璧","reading":"かんぺき","offset":26}]},{"id":"sentence-21","text":"勉強のリソースだと信じてます。","start":110.2,"end":114.64,"readings":[{"word":"勉強","reading":"べんきょう","offset":0},{"word":"信じ","reading":"しんじ","offset":9}]},{"id":"sentence-22","text":"なぜ信じてるかと言うと、たくさんの人が日本語con Teppeiを聞いて日本語がどんどんどんどん上達した。","start":114.64,"end":127.36,"readings":[{"word":"信じ","reading":"しんじ","offset":2},{"word":"言う","reading":"いう","offset":8},{"word":"人","reading":"ひと","offset":17},{"word":"日本語","reading":"にほんご","offset":19},{"word":"聞い","reading":"きい","offset":33},{"word":"日本語","reading":"にほんご","offset":36},{"word":"上達","reading":"じょうたつ","offset":48}]},{"id":"sentence-23","text":"そういう本当の結果ですね。","start":127.36,"end":129.809,"readings":[{"word":"本当","reading":"ほんとう","offset":4},{"word":"結果","reading":"けっか","offset":7}]},{"id":"sentence-24","text":"結果と言いますね。","start":129.809,"end":131.504,"readings":[{"word":"結果","reading":"けっか","offset":0},{"word":"言い","reading":"いい","offset":3}]},{"id":"sentence-25","text":"本当の結果。","start":131.504,"end":132.635,"readings":[{"word":"本当","reading":"ほんとう","offset":0},{"word":"結果","reading":"けっか","offset":3}]},{"id":"sentence-26","text":"たくさんの人が日本語con Teppeiを聞いて日本語が分かるようになった。","start":132.635,"end":139.793,"readings":[{"word":"人","reading":"ひと","offset":5},{"word":"日本語","reading":"にほんご","offset":7},{"word":"聞い","reading":"きい","offset":21},{"word":"日本語","reading":"にほんご","offset":24},{"word":"分かる","reading":"わかる","offset":28}]},{"id":"sentence-27","text":"そして話せるようになった。","start":139.793,"end":142.242,"readings":[{"word":"話せる","reading":"はなせる","offset":3}]},{"id":"sentence-28","text":"え、そういう結果があるから僕は日本語con Teppeiを信じてるんですね。","start":142.242,"end":149.4,"readings":[{"word":"結果","reading":"けっか","offset":6},{"word":"僕","reading":"ぼく","offset":13},{"word":"日本語","reading":"にほんご","offset":15},{"word":"信じ","reading":"しんじ","offset":29}]},{"id":"sentence-29","text":"そして皆さんにお願いがある。","start":149.4,"end":152.141,"readings":[{"word":"皆さん","reading":"みなさん","offset":3},{"word":"お願い","reading":"おねがい","offset":7}]},{"id":"sentence-30","text":"だから皆さんにお願いがある。","start":152.141,"end":154.882,"readings":[{"word":"皆さん","reading":"みなさん","offset":3},{"word":"お願い","reading":"おねがい","offset":7}]},{"id":"sentence-31","text":"日本語con Teppeiをもっと広げて広めてください。","start":154.882,"end":160.363,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"広げ","reading":"ひろげ","offset":17},{"word":"広め","reading":"ひろめ","offset":20}]},{"id":"sentence-32","text":"広めるですね。","start":160.363,"end":161.734,"readings":[{"word":"広める","reading":"ひろめる","offset":0}]},{"id":"sentence-33","text":"広めてください。","start":161.734,"end":163.3,"readings":[{"word":"広め","reading":"ひろめ","offset":0}]},{"id":"sentence-34","text":"もっともっとたくさんの人に聞いて欲しい。","start":163.3,"end":167.215,"readings":[{"word":"人","reading":"ひと","offset":11},{"word":"聞い","reading":"きい","offset":13},{"word":"欲しい","reading":"ほしい","offset":16}]},{"id":"sentence-35","text":"そのためにお願いがあります。","start":167.215,"end":169.956,"readings":[{"word":"お願い","reading":"おねがい","offset":5}]},{"id":"sentence-36","text":"え、まずレビューを書いてください。","start":169.956,"end":173.285,"readings":[{"word":"書い","reading":"かい","offset":9}]},{"id":"sentence-37","text":"色々なところでレビューを書いてください。","start":173.285,"end":177.2,"readings":[{"word":"色々","reading":"いろいろ","offset":0},{"word":"書い","reading":"かい","offset":12}]},{"id":"sentence-38","text":"え、ま、もちろんApplePodcastとかでもいいし、あの、ま、色々なウェブサイト、例えばレディットとかでもいいし、日本語con Teppeiが本当に役に立ちましたと言ってください、書いてください。","start":177.2,"end":196.68,"readings":[{"word":"色々","reading":"いろいろ","offset":33},{"word":"例えば","reading":"たとえば","offset":43},{"word":"日本語","reading":"にほんご","offset":59},{"word":"本当に","reading":"ほんとうに","offset":73},{"word":"役に立ち","reading":"やくにたち","offset":76},{"word":"言っ","reading":"いっ","offset":84},{"word":"書い","reading":"かい","offset":92}]},{"id":"sentence-39","text":"まあまあ役に立ってないんだったら嘘は書かなくていいですよ。","start":196.68,"end":202.321,"readings":[{"word":"役に立っ","reading":"やくにたっ","offset":4},{"word":"嘘","reading":"うそ","offset":16},{"word":"書か","reading":"かか","offset":18}]},{"id":"sentence-40","text":"嘘は書かなくてもいいので好きじゃなかったら、まあ書かなくていいです。","start":202.321,"end":208.935,"readings":[{"word":"嘘","reading":"うそ","offset":0},{"word":"書か","reading":"かか","offset":2},{"word":"好き","reading":"すき","offset":12},{"word":"書か","reading":"かか","offset":24}]},{"id":"sentence-41","text":"でももし皆さんがあ、日本語con Teppeiは確かに確かに役に立つ。","start":208.935,"end":215.743,"readings":[{"word":"皆さん","reading":"みなさん","offset":4},{"word":"日本語","reading":"にほんご","offset":10},{"word":"確か","reading":"たしか","offset":24},{"word":"確か","reading":"たしか","offset":27},{"word":"役に立つ","reading":"やくにたつ","offset":30}]},{"id":"sentence-42","text":"確かにあの私にとって良かった。","start":215.743,"end":218.661,"readings":[{"word":"確か","reading":"たしか","offset":0},{"word":"私","reading":"わたし","offset":5},{"word":"良かっ","reading":"よかっ","offset":10}]},{"id":"sentence-43","text":"僕にとって最高だと思ってくれるんだったらレビューを書いてください。","start":218.661,"end":225.08,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"最高","reading":"さいこう","offset":5},{"word":"思っ","reading":"おもっ","offset":9},{"word":"書い","reading":"かい","offset":25}]},{"id":"sentence-44","text":"これは本当に役に立ちます。","start":225.08,"end":228.2,"readings":[{"word":"本当に","reading":"ほんとうに","offset":3},{"word":"役に立ち","reading":"やくにたち","offset":6}]},{"id":"sentence-45","text":"そしてあのま、友達に教えてください。","start":228.2,"end":233.28,"readings":[{"word":"友達","reading":"ともだち","offset":7},{"word":"教え","reading":"おしえ","offset":10}]},{"id":"sentence-46","text":"まあまあ友達がもし、まあ中級ぐらいの人だったら教えてください。","start":233.28,"end":240.728,"readings":[{"word":"友達","reading":"ともだち","offset":4},{"word":"中級","reading":"ちゅうきゅう","offset":12},{"word":"人","reading":"ひと","offset":18},{"word":"教え","reading":"おしえ","offset":23}]},{"id":"sentence-47","text":"まか、完全な初級はちょっと難しいかもしれないけど、まあ友達が1年間とか2年間とか日本語勉強してる人だったら教えてください。","start":240.728,"end":255.383,"readings":[{"word":"完全","reading":"かんぜん","offset":3},{"word":"初級","reading":"しょきゅう","offset":6},{"word":"難しい","reading":"むずかしい","offset":13},{"word":"友達","reading":"ともだち","offset":27},{"word":"年間","reading":"ねんかん","offset":31},{"word":"年間","reading":"ねんかん","offset":36},{"word":"日本語","reading":"にほんご","offset":40},{"word":"勉強","reading":"べんきょう","offset":43},{"word":"人","reading":"ひと","offset":48},{"word":"教え","reading":"おしえ","offset":53}]},{"id":"sentence-48","text":"レビューを書く。","start":255.383,"end":257.305,"readings":[{"word":"書く","reading":"かく","offset":5}]},{"id":"sentence-49","text":"友達に教える。","start":257.305,"end":258.987,"readings":[{"word":"友達","reading":"ともだち","offset":0},{"word":"教える","reading":"おしえる","offset":3}]},{"id":"sentence-50","text":"そして、あの、ま、最後のお願いは、あの、パトレオンとコフィーでサポートお願いします。","start":258.987,"end":269.077,"readings":[{"word":"最後","reading":"さいご","offset":9},{"word":"お願い","reading":"おねがい","offset":12},{"word":"お願い","reading":"おねがい","offset":35}]},{"id":"sentence-51","text":"それも本当に大事です。","start":269.077,"end":271.72,"readings":[{"word":"本当に","reading":"ほんとうに","offset":3},{"word":"大事","reading":"だいじ","offset":6}]},{"id":"sentence-52","text":"えー、僕がポッドキャストを続けられるのは、えー、そうやっていつもいつもお金のサポート皆さんのおかげです。","start":271.72,"end":284.117,"readings":[{"word":"僕","reading":"ぼく","offset":3},{"word":"続け","reading":"つづけ","offset":13},{"word":"お金","reading":"おかね","offset":35},{"word":"皆さん","reading":"みなさん","offset":42}]},{"id":"sentence-53","text":"なので、その3つ是非ぜひよろしくお願いします。","start":284.117,"end":289.6,"readings":[{"word":"是非","reading":"ぜひ","offset":8},{"word":"お願い","reading":"おねがい","offset":16}]},{"id":"sentence-54","text":"ま、みんなでね、みんなでこのコミュニティをもっともっとこう成功させたい、あの、続けたい、続けるための力が欲しい。","start":289.6,"end":304.32,"readings":[{"word":"成功","reading":"せいこう","offset":29},{"word":"続け","reading":"つづけ","offset":39},{"word":"続ける","reading":"つづける","offset":44},{"word":"力","reading":"ちから","offset":50},{"word":"欲しい","reading":"ほしい","offset":52}]},{"id":"sentence-55","text":"え、だから、ま、皆さんに手伝って欲しいね。","start":304.32,"end":308.493,"readings":[{"word":"皆さん","reading":"みなさん","offset":8},{"word":"手伝っ","reading":"てつだっ","offset":12},{"word":"欲しい","reading":"ほしい","offset":16}]},{"id":"sentence-56","text":"レビューを書いて欲しい。","start":308.493,"end":310.877,"readings":[{"word":"書い","reading":"かい","offset":5},{"word":"欲しい","reading":"ほしい","offset":8}]},{"id":"sentence-57","text":"友達を誘ってほしい。","start":310.877,"end":312.864,"readings":[{"word":"友達","reading":"ともだち","offset":0},{"word":"誘っ","reading":"さそっ","offset":3}]},{"id":"sentence-58","text":"そしてあの、サポーターになってほしい。","start":312.864,"end":316.639,"readings":[]},{"id":"sentence-59","text":"是非ぜひよろしくお願いします。","start":316.639,"end":319.608,"readings":[{"word":"是非","reading":"ぜひ","offset":0},{"word":"お願い","reading":"おねがい","offset":8}]},{"id":"sentence-60","text":"それではまたね。","start":319.608,"end":321.191,"readings":[]},{"id":"sentence-61","text":"いつもありがとう。","start":321.191,"end":322.972,"readings":[]},{"id":"sentence-62","text":"ありがとう。","start":322.972,"end":324.16,"readings":[]},{"id":"sentence-63","text":"ありがとう。","start":324.16,"end":326.18,"readings":[]},{"id":"sentence-64","text":"ありがとう。","start":326.18,"end":328.199,"readings":[]}]}