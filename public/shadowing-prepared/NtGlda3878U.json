","reading":"ほう","offset":3}]},{"id":"sentence-166","text":"うん。","start":891.399,"end":892.042,"readings":[]},{"id":"sentence-167","text":"そうだね。","start":892.042,"end":893.113,"readings":[]},{"id":"sentence-168","text":"そうしよう。","start":893.113,"end":894.399,"readings":[]},{"id":"sentence-169","text":"2人は何を買いますか?","start":898.959,"end":904.079,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"何","reading":"なに","offset":3},{"word":"買い","reading":"かい","offset":5}]},{"id":"sentence-170","text":"5番店で、女の人と男の人が話しています。","start":923.8,"end":930.437,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"店","reading":"てん","offset":2},{"word":"女","reading":"おんな","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"男","reading":"おとこ","offset":9},{"word":"人","reading":"ひと","offset":11},{"word":"話し","reading":"はなし","offset":13}]},{"id":"sentence-171","text":"2人はどんなテーブルを買いますか?","start":930.437,"end":936.079,"readings":[{"word":"人","reading":"にん","offset":1},{"word":"買い","reading":"かい","offset":11}]},{"id":"sentence-172","text":"お客様にお知らせします。","start":947.8,"end":950.616,"readings":[{"word":"お客様","reading":"おきゃくさま","offset":0},{"word":"お知らせ","reading":"おしらせ","offset":4}]},{"id":"sentence-173","text":"本日の博物館ツアーは午後2時から始まる予定でしたが、準備に時間がかかっているため30分遅れます。","start":950.616,"end":961.88,"readings":[{"word":"本日","reading":"ほんじつ","offset":0},{"word":"博物館","reading":"はくぶつかん","offset":3},{"word":"午後","reading":"ごご","offset":10},{"word":"時","reading":"じ","offset":13},{"word":"始まる","reading":"はじまる","offset":16},{"word":"予定","reading":"よてい","offset":19},{"word":"準備","reading":"じゅんび","offset":26},{"word":"時間","reading":"じかん","offset":29},{"word":"分","reading":"ふん","offset":42},{"word":"遅れ","reading":"おくれ","offset":43}]},{"id":"sentence-174","text":"ツアーは午後20分から始まります。","start":961.88,"end":966.268,"readings":[{"word":"午後","reading":"ごご","offset":4},{"word":"分","reading":"ふん","offset":8},{"word":"始まり","reading":"はじまり","offset":11}]},{"id":"sentence-175","text":"参加するお客様は午後2時20分までに1回