1324.36,"readings":[{"word":"線路","reading":"せんろ","offset":0},{"word":"拾っ","reading":"ひろっ","offset":5}]},{"id":"sentence-209","text":"線路から取ったんですが、どうすればいいですか","start":1329.36,"end":1332.36,"readings":[{"word":"線路","reading":"せんろ","offset":0},{"word":"取っ","reading":"とっ","offset":4}]},{"id":"sentence-210","text":"問題4では絵などがありません。","start":1355.559,"end":1359.693,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"絵","reading":"え","offset":5}]},{"id":"sentence-211","text":"まず文を聞いてください。","start":1359.693,"end":1363,"readings":[{"word":"文","reading":"ぶん","offset":2},{"word":"聞い","reading":"きい","offset":4}]},{"id":"sentence-212","text":"それからその返事を聞いて1から3の中から1番いいものを1つ選んでください。","start":1363,"end":1372.84,"readings":[{"word":"返事","reading":"へんじ","offset":6},{"word":"聞い","reading":"きい","offset":9},{"word":"中","reading":"なか","offset":17},{"word":"番","reading":"ばん","offset":21},{"word":"選ん","reading":"えらん","offset":29}]},{"id":"sentence-213","text":"番。","start":1376.84,"end":1377.385,"readings":[{"word":"番","reading":"ばん","offset":0}]},{"id":"sentence-214","text":"今日何曜日ですか?","start":1377.385,"end":1379.84,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"何","reading":"なん","offset":2},{"word":"曜日","reading":"ようび","offset":3}]},{"id":"sentence-215","text":"10時です。","start":1383.799,"end":1388.32,"readings":[{"word":"時","reading":"じ","offset":2}]},{"id":"sentence-216","text":"13日です。","start":1388.32,"end":1393.2,"readings":[{"word":"日","reading":"にち","offset":2}]},{"id":"sentence-217","text":"日曜日です。","start":1393.2,"end":1397.08,"readings":[{"word":"日曜日","reading":"にちようび","offset":0}]},{"id":"sentence-218","text":"2番、コーヒー飲みませんか?","start":1417.039,"end":1420.24,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"飲み","reading":"のみ","offset":7}]},{"id":"sentence-219","text":"はい、だきます。","start":1424.159,"end":1427.159,"readings":[]},{"id":"sentence-220","text":"2はい、ごちそうさでした。","start":1427.64,"end":1432.039,"readings":[]},{"id":"sentence-221","text":"3はい、どうぞ。","start":1432.72,"end":1437.2,"readings":[]},{"id":"sentence-222","text":"3番明日どこか行きませんか?","start":1457.72,"end":1461,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"明日","reading":"あした","offset":2},{"word":"行き","reading":"いき","offset":7}]},{"id":"sentence-223","text":"うん。","start":1466.12,"end":1466.87,"readings":[]},{"id":"sentence-224","text":"北海道に行ったよ。","start":1466.87,"end":1469.12,"readings":[{"word":"北海道","reading":"ほっかいどう","offset":0},{"word":"行っ","reading":"いっ","offset":4}]},{"id":"sentence-225","text":"2近くの公園に行きましょう。","start":1469.96,"end":1476.6,"readings":[{"word":"近く","reading":"ちかく","offset":1},{"word":"公園","reading":"こうえん","offset":4},{"word":"行き","reading":"いき","offset":7}]},{"id":"sentence-226","text":"どこも行ったよ。","start":1476.6,"end":1480.48,"readings":[{"word":"行っ","reading":"おこなっ","offset":3}]},{"id":"sentence-227","text":"4番ご飯の時間ですよ。","start":1499.48,"end":1502.799,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"ご飯","reading":"ごはん","offset":2},{"word":"時間","reading":"じかん","offset":5}]},{"id":"sentence-228","text":"1はい、すぐ行きます。","start":1504.279,"end":1508.76,"readings":[{"word":"行き","reading":"いき","offset":6}]},{"id":"sentence-229","text":"2はい、美味しかったです。","start":1509.44,"end":1513.88,"readings":[{"word":"美味しかっ","reading":"おいしかっ","offset":4}]},{"id":"sentence-230","text":"はい、ご馳そう様。","start":1515.88,"end":1518.88,"readings":[{"word":"様","reading":"さま","offset":7}]},{"id":"sentence-231","text":"5番ちょっと重いですね、この箱。","start":1540.36,"end":1543.559,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"重い","reading":"おもい","offset":6},{"word":"箱","reading":"はこ","offset":14}]},{"id":"sentence-232","text":"重いですよ。","start":1548.72,"end":1551.48,"readings":[{"word":"重い","reading":"おもい","offset":0}]},{"id":"sentence-233","text":"2手伝いましょうか?","start":1551.48,"end":1557.36,"readings":[{"word":"手","reading":"て","offset":1},{"word":"伝い","reading":"つたい","offset":2}]},{"id":"sentence-234","text":"重かったですよ。","start":1557.36,"end":1561.24,"readings":[{"word":"重かっ","reading":"おもかっ","offset":0}]},{"id":"sentence-235","text":"6番あ、大変。","start":1580.88,"end":1584.2,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"大変","reading":"たいへん","offset":4}]},{"id":"sentence-236","text":"どうしましたか?","start":1588.039,"end":1590.799,"readings":[]},{"id":"sentence-237","text":"2良かったね。","start":1590.799,"end":1596.52,"readings":[{"word":"良かっ","reading":"よかっ","offset":1}]},{"id":"sentence-238","text":"大変そうですね。","start":1596.52,"end":1599.52,"readings":[{"word":"大変","reading":"たいへん","offset":0}]},{"id":"sentence-239","text":"7番。","start":1620.36,"end":1622.44,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-240","text":"ああ、お腹が空いた。","start":1622.44,"end":1629,"readings":[{"word":"お腹","reading":"おなか","offset":3},{"word":"空い","reading":"あい","offset":6}]},{"id":"sentence-241","text":"美味しかったね。","start":1629,"end":1631.84,"readings":[{"word":"美味しかっ","reading":"おいしかっ","offset":0}]},{"id":"sentence-242","text":"2じゃあ弁当を買ってこよう。","start":1631.84,"end":1637.159,"readings":[{"word":"弁当","reading":"べんとう","offset":4},{"word":"買っ","reading":"かっ","offset":7}]},{"id":"sentence-243","text":"3いや、僕空いていないよ。","start":1637.159,"end":1643.72,"readings":[{"word":"僕","reading":"ぼく","offset":4},{"word":"空い","reading":"あい","offset":5}]},{"id":"sentence-244","text":"8番。","start":1663.159,"end":1665.36,"readings":[{"word":"番","reading":"ばん","offset":1}]},{"id":"sentence-245","text":"このパソコン動くのが遅いなあ。","start":1665.36,"end":1673.08,"readings":[{"word":"動く","reading":"うごく","offset":6},{"word":"遅い","reading":"おそい","offset":10}]},{"id":"sentence-246","text":"新しいのを買ってきなさい。","start":1673.08,"end":1676.48,"readings":[{"word":"新しい","reading":"あたらしい","offset":0},{"word":"買っ","reading":"かっ","offset":5}]},{"id":"sentence-247","text":"2長く使っていたのね。","start":1676.48,"end":1682.919,"readings":[{"word":"長く","reading":"ながく","offset":1},{"word":"使っ","reading":"つかっ","offset":3}]},{"id":"sentence-248","text":"もうちょっと早くした方がいいよ。","start":1682.919,"end":1687.88,"readings":[{"word":"早く","reading":"はやく","offset":6},{"word":"方","reading":"ほう","offset":10}]}]}