{"videoId":"OizSGEkzums","title":"【N5-N4】#156 Laos / Oyasumi Japanese Podcast for Beginners","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"おやすみ。","start":0.88,"end":3.225,"readings":[]},{"id":"sentence-1","text":"しと日本語。","start":3.225,"end":6.04,"readings":[{"word":"日本語","reading":"にほんご","offset":2}]},{"id":"sentence-2","text":"皆さんこんばんは。","start":12,"end":14.653,"readings":[{"word":"皆さん","reading":"みなさん","offset":0}]},{"id":"sentence-3","text":"日本語教師のしです。","start":14.653,"end":17.6,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"教師","reading":"きょうし","offset":3}]},{"id":"sentence-4","text":"皆さん、今日はどんな1日でしたか?","start":17.6,"end":22.56,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"今日","reading":"きょう","offset":4},{"word":"日","reading":"にち","offset":11}]},{"id":"sentence-5","text":"皆さんの週末はどうでしたか?","start":22.56,"end":28.48,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"週末","reading":"しゅうまつ","offset":4}]},{"id":"sentence-6","text":"さあ、今日は最近行った国について話そうと思います。","start":28.8,"end":38.44,"readings":[{"word":"今日","reading":"きょう","offset":3},{"word":"最近","reading":"さいきん","offset":6},{"word":"行っ","reading":"おこなっ","offset":8},{"word":"国","reading":"くに","offset":11},{"word":"話そ","reading":"はなそ","offset":16},{"word":"思い","reading":"おもい","offset":20}]},{"id":"sentence-7","text":"最近ラオスに行きましたよ。","start":38.84,"end":44.28,"readings":[{"word":"最近","reading":"さいきん","offset":0},{"word":"行き","reading":"いき","offset":6}]},{"id":"sentence-8","text":"皆さんまずラオスという国を知っていますか?","start":44.28,"end":51.76,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"国","reading":"くに","offset":11},{"word":"知っ","reading":"しっ","offset":13}]},{"id":"sentence-9","text":"どこにあるか分かりますか?","start":51.76,"end":57.039,"readings":[{"word":"分かり","reading":"わかり","offset":6}]},{"id":"sentence-10","text":"ラオスは東南アジアにあります。","start":57.52,"end":63.44,"readings":[{"word":"東南アジア","reading":"とうなんあじあ","offset":4}]},{"id":"sentence-11","text":"タとベトナムの間にあります。","start":63.44,"end":69.68,"readings":[{"word":"間","reading":"ま","offset":7}]},{"id":"sentence-12","text":"私はラオスに本当に色々な思い出がありますよ。","start":70.24,"end":79.744,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"本当に","reading":"ほんとうに","offset":6},{"word":"色々","reading":"いろいろ","offset":9},{"word":"思い出","reading":"おもいで","offset":12}]},{"id":"sentence-13","text":"はい。","start":79.744,"end":81.04,"readings":[]},{"id":"sentence-14","text":"まず私が初めて1人旅をした時にタイとラオスとカンボジアに行きました。","start":81.04,"end":95.64,"readings":[{"word":"私","reading":"わたし","offset":2},{"word":"初めて","reading":"はじめて","offset":4},{"word":"人","reading":"にん","offset":8},{"word":"旅","reading":"たび","offset":9},{"word":"時","reading":"とき","offset":13},{"word":"行き","reading":"いき","offset":28}]},{"id":"sentence-15","text":"だから私が初めて1人旅をした国の1つですね。","start":95.64,"end":104.68,"readings":[{"word":"私","reading":"わたし","offset":3},{"word":"初めて","reading":"はじめて","offset":5},{"word":"人","reading":"にん","offset":9},{"word":"旅","reading":"たび","offset":10},{"word":"国","reading":"くに","offset":14}]},{"id":"sentence-16","text":"まあ、いい思い出と悪い思い出がありますまずはちょっと悪い思い出、まあ大変だった思い出から話しますね。","start":104.68,"end":123.68,"readings":[{"word":"思い出","reading":"おもいで","offset":5},{"word":"悪い","reading":"わるい","offset":9},{"word":"思い出","reading":"おもいで","offset":11},{"word":"悪い","reading":"わるい","offset":26},{"word":"思い出","reading":"おもいで","offset":28},{"word":"大変","reading":"たいへん","offset":34},{"word":"思い出","reading":"おもいで","offset":39},{"word":"話し","reading":"はなし","offset":44}]},{"id":"sentence-17","text":"初めてラオスに行った時は私が18歳、19歳の時でした。","start":124.28,"end":135.16,"readings":[{"word":"初めて","reading":"はじめて","offset":0},{"word":"行っ","reading":"いっ","offset":7},{"word":"時","reading":"とき","offset":10},{"word":"私","reading":"わたし","offset":12},{"word":"歳","reading":"さい","offset":16},{"word":"歳","reading":"さい","offset":20},{"word":"時","reading":"とき","offset":22}]},{"id":"sentence-18","text":"私はこの時カンボジアからラオスに入りました。","start":135.28,"end":143.44,"readings":[{"word":"私","reading":"わたし","offset":0},{"word":"時","reading":"とき","offset":4},{"word":"入り","reading":"はいり","offset":16}]},{"id":"sentence-19","text":"まあ、この話は、え、昔のポッドキャストでも話したことがあるので覚えている人もいるかもしれません。","start":144.239,"end":158,"readings":[{"word":"話","reading":"はなし","offset":5},{"word":"昔","reading":"むかし","offset":10},{"word":"話し","reading":"はなし","offset":21},{"word":"覚え","reading":"おぼえ","offset":31},{"word":"人","reading":"ひと","offset":36}]},{"id":"sentence-20","text":"え、カンボジアからラオスの南にあるパクセという町に行きました。","start":158,"end":169.519,"readings":[{"word":"南","reading":"みなみ","offset":13},{"word":"町","reading":"まち","offset":23},{"word":"行き","reading":"いき","offset":25}]},{"id":"sentence-21","text":"17年前に行った時はこの町に、ま、本当にあまりありませんでした。","start":169.72,"end":180.239,"readings":[{"word":"年","reading":"ねん","offset":2},{"word":"前","reading":"まえ","offset":3},{"word":"行っ","reading":"いっ","offset":5},{"word":"時","reading":"とき","offset":8},{"word":"町","reading":"まち","offset":12},{"word":"本当に","reading":"ほんとうに","offset":17}]},{"id":"sentence-22","text":"綺麗なメガしかありませんでした。","start":180.239,"end":184.921,"readings":[{"word":"綺麗","reading":"きれい","offset":0}]},{"id":"sentence-23","text":"うん。","start":184.921,"end":185.799,"readings":[]},{"id":"sentence-24","text":"でもそれが良かったです。","start":185.799,"end":190.568,"readings":[{"word":"良かっ","reading":"よかっ","offset":5}]},{"id":"sentence-25","text":"はい。","start":190.568,"end":191.76,"readings":[]},{"id":"sentence-26","text":"外国人もあまりいませんでしたね。","start":191.76,"end":197.959,"readings":[{"word":"外国","reading":"がいこく","offset":0},{"word":"人","reading":"じん","offset":2}]},{"id":"sentence-27","text":"でも本当にラオスの人の生活、のんびりした生活を見て感じることができて本当に良かったですよ。","start":197.959,"end":211.647,"readings":[{"word":"本当に","reading":"ほんとうに","offset":2},{"word":"人","reading":"ひと","offset":9},{"word":"生活","reading":"せいかつ","offset":11},{"word":"生活","reading":"せいかつ","offset":20},{"word":"見","reading":"み","offset":23},{"word":"感じる","reading":"かんじる","offset":25},{"word":"本当に","reading":"ほんとうに","offset":34},{"word":"良かっ","reading":"よかっ","offset":37}]},{"id":"sentence-28","text":"うん。","start":211.647,"end":212.56,"readings":[]},{"id":"sentence-29","text":"そう。","start":212.56,"end":213.678,"readings":[]},{"id":"sentence-30","text":"えー、カンボジアとラオスの国境を超えた時に私は少し体調が悪くなりましたラオスのパクセについてどんどん体調が悪くなりました。","start":213.678,"end":236.4,"readings":[{"word":"国境","reading":"こっきょう","offset":13},{"word":"超え","reading":"こえ","offset":16},{"word":"時","reading":"とき","offset":19},{"word":"私","reading":"わたし","offset":21},{"word":"少し","reading":"すこし","offset":23},{"word":"体調","reading":"たいちょう","offset":25},{"word":"悪く","reading":"わるく","offset":28},{"word":"体調","reading":"たいちょう","offset":50},{"word":"悪く","reading":"わるく","offset":53}]},{"id":"sentence-31","text":"もう熱があってベッドから起きることができませんでした。","start":236.4,"end":245.72,"readings":[{"word":"熱","reading":"ねつ","offset":2},{"word":"起きる","reading":"おきる","offset":12}]},{"id":"sentence-32","text":"この時私はゲストハウスに泊まっていました。","start":246.239,"end":254.159,"readings":[{"word":"時","reading":"とき","offset":2},{"word":"私","reading":"わたし","offset":3},{"word":"泊まっ","reading":"とまっ","offset":12}]},{"id":"sentence-33","text":"この時はまだ全然ホステルがありませんでしたね。","start":254.439,"end":261.76,"readings":[{"word":"時","reading":"とき","offset":2},{"word":"全然","reading":"ぜんぜん","offset":6}]},{"id":"sentence-34","text":"はいそう、2日ぐらいずっとベッドの上にいました。","start":261.76,"end":269.4,"readings":[{"word":"日","reading":"にち","offset":6},{"word":"上","reading":"うえ","offset":17}]},{"id":"sentence-35","text":"何も食べられませんでした。","start":269.4,"end":274.12,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"食べ","reading":"たべ","offset":2}]},{"id":"sentence-36","text":"3日目に、あ、何か食べなきゃいけないと思ってマーケットに食べ物を買いに行きました。","start":274.479,"end":286.199,"readings":[{"word":"日","reading":"にち","offset":1},{"word":"目","reading":"め","offset":2},{"word":"何","reading":"なに","offset":7},{"word":"食べ","reading":"たべ","offset":9},{"word":"思っ","reading":"おもっ","offset":19},{"word":"食べ物","reading":"たべもの","offset":28},{"word":"買い","reading":"かい","offset":32},{"word":"行き","reading":"いき","offset":35}]},{"id":"sentence-37","text":"そこで道で倒れてしまいました。","start":286.44,"end":292.72,"readings":[{"word":"道","reading":"みち","offset":3},{"word":"倒れ","reading":"たおれ","offset":5}]},{"id":"sentence-38","text":"気づいたら病院にいました。","start":292.72,"end":297.68,"readings":[{"word":"気づい","reading":"きづい","offset":0},{"word":"病院","reading":"びょういん","offset":5}]},{"id":"sentence-39","text":"4日間も入院しました。","start":297.68,"end":303.4,"readings":[{"word":"日間","reading":"にちかん","offset":1},{"word":"入院","reading":"にゅういん","offset":4}]},{"id":"sentence-40","text":"そう。","start":303.4,"end":304.549,"readings":[]},{"id":"sentence-41","text":"そしてまた1人旅を続けましたね。","start":304.549,"end":310.68,"readings":[{"word":"人","reading":"にん","offset":6},{"word":"旅","reading":"たび","offset":7},{"word":"続け","reading":"つづけ","offset":9}]},{"id":"sentence-42","text":"まあ、19歳で本当にすごいアドベンチャーだったと思います。","start":310.72,"end":320.68,"readings":[{"word":"歳","reading":"さい","offset":5},{"word":"本当に","reading":"ほんとうに","offset":7},{"word":"思い","reading":"おもい","offset":24}]},{"id":"sentence-43","text":"その時は死ぬかもしれないと思いましたよ。","start":320.84,"end":326.51,"readings":[{"word":"時","reading":"とき","offset":2},{"word":"死ぬ","reading":"しぬ","offset":4},{"word":"思い","reading":"おもい","offset":13}]},{"id":"sentence-44","text":"はい。","start":326.51,"end":327.36,"readings":[]},{"id":"sentence-45","text":"本当に大変でした。","start":327.36,"end":331.52,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"大変","reading":"たいへん","offset":3}]},{"id":"sentence-46","text":"そうだから、えー、そんな思い出があるラオスにまた17年後に戻ることができて本当に嬉しい気持ちになりました。","start":331.52,"end":350.88,"readings":[{"word":"思い出","reading":"おもいで","offset":12},{"word":"年","reading":"ねん","offset":26},{"word":"後","reading":"ご","offset":27},{"word":"戻る","reading":"もどる","offset":29},{"word":"本当に","reading":"ほんとうに","offset":37},{"word":"嬉しい","reading":"うれしい","offset":40},{"word":"気持ち","reading":"きもち","offset":43}]},{"id":"sentence-47","text":"えー、今回はタから歩いて国境を超えました。","start":350.88,"end":360,"readings":[{"word":"今回","reading":"こんかい","offset":3},{"word":"歩い","reading":"あるい","offset":9},{"word":"国境","reading":"こっきょう","offset":12},{"word":"超え","reading":"こえ","offset":15}]},{"id":"sentence-48","text":"まあ、国境を超えてすぐタと比べると、あの、全然まだ発展していないと感じましたね。","start":360.16,"end":377.08,"readings":[{"word":"国境","reading":"こっきょう","offset":3},{"word":"超え","reading":"こえ","offset":6},{"word":"比べる","reading":"くらべる","offset":13},{"word":"全然","reading":"ぜんぜん","offset":21},{"word":"発展","reading":"はってん","offset":25},{"word":"感じ","reading":"かんじ","offset":33}]},{"id":"sentence-49","text":"うん。","start":377.08,"end":378,"readings":[]},{"id":"sentence-50","text":"でもなんか昔東南アジアをバックパッキングをしていた時を思い出しましたよ。","start":378,"end":389.039,"readings":[{"word":"昔","reading":"むかし","offset":5},{"word":"東南アジア","reading":"とうなんあじあ","offset":6},{"word":"時","reading":"とき","offset":25},{"word":"思い出し","reading":"おもいだし","offset":27}]},{"id":"sentence-51","text":"はい。","start":389.039,"end":390.8,"readings":[]},{"id":"sentence-52","text":"今はタイヤマレーシアはすごく昔と比べて発展したと思います。","start":390.8,"end":401.479,"readings":[{"word":"今","reading":"いま","offset":0},{"word":"昔","reading":"むかし","offset":14},{"word":"比べ","reading":"くらべ","offset":16},{"word":"発展","reading":"はってん","offset":19},{"word":"思い","reading":"おもい","offset":24}]},{"id":"sentence-53","text":"そう、なんか昔のタイヤマレーシアを見ているみたいでしたね。","start":401.479,"end":409.221,"readings":[{"word":"昔","reading":"むかし","offset":6},{"word":"見","reading":"み","offset":17}]},{"id":"sentence-54","text":"うん。","start":409.221,"end":410.022,"readings":[]},{"id":"sentence-55","text":"すごく懐かしい気持ちになりました。","start":410.022,"end":414.56,"readings":[{"word":"懐かしい","reading":"なつかしい","offset":3},{"word":"気持ち","reading":"きもち","offset":7}]},{"id":"sentence-56","text":"あとラオスの人はいつも笑っています。","start":414.56,"end":421.68,"readings":[{"word":"人","reading":"ひと","offset":6},{"word":"笑っ","reading":"わらっ","offset":11}]},{"id":"sentence-57","text":"このラオスの人の笑顔を見ると私も本当に幸せな気持ちになりました。","start":421.8,"end":432.8,"readings":[{"word":"人","reading":"ひと","offset":6},{"word":"笑顔","reading":"えがお","offset":8},{"word":"見る","reading":"みる","offset":11},{"word":"私","reading":"わたし","offset":14},{"word":"本当に","reading":"ほんとうに","offset":16},{"word":"幸せ","reading":"しあわせ","offset":19},{"word":"気持ち","reading":"きもち","offset":22}]},{"id":"sentence-58","text":"そうですね、今回の旅行で行った台湾対ベトナムラオスの中でうん。","start":432.879,"end":441.192,"readings":[{"word":"今回","reading":"こんかい","offset":6},{"word":"旅行","reading":"りょこう","offset":9},{"word":"行っ","reading":"おこなっ","offset":12},{"word":"台湾","reading":"たいわん","offset":15},{"word":"対","reading":"たい","offset":17},{"word":"中","reading":"なか","offset":26}]},{"id":"sentence-59","text":"1番アドベンチャーを経験することができました。","start":441.192,"end":447.36,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"経験","reading":"けいけん","offset":10}]},{"id":"sentence-60","text":"だから私は今回本当に楽しい時間を過ごせましたよ。","start":447.36,"end":455.718,"readings":[{"word":"私","reading":"わたし","offset":3},{"word":"今回","reading":"こんかい","offset":5},{"word":"本当に","reading":"ほんとうに","offset":7},{"word":"楽しい","reading":"たのしい","offset":10},{"word":"時間","reading":"じかん","offset":13},{"word":"過ごせ","reading":"すごせ","offset":16}]},{"id":"sentence-61","text":"うん。","start":455.718,"end":456.762,"readings":[]},{"id":"sentence-62","text":"ま、もちろんATMでお金が下ろせなかったり、停電になったり、色々な問題もありましたけどそれも楽しむことができました。","start":456.762,"end":476.96,"readings":[{"word":"お金","reading":"おかね","offset":10},{"word":"下ろせ","reading":"おろせ","offset":13},{"word":"停電","reading":"ていでん","offset":22},{"word":"色々","reading":"いろいろ","offset":30},{"word":"問題","reading":"もんだい","offset":33},{"word":"楽しむ","reading":"たのしむ","offset":46}]},{"id":"sentence-63","text":"ラオスは本当に小さい国で自然が本当に綺麗な国ですね。","start":477.199,"end":487.8,"readings":[{"word":"本当に","reading":"ほんとうに","offset":4},{"word":"小さい","reading":"ちいさい","offset":7},{"word":"国","reading":"くに","offset":10},{"word":"自然","reading":"しぜん","offset":12},{"word":"本当に","reading":"ほんとうに","offset":15},{"word":"綺麗","reading":"きれい","offset":18},{"word":"国","reading":"くに","offset":21}]},{"id":"sentence-64","text":"だからラオスでは色々なアクティビティをしました。","start":487.8,"end":494.52,"readings":[{"word":"色々","reading":"いろいろ","offset":8}]},{"id":"sentence-65","text":"ハイキングやチュービング、スローボートの旅行、バイクを借りて色々な池にも行きました。","start":494.879,"end":508.039,"readings":[{"word":"旅行","reading":"りょこう","offset":20},{"word":"借り","reading":"かり","offset":27},{"word":"色々","reading":"いろいろ","offset":30},{"word":"池","reading":"いけ","offset":33},{"word":"行き","reading":"いき","offset":36}]},{"id":"sentence-66","text":"あと多分ラオスで1番たくさん友達を作ることができたと思います。","start":508.52,"end":519.839,"readings":[{"word":"多分","reading":"たぶん","offset":2},{"word":"番","reading":"ばん","offset":9},{"word":"友達","reading":"ともだち","offset":14},{"word":"作る","reading":"つくる","offset":17},{"word":"思い","reading":"おもい","offset":26}]},{"id":"sentence-67","text":"うん。","start":519.839,"end":520.79,"readings":[]},{"id":"sentence-68","text":"本当に仲がいい友達。","start":520.79,"end":523.959,"readings":[{"word":"本当に","reading":"ほんとうに","offset":0},{"word":"仲","reading":"なか","offset":3},{"word":"友達","reading":"ともだち","offset":7}]},{"id":"sentence-69","text":"あの、また会いたいなと思う友達にラオスでたくさん会うことができましたねはい。","start":523.959,"end":536.142,"readings":[{"word":"会い","reading":"あい","offset":5},{"word":"思う","reading":"おもう","offset":11},{"word":"友達","reading":"ともだち","offset":13},{"word":"会う","reading":"あう","offset":24}]},{"id":"sentence-70","text":"え、あとラオスで、あの、ほとんど毎日ビールを飲んでいました。","start":536.142,"end":545.76,"readings":[{"word":"毎日","reading":"まいにち","offset":16},{"word":"飲ん","reading":"のん","offset":22}]},{"id":"sentence-71","text":"え、ビアラオというビールを飲んでいました。","start":545.76,"end":552.16,"readings":[{"word":"飲ん","reading":"のん","offset":13}]},{"id":"sentence-72","text":"なんかこのラオスの天気で飲むビアラオは本当に美味しかったです。","start":552.16,"end":561.72,"readings":[{"word":"天気","reading":"てんき","offset":9},{"word":"飲む","reading":"のむ","offset":12},{"word":"本当に","reading":"ほんとうに","offset":19},{"word":"美味しかっ","reading":"おいしかっ","offset":22}]},{"id":"sentence-73","text":"うん。","start":561.72,"end":562.629,"readings":[]},{"id":"sentence-74","text":"ま、多分ラオスは小さい国なのでラオスでしか飲むことができないかもしれませんね。","start":562.629,"end":574.44,"readings":[{"word":"多分","reading":"たぶん","offset":2},{"word":"小さい","reading":"ちいさい","offset":8},{"word":"国","reading":"くに","offset":11},{"word":"飲む","reading":"のむ","offset":21}]},{"id":"sentence-75","text":"日本では見たことがありません。","start":574.44,"end":579.399,"readings":[{"word":"日本","reading":"にっぽん","offset":0},{"word":"見","reading":"み","offset":4}]},{"id":"sentence-76","text":"え、本当に毎日飲んでいたので自分のお土産にビアラオのTシャツを買いました。","start":579.399,"end":591,"readings":[{"word":"本当に","reading":"ほんとうに","offset":2},{"word":"毎日","reading":"まいにち","offset":5},{"word":"飲ん","reading":"のん","offset":7},{"word":"自分","reading":"じぶん","offset":14},{"word":"土産","reading":"みやげ","offset":18},{"word":"買い","reading":"かい","offset":31}]},{"id":"sentence-77","text":"いいですね。","start":591,"end":592.948,"readings":[]},{"id":"sentence-78","text":"うん。","start":592.948,"end":593.922,"readings":[]},{"id":"sentence-79","text":"着るたびにラオスのビールを思い出すことができます。","start":593.922,"end":602.04,"readings":[{"word":"着る","reading":"きる","offset":0},{"word":"思い出す","reading":"おもいだす","offset":13}]},{"id":"sentence-80","text":"ラオスではあの色々なことに気をつけなければいけません。","start":602.279,"end":611.24,"readings":[{"word":"色々","reading":"いろいろ","offset":7},{"word":"気","reading":"き","offset":13}]},{"id":"sentence-81","text":"例えばラオスのお金は他の国で両替えすることができません。","start":611.24,"end":621.88,"readings":[{"word":"例えば","reading":"たとえば","offset":0},{"word":"お金","reading":"おかね","offset":7},{"word":"他","reading":"た","offset":10},{"word":"国","reading":"くに","offset":12},{"word":"両","reading":"りょう","offset":14},{"word":"替え","reading":"かえ","offset":15}]},{"id":"sentence-82","text":"だからラオスにいる間に全部使わなければいけませんね。","start":621.88,"end":631.04,"readings":[{"word":"間","reading":"ま","offset":9},{"word":"全部","reading":"ぜんぶ","offset":11},{"word":"使わ","reading":"つかわ","offset":13}]},{"id":"sentence-8