{"videoId":"K65rdMF4tuo","title":"Japanese podcast for beginners (Nihongo con Teppei)#1602「会話の自信がないと言うことについて！」","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"借金。","start":1.68,"end":2.422,"readings":[{"word":"借金","reading":"しゃっきん","offset":0}]},{"id":"sentence-1","text":"え、今日は会話の自信がないことについて。","start":2.422,"end":7.371,"readings":[{"word":"今日","reading":"きょう","offset":2},{"word":"会話","reading":"かいわ","offset":5},{"word":"自信","reading":"じしん","offset":8}]},{"id":"sentence-2","text":"はい。","start":7.371,"end":8.114,"readings":[]},{"id":"sentence-3","text":"皆さん元気ですか?","start":8.114,"end":10.341,"readings":[{"word":"皆さん","reading":"みなさん","offset":0},{"word":"元気","reading":"げんき","offset":3}]},{"id":"sentence-4","text":"日本語この平雨ですね。","start":10.341,"end":13.063,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"平","reading":"たいら","offset":5},{"word":"雨","reading":"う","offset":6}]},{"id":"sentence-5","text":"ちょっと雨が降ってるな。","start":13.063,"end":16.032,"readings":[{"word":"雨","reading":"あめ","offset":4},{"word":"降っ","reading":"ふっ","offset":6}]},{"id":"sentence-6","text":"うん。","start":16.032,"end":16.775,"readings":[]},{"id":"sentence-7","text":"まあまあ大丈夫ですね。","start":16.775,"end":19.497,"readings":[{"word":"大丈夫","reading":"だいじょうぶ","offset":4}]},{"id":"sentence-8","text":"たまには雨が降り、たまには曇り、たまには晴れる。","start":19.497,"end":25.436,"readings":[{"word":"雨","reading":"あめ","offset":4},{"word":"降り","reading":"ふり","offset":6},{"word":"曇り","reading":"くもり","offset":13},{"word":"晴れる","reading":"はれる","offset":20}]},{"id":"sentence-9","text":"それがま、天気ですね。","start":25.436,"end":28.158,"readings":[{"word":"天気","reading":"てんき","offset":5}]},{"id":"sentence-10","text":"え、モチベーションもたまには上がり、たまには下がり、たまには普通。","start":28.158,"end":36.323,"readings":[{"word":"上がり","reading":"あがり","offset":14},{"word":"下がり","reading":"さがり","offset":22},{"word":"普通","reading":"ふつう","offset":30}]},{"id":"sentence-11","text":"ま、それが日本語の勉強の、ま、人生ですね。","start":36.323,"end":41.52,"readings":[{"word":"日本語","reading":"にほんご","offset":5},{"word":"勉強","reading":"べんきょう","offset":9},{"word":"人生","reading":"じんせい","offset":15}]},{"id":"sentence-12","text":"皆さんはどうですか?","start":41.52,"end":43.559,"readings":[{"word":"皆さん","reading":"みなさん","offset":0}]},{"id":"sentence-13","text":"今やる気がありますか?","start":43.559,"end":45.801,"readings":[{"word":"今","reading":"こん","offset":0},{"word":"やる気","reading":"やるき","offset":1}]},{"id":"sentence-14","text":"やる気がないですか?","start":45.801,"end":47.84,"readings":[{"word":"やる気","reading":"やるき","offset":0}]},{"id":"sentence-15","text":"とりあえず日本語ても聞いてみようといつものように、え、ポッドキャストを再生してね。","start":47.84,"end":56.86,"readings":[{"word":"日本語","reading":"にほんご","offset":5},{"word":"聞い","reading":"きい","offset":10},{"word":"再生","reading":"さいせい","offset":35}]},{"id":"sentence-16","text":"ありがとうございます。","start":56.86,"end":59.28,"readings":[]},{"id":"sentence-17","text":"ま、一緒に頑張りましょう。","start":59.28,"end":62.273,"readings":[{"word":"一緒","reading":"いっしょ","offset":2},{"word":"頑張り","reading":"がんばり","offset":5}]},{"id":"sentence-18","text":"あの、今日のトピックですけど、会話の自信がないということについてですね。","start":62.273,"end":70.56,"readings":[{"word":"今日","reading":"きょう","offset":3},{"word":"会話","reading":"かいわ","offset":15},{"word":"自信","reading":"じしん","offset":18}]},{"id":"sentence-19","text":"たくさんの生徒さんからそういうあのことを聞きますね。","start":70.56,"end":76.899,"readings":[{"word":"生徒","reading":"せいと","offset":5},{"word":"聞き","reading":"きき","offset":20}]},{"id":"sentence-20","text":"先生、え、僕はあの聞くのは結構大丈夫になってきたんですけど、話す自信が全くありません。","start":76.899,"end":87.384,"readings":[{"word":"先生","reading":"せんせい","offset":0},{"word":"僕","reading":"ぼく","offset":5},{"word":"聞く","reading":"きく","offset":9},{"word":"結構","reading":"けっこう","offset":13},{"word":"大丈夫","reading":"だいじょうぶ","offset":15},{"word":"話す","reading":"はなす","offset":30},{"word":"自信","reading":"じしん","offset":32},{"word":"全く","reading":"まったく","offset":35}]},{"id":"sentence-21","text":"ね、ま、僕はそれを聞いて、ま、それは普通ですよね。","start":87.384,"end":93.479,"readings":[{"word":"僕","reading":"ぼく","offset":4},{"word":"聞い","reading":"きい","offset":9},{"word":"普通","reading":"ふつう","offset":18}]},{"id":"sentence-22","text":"心配しないでくださいね。","start":93.479,"end":96.032,"readings":[{"word":"心配","reading":"しんぱい","offset":0}]},{"id":"sentence-23","text":"少しずつ慣れますとしか言えないんですけど、あの、本当にあの、自信がないっていうのは、ま、仕方がないですよね。","start":96.032,"end":107.52,"readings":[{"word":"少し","reading":"すこし","offset":0},{"word":"慣れ","reading":"なれ","offset":4},{"word":"言え","reading":"いえ","offset":11},{"word":"本当に","reading":"ほんとうに","offset":24},{"word":"自信","reading":"じしん","offset":30},{"word":"仕方","reading":"しかた","offset":44}]},{"id":"sentence-24","text":"まずは、あの、それは大丈夫です。","start":107.52,"end":111.115,"readings":[{"word":"大丈夫","reading":"だいじょうぶ","offset":10}]},{"id":"sentence-25","text":"それは普通です。","start":111.115,"end":112.913,"readings":[{"word":"普通","reading":"ふつう","offset":3}]},{"id":"sentence-26","text":"あの、やっぱり経験がないからね。","start":112.913,"end":116.508,"readings":[{"word":"経験","reading":"けいけん","offset":7}]},{"id":"sentence-27","text":"日本語を話すことがあまりないでしょ。","start":116.508,"end":120.553,"readings":[{"word":"日本語","reading":"にほんご","offset":0},{"word":"話す","reading":"はなす","offset":4}]},{"id":"sentence-28","text":"えー、ま、久しぶりに話す。","start":120.553,"end":123.474,"readings":[{"word":"久しぶり","reading":"ひさしぶり","offset":5},{"word":"話す","reading":"はなす","offset":10}]},{"id":"sentence-29","text":"ま、例えば、ま、例えば僕の生徒さんたちも多分1週間に1回僕と話すだけですよね。","start":123.474,"end":132.238,"readings":[{"word":"例えば","reading":"たとえば","offset":2},{"word":"例えば","reading":"たとえば","offset":8},{"word":"僕","reading":"ぼく","offset":11},{"word":"生徒","reading":"せいと","offset":13},{"word":"多分","reading":"たぶん","offset":20},{"word":"週間","reading":"しゅうかん","offset":23},{"word":"回","reading":"かい","offset":27},{"word":"僕","reading":"ぼく","offset":28},{"word":"話す","reading":"はなす","offset":30}]},{"id":"sentence-30","text":"僕以外の人と日本語を話すことはあまりないと思う。","start":132.238,"end":137.631,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"以外","reading":"いがい","offset":1},{"word":"人","reading":"ひと","offset":4},{"word":"日本語","reading":"にほんご","offset":6},{"word":"話す","reading":"はなす","offset":10},{"word":"思う","reading":"おもう","offset":21}]},{"id":"sentence-31","text":"だけど、まあ、1週間に1回、え、僕と話せば少しずつね、慣れてきます。","start":137.631,"end":145.271,"readings":[{"word":"週間","reading":"しゅうかん","offset":8},{"word":"回","reading":"かい","offset":12},{"word":"僕","reading":"ぼく","offset":16},{"word":"話せ","reading":"はなせ","offset":18},{"word":"少し","reading":"すこし","offset":21},{"word":"慣れ","reading":"なれ","offset":27}]},{"id":"sentence-32","text":"なので、ま、会話の自信がないというのは、ま、当たり前のことなんですけど、もし自信をつけたいんだったらやっぱり1週間","start":145.271,"end":158.08,"readings":[{"word":"会話","reading":"かいわ","offset":6},{"word":"自信","reading":"じしん","offset":9},{"word":"当たり前","reading":"あたりまえ","offset":22},{"word":"自信","reading":"じしん","offset":38},{"word":"週間","reading":"しゅうかん","offset":55}]},{"id":"sentence-33","text":"に1回とか1週間に2回とか、ま、先生と話すのが1番いいんじゃないかなと思いますね。","start":158.08,"end":167.354,"readings":[{"word":"回","reading":"かい","offset":2},{"word":"週間","reading":"しゅうかん","offset":6},{"word":"回","reading":"かい","offset":10},{"word":"先生","reading":"せんせい","offset":16},{"word":"話す","reading":"はなす","offset":19},{"word":"番","reading":"ばん","offset":24},{"word":"思い","reading":"おもい","offset":35}]},{"id":"sentence-34","text":"なぜ先生がいいかと言うと、友達とかだとちょっとこう、まあ、続かない可能性がありますね。","start":167.354,"end":177.079,"readings":[{"word":"先生","reading":"せんせい","offset":2},{"word":"言う","reading":"いう","offset":9},{"word":"友達","reading":"ともだち","offset":13},{"word":"続か","reading":"つづか","offset":29},{"word":"可能","reading":"かのう","offset":33},{"word":"性","reading":"せい","offset":35}]},{"id":"sentence-35","text":"例えば、まあ、1週間に1回友達とオンラインで話そうと約束してもなんか少しずつね、え、めんどくさくなって、まあ、1年間とか続かないことが多いですよね。","start":177.079,"end":193.817,"readings":[{"word":"例えば","reading":"たとえば","offset":0},{"word":"週間","reading":"しゅうかん","offset":8},{"word":"回","reading":"かい","offset":12},{"word":"友達","reading":"ともだち","offset":13},{"word":"話そ","reading":"はなそ","offset":22},{"word":"約束","reading":"やくそく","offset":26},{"word":"少し","reading":"すこし","offset":34},{"word":"年間","reading":"ねんかん","offset":56},{"word":"続か","reading":"つづか","offset":60},{"word":"多い","reading":"おおい","offset":67}]},{"id":"sentence-36","text":"もしあの友達と毎週毎週毎週あの話ができれば、ま、それはいいんですけど、ま、あの先生だったら1年とか2年とか3年とかね、続けることは","start":193.817,"end":208.519,"readings":[{"word":"友達","reading":"ともだち","offset":4},{"word":"毎週","reading":"まいしゅう","offset":7},{"word":"毎週","reading":"まいしゅう","offset":9},{"word":"毎週","reading":"まいしゅう","offset":11},{"word":"話","reading":"はなし","offset":15},{"word":"先生","reading":"せんせい","offset":39},{"word":"年","reading":"ねん","offset":46},{"word":"年","reading":"ねん","offset":50},{"word":"年","reading":"ねん","offset":54},{"word":"続ける","reading":"つづける","offset":59}]},{"id":"sentence-37","text":"普通は難しくないです。","start":208.519,"end":210.873,"readings":[{"word":"普通","reading":"ふつう","offset":0},{"word":"難しく","reading":"むずかしく","offset":3}]},{"id":"sentence-38","text":"ま、なぜかと言うと、先生を見つけてお金を払って毎週毎週話すっていうのは、ま、それは先生の仕事だからね、あの、友達よりも多分簡単だと思います。","start":210.873,"end":225.852,"readings":[{"word":"言う","reading":"いう","offset":6},{"word":"先生","reading":"せんせい","offset":10},{"word":"見つけ","reading":"みつけ","offset":13},{"word":"お金","reading":"おかね","offset":17},{"word":"払っ","reading":"はらっ","offset":20},{"word":"毎週","reading":"まいしゅう","offset":23},{"word":"毎週","reading":"まいしゅう","offset":25},{"word":"話す","reading":"はなす","offset":27},{"word":"先生","reading":"せんせい","offset":41},{"word":"仕事","reading":"しごと","offset":44},{"word":"友達","reading":"ともだち","offset":54},{"word":"多分","reading":"たぶん","offset":59},{"word":"簡単","reading":"かんたん","offset":61},{"word":"思い","reading":"おもい","offset":65}]},{"id":"sentence-39","text":"問題は、ま、お金ですよね。","start":225.852,"end":228.634,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"お金","reading":"おかね","offset":6}]},{"id":"sentence-40","text":"だけどもしお金に問題がない人だったら先生を見つけて毎週毎週話をするというのが会話の自信をつけるための1番いい方法と思います。","start":228.634,"end":241.901,"readings":[{"word":"お金","reading":"おかね","offset":5},{"word":"問題","reading":"もんだい","offset":8},{"word":"人","reading":"ひと","offset":13},{"word":"先生","reading":"せんせい","offset":18},{"word":"見つけ","reading":"みつけ","offset":21},{"word":"毎週","reading":"まいしゅう","offset":25},{"word":"毎週","reading":"まいしゅう","offset":27},{"word":"話","reading":"ばなし","offset":29},{"word":"会話","reading":"かいわ","offset":38},{"word":"自信","reading":"じしん","offset":41},{"word":"番","reading":"ばん","offset":51},{"word":"方法","reading":"ほうほう","offset":54},{"word":"思い","reading":"おもい","offset":57}]},{"id":"sentence-41","text":"会話の自信がないね。","start":241.901,"end":244.041,"readings":[{"word":"会話","reading":"かいわ","offset":0},{"word":"自信","reading":"じしん","offset":3}]},{"id":"sentence-42","text":"そのためにはそれをあの良くするためにはあのま会話をするのが1番です。","start":244.041,"end":251.316,"readings":[{"word":"良く","reading":"よく","offset":11},{"word":"会話","reading":"かいわ","offset":22},{"word":"番","reading":"ばん","offset":30}]},{"id":"sentence-43","text":"会話をしなければいけないね。","start":251.316,"end":254.312,"readings":[{"word":"会話","reading":"かいわ","offset":0}]},{"id":"sentence-44","text":"自信がないことはたくさん","start":254.312,"end":256.88,"readings":[{"word":"自信","reading":"じしん","offset":0}]},{"id":"sentence-45","text":"やって、えー、ま、慣れるしかないですね。","start":256.88,"end":260.629,"readings":[{"word":"慣れる","reading":"なれる","offset":9}]},{"id":"sentence-46","text":"はい。","start":260.629,"end":261.191,"readings":[]},{"id":"sentence-47","text":"たくさんやれば慣れます。","start":261.191,"end":263.44,"readings":[{"word":"慣れ","reading":"なれ","offset":7}]},{"id":"sentence-48","text":"たくさん会話をすれば会話になれますね。","start":263.44,"end":267.628,"readings":[{"word":"会話","reading":"かいわ","offset":4},{"word":"会話","reading":"かいわ","offset":10}]},{"id":"sentence-49","text":"そうすると自信がつくね。","start":267.628,"end":270.273,"readings":[{"word":"自信","reading":"じしん","offset":5}]},{"id":"sentence-50","text":"なので、ま、あの、心配しないでください。","start":270.273,"end":274.682,"readings":[{"word":"心配","reading":"しんぱい","offset":9}]},{"id":"sentence-51","text":"会話の自信がない。","start":274.682,"end":276.666,"readings":[{"word":"会話","reading":"かいわ","offset":0},{"word":"自信","reading":"じしん","offset":3}]},{"id":"sentence-52","text":"それは普通です。","start":276.666,"end":278.429,"readings":[{"word":"普通","reading":"ふつう","offset":3}]},{"id":"sentence-53","text":"だから、ま、少しずつ、あの、慣れるようにね、たくさん話してみてください。","start":278.429,"end":286.365,"readings":[{"word":"少し","reading":"すこし","offset":6},{"word":"慣れる","reading":"なれる","offset":14},{"word":"話し","reading":"はなし","offset":26}]},{"id":"sentence-54","text":"たくさん話せば会話の自信が必ずつくと思います。","start":286.365,"end":291.435,"readings":[{"word":"話せ","reading":"はなせ","offset":4},{"word":"会話","reading":"かいわ","offset":7},{"word":"自信","reading":"じしん","offset":10},{"word":"必ず","reading":"かならず","offset":13},{"word":"思い","reading":"おもい","offset":18}]},{"id":"sentence-55","text":"それではまた次回またね。","start":291.435,"end":294.08,"readings":[{"word":"次回","reading":"じかい","offset":6}]}]}