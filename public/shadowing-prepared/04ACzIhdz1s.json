{"videoId":"04ACzIhdz1s","title":"Đề luyện nghe N4 · Bài 08","sentenceVersion":"2026-10-04-v1","cues":[{"id":"sentence-0","text":"N4総復習問題問題","start":10.16,"end":14.12,"readings":[{"word":"総","reading":"そう","offset":2},{"word":"復習","reading":"ふくしゅう","offset":3},{"word":"問題","reading":"もんだい","offset":5},{"word":"問題","reading":"もんだい","offset":7}]},{"id":"sentence-1","text":"問題1ではまず質問を聞いてください。","start":23.24,"end":27.039,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"質問","reading":"しつもん","offset":7},{"word":"聞い","reading":"きい","offset":10}]},{"id":"sentence-2","text":"それから話を聞いて問題用紙の1から4の中から1番いいものを1つ選んでください。","start":28.32,"end":39.24,"readings":[{"word":"話","reading":"はなし","offset":4},{"word":"聞い","reading":"きい","offset":6},{"word":"問題","reading":"もんだい","offset":9},{"word":"用紙","reading":"ようし","offset":11},{"word":"中","reading":"なか","offset":19},{"word":"番","reading":"ばん","offset":23},{"word":"選ん","reading":"えらん","offset":31}]},{"id":"sentence-3","text":"例","start":39.24,"end":39.52,"readings":[{"word":"例","reading":"れい","offset":0}]},{"id":"sentence-4","text":"パーティーの準備をしています。","start":44.52,"end":45.52,"readings":[{"word":"準備","reading":"じゅんび","offset":6}]},{"id":"sentence-5","text":"花はどこに置きますか?","start":45.52,"end":46.253,"readings":[{"word":"花","reading":"はな","offset":0},{"word":"置き","reading":"おき","offset":5}]},{"id":"sentence-6","text":"この花瓶はテーブルの上にお願いします。","start":46.253,"end":47.52,"readings":[{"word":"花瓶","reading":"かびん","offset":2},{"word":"上","reading":"うえ","offset":10},{"word":"お願い","reading":"おねがい","offset":12}]},{"id":"sentence-7","text":"はい。","start":54.32,"end":56.239,"readings":[]},{"id":"sentence-8","text":"えっと、テーブルの上はもういっぱいですよ。","start":56.239,"end":59.239,"readings":[{"word":"上","reading":"うえ","offset":9}]},{"id":"sentence-9","text":"そう。","start":61.039,"end":61.602,"readings":[]},{"id":"sentence-10","text":"じゃあ棚の上はどうかしら?","start":61.602,"end":64.039,"readings":[{"word":"棚","reading":"たな","offset":3},{"word":"上","reading":"うえ","offset":5}]},{"id":"sentence-11","text":"ちょっと危ないですね。","start":65.28,"end":66.655,"readings":[{"word":"危ない","reading":"あぶない","offset":4}]},{"id":"sentence-12","text":"その椅子の上はどうですか?","start":66.655,"end":68.28,"readings":[{"word":"椅子","reading":"いす","offset":2},{"word":"上","reading":"うえ","offset":5}]},{"id":"sentence-13","text":"いいけど座る人がいるかもしれないわね。","start":70.92,"end":73.92,"readings":[{"word":"座る","reading":"すわる","offset":4},{"word":"人","reading":"ひと","offset":6}]},{"id":"sentence-14","text":"うーん。","start":75.36,"end":75.822,"readings":[]},{"id":"sentence-15","text":"じゃあ入り口の方に置く場所を作りましょうか。","start":75.822,"end":78.36,"readings":[{"word":"入り口","reading":"いりくち","offset":3},{"word":"方","reading":"ほう","offset":7},{"word":"置く","reading":"おく","offset":9},{"word":"場所","reading":"ばしょ","offset":11},{"word":"作り","reading":"つくり","offset":14}]},{"id":"sentence-16","text":"そうね。","start":81.759,"end":84.079,"readings":[]},{"id":"sentence-17","text":"やっぱりテーブルの上にしましょう。","start":84.079,"end":87.32,"readings":[{"word":"上","reading":"うえ","offset":9}]},{"id":"sentence-18","text":"グラスやお皿の場所を変えましょう。","start":87.32,"end":92.479,"readings":[{"word":"皿","reading":"さら","offset":5},{"word":"場所","reading":"ばしょ","offset":7},{"word":"変え","reading":"かえ","offset":10}]},{"id":"sentence-19","text":"花はどこに置きますか?","start":94.439,"end":99.6,"readings":[{"word":"花","reading":"はな","offset":0},{"word":"置き","reading":"おき","offset":5}]},{"id":"sentence-20","text":"正しい答えは4です。","start":108,"end":112.094,"readings":[{"word":"正しい","reading":"ただしい","offset":0},{"word":"答え","reading":"こたえ","offset":3}]},{"id":"sentence-21","text":"では始めます。","start":112.094,"end":114.96,"readings":[{"word":"始め","reading":"はじめ","offset":2}]},{"id":"sentence-22","text":"1番日本語クラスの先生が話しています。","start":117.96,"end":121.152,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"日本語","reading":"にほんご","offset":2},{"word":"先生","reading":"せんせい","offset":9},{"word":"話し","reading":"はなし","offset":12}]},{"id":"sentence-23","text":"月曜日に何をしますか?","start":121.152,"end":123,"readings":[{"word":"月曜日","reading":"げつようび","offset":0},{"word":"何","reading":"なに","offset":4}]},{"id":"sentence-24","text":"えっと、月曜日に漢字のテストをします。","start":128.56,"end":130.84,"readings":[{"word":"月曜日","reading":"げつようび","offset":4},{"word":"漢字","reading":"かんじ","offset":8}]},{"id":"sentence-25","text":"漢字の読みを","start":130.84,"end":131.56,"readings":[{"word":"漢字","reading":"かんじ","offset":0},{"word":"読み","reading":"よみ","offset":3}]},{"id":"sentence-26","text":"50問出します。","start":134.68,"end":137.2,"readings":[{"word":"問","reading":"もん","offset":2},{"word":"出し","reading":"だし","offset":3}]},{"id":"sentence-27","text":"30ページに練習問題がありますからノートにやってきてください。","start":137.2,"end":145.88,"readings":[{"word":"練習","reading":"れんしゅう","offset":6},{"word":"問題","reading":"もんだい","offset":8}]},{"id":"sentence-28","text":"これは宿題です。","start":145.88,"end":148.12,"readings":[{"word":"宿題","reading":"しゅくだい","offset":3}]},{"id":"sentence-29","text":"月曜日に何をしますか?","start":150.12,"end":155.599,"readings":[{"word":"月曜日","reading":"げつようび","offset":0},{"word":"何","reading":"なに","offset":4}]},{"id":"sentence-30","text":"2番女の人が家に電話しています。","start":166.879,"end":172.8,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"女","reading":"おんな","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"家","reading":"いえ","offset":6},{"word":"電話","reading":"でんわ","offset":8}]},{"id":"sentence-31","text":"女の人は何を買って帰りますか?","start":172.8,"end":174.531,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"何","reading":"なに","offset":4},{"word":"買っ","reading":"かっ","offset":6},{"word":"帰り","reading":"かえり","offset":9}]},{"id":"sentence-32","text":"ああ、私今駅に着いた。","start":174.531,"end":175.8,"readings":[{"word":"私","reading":"わたし","offset":3},{"word":"今","reading":"こん","offset":4},{"word":"駅","reading":"えき","offset":5},{"word":"着い","reading":"つい","offset":7}]},{"id":"sentence-33","text":"悪いんだけど買い物を頼んでいい?","start":186.64,"end":189.64,"readings":[{"word":"悪い","reading":"わるい","offset":0},{"word":"買い物","reading":"かいもの","offset":6},{"word":"頼ん","reading":"たのん","offset":10}]},{"id":"sentence-34","text":"うん。","start":190.319,"end":191.496,"readings":[]},{"id":"sentence-35","text":"何?","start":191.496,"end":192.28,"readings":[{"word":"何","reading":"なに","offset":0}]},{"id":"sentence-36","text":"明日のパンがないんだ。","start":192.28,"end":194.343,"readings":[{"word":"明日","reading":"あした","offset":0}]},{"id":"sentence-37","text":"あと牛乳。","start":194.343,"end":195.28,"readings":[{"word":"牛乳","reading":"ぎゅうにゅう","offset":2}]},{"id":"sentence-38","text":"パンは何でもいい?","start":196.76,"end":198.48,"readings":[{"word":"何","reading":"なに","offset":3}]},{"id":"sentence-39","text":"うん。","start":198.48,"end":200,"readings":[]},{"id":"sentence-40","text":"ああ、ジャムもうちょっとしかないなあ。","start":200,"end":203,"readings":[]},{"id":"sentence-41","text":"他にはビールかな?","start":204.4,"end":207.599,"readings":[{"word":"他","reading":"た","offset":0}]},{"id":"sentence-42","text":"それは嫌。","start":207.599,"end":208.537,"readings":[{"word":"嫌","reading":"いや","offset":3}]},{"id":"sentence-43","text":"牛乳だけでも重いのに。","start":208.537,"end":210.599,"readings":[{"word":"牛乳","reading":"ぎゅうにゅう","offset":0},{"word":"重い","reading":"おもい","offset":6}]},{"id":"sentence-44","text":"女の人は何を買って帰りますか?","start":215.959,"end":222.159,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"何","reading":"なに","offset":4},{"word":"買っ","reading":"かっ","offset":6},{"word":"帰り","reading":"かえり","offset":9}]},{"id":"sentence-45","text":"3番男の人が話しています。","start":233.56,"end":238.76,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"話し","reading":"はなし","offset":6}]},{"id":"sentence-46","text":"冷蔵庫に卵をしまう時はどうすればいいですか?","start":238.76,"end":241.76,"readings":[{"word":"冷蔵庫","reading":"れいぞうこ","offset":0},{"word":"卵","reading":"たまご","offset":4},{"word":"時","reading":"とき","offset":9}]},{"id":"sentence-47","text":"卵に上と下があるのはご存知ですか?","start":245.159,"end":245.858,"readings":[{"word":"卵","reading":"たまご","offset":0},{"word":"上と下","reading":"うえとした","offset":2},{"word":"ご存知","reading":"ごぞんじ","offset":10}]},{"id":"sentence-48","text":"よく見ると丸い方と少し先が細くなっている方があるんです。","start":245.858,"end":247.008,"readings":[{"word":"見る","reading":"みる","offset":2},{"word":"丸い","reading":"まるい","offset":5},{"word":"方","reading":"ほう","offset":7},{"word":"少し","reading":"すこし","offset":9},{"word":"先","reading":"さき","offset":11},{"word":"細く","reading":"ほそく","offset":13},{"word":"方","reading":"ほう","offset":20}]},{"id":"sentence-49","text":"丸い方が上です。","start":247.008,"end":247.337,"readings":[{"word":"丸い","reading":"まるい","offset":0},{"word":"方","reading":"ほう","offset":2},{"word":"上","reading":"うえ","offset":4}]},{"id":"sentence-50","text":"卵を冷蔵庫にしまう時を上にしてください。","start":247.337,"end":248.159,"readings":[{"word":"卵","reading":"たまご","offset":0},{"word":"冷蔵庫","reading":"れいぞうこ","offset":2},{"word":"時","reading":"とき","offset":9},{"word":"上","reading":"うえ","offset":11}]},{"id":"sentence-51","text":"どっちでもいいと思われるかもしれませんが、理由があります。","start":266.6,"end":272.32,"readings":[{"word":"思わ","reading":"おもわ","offset":8},{"word":"理由","reading":"りゆう","offset":21}]},{"id":"sentence-52","text":"丸い方には上に空気が入っています。","start":272.32,"end":276.919,"readings":[{"word":"丸い","reading":"まるい","offset":0},{"word":"方","reading":"ほう","offset":2},{"word":"上","reading":"うえ","offset":5},{"word":"空気","reading":"くうき","offset":7},{"word":"入っ","reading":"はいっ","offset":10}]},{"id":"sentence-53","text":"この空気のおかげで卵の殻から離れます。","start":276.919,"end":283.88,"readings":[{"word":"空気","reading":"くうき","offset":2},{"word":"卵","reading":"たまご","offset":9},{"word":"殻","reading":"から","offset":11},{"word":"離れ","reading":"はなれ","offset":14}]},{"id":"sentence-54","text":"殻はあまり綺麗ではないので君が離れている方が長くしまっておけるんですよ。","start":283.88,"end":293.84,"readings":[{"word":"殻","reading":"から","offset":0},{"word":"綺麗","reading":"きれい","offset":5},{"word":"君","reading":"きみ","offset":13},{"word":"離れ","reading":"はなれ","offset":15},{"word":"方","reading":"ほう","offset":20},{"word":"長く","reading":"ながく","offset":22}]},{"id":"sentence-55","text":"冷蔵庫に卵をしまう時はどうすればいいですか?","start":295.8,"end":303.36,"readings":[{"word":"冷蔵庫","reading":"れいぞうこ","offset":0},{"word":"卵","reading":"たまご","offset":4},{"word":"時","reading":"とき","offset":9}]},{"id":"sentence-56","text":"4番女の人がレストランで注文しています。","start":314.759,"end":321.36,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"女","reading":"おんな","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"注文","reading":"ちゅうもん","offset":12}]},{"id":"sentence-57","text":"飲み物はどうすることにしましたか?","start":321.36,"end":322.224,"readings":[{"word":"飲み物","reading":"のみもの","offset":0}]},{"id":"sentence-58","text":"ランチセットにはコーヒーか紅茶が付いているんですね。","start":322.224,"end":323.546,"readings":[{"word":"紅茶","reading":"こうちゃ","offset":13},{"word":"付い","reading":"つい","offset":16}]},{"id":"sentence-59","text":"はい。","start":323.546,"end":323.699,"readings":[]},{"id":"sentence-60","text":"ホットかアイスか選べます。","start":323.699,"end":324.36,"readings":[{"word":"選べ","reading":"えらべ","offset":8}]},{"id":"sentence-61","text":"じゃあアイスコーヒーお願いします。","start":333.52,"end":335.96,"readings":[{"word":"お願い","reading":"おねがい","offset":10}]},{"id":"sentence-62","text":"かしこまりました。","start":335.96,"end":336.804,"readings":[]},{"id":"sentence-63","text":"先にお持ちしますか?","start":336.804,"end":337.741,"readings":[{"word":"先","reading":"さき","offset":0},{"word":"持ち","reading":"もち","offset":3}]},{"id":"sentence-64","text":"お食事の後になさいますか?","start":337.741,"end":338.96,"readings":[{"word":"食事","reading":"しょくじ","offset":1},{"word":"後","reading":"のち","offset":4}]},{"id":"sentence-65","text":"えっと、お代わりはできるんですか?","start":342.56,"end":345.319,"readings":[{"word":"代わり","reading":"かわり","offset":5}]},{"id":"sentence-66","text":"はい。","start":345.319,"end":346.88,"readings":[]},{"id":"sentence-67","text":"じゃあ先に持ってきてください。","start":346.88,"end":349.88,"readings":[{"word":"先","reading":"さき","offset":3},{"word":"持っ","reading":"もっ","offset":5}]},{"id":"sentence-68","text":"飲み物はどうすることにしましたか?","start":353.4,"end":359.28,"readings":[{"word":"飲み物","reading":"のみもの","offset":0}]},{"id":"sentence-69","text":"5番男の人と女の人がカレンダーを見ながら話しています。","start":370.599,"end":379.12,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"見","reading":"み","offset":16},{"word":"話し","reading":"はなし","offset":20}]},{"id":"sentence-70","text":"これからどんなカレンダーを作りますか?","start":379.12,"end":380.195,"readings":[{"word":"作り","reading":"つくり","offset":13}]},{"id":"sentence-71","text":"来年のカレンダーのデザインを考えてみました。","start":380.195,"end":381.441,"readings":[{"word":"来年","reading":"らいねん","offset":0},{"word":"考え","reading":"かんがえ","offset":14}]},{"id":"sentence-72","text":"これです。","start":381.441,"end":381.724,"readings":[]},{"id":"sentence-73","text":"ご覧ください。","start":381.724,"end":382.12,"readings":[{"word":"ご覧","reading":"ごらん","offset":0}]},{"id":"sentence-74","text":"うーん。","start":392,"end":392.632,"readings":[]},{"id":"sentence-75","text":"これじゃあ字が見にくないかな。","start":392.632,"end":395,"readings":[{"word":"字","reading":"じ","offset":5},{"word":"見にく","reading":"みにく","offset":7}]},{"id":"sentence-76","text":"はあ。","start":397.8,"end":398.133,"readings":[]},{"id":"sentence-77","text":"まあそうですね。","start":398.133,"end":399.022,"readings":[]},{"id":"sentence-78","text":"じゃあ絵よりも字を大きくします。","start":399.022,"end":400.8,"readings":[{"word":"絵","reading":"え","offset":3},{"word":"字","reading":"じ","offset":7},{"word":"大きく","reading":"おおきく","offset":9}]},{"id":"sentence-79","text":"うん。","start":405.56,"end":406.759,"readings":[]},{"id":"sentence-80","text":"字が大きければ1枚に2つ入れても問題ないだろう。","start":406.759,"end":412.84,"readings":[{"word":"字","reading":"じ","offset":0},{"word":"大きけれ","reading":"おおきけれ","offset":2},{"word":"枚","reading":"まい","offset":8},{"word":"入れ","reading":"いれ","offset":12},{"word":"問題","reading":"もんだい","offset":16}]},{"id":"sentence-81","text":"そうですね。","start":412.84,"end":414.8,"readings":[]},{"id":"sentence-82","text":"じゃ、そのように変えて。","start":414.8,"end":417.039,"readings":[{"word":"変え","reading":"かえ","offset":8}]},{"id":"sentence-83","text":"はい、わかりました。","start":417.039,"end":420.039,"readings":[]},{"id":"sentence-84","text":"これからどんなカレンダーを作りますか?","start":422.84,"end":429,"readings":[{"word":"作り","reading":"つくり","offset":13}]},{"id":"sentence-85","text":"6番会社で男の人と女の人が話しています。","start":440.319,"end":447.759,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"会社","reading":"かいしゃ","offset":2},{"word":"男","reading":"おとこ","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"女","reading":"おんな","offset":9},{"word":"人","reading":"ひと","offset":11},{"word":"話し","reading":"はなし","offset":13}]},{"id":"sentence-86","text":"女の人はこれから何をしますか?","start":447.759,"end":450.759,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"何","reading":"なに","offset":8}]},{"id":"sentence-87","text":"あの山田さん、今ちょっといい?","start":452.56,"end":455.56,"readings":[{"word":"山田","reading":"やまだ","offset":2},{"word":"今","reading":"いま","offset":7}]},{"id":"sentence-88","text":"はい。","start":456.639,"end":457.413,"readings":[]},{"id":"sentence-89","text":"何でしょう?","start":457.413,"end":458.96,"readings":[{"word":"何","reading":"なに","offset":0}]},{"id":"sentence-90","text":"悪いんだけど、昨日コピーしてもらった書類なんだけど、このグラフ忘れてたんだ。","start":458.96,"end":461.96,"readings":[{"word":"悪い","reading":"わるい","offset":0},{"word":"昨日","reading":"きのう","offset":7},{"word":"書類","reading":"しょるい","offset":18},{"word":"忘れ","reading":"わすれ","offset":31}]},{"id":"sentence-91","text":"分かりました。","start":467.28,"end":468.447,"readings":[{"word":"分かり","reading":"わかり","offset":0}]},{"id":"sentence-92","text":"何ページに入れますか?","start":468.447,"end":470.28,"readings":[{"word":"何","reading":"なん","offset":0},{"word":"入れ","reading":"いれ","offset":5}]},{"id":"sentence-93","text":"本当は10ページだけど、もう閉じちゃったでしょ。","start":471,"end":474.919,"readings":[{"word":"本当は","reading":"ほんとうは","offset":0},{"word":"閉じ","reading":"とじ","offset":14}]},{"id":"sentence-94","text":"やり直すのは大変だから配る時説明して中に入れてもらうよ。","start":475.96,"end":478.96,"readings":[{"word":"やり直す","reading":"やりなおす","offset":0},{"word":"大変","reading":"たいへん","offset":6},{"word":"配る","reading":"くばる","offset":11},{"word":"時","reading":"とき","offset":13},{"word":"説明","reading":"せつめい","offset":14},{"word":"中","reading":"なか","offset":18},{"word":"入れ","reading":"いれ","offset":20}]},{"id":"sentence-95","text":"そうですか。","start":481.96,"end":483.816,"readings":[]},{"id":"sentence-96","text":"15人分でしたね。","start":483.816,"end":486.599,"readings":[{"word":"人","reading":"にん","offset":2},{"word":"分","reading":"ぶん","offset":3}]},{"id":"sentence-97","text":"女の人はこれから何をしますか?","start":489.52,"end":495.52,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"何","reading":"なに","offset":8}]},{"id":"sentence-98","text":"7番男の人が会社で話しています。","start":506.96,"end":513.039,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"会社","reading":"かいしゃ","offset":6},{"word":"話し","reading":"はなし","offset":9}]},{"id":"sentence-99","text":"男の人は今晩どうするように言いましたか?","start":513.039,"end":516.039,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"今晩","reading":"こんばん","offset":4},{"word":"言い","reading":"いい","offset":13}]},{"id":"sentence-100","text":"あの、皆さんお仕事中すみません。","start":523.959,"end":524.733,"readings":[{"word":"皆さん","reading":"みなさん","offset":3},{"word":"仕事","reading":"しごと","offset":7},{"word":"中","reading":"ちゅう","offset":9}]},{"id":"sentence-101","text":"ちょっと聞いてください。","start":524.733,"end":525.314,"readings":[{"word":"聞い","reading":"きい","offset":4}]},{"id":"sentence-102","text":"ニュースによると今電車が全部止まっていて今晩はもう動かないそうです。","start":525.314,"end":526.959,"readings":[{"word":"今","reading":"いま","offset":8},{"word":"電車","reading":"でんしゃ","offset":9},{"word":"全部","reading":"ぜんぶ","offset":12},{"word":"止まっ","reading":"とまっ","offset":14},{"word":"今晩","reading":"こんばん","offset":20},{"word":"動か","reading":"うごか","offset":25}]},{"id":"sentence-103","text":"バスやタクシーは動いていますが、何時間も待たないと乗れないと思います。","start":539.36,"end":545.72,"readings":[{"word":"動い","reading":"うごい","offset":8},{"word":"何","reading":"なん","offset":16},{"word":"時間","reading":"じかん","offset":17},{"word":"待た","reading":"また","offset":20},{"word":"乗れ","reading":"のれ","offset":25},{"word":"思い","reading":"おもい","offset":30}]},{"id":"sentence-104","text":"会社で今晩皆さんが止まるホテルを予約しましたので、無理して帰らないで止まってください。","start":545.72,"end":556.48,"readings":[{"word":"会社","reading":"かいしゃ","offset":0},{"word":"今晩","reading":"こんばん","offset":3},{"word":"皆さん","reading":"みなさん","offset":5},{"word":"止まる","reading":"とまる","offset":9},{"word":"予約","reading":"よやく","offset":16},{"word":"無理","reading":"むり","offset":25},{"word":"帰ら","reading":"かえら","offset":29},{"word":"止まっ","reading":"とまっ","offset":34}]},{"id":"sentence-105","text":"男の人は今晩どうするように言いましたか?","start":558.36,"end":561.36,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"今晩","reading":"こんばん","offset":4},{"word":"言い","reading":"いい","offset":13}]},{"id":"sentence-106","text":"番男の人と女の人が道で話しています。","start":577.32,"end":582.16,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"男","reading":"おとこ","offset":1},{"word":"人","reading":"ひと","offset":3},{"word":"女","reading":"おんな","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"道","reading":"みち","offset":9},{"word":"話し","reading":"はなし","offset":11}]},{"id":"sentence-107","text":"女の人はこの後どうしますか?","start":584.44,"end":587.44,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"後","reading":"のち","offset":6}]},{"id":"sentence-108","text":"あの、すいません。","start":589.56,"end":590.981,"readings":[]},{"id":"sentence-109","text":"ちょっと伺いますが。","start":590.981,"end":592.56,"readings":[{"word":"伺い","reading":"うかがい","offset":4}]},{"id":"sentence-110","text":"はい。","start":593.399,"end":594.6,"readings":[]},{"id":"sentence-111","text":"南書館はここから遠いですか?","start":594.6,"end":597.6,"readings":[{"word":"南","reading":"みなみ","offset":0},{"word":"書","reading":"しょ","offset":1},{"word":"館","reading":"かん","offset":2},{"word":"遠い","reading":"とおい","offset":8}]},{"id":"sentence-112","text":"うーん。","start":598.44,"end":598.996,"readings":[]},{"id":"sentence-113","text":"歩くとね、分くらいかかりますよ。","start":598.996,"end":601.22,"readings":[{"word":"歩く","reading":"あるく","offset":0},{"word":"分","reading":"ぶん","offset":5}]},{"id":"sentence-114","text":"バスがあるんですけどね。","start":601.22,"end":602.889,"readings":[]},{"id":"sentence-115","text":"なかなか来ないから。","start":602.889,"end":604.279,"readings":[{"word":"来","reading":"こ","offset":4}]},{"id":"sentence-116","text":"はあ。","start":608.24,"end":609.08,"readings":[]},{"id":"sentence-117","text":"で、あちらの方ですか?","start":609.08,"end":612.16,"readings":[{"word":"方","reading":"ほう","offset":6}]},{"id":"sentence-118","text":"ええ、あっちの方なんですけどね。","start":612.16,"end":613.251,"readings":[{"word":"方","reading":"ほう","offset":7}]},{"id":"sentence-119","text":"道が複雑で説明しにくいのよ。","start":613.251,"end":614.205,"readings":[{"word":"道","reading":"みち","offset":0},{"word":"複雑","reading":"ふくざつ","offset":2},{"word":"説明","reading":"せつめい","offset":5}]},{"id":"sentence-120","text":"一緒に行ってあげましょうか?","start":614.205,"end":615.16,"readings":[{"word":"一緒","reading":"いっしょ","offset":0},{"word":"行っ","reading":"いっ","offset":3}]},{"id":"sentence-121","text":"いえ、そんなじゃあ紙か何かある?","start":622.64,"end":625.566,"readings":[{"word":"紙","reading":"かみ","offset":9},{"word":"何","reading":"なに","offset":11}]},{"id":"sentence-122","text":"地図を描いてあげるから。","start":625.566,"end":627.76,"readings":[{"word":"地図","reading":"ちず","offset":0},{"word":"描い","reading":"えがい","offset":3}]},{"id":"sentence-123","text":"すいません。","start":629.12,"end":629.938,"readings":[]},{"id":"sentence-124","text":"えっと、じゃこれにお願いします。","start":629.938,"end":632.12,"readings":[{"word":"お願い","reading":"おねがい","offset":9}]},{"id":"sentence-125","text":"女の人はこの後どうしますか?","start":638.2,"end":644.519,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"後","reading":"のち","offset":6}]},{"id":"sentence-126","text":"問題2問題2ではまずくさい。","start":657.32,"end":663.074,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3}]},{"id":"sentence-127","text":"その後問題用紙を見てください。","start":663.074,"end":669.24,"readings":[{"word":"その後","reading":"そのご","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"用紙","reading":"ようし","offset":5},{"word":"見","reading":"み","offset":8}]},{"id":"sentence-128","text":"読む時間があります。","start":669.24,"end":672.306,"readings":[{"word":"読む","reading":"よむ","offset":0},{"word":"時間","reading":"じかん","offset":2}]},{"id":"sentence-129","text":"それから話を聞いて問題用の1から4の中から1番いいものを1つ選んでください。","start":672.306,"end":683.959,"readings":[{"word":"話","reading":"はなし","offset":4},{"word":"聞い","reading":"きい","offset":6},{"word":"問題","reading":"もんだい","offset":9},{"word":"用","reading":"よう","offset":11},{"word":"中","reading":"なか","offset":18},{"word":"番","reading":"ばん","offset":22},{"word":"選ん","reading":"えらん","offset":30}]},{"id":"sentence-130","text":"例男の人と女の人が本を見ながら話しています。","start":685.88,"end":693.839,"readings":[{"word":"例","reading":"れい","offset":0},{"word":"男","reading":"おとこ","offset":1},{"word":"人","reading":"ひと","offset":3},{"word":"女","reading":"おんな","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"本","reading":"ほん","offset":9},{"word":"見","reading":"み","offset":11},{"word":"話し","reading":"はなし","offset":15}]},{"id":"sentence-131","text":"女の人は本をどうしますか?","start":693.839,"end":695.184,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"本","reading":"ほん","offset":4}]},{"id":"sentence-132","text":"この本いくらくらいするんですか?","start":695.184,"end":696.839,"readings":[{"word":"本","reading":"ほん","offset":2}]},{"id":"sentence-133","text":"これ先輩から円で買ったんだ。","start":707.92,"end":709.796,"readings":[{"word":"先輩","reading":"せんぱい","offset":2},{"word":"円","reading":"えん","offset":6},{"word":"買っ","reading":"かっ","offset":8}]},{"id":"sentence-134","text":"よかったら貸してあげようか。","start":709.796,"end":711.671,"readings":[{"word":"貸し","reading":"かし","offset":5}]},{"id":"sentence-135","text":"僕もう読んじゃったから。","start":711.671,"end":713.279,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"読ん","reading":"よん","offset":3}]},{"id":"sentence-136","text":"え、でもそれじゃ悪いですから。","start":716.639,"end":719.639,"readings":[{"word":"悪い","reading":"わるい","offset":8}]},{"id":"sentence-137","text":"いや、構わないよ。","start":719.8,"end":721.488,"readings":[{"word":"構わ","reading":"かまわ","offset":3}]},{"id":"sentence-138","text":"遠慮しないで。","start":721.488,"end":722.8,"readings":[{"word":"遠慮","reading":"えんりょ","offset":0}]},{"id":"sentence-139","text":"そうですか。","start":723.48,"end":724.605,"readings":[]},{"id":"sentence-140","text":"じゃあ、すみません。","start":724.605,"end":726.48,"readings":[]},{"id":"sentence-141","text":"どうぞ。","start":727,"end":730,"readings":[]},{"id":"sentence-142","text":"女の人は本をどうしますか?","start":732.16,"end":734.213,"readings":[{"word":"女","reading":"おんな","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"本","reading":"ほん","offset":4}]},{"id":"sentence-143","text":"正しい答えは","start":734.213,"end":735.16,"readings":[{"word":"正しい","reading":"ただしい","offset":0},{"word":"答え","reading":"こたえ","offset":3}]},{"id":"sentence-144","text":"1です。","start":748.92,"end":750.098,"readings":[]},{"id":"sentence-145","text":"では始めます。","start":750.098,"end":752.16,"readings":[{"word":"始め","reading":"はじめ","offset":2}]},{"id":"sentence-146","text":"1番男の人が家に電話しています。","start":757.079,"end":759.284,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"家","reading":"いえ","offset":6},{"word":"電話","reading":"でんわ","offset":8}]},{"id":"sentence-147","text":"男の人はどうして遅くなると言ってますか?","start":759.284,"end":762.04,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"遅く","reading":"おそく","offset":8},{"word":"言っ","reading":"いっ","offset":13}]},{"id":"sentence-148","text":"はい。","start":779.44,"end":780.8,"readings":[]},{"id":"sentence-149","text":"あ、今ね、まだ会社にいるんだ。","start":780.8,"end":783.8,"readings":[{"word":"今","reading":"いま","offset":2},{"word":"会社","reading":"かいしゃ","offset":7}]},{"id":"sentence-150","text":"電車雨で止まってるんですって。","start":784.839,"end":786.796,"readings":[{"word":"電車","reading":"でんしゃ","offset":0},{"word":"雨","reading":"う","offset":2},{"word":"止まっ","reading":"とまっ","offset":4}]},{"id":"sentence-151","text":"ニュースで見た。","start":786.796,"end":787.839,"readings":[{"word":"見","reading":"み","offset":5}]},{"id":"sentence-152","text":"え、そうなの?","start":789.48,"end":790.116,"readings":[]},{"id":"sentence-153","text":"僕は仕事がもう少しかかりそうなんで電話したんだけど。","start":790.116,"end":792.48,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"仕事","reading":"しごと","offset":2},{"word":"もう少し","reading":"もうすこし","offset":5},{"word":"電話","reading":"でんわ","offset":17}]},{"id":"sentence-154","text":"そう分かった。","start":797.04,"end":798.655,"readings":[{"word":"分かっ","reading":"わかっ","offset":2}]},{"id":"sentence-155","text":"どのくらい?","start":798.655,"end":800.04,"readings":[]},{"id":"sentence-156","text":"うーん、あと2時間くらいかな。","start":800.36,"end":803.595,"readings":[{"word":"時間","reading":"じかん","offset":7}]},{"id":"sentence-157","text":"先に食事してて。","start":803.595,"end":805.32,"readings":[{"word":"先","reading":"さき","offset":0},{"word":"食事","reading":"しょくじ","offset":2}]},{"id":"sentence-158","text":"男の人はどうして遅くなると言っていますか?","start":810.16,"end":817.04,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"遅く","reading":"おそく","offset":8},{"word":"言っ","reading":"いっ","offset":13}]},{"id":"sentence-159","text":"2番会社で男の人と女の人が話しています。","start":829.32,"end":837.12,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"会社","reading":"かいしゃ","offset":2},{"word":"男","reading":"おとこ","offset":5},{"word":"人","reading":"ひと","offset":7},{"word":"女","reading":"おんな","offset":9},{"word":"人","reading":"ひと","offset":11},{"word":"話し","reading":"はなし","offset":13}]},{"id":"sentence-160","text":"男の人はこれから何をしますか?","start":837.12,"end":838.62,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"何","reading":"なに","offset":8}]},{"id":"sentence-161","text":"ねえ、おいの新聞まだあるかな?","start":838.62,"end":840.12,"readings":[{"word":"新聞","reading":"しんぶん","offset":6}]},{"id":"sentence-162","text":"どうしたんですか?","start":850.959,"end":852.68,"readings":[]},{"id":"sentence-163","text":"読みたかったニュースがあってね。","start":852.68,"end":855.199,"readings":[{"word":"読み","reading":"よみ","offset":0}]},{"id":"sentence-164","text":"ここにはないですね。","start":855.199,"end":856.056,"readings":[]},{"id":"sentence-165","text":"あ、受付に座っていただくところがありますよね。","start":856.056,"end":858.028,"readings":[{"word":"受付","reading":"うけつけ","offset":2},{"word":"座っ","reading":"すわっ","offset":5}]},{"id":"sentence-166","text":"多分","start":858.028,"end":858.199,"readings":[{"word":"多分","reading":"たぶん","offset":0}]},{"id":"sentence-167","text":"1週間分取ってあると思います。","start":864.079,"end":867.32,"readings":[{"word":"週間","reading":"しゅうかん","offset":1},{"word":"分","reading":"ぶん","offset":3},{"word":"取っ","reading":"とっ","offset":4},{"word":"思い","reading":"おもい","offset":10}]},{"id":"sentence-168","text":"受付か。","start":867.44,"end":868.72,"readings":[{"word":"受付","reading":"うけつけ","offset":0}]},{"id":"sentence-169","text":"なるほど。","start":868.72,"end":870.32,"readings":[]},{"id":"sentence-170","text":"はい。","start":870.32,"end":870.77,"readings":[]},{"id":"sentence-171","text":"新聞とか雑誌とか置いてあるんです。","start":870.77,"end":873.32,"readings":[{"word":"新聞","reading":"しんぶん","offset":0},{"word":"雑誌","reading":"ざっし","offset":4},{"word":"置い","reading":"おい","offset":8}]},{"id":"sentence-172","text":"じゃ、ちょっと行ってくるね。","start":874.24,"end":877.24,"readings":[{"word":"行っ","reading":"いっ","offset":7}]},{"id":"sentence-173","text":"男の人はこれから何をしますか?","start":880.68,"end":886.8,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"何","reading":"なに","offset":8}]},{"id":"sentence-174","text":"3番男の人と女の人がテレビを見ています。","start":899.36,"end":905.195,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"見","reading":"み","offset":14}]},{"id":"sentence-175","text":"9時から何を見ますか?","start":905.195,"end":908.404,"readings":[{"word":"時","reading":"じ","offset":1},{"word":"何","reading":"なに","offset":4},{"word":"見","reading":"み","offset":6}]},{"id":"sentence-176","text":"ねえ。","start":908.404,"end":909.279,"readings":[]},{"id":"sentence-177","text":"うん。","start":915.759,"end":916.279,"readings":[]},{"id":"sentence-178","text":"9時から昔見た映画やってるの一緒に見ない?","start":916.279,"end":919.92,"readings":[{"word":"時","reading":"じ","offset":1},{"word":"昔","reading":"むかし","offset":4},{"word":"見","reading":"み","offset":5},{"word":"映画","reading":"えいが","offset":7},{"word":"一緒","reading":"いっしょ","offset":14},{"word":"見","reading":"み","offset":17}]},{"id":"sentence-179","text":"え、そうなの?","start":921.12,"end":922.742,"readings":[]},{"id":"sentence-180","text":"僕はスポーツニュース見たいんだけどすごく良かったのよ。","start":922.742,"end":929,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"見","reading":"み","offset":10},{"word":"良かっ","reading":"よかっ","offset":20}]},{"id":"sentence-181","text":"いいや。","start":929,"end":929.571,"readings":[]},{"id":"sentence-182","text":"映画って長いし僕明日早いんだよね。","start":929.571,"end":932,"readings":[{"word":"映画","reading":"えいが","offset":0},{"word":"長い","reading":"ながい","offset":4},{"word":"僕","reading":"ぼく","offset":7},{"word":"明日","reading":"あした","offset":8},{"word":"早い","reading":"はやい","offset":10}]},{"id":"sentence-183","text":"でも分かったよ。","start":934.8,"end":936.187,"readings":[{"word":"分かっ","reading":"わかっ","offset":2}]},{"id":"sentence-184","text":"もしつまらなかったらきっと寝ちゃうぞ。","start":936.187,"end":939.48,"readings":[{"word":"寝","reading":"ね","offset":13}]},{"id":"sentence-185","text":"9時から何を見ますか?","start":945.72,"end":950.92,"readings":[{"word":"時","reading":"じ","offset":1},{"word":"何","reading":"なに","offset":4},{"word":"見","reading":"み","offset":6}]},{"id":"sentence-186","text":"4番先生と学生が話しています。","start":963.36,"end":969.959,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"先生","reading":"せんせい","offset":2},{"word":"学生","reading":"がくせい","offset":5},{"word":"話し","reading":"はなし","offset":8}]},{"id":"sentence-187","text":"はどうして宿題を出せませんか?","start":969.959,"end":971.365,"readings":[{"word":"宿題","reading":"しゅくだい","offset":5},{"word":"出せ","reading":"だせ","offset":8}]},{"id":"sentence-188","text":"じゃあ皆さん宿題を出してください。","start":971.365,"end":972.959,"readings":[{"word":"皆さん","reading":"みなさん","offset":3},{"word":"宿題","reading":"しゅくだい","offset":6},{"word":"出し","reading":"だし","offset":9}]},{"id":"sentence-189","text":"はい。","start":982.519,"end":984.019,"readings":[]},{"id":"sentence-190","text":"あれ?","start":984.019,"end":985.519,"readings":[]},{"id":"sentence-191","text":"どうしました?","start":987.44,"end":988.959,"readings":[]},{"id":"sentence-192","text":"はい。","start":988.959,"end":989.879,"readings":[]},{"id":"sentence-193","text":"あの宿題がまたやらなかったんですか?","start":989.879,"end":995.399,"readings":[{"word":"宿題","reading":"しゅくだい","offset":2}]},{"id":"sentence-194","text":"いえ、全部やりました。","start":995.399,"end":998.24,"readings":[{"word":"全部","reading":"ぜんぶ","offset":3}]},{"id":"sentence-195","text":"じゃあ持ってくるのを忘れたんでしょう?","start":998.24,"end":1001.199,"readings":[{"word":"持っ","reading":"もっ","offset":3},{"word":"忘れ","reading":"わすれ","offset":10}]},{"id":"sentence-196","text":"いえ、カにあります。","start":1001.199,"end":1004.151,"readings":[]},{"id":"sentence-197","text":"これです。","start":1004.151,"end":1005.627,"readings":[]},{"id":"sentence-198","text":"あら、3番と4番だけですね。","start":1005.627,"end":1009.759,"readings":[{"word":"番","reading":"ばん","offset":4},{"word":"番","reading":"ばん","offset":7}]},{"id":"sentence-199","text":"番と2番はうちにあると思います。","start":1009.759,"end":1013.16,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"番","reading":"ばん","offset":3},{"word":"思い","reading":"おもい","offset":11}]},{"id":"sentence-200","text":"じゃ、明日全部一緒に出してください。","start":1013.16,"end":1016.16,"readings":[{"word":"明日","reading":"あした","offset":3},{"word":"全部","reading":"ぜんぶ","offset":5},{"word":"一緒","reading":"いっしょ","offset":7},{"word":"出し","reading":"だし","offset":10}]},{"id":"sentence-201","text":"はい。","start":1016.8,"end":1017.8,"readings":[]},{"id":"sentence-202","text":"すいません。","start":1017.8,"end":1019.8,"readings":[]},{"id":"sentence-203","text":"学生はどうして宿題を出せませんか?","start":1024.559,"end":1031,"readings":[{"word":"学生","reading":"がくせい","offset":0},{"word":"宿題","reading":"しゅくだい","offset":7},{"word":"出せ","reading":"だせ","offset":10}]},{"id":"sentence-204","text":"5番男の人と女の人が話しています。","start":1043.52,"end":1049.84,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-205","text":"男の人は昨日何をしていましたか?","start":1049.84,"end":1051.76,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"昨日","reading":"きのう","offset":4},{"word":"何","reading":"なに","offset":6}]},{"id":"sentence-206","text":"昨日はどうしたの?","start":1051.76,"end":1052.84,"readings":[{"word":"昨日","reading":"きのう","offset":0}]},{"id":"sentence-207","text":"いやあ、朝から頭が痛くてずっと寝てたんだ。","start":1062.2,"end":1065.2,"readings":[{"word":"朝","reading":"あさ","offset":4},{"word":"頭","reading":"あたま","offset":7},{"word":"痛く","reading":"いたく","offset":9},{"word":"寝","reading":"ね","offset":15}]},{"id":"sentence-208","text":"食事は?","start":1067.76,"end":1069.48,"readings":[{"word":"食事","reading":"しょくじ","offset":0}]},{"id":"sentence-209","text":"あんまり食欲はなかったけど、夜は食べたよ。","start":1069.48,"end":1072.48,"readings":[{"word":"食欲","reading":"しょくよく","offset":4},{"word":"夜","reading":"よる","offset":14},{"word":"食べ","reading":"たべ","offset":16}]},{"id":"sentence-210","text":"今日は元気そうね。","start":1074,"end":1075.588,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"元気","reading":"げんき","offset":3}]},{"id":"sentence-211","text":"病院へ行ったの?","start":1075.588,"end":1077,"readings":[{"word":"病院","reading":"びょういん","offset":0},{"word":"行っ","reading":"いっ","offset":3}]},{"id":"sentence-212","text":"行かないよ。","start":1077.64,"end":1078.96,"readings":[{"word":"行か","reading":"いか","offset":0}]},{"id":"sentence-213","text":"ずっと寝てたんだ。","start":1078.96,"end":1080.46,"readings":[{"word":"寝","reading":"ね","offset":3}]},{"id":"sentence-214","text":"風薬は飲んだけど。","start":1080.46,"end":1081.96,"readings":[{"word":"風","reading":"かぜ","offset":0},{"word":"薬","reading":"やく","offset":1},{"word":"飲ん","reading":"のん","offset":3}]},{"id":"sentence-215","text":"きっと疲れてたのよ。","start":1083.2,"end":1084.109,"readings":[{"word":"疲れ","reading":"つかれ","offset":3}]},{"id":"sentence-216","text":"今日も授業が終わったら早く帰った方がいいわよ。","start":1084.109,"end":1086.2,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"授業","reading":"じゅぎょう","offset":3},{"word":"終わっ","reading":"おわっ","offset":6},{"word":"早く","reading":"はやく","offset":11},{"word":"帰っ","reading":"かえっ","offset":13},{"word":"方","reading":"ほう","offset":16}]},{"id":"sentence-217","text":"うん。","start":1089.24,"end":1090.365,"readings":[]},{"id":"sentence-218","text":"そうする。","start":1090.365,"end":1092.24,"readings":[]},{"id":"sentence-219","text":"男の人は昨日何をしていましたか?","start":1095.12,"end":1101.6,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"昨日","reading":"きのう","offset":4},{"word":"何","reading":"なに","offset":6}]},{"id":"sentence-220","text":"6番男の人と女の人が話しています。","start":1114.039,"end":1120.559,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":2},{"word":"人","reading":"ひと","offset":4},{"word":"女","reading":"おんな","offset":6},{"word":"人","reading":"ひと","offset":8},{"word":"話し","reading":"はなし","offset":10}]},{"id":"sentence-221","text":"この人はどうやって駅まで行きますか?","start":1120.559,"end":1121.876,"readings":[{"word":"人","reading":"ひと","offset":2},{"word":"駅","reading":"えき","offset":9},{"word":"行き","reading":"いき","offset":12}]},{"id":"sentence-222","text":"あなた悪いけど駅まで花子を迎えに行ってくれる?","start":1121.876,"end":1123.559,"readings":[{"word":"悪い","reading":"わるい","offset":3},{"word":"駅","reading":"えき","offset":7},{"word":"花子","reading":"はなこ","offset":10},{"word":"迎え","reading":"むかえ","offset":13},{"word":"行っ","reading":"いっ","offset":16}]},{"id":"sentence-223","text":"いいけどなんで?","start":1135.4,"end":1137.4,"readings":[]},{"id":"sentence-224","text":"今日は学校から色々持って帰ってくるものがあって荷物が多いのよ。","start":1137.4,"end":1140.4,"readings":[{"word":"今日","reading":"きょう","offset":0},{"word":"学校","reading":"がっこう","offset":3},{"word":"色々","reading":"いろいろ","offset":7},{"word":"持っ","reading":"もっ","offset":9},{"word":"帰っ","reading":"かえっ","offset":12},{"word":"荷物","reading":"にもつ","offset":23},{"word":"多い","reading":"おおい","offset":26}]},{"id":"sentence-225","text":"じゃあ車がいいかな?","start":1143.039,"end":1145.72,"readings":[{"word":"車","reading":"くるま","offset":3}]},{"id":"sentence-226","text":"車で行くほどじゃないと思うけど、自転車でも大丈夫よ。","start":1145.72,"end":1147.493,"readings":[{"word":"車","reading":"くるま","offset":0},{"word":"行く","reading":"いく","offset":2},{"word":"思う","reading":"おもう","offset":11},{"word":"自転車","reading":"じてんしゃ","offset":16},{"word":"大丈夫","reading":"だいじょうぶ","offset":21}]},{"id":"sentence-227","text":"僕の自転車今修理に出しているんだよ。","start":1147.493,"end":1148.72,"readings":[{"word":"僕","reading":"ぼく","offset":0},{"word":"自転車","reading":"じてんしゃ","offset":2},{"word":"今","reading":"こん","offset":5},{"word":"修理","reading":"しゅうり","offset":6},{"word":"出し","reading":"だし","offset":9}]},{"id":"sentence-228","text":"あら、そうだったの。","start":1154.6,"end":1156.267,"readings":[]},{"id":"sentence-229","text":"じゃあ私の使う?","start":1156.267,"end":1157.6,"readings":[{"word":"私","reading":"わたし","offset":3},{"word":"使う","reading":"つかう","offset":5}]},{"id":"sentence-230","text":"うん。","start":1158.08,"end":1158.609,"readings":[]},{"id":"sentence-231","text":"そうする。","start":1158.609,"end":1159.492,"readings":[]},{"id":"sentence-232","text":"つ頃行けばいいの?","start":1159.492,"end":1161.08,"readings":[{"word":"頃","reading":"ころ","offset":1},{"word":"行け","reading":"いけ","offset":2}]},{"id":"sentence-233","text":"花子が電話してくるからもう少し待ってて。","start":1161.72,"end":1164.72,"readings":[{"word":"花子","reading":"はなこ","offset":0},{"word":"電話","reading":"でんわ","offset":3},{"word":"もう少し","reading":"もうすこし","offset":11},{"word":"待っ","reading":"まっ","offset":15}]},{"id":"sentence-234","text":"男の人はどうやって駅まで行きますか?","start":1169.28,"end":1175.96,"readings":[{"word":"男","reading":"おとこ","offset":0},{"word":"人","reading":"ひと","offset":2},{"word":"駅","reading":"えき","offset":9},{"word":"行き","reading":"いき","offset":12}]},{"id":"sentence-235","text":"7番先生と学生が話しています。","start":1188.44,"end":1195.2,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"先生","reading":"せんせい","offset":2},{"word":"学生","reading":"がくせい","offset":5},{"word":"話し","reading":"はなし","offset":8}]},{"id":"sentence-236","text":"は本をつ返しますか?","start":1195.2,"end":1195.867,"readings":[{"word":"本","reading":"ほん","offset":1},{"word":"返し","reading":"かえし","offset":4}]},{"id":"sentence-237","text":"すみません。","start":1195.867,"end":1196.267,"readings":[]},{"id":"sentence-238","text":"ではこの本をしばらくお借りします。","start":1196.267,"end":1197.4,"readings":[{"word":"本","reading":"ほん","offset":4},{"word":"借り","reading":"かり","offset":11}]},{"id":"sentence-239","text":"つ頃までよろしいですか?","start":1197.4,"end":1198.2,"readings":[{"word":"頃","reading":"ころ","offset":1}]},{"id":"sentence-240","text":"それは今ほとんど使ってないからしばらくいいよ。","start":1211.88,"end":1213.448,"readings":[{"word":"今","reading":"いま","offset":3},{"word":"使っ","reading":"つかっ","offset":8}]},{"id":"sentence-241","text":"レポートが終わったら返してくれればいいよ。","start":1213.448,"end":1214.88,"readings":[{"word":"終わっ","reading":"おわっ","offset":5},{"word":"返し","reading":"かえし","offset":10}]},{"id":"sentence-242","text":"そうですか。","start":1221.12,"end":1221.905,"readings":[]},{"id":"sentence-243","text":"では今月中にはレポートは来月の日までだからその後で構わないよ。","start":1221.905,"end":1225.964,"readings":[{"word":"今月","reading":"こんげつ","offset":2},{"word":"中","reading":"ちゅう","offset":4},{"word":"来月","reading":"らいげつ","offset":12},{"word":"日","reading":"ひ","offset":15},{"word":"その後","reading":"そのご","offset":21},{"word":"構わ","reading":"かまわ","offset":25}]},{"id":"sentence-244","text":"ありがとうございます。","start":1225.964,"end":1227.404,"readings":[]},{"id":"sentence-245","text":"レポートができたらすぐお返しします。","start":1227.404,"end":1229.76,"readings":[{"word":"お返し","reading":"おかえし","offset":11}]},{"id":"sentence-246","text":"学生は本をいつ返しますか?","start":1240.2,"end":1246.2,"readings":[{"word":"学生","reading":"がくせい","offset":0},{"word":"本","reading":"ほん","offset":3},{"word":"返し","reading":"かえし","offset":7}]},{"id":"sentence-247","text":"問題3問題3では絵を見ながら質問を聞いくさい。","start":1260.039,"end":1266.76,"readings":[{"word":"問題","reading":"もんだい","offset":0},{"word":"問題","reading":"もんだい","offset":3},{"word":"絵","reading":"え","offset":8},{"word":"見","reading":"み","offset":10},{"word":"質問","reading":"しつもん","offset":14},{"word":"聞い","reading":"きい","offset":17}]},{"id":"sentence-248","text":"矢印の人は何と言いますか?","start":1266.76,"end":1270.559,"readings":[{"word":"矢印","reading":"やじるし","offset":0},{"word":"人","reading":"ひと","offset":3},{"word":"何","reading":"なに","offset":5},{"word":"言い","reading":"いい","offset":7}]},{"id":"sentence-249","text":"1から3の中から1番いいものを1つ選んでください。","start":1273.6,"end":1280.291,"readings":[{"word":"中","reading":"なか","offset":5},{"word":"番","reading":"ばん","offset":9},{"word":"選ん","reading":"えらん","offset":17}]},{"id":"sentence-250","text":"例","start":1280.291,"end":1280.559,"readings":[{"word":"例","reading":"れい","offset":0}]},{"id":"sentence-251","text":"結婚する人に何と言いますか?","start":1285.4,"end":1288.4,"readings":[{"word":"結婚","reading":"けっこん","offset":0},{"word":"人","reading":"ひと","offset":4},{"word":"何","reading":"なに","offset":6},{"word":"言い","reading":"いい","offset":8}]},{"id":"sentence-252","text":"おめでとうございます。","start":1291.919,"end":1294.919,"readings":[]},{"id":"sentence-253","text":"ありがとうございます。","start":1296.52,"end":1301.2,"readings":[]},{"id":"sentence-254","text":"お大事に。","start":1301.2,"end":1302.564,"readings":[{"word":"大事","reading":"だいじ","offset":1}]},{"id":"sentence-255","text":"正しい答えは","start":1302.564,"end":1304.2,"readings":[{"word":"正しい","reading":"ただしい","offset":0},{"word":"答え","reading":"こたえ","offset":3}]},{"id":"sentence-256","text":"1です。","start":1314.76,"end":1315.938,"readings":[]},{"id":"sentence-257","text":"では始めます。","start":1315.938,"end":1318,"readings":[{"word":"始め","reading":"はじめ","offset":2}]},{"id":"sentence-258","text":"1番待ち合わせの時間に遅れました。","start":1323.08,"end":1327.282,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"待ち合わせ","reading":"まちあわせ","offset":2},{"word":"時間","reading":"じかん","offset":8},{"word":"遅れ","reading":"おくれ","offset":11}]},{"id":"sentence-259","text":"何と言いますか?","start":1327.282,"end":1329.259,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-260","text":"遅かったです。","start":1332.76,"end":1337.039,"readings":[{"word":"遅かっ","reading":"おそかっ","offset":0}]},{"id":"sentence-261","text":"遅れます。","start":1337.039,"end":1341.2,"readings":[{"word":"遅れ","reading":"おくれ","offset":0}]},{"id":"sentence-262","text":"遅くなりました。","start":1341.2,"end":1344.2,"readings":[{"word":"遅く","reading":"おそく","offset":0}]},{"id":"sentence-263","text":"2番会社で風を引いた人が先に帰ります。","start":1356.32,"end":1361.279,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"会社","reading":"かいしゃ","offset":2},{"word":"風","reading":"かぜ","offset":5},{"word":"引い","reading":"ひい","offset":7},{"word":"人","reading":"ひと","offset":10},{"word":"先","reading":"さき","offset":12},{"word":"帰り","reading":"かえり","offset":14}]},{"id":"sentence-264","text":"何と言いますか?","start":1362.88,"end":1367.4,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-265","text":"お先にお大事に頑張ってください。","start":1367.4,"end":1378.72,"readings":[{"word":"お先に","reading":"おさきに","offset":0},{"word":"大事","reading":"だいじ","offset":4},{"word":"頑張っ","reading":"がんばっ","offset":7}]},{"id":"sentence-266","text":"番困っている人がいます。","start":1391.32,"end":1393.12,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"困っ","reading":"こまっ","offset":1},{"word":"人","reading":"ひと","offset":6}]},{"id":"sentence-267","text":"何と言いますか?","start":1393.12,"end":1394.32,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-268","text":"手伝ってください。","start":1400,"end":1404.159,"readings":[{"word":"手伝っ","reading":"てつだっ","offset":0}]},{"id":"sentence-269","text":"手伝いましょうか?","start":1404.159,"end":1408.76,"readings":[{"word":"手伝い","reading":"てつだい","offset":0}]},{"id":"sentence-270","text":"手伝ってもいいです。","start":1408.76,"end":1411.76,"readings":[{"word":"手伝っ","reading":"てつだっ","offset":0}]},{"id":"sentence-271","text":"4番荷物がいっぱいで困っています。","start":1424.32,"end":1427.856,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"荷物","reading":"にもつ","offset":2},{"word":"困っ","reading":"こまっ","offset":10}]},{"id":"sentence-272","text":"何と言いますか?","start":1427.856,"end":1429.52,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-273","text":"すみません。","start":1434.32,"end":1435.267,"readings":[]},{"id":"sentence-274","text":"ドアを開けてもいいですか?","start":1435.267,"end":1437.32,"readings":[{"word":"開け","reading":"あけ","offset":3}]},{"id":"sentence-275","text":"すみません。","start":1440.559,"end":1442.159,"readings":[]},{"id":"sentence-276","text":"ドアを開けてあげますか?","start":1442.159,"end":1445.159,"readings":[{"word":"開け","reading":"あけ","offset":3}]},{"id":"sentence-277","text":"すみません。","start":1447.36,"end":1448.307,"readings":[]},{"id":"sentence-278","text":"ドアを開けてもらえますか?","start":1448.307,"end":1450.36,"readings":[{"word":"開け","reading":"あけ","offset":3}]},{"id":"sentence-279","text":"番先生と相談します。","start":1464.919,"end":1469.399,"readings":[{"word":"番","reading":"ばん","offset":0},{"word":"先生","reading":"せんせい","offset":1},{"word":"相談","reading":"そうだん","offset":4}]},{"id":"sentence-280","text":"何と言いますか?","start":1469.399,"end":1473.84,"readings":[{"word":"何","reading":"なに","offset":0},{"word":"言い","reading":"いい","offset":2}]},{"id":"sentence-281","text":"先生、ちょっとご相談したいことがあるんですが","start":1473.84,"end":1476.84,"readings":[{"word":"先生","reading":"せんせい","offset":0},{"word":"相談","reading":"そうだん","offset":8}]},{"id":"sentence-282","text":"先生、ちょっと相談していただきたいことがあるんですが","start":1480.76,"end":1483.76,"readings":[{"word":"先生","reading":"せんせい","offset":0},{"word":"相談","reading":"そうだん","offset":7}]},{"id":"sentence-283","text":"先生、ちょっと相談していただけませんでしょうか","start":1488.12,"end":1491.12,"readings":[{"word":"先生","reading":"せんせい","offset":0},{"word":"相談","reading":"そうだん","offset":7}]},{"id":"sentence-284","text":"これで長試験を終わります。","start":1509.039,"end":1515.96,"readings":[{"word":"長","reading":"ちょう","offset":3},{"word":"試験","reading":"しけん","offset":4},{"word":"終わり","reading":"おわり","offset":7}]}]}