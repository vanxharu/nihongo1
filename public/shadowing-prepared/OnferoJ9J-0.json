82","text":"すぐ帰ってきますから。","start":505.707,"end":507.36,"readings":[{"word":"帰っ","reading":"かえっ","offset":2}]},{"id":"sentence-83","text":"そうですか。","start":510.28,"end":511.18,"readings":[]},{"id":"sentence-84","text":"クーラーはどうしましょうか?","start":511.18,"end":513.28,"readings":[]},{"id":"sentence-85","text":"クーラーもつけておきましょう。","start":514.719,"end":516.219,"readings":[]},{"id":"sentence-86","text":"帰ってきた時涼しいですからね。","start":516.219,"end":517.719,"readings":[{"word":"帰っ","reading":"かえっ","offset":0},{"word":"時","reading":"とき","offset":5},{"word":"涼しい","reading":"すずしい","offset":6}]},{"id":"sentence-87","text":"部屋はどうなりましたか?","start":525.2,"end":530.48,"readings":[{"word":"部屋","reading":"へや","offset":0}]},{"id":"sentence-88","text":"3番デパートで男の人と女の人が話しています自転車はどこで変えますか?","start":542.839,"end":556.8,"readings":[{"word":"番","reading":"ばん","offset":1},{"word":"男","reading":"おとこ","offset":7},{"word":"人","reading":"ひと","offset":9},{"word":"女","reading":"おんな","offset":11},{"word":"人","reading":"ひと","offset":13},{"word":"話し","reading":"はなし","offset":15},{"word":"自転車","reading":"じてんしゃ","offset":21},{"word":"変え","reading":"かえ","offset":28}]},{"id":"sentence-89","text":"あれ?","start":577.8,"end":578.647,"readings":[]},{"id":"sentence-90","text":"自転車って3階に言ってたよね。","start":578.647,"end":582.88,"readings":[{"word":"自転車","reading":"じてんしゃ","offset":0},{"word":"階","reading":"かい","offset":6},{"word":"言っ","reading":"いっ","offset":8}]},{"id":"sentence-91","text":"うん。","start":582.88,"end":583.4,"readings":[]},{"id":"sentence-92","text":"3階だよ。","start":583.4,"end":584.267,"readings":[{"word":"階","reading":"かい","offset":1}]},{"id":"sentence-93","text":"あ、売り場が変わってるじゃない。","start":584.267,"end":587.04,"readings":[{"word":"売り場","reading":"うりば","offset":2},{"word":"変わっ","reading":"かわっ","offset":6}]},{"id":"sentence-94","text":"自転車どこに行っちゃったんだろう。","start":590,"end":593,"readings":[{"word":"自転車","reading":"じてんしゃ","offset":0},{"word":"行っ","reading":"いっ","offset":6}]},{"id":"sentence-95","text":"あ、1階になったみたいだよ。","star