{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/vocabulary-illustrations/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/mascot/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/reading/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/exams/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/ai-analysis/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/tango/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/tts.ts": {
      "maxDuration": 30
    },
    "api/shadowing/video.ts": {
      "includeFiles": "public/shadowing-prepared/*.json",
      "maxDuration": 60
    },
    "api/shadowing/analyze.ts": {
      "includeFiles": "node_modules/kuromoji/dict/**",
      "maxDuration": 60
    },
    "api/shadowing/prepare.ts": {
      "includeFiles": "node_modules/kuromoji/dict/**",
      "maxDuration": 60
    },
    "api/server.ts": {
      "includeFiles": "{node_modules/kuromoji/dict/**,youtube-listening-*.json,src/data/*.json,public/shadowing-prepared/*.json,public/shadowing-analysis/*.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://nihongo-fd01e.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/api/((?!shadowing/(?:video|transcript|analyze|prepare)$|tts$).*)",
      "destination": "/api/server"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
