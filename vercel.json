{
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ],
  "functions": {
    "api/reading/generate.ts": { "maxDuration": 60 },
    "api/shadowing/video.ts": { "includeFiles": "public/shadowing-prepared/*.json", "maxDuration": 60 },
    "api/shadowing/analyze.ts": { "includeFiles": "node_modules/kuromoji/dict/**", "maxDuration": 60 },
    "api/shadowing/prepare.ts": { "includeFiles": "node_modules/kuromoji/dict/**", "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://nihongo-fd01e.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
