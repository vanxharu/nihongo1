{
  "functions": {
    "api/shadowing/analyze.ts": { "includeFiles": "node_modules/kuromoji/dict/**" }
  },
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://nihongo-fd01e.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
